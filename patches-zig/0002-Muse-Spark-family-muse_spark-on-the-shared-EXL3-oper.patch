@@ -0,0 +1,202 @@
+//! EXL3 pack helpers for a rank's load: a device arena, trellis reads, TP cuts, the strips layout and fp32 reads.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const config = @import("config.zig");
+const exl3 = @import("exl3.zig");
+const fmt = core.exl3_format;
+
+/// Device memory in 64 MiB blocks handed out first-fit (256-byte aligned); a block or more gets its own buffer.
+pub const Arena = struct {
+    d: *const cuda.Driver,
+    gpa: std.mem.Allocator,
+    blocks: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    own: std.ArrayList(cuda.DeviceBuffer) = .empty, // requests of a block or more, each its own buffer
+    fill: std.ArrayList(usize) = .empty, // bytes handed out of each block
+    first_open: usize = 0, // the first block with 4 KiB or more left
+    total: usize = 0,
+    pub const block_bytes: usize = 64 << 20;
+
+    /// Device bytes the arena holds (blocks and own buffers), against `total` handed out.
+    pub fn reserved(a: *const Arena) usize {
+        var r: usize = 0;
+        for (a.blocks.items) |b| r += b.len;
+        for (a.own.items) |b| r += b.len;
+        return r;
+    }
+
+    pub fn alloc(a: *Arena, bytes: usize) !u64 {
+        const n = std.mem.alignForward(usize, @max(bytes, 1), 256);
+        if (n >= block_bytes) {
+            try a.own.ensureUnusedCapacity(a.gpa, 1);
+            const buf = try cuda.DeviceBuffer.alloc(a.d, n);
+            a.own.appendAssumeCapacity(buf);
+            a.total += n;
+            return buf.ptr;
+        }
+        var i = a.first_open;
+        while (i < a.blocks.items.len) : (i += 1) {
+            if (a.fill.items[i] + n <= a.blocks.items[i].len) break;
+        }
+        if (i == a.blocks.items.len) {
+            try a.fill.ensureUnusedCapacity(a.gpa, 1);
+            try a.blocks.append(a.gpa, try cuda.DeviceBuffer.alloc(a.d, block_bytes));
+            a.fill.appendAssumeCapacity(0);
+        }
+        const at = a.blocks.items[i].ptr + a.fill.items[i];
+        a.fill.items[i] += n;
+        a.total += n;
+        while (a.first_open < a.blocks.items.len and a.blocks.items[a.first_open].len - a.fill.items[a.first_open] < 4096) a.first_open += 1;
+        return at;
+    }
+    pub fn upload(a: *Arena, bytes: []const u8) !u64 {
+        const at = try a.alloc(bytes.len);
+        try check(a.d, a.d.api.cuMemcpyHtoD_v2(at, bytes.ptr, bytes.len));
+        return at;
+    }
+    pub fn zeros(a: *Arena, bytes: usize) !u64 {
+        const at = try a.alloc(bytes);
+        try check(a.d, a.d.api.cuMemsetD8_v2(at, 0, std.mem.alignForward(usize, @max(bytes, 1), 256)));
+        return at;
+    }
+    pub fn deinit(a: *Arena) void {
+        for (a.blocks.items) |*b| b.free();
+        a.blocks.deinit(a.gpa);
+        for (a.own.items) |*b| b.free();
+        a.own.deinit(a.gpa);
+        a.fill.deinit(a.gpa);
+    }
+};
+
+fn check(d: *const cuda.Driver, r: anytype) !void {
+    try d.check(r, "muse_spark load");
+}
+
+/// An EXL3 matrix on the host: trellis int16 [tk, tn, 8 * k2], suh fp16 [K], svh fp16 [N].
+pub const Mat = struct {
+    trellis: []i16,
+    suh: []f16,
+    svh: []f16,
+    tk: usize,
+    tn: usize,
+    k2: u32,
+
+    pub fn deinit(m: Mat, a: std.mem.Allocator) void {
+        a.free(m.trellis);
+        a.free(m.suh);
+        a.free(m.svh);
+    }
+    pub fn k(m: Mat) usize {
+        return m.tk * 16;
+    }
+    pub fn n(m: Mat) usize {
+        return m.tn * 16;
+    }
+};
+
+pub fn readMat(a: std.mem.Allocator, ck: *core.Checkpoint, prefix: []const u8) !Mat {
+    var nb: [256]u8 = undefined;
+    if ((ck.get(try std.fmt.bufPrint(&nb, "{s}.mul1", .{prefix})) catch null) == null) return error.NotMul1;
+    const t = try ck.get(try std.fmt.bufPrint(&nb, "{s}.trellis", .{prefix}));
+    if (t.dtype != .i16 or t.rank != 3 or t.shape[2] % 8 != 0) return error.BadTrellis;
+    const tr = try a.alloc(i16, t.numel());
+    errdefer a.free(tr);
+    @memcpy(std.mem.sliceAsBytes(tr), t.bytes);
+    const suh = try scales(a, ck, prefix, "suh", t.shape[0] * 16);
+    errdefer a.free(suh);
+    return .{ .trellis = tr, .suh = suh, .svh = try scales(a, ck, prefix, "svh", t.shape[1] * 16), .tk = t.shape[0], .tn = t.shape[1], .k2 = @intCast(t.shape[2] / 8) };
+}
+
+fn scales(a: std.mem.Allocator, ck: *core.Checkpoint, prefix: []const u8, part: []const u8, size: usize) ![]f16 {
+    var nb: [256]u8 = undefined;
+    const t = try ck.get(try std.fmt.bufPrint(&nb, "{s}.{s}", .{ prefix, part }));
+    const out = try a.alloc(f16, size);
+    errdefer a.free(out);
+    if (t.dtype == .f16 and t.numel() == size) {
+        @memcpy(std.mem.sliceAsBytes(out), t.bytes);
+    } else if (t.dtype == .i16 and t.numel() * 16 == size) {
+        const w = try a.alloc(i16, t.numel());
+        defer a.free(w);
+        @memcpy(std.mem.sliceAsBytes(w), t.bytes);
+        fmt.unpackSigns(w, out);
+    } else return error.BadScales;
+    return out;
+}
+
+/// weights.py cut(): outputs [lo, hi) (trellis columns, svh) or inputs [lo, hi) (trellis rows, suh); `m` is freed.
+pub fn cut(a: std.mem.Allocator, m: Mat, c: config.Cut) !Mat {
+    if (c.axis == .whole) return m;
+    defer m.deinit(a);
+    const w = 8 * @as(usize, m.k2);
+    if (c.lo % 128 != 0 or c.hi % 128 != 0) return error.CutNotOnBlock;
+    if (c.axis == .n) {
+        const tn = (c.hi - c.lo) / 16;
+        const tr = try a.alloc(i16, m.tk * tn * w);
+        for (0..m.tk) |kt| @memcpy(tr[kt * tn * w ..][0 .. tn * w], m.trellis[(kt * m.tn + c.lo / 16) * w ..][0 .. tn * w]);
+        return .{ .trellis = tr, .suh = try a.dupe(f16, m.suh), .svh = try a.dupe(f16, m.svh[c.lo..c.hi]), .tk = m.tk, .tn = tn, .k2 = m.k2 };
+    }
+    const tk = (c.hi - c.lo) / 16;
+    return .{ .trellis = try a.dupe(i16, m.trellis[(c.lo / 16) * m.tn * w ..][0 .. tk * m.tn * w]), .suh = try a.dupe(f16, m.suh[c.lo..c.hi]), .svh = try a.dupe(f16, m.svh), .tk = tk, .tn = m.tn, .k2 = m.k2 };
+}
+
+/// linear.strips: trellis int32 words [K/16, N/16, W] -> [N/128, K/16, 8, W].
+pub fn strips(a: std.mem.Allocator, m: Mat) ![]u32 {
+    const w32 = 4 * @as(usize, m.k2);
+    const words: []align(2) const u32 = std.mem.bytesAsSlice(u32, std.mem.sliceAsBytes(m.trellis));
+    const out = try a.alloc(u32, words.len);
+    for (0..m.tk) |kt| for (0..m.tn / 8) |nb8| for (0..8) |j| {
+        @memcpy(out[((nb8 * m.tk + kt) * 8 + j) * w32 ..][0..w32], words[((kt * m.tn) + nb8 * 8 + j) * w32 ..][0..w32]);
+    };
+    return out;
+}
+
+/// Exl3Linear.from_tensors (strips) on the device, with its zeroed split counters; the host matrix `m` is freed.
+pub fn linear(a: std.mem.Allocator, ar: *Arena, m: Mat) !exl3.Linear {
+    defer m.deinit(a);
+    if (m.k() % 128 != 0 or m.n() % 128 != 0) return error.NotBlocked;
+    const st = try strips(a, m);
+    defer a.free(st);
+    return .{
+        .words = try ar.upload(std.mem.sliceAsBytes(st)),
+        .suh = try ar.upload(std.mem.sliceAsBytes(m.suh)),
+        .svh = try ar.upload(std.mem.sliceAsBytes(m.svh)),
+        .counters = try ar.zeros(8 * (m.n() / 128) * 4),
+        .k = m.k(),
+        .n = m.n(),
+        .k2 = m.k2,
+        .split = exl3.plan(m.k(), m.n()),
+    };
+}
+
+/// torch's float -> bfloat16 (round to nearest even; NaN kept quiet).
+pub fn bf16Round(x: f32) f32 {
+    const u: u32 = @bitCast(x);
+    if (std.math.isNan(x)) return @bitCast((u | 0x0040_0000) & 0xFFFF_0000);
+    const r = u + 0x7FFF + ((u >> 16) & 1);
+    return @bitCast(r & 0xFFFF_0000);
+}
+
+/// A tensor as fp32 (`.float()`): bf16, fp16 or fp32 storage.
+pub fn asF32(a: std.mem.Allocator, t: core.safetensors.Tensor) ![]f32 {
+    const n = t.numel();
+    const out = try a.alloc(f32, n);
+    switch (t.dtype) {
+        .f32 => @memcpy(std.mem.sliceAsBytes(out), t.bytes),
+        .bf16 => for (out, 0..) |*o, i| {
+            o.* = @bitCast(@as(u32, std.mem.readInt(u16, t.bytes[2 * i ..][0..2], .little)) << 16);
+        },
+        .f16 => for (out, 0..) |*o, i| {
+            o.* = @floatCast(@as(f16, @bitCast(std.mem.readInt(u16, t.bytes[2 * i ..][0..2], .little))));
+        },
+        else => return error.BadDType,
+    }
+    return out;
+}
+
+test "bf16 rounding is torch's: nearest even, NaN kept quiet" {
+    try std.testing.expectEqual(@as(f32, 1.0), bf16Round(1.0));
+    try std.testing.expectEqual(@as(u32, 0x3F80_0000), @as(u32, @bitCast(bf16Round(@bitCast(@as(u32, 0x3F80_8000))))));
+    try std.testing.expectEqual(@as(u32, 0x3F82_0000), @as(u32, @bitCast(bf16Round(@bitCast(@as(u32, 0x3F81_8000))))));
+    try std.testing.expect(std.math.isNan(bf16Round(std.math.nan(f32))));
+}
diff --git a/zig/src/families/muse_spark/pair.zig b/zig/src/families/muse_spark/pair.zig
new file mode 100644
index 00000000..bf0f8526
--- /dev/null
+++ b/zig/src/families/muse_spark/pair.zig
@@ -0,0 +1,89 @@
+//! A test-only TP=2 collective for both ranks on one GPU (MUSE_PAIR=1): device-copy gathers between two threads.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const tp = @import("tp");
+const C = tp.Collective;
+const K = tp.collective;
+
+pub const Pair = struct {
+    d: *const cuda.Driver,
+    arrived: std.atomic.Value(u32) = .init(0),
+    gen: std.atomic.Value(u32) = .init(0),
+    aborted: std.atomic.Value(bool) = .init(false),
+    dst: [2]u64 = .{ 0, 0 },
+
+    fn barrier(p: *Pair) K.Error!void {
+        const g = p.gen.load(.acquire);
+        if (p.arrived.fetchAdd(1, .acq_rel) == 1) {
+            p.arrived.store(0, .release);
+            _ = p.gen.fetchAdd(1, .release);
+            return;
+        }
+        while (p.gen.load(.acquire) == g) {
+            if (p.aborted.load(.acquire)) return error.Aborted;
+            std.atomic.spinLoopHint();
+        }
+    }
+
+    pub fn abort(p: *Pair) void {
+        p.aborted.store(true, .release);
+    }
+};
+
+pub const Rank = struct {
+    pair: *Pair,
+    rank: u32,
+
+    fn of(ptr: *anyopaque) *Rank {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    pub fn collective(r: *Rank) C {
+        return .{ .ptr = r, .vtable = &vtable };
+    }
+
+    const vtable: C.VTable = .{ .kind = .host, .rank = rankFn, .world = worldFn, .all_reduce = allReduce, .all_gather = allGather, .exchange = exchange, .send = sendFn, .recv = recvFn, .barrier = barrierFn, .check = check, .abort = abortFn };
+
+    fn rankFn(ptr: *anyopaque) u32 {
+        return of(ptr).rank;
+    }
+    fn worldFn(_: *anyopaque) u32 {
+        return 2;
+    }
+    /// recv[2 * count] <- both ranks' send[count], each rank copying its slice into both after its stream drains.
+    fn allGather(ptr: *anyopaque, send: K.DevicePtr, recv: K.DevicePtr, count: usize, t: tp.DType, stream: K.Stream) K.Error!void {
+        const r = of(ptr);
+        const p = r.pair;
+        const d = p.d;
+        d.check(d.api.cuStreamSynchronize(stream), "pair sync") catch return error.BackendFailed;
+        p.dst[r.rank] = recv;
+        try p.barrier();
+        const bytes = count * t.size();
+        // on this rank's stream, finished before the barrier (a plain DtoD copy does not wait for completion)
+        for (p.dst) |dst| d.check(d.api.cuMemcpyDtoDAsync_v2(dst + r.rank * bytes, send, bytes, stream), "pair copy") catch return error.BackendFailed;
+        d.check(d.api.cuStreamSynchronize(stream), "pair sync") catch return error.BackendFailed;
+        try p.barrier();
+    }
+    fn allReduce(_: *anyopaque, _: K.DevicePtr, _: K.DevicePtr, _: usize, _: tp.DType, _: tp.Op, _: K.Stream) K.Error!void {
+        return error.Unsupported;
+    }
+    fn exchange(_: *anyopaque, _: K.DevicePtr, _: K.DevicePtr, _: usize, _: tp.DType, _: u32, _: K.Stream) K.Error!void {
+        return error.Unsupported;
+    }
+    fn sendFn(_: *anyopaque, _: K.DevicePtr, _: usize, _: tp.DType, _: u32, _: K.Stream) K.Error!void {
+        return error.Unsupported;
+    }
+    fn recvFn(_: *anyopaque, _: K.DevicePtr, _: usize, _: tp.DType, _: u32, _: K.Stream) K.Error!void {
+        return error.Unsupported;
+    }
+    fn barrierFn(ptr: *anyopaque) K.Error!void {
+        return of(ptr).pair.barrier();
+    }
+    fn check(ptr: *anyopaque) K.Error!void {
+        if (of(ptr).pair.aborted.load(.acquire)) return error.Aborted;
+    }
+    fn abortFn(ptr: *anyopaque) void {
+        of(ptr).pair.abort();
+    }
+};
diff --git a/zig/src/families/muse_spark/prompt.zig b/zig/src/families/muse_spark/prompt.zig
new file mode 100644
index 00000000..334596f1
--- /dev/null
+++ b/zig/src/families/muse_spark/prompt.zig
@@ -0,0 +1,307 @@
+//! Muse Spark's prompt path: a slot's prompt chunk as wide windows, with the decode rows' bits.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const load_ = @import("load.zig");
+const fwd = @import("forward.zig");
+const exl3 = @import("exl3.zig");
+const Stream = cuda.Stream;
+const Model = fwd.Model;
+
+pub const CAP = 1024; // rows a chunk
+pub const EWIN = 512; // rows an experts window: each expert's trellis read once a window instead of once per 128 rows
+pub const MIN = 33; // the shortest prompt (from the pass's start) on this path; shorter ones run as decode windows
+const W = fwd.DECODE_ROWS; // the dense and attention windows
+
+fn u(x: usize) u32 {
+    return @intCast(x);
+}
+fn ci(x: usize) c_int {
+    return @intCast(x);
+}
+
+/// Bytes of the experts window's scratch: (xg + xu + xd, with y over them; z, also the gathers' landing).
+pub fn expertBytes(e: exl3.Experts, ewin: usize, slots: usize, world: usize, chunk_d: usize) ![2]usize {
+    const sz = try exl3.sizes(e, ewin, slots);
+    const front = @max(2 * sz.xg + sz.xd, sz.y);
+    const land = world * @max(ewin * slots * e.dims, chunk_d) * 4;
+    return .{ front, @max(sz.z, if (world > 1) land else 0) };
+}
+
+pub const Prompt = struct {
+    m: *Model,
+    gpa: std.mem.Allocator,
+    cap: usize,
+    ewin: usize,
+    ar: load_.Arena,
+    ids: u64, // i64 [cap]
+    pos: u64, // i32 [cap]
+    slot: u64,
+    res: u64, // f32 [cap, D]
+    x: u64, // f16 [cap, D]
+    xf: u64, // f32 [cap, D]
+    part: u64, // f32 [cap, D]
+    big: u64, // f32: the experts' split partials (z), else an all-gather's landing (never live together)
+    logits: u64, // f32 [cap, E]
+    pick: u64, // i32 [cap, K]
+    wts: u64, // f32 [cap, K]
+    lat: u64, // f16 [cap, latent / world]
+    latg: u64, // f16 [world, cap, latent / world]
+    latn: u64, // f16 [cap, latent]
+    acc: u64, // f16 [cap, post inputs]
+    sc: exl3.Scratch, // the grouped kernel's for ewin rows; y over xg / xu / xd, z = big
+    taps: u64, // drafter: the chunk's taps, f16 [cap, taps, D]
+    erow: u64, // bf16 [cap, D] embedding rows, read through iota (i64 [cap])
+    iota: u64,
+    h_erow: []u16,
+    h_ids: []i64,
+    h_pos: []i32,
+    h_slot: []i32,
+
+    /// Chunks of up to `cap` rows, experts in windows of up to `ewin_` rows.
+    pub fn init(m: *Model, gpa: std.mem.Allocator, cap: usize, ewin_: usize, s: Stream) !*Prompt {
+        const w = m.w;
+        const cfg = w.cfg;
+        if (cap < 1 or ewin_ < 1) return error.PromptRows;
+        const ewin = @min(ewin_, cap);
+        if (ewin * cfg.top_k * 4 > 96 * 1024) return error.ExpertWindow; // the group kernel's picks in shared memory
+        const pr = try gpa.create(Prompt);
+        errdefer gpa.destroy(pr);
+        pr.* = undefined;
+        pr.m = m;
+        pr.gpa = gpa;
+        pr.cap = cap;
+        pr.ewin = ewin;
+        pr.ar = .{ .d = m.d, .gpa = gpa };
+        errdefer pr.ar.deinit();
+        const ar = &pr.ar;
+        const R = cap;
+        const D = cfg.hidden;
+        const L0 = w.layers[0];
+        const e0 = L0.experts;
+        pr.ids = try ar.zeros(R * 8);
+        pr.pos = try ar.zeros(R * 4);
+        pr.slot = try ar.zeros(R * 4);
+        pr.res = try ar.zeros(R * D * 4);
+        pr.x = try ar.zeros(R * D * 2);
+        pr.xf = try ar.zeros(R * D * 4);
+        pr.part = try ar.zeros(R * D * 4);
+        pr.logits = try ar.zeros(R * cfg.experts * 4);
+        pr.pick = try ar.zeros(R * cfg.top_k * 4);
+        pr.wts = try ar.zeros(R * cfg.top_k * 4);
+        pr.lat = try ar.zeros(R * L0.pre.n * 2);
+        pr.latg = try ar.zeros(R * cfg.latent * 2);
+        pr.latn = try ar.zeros(R * cfg.latent * 2);
+        pr.acc = try ar.zeros(R * L0.post.k * 2);
+        const eb = try expertBytes(e0, ewin, cfg.top_k, w.world, R * D);
+        const sz = try exl3.sizes(e0, ewin, cfg.top_k);
+        const front = try ar.zeros(eb[0]);
+        pr.big = try ar.zeros(eb[1]);
+        pr.sc = .{ .xg = front, .xu = front + sz.xg, .xd = front + 2 * sz.xg, .z = pr.big, .y = front, .ids = try ar.zeros(sz.ids), .count = try ar.zeros(4), .members = try ar.alloc(sz.members), .rows = ewin, .slots = cfg.top_k };
+        try m.d.check(m.d.api.cuMemsetD32_v2(pr.sc.members, 0xFFFF_FFFF, sz.members / 4), "members -1");
+        pr.taps = if (m.dr) |dr| try ar.zeros(R * dr.taps.len * D * 2) else 0;
+        pr.erow = try ar.zeros(R * D * 2);
+        {
+            const io_ = try gpa.alloc(i64, R);
+            defer gpa.free(io_);
+            for (io_, 0..) |*x, j| x.* = @intCast(j);
+            pr.iota = try ar.upload(std.mem.sliceAsBytes(io_));
+        }
+        pr.h_erow = try gpa.alloc(u16, R * D);
+        errdefer gpa.free(pr.h_erow);
+        pr.h_ids = try gpa.alloc(i64, R);
+        errdefer gpa.free(pr.h_ids);
+        pr.h_pos = try gpa.alloc(i32, R);
+        errdefer gpa.free(pr.h_pos);
+        pr.h_slot = try gpa.alloc(i32, R);
+        try s.synchronize();
+        return pr;
+    }
+
+    pub fn deinit(pr: *Prompt) void {
+        pr.gpa.free(pr.h_erow);
+        pr.gpa.free(pr.h_ids);
+        pr.gpa.free(pr.h_pos);
+        pr.gpa.free(pr.h_slot);
+        pr.ar.deinit();
+        pr.gpa.destroy(pr);
+    }
+
+    pub fn bytes(pr: *const Prompt) usize {
+        return pr.ar.total;
+    }
+
+    /// The ranks' fp32 partials [count] gathered into big (rank-major); (rank 0's, rank 1's or 0).
+    fn gather(pr: *Prompt, s: Stream, part: u64, count: usize) ![2]u64 {
+        const c = pr.m.comm orelse return .{ part, 0 };
+        try c.allGather(part, pr.big, count, .f32, s.handle);
+        return .{ pr.big, pr.big + count * 4 };
+    }
+
+    /// An EXL3 projection of the chunk's n rows in 128-row windows: x [n, K] fp16 -> out [n, N].
+    fn proj(pr: *Prompt, s: Stream, l: exl3.Linear, x: u64, out: u64, out_f32: bool, n: usize) !void {
+        var w0: usize = 0;
+        while (w0 < n) : (w0 += W) {
+            const k = @min(W, n - w0);
+            try pr.m.proj(s, l, x + w0 * l.k * 2, out + w0 * l.n * @as(usize, if (out_f32) 4 else 2), out_f32, k);
+        }
+    }
+
+    /// Layer i's attention half over the chunk at [p0, p0 + n): 128-row windows of q / k / v / g and o_proj.
+    fn attention(pr: *Prompt, s: Stream, L: load_.Layer, i: usize, p0: usize, n: usize) !void {
+        const m = pr.m;
+        const D = m.w.cfg.hidden;
+        var w0: usize = 0;
+        while (w0 < n) : (w0 += W) {
+            const k = @min(W, n - w0);
+            const x = pr.x + w0 * D * 2;
+            try m.qkvg(s, L, x, m.b.q, m.b.k, m.b.v, m.b.g, k);
+            var chunks: usize = 1;
+            for (0..k) |j| chunks = @max(chunks, fwd.rowChunks(m.context, p0 + w0 + j));
+            try m.attentionIo(s, i, k, chunks, .{ .q = m.b.q, .k = m.b.k, .v = m.b.v, .g = m.b.g, .qo = m.b.qo, .att = m.b.att, .pos = pr.pos + w0 * 4, .slot = pr.slot + w0 * 4 });
+            try m.proj(s, L.o, m.b.att, pr.part + w0 * D * 4, true, k);
+        }
+    }
+
+    /// MuseSparkMoE over the chunk: router and latent for every row, experts in windows of ewin rows, then post.
+    fn moe(pr: *Prompt, s: Stream, L: load_.Layer, n: usize) !void {
+        const m = pr.m;
+        const cfg = m.w.cfg;
+        const E = cfg.experts;
+        const K = cfg.top_k;
+        {
+            var a: cuda.Args = .{};
+            a.add(pr.xf);
+            a.add(L.router);
+            a.add(@as(c_int, @intFromBool(L.router_bf16)));
+            a.add(pr.logits);
+            a.add(ci(cfg.hidden));
+            a.add(ci(E));
+            const rw: usize = 2;
+            try cuda.launch.launch(m.f_router, .{ .grid = .{ .x = u((E + rw - 1) / rw), .y = u(n), .z = 1 }, .block = .{ .x = u(32 * rw), .y = 1, .z = 1 } }, s, &a);
+        }
+        {
+            var a: cuda.Args = .{};
+            a.add(pr.logits);
+            a.add(L.bias);
+            a.add(ci(E));
+            a.add(ci(K));
+            a.add(@as(f32, @floatCast(cfg.out_mult)));
+            a.add(@as(f32, @floatCast(cfg.route_scale)));
+            a.add(pr.pick);
+            a.add(pr.wts);
+            const tn = std.math.ceilPowerOfTwo(usize, @max(E, 32)) catch unreachable;
+            try cuda.launch.launch(m.f_topk, .{ .grid = .{ .x = u(n), .y = 1, .z = 1 }, .block = .{ .x = u(tn), .y = 1, .z = 1 } }, s, &a);
+        }
+        try pr.proj(s, L.pre, pr.x, pr.lat, false, n);
+        if (m.comm) |c| {
+            const half = L.pre.n;
+            try c.allGather(pr.lat, pr.latg, n * half, .f16, s.handle);
+            try m.normParts(s, pr.latg, true, L.pre_norm, pr.latn, n, cfg.latent, cfg.eps, half);
+        } else try m.norm(s, pr.lat, true, L.pre_norm, pr.latn, n, cfg.latent, cfg.eps);
+        const e = L.experts;
+        const sc = pr.sc;
+        var w0: usize = 0;
+        while (w0 < n) : (w0 += pr.ewin) {
+            const r = @min(pr.ewin, n - w0);
+            const p = r * K;
+            const pick = pr.pick + w0 * K * 4;
+            try m.k3.routedWide(s, e, pr.latn + w0 * cfg.latent * 2, cfg.latent, pick, r, sc); // y over xg / xu / xd
+            const y = try pr.gather(s, sc.y, p * e.dims); // z is dead too: the landing reuses it
+            var a: cuda.Args = .{};
+            a.add(y[0]);
+            a.add(y[1]);
+            a.add(pr.wts + w0 * K * 4);
+            a.add(L.expert_norm);
+            a.add(@as(f32, @floatCast(cfg.post_eps)));
+            a.add(pr.acc + w0 * L.post.k * 2);
+            a.add(ci(cfg.latent));
+            a.add(ci(K));
+            a.add(ci(m.w.rank * L.post.k));
+            a.add(ci(L.post.k));
+            try m.rowLaunch(m.f_esum, m.f_esum_c, cfg.latent, r, s, &a);
+        }
+        try pr.proj(s, L.post, pr.acc, pr.part, true, n);
+    }
+
+    /// A prompt chunk at [p0, p0 + n) of `slot`: every cache written, the last row's logits in the decode buffers.
+    pub fn chunk(pr: *Prompt, s: Stream, slot: u32, p0: usize, tokens: []const i64) !void {
+        const m = pr.m;
+        const cfg = m.w.cfg;
+        const D = cfg.hidden;
+        const n = tokens.len;
+        if (n == 0 or n > pr.cap) return error.ChunkTooWide;
+        if (p0 + n > m.context) return error.PastContext;
+        if (slot >= m.slots) return error.BadSlot;
+        for (tokens, 0..) |t, j| {
+            if (t < 0 or t >= m.w.full.vocab) return error.BadToken;
+            pr.h_ids[j] = t;
+            pr.h_pos[j] = @intCast(p0 + j);
+            pr.h_slot[j] = @intCast(slot);
+        }
+        try m.d.check(m.d.api.cuMemcpyHtoD_v2(pr.ids, @ptrCast(pr.h_ids.ptr), n * 8), "ids");
+        try m.d.check(m.d.api.cuMemcpyHtoD_v2(pr.pos, @ptrCast(pr.h_pos.ptr), n * 4), "pos");
+        try m.d.check(m.d.api.cuMemcpyHtoD_v2(pr.slot, @ptrCast(pr.h_slot.ptr), n * 4), "slot");
+        try m.embedRows(pr.h_ids[0..n], pr.h_erow, pr.erow);
+        {
+            var a: cuda.Args = .{};
+            const es = m.embedSrc(pr.erow, pr.iota);
+            a.add(es[0]);
+            a.add(es[1]);
+            a.add(pr.res);
+            a.add(ci(D));
+            a.add(@as(f32, @floatCast(cfg.eps)));
+            try cuda.launch.launch(m.f_embed, .{ .grid = .{ .x = u(n), .y = 1, .z = 1 }, .block = .{ .x = fwd.NORM_THREADS, .y = 1, .z = 1 } }, s, &a);
+        }
+        try m.norm(s, pr.res, false, m.w.layers[0].in_norm, pr.x, n, D, cfg.eps);
+        for (m.w.layers, 0..) |L, i| {
+            try pr.attention(s, L, i, p0, n);
+            try m.gateNormAt(s, pr.res, try pr.gather(s, pr.part, n * D), 0, L.attn_ab, L.ffn_norm, pr.x, pr.xf, n);
+            try pr.moe(s, L, n);
+            const after = if (i + 1 < m.w.layers.len) m.w.layers[i + 1].in_norm else m.w.norm;
+            try m.gateNormAt(s, pr.res, try pr.gather(s, pr.part, n * D), L.post_ffn, L.mlp_ab, after, pr.x, 0, n);
+            if (m.dr) |dr| try dr.tapInto(s, i, pr.res, n, pr.taps);
+        }
+        if (m.dr) |dr| {
+            const row = dr.taps.len * D * 2;
+            var w0: usize = 0;
+            while (w0 < n) : (w0 += W) {
+                const k = @min(W, n - w0);
+                try dr.updateAt(s, pr.taps + w0 * row, pr.pos + w0 * 4, pr.slot + w0 * 4, k);
+            }
+        }
+        // the head on the last row: the decode GEMV, softcap and gather into the decode buffers
+        try m.proj(s, m.w.head, pr.x + (n - 1) * D * 2, m.b.head, true, 1);
+        const cfgf = m.w.full;
+        var a: cuda.Args = .{};
+        a.add(m.b.head);
+        a.add(@as(i64, @intCast(m.w.head.n)));
+        a.add(@as(f32, @floatCast(cfgf.out_mult)));
+        a.add(@as(f32, @floatCast(cfgf.softcap)));
+        try cuda.launch.launch(m.f_softcap, .{ .grid = .{ .x = u(@min((m.w.head.n + 255) / 256, 4096)), .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+        if (m.comm) |c| try c.allGather(m.b.head, m.b.recv, m.w.head_stride, .f32, s.handle);
+    }
+};
+
+/// The chunks of a prompt of `len` tokens: `cap` rows each, the rest last.
+pub fn planChunks(len: usize, cap: usize, out: *std.ArrayList(usize), gpa: std.mem.Allocator) !void {
+    out.clearRetainingCapacity();
+    var at: usize = 0;
+    while (at < len) {
+        const n = @min(cap, len - at);
+        try out.append(gpa, n);
+        at += n;
+    }
+}
+
+test "prompt chunks" {
+    const g = std.testing.allocator;
+    var c: std.ArrayList(usize) = .empty;
+    defer c.deinit(g);
+    try planChunks(40, 1024, &c, g);
+    try std.testing.expectEqualSlices(usize, &.{40}, c.items);
+    try planChunks(2500, 1024, &c, g);
+    try std.testing.expectEqualSlices(usize, &.{ 1024, 1024, 452 }, c.items);
+    try planChunks(2048, 1024, &c, g);
+    try std.testing.expectEqualSlices(usize, &.{ 1024, 1024 }, c.items);
+}
diff --git a/zig/src/families/muse_spark/prompt_main.zig b/zig/src/families/muse_spark/prompt_main.zig
new file mode 100644
index 00000000..36b0c5f6
--- /dev/null
+++ b/zig/src/families/muse_spark/prompt_main.zig
@@ -0,0 +1,120 @@
+//! tf-muse prompt: the prompt path's chunk plans against decode rows, byte for byte (docs/recipes/muse-spark.md).
+
+const std = @import("std");
+const cuda = @import("cuda");
+const tp = @import("tp");
+const muse = @import("muse_spark");
+const Model = muse.forward.Model;
+const Row = muse.forward.Row;
+
+fn env(name: [*:0]const u8, default: usize) usize {
+    const v = std.c.getenv(name) orelse return default;
+    return std.fmt.parseInt(usize, std.mem.span(v), 10) catch default;
+}
+
+fn argmax(xs: []const f32) i32 {
+    var best: usize = 0;
+    for (xs, 0..) |x, i| if (x > xs[best]) {
+        best = i;
+    };
+    return @intCast(best);
+}
+
+/// Greedy decode rows on `slot` from position `pos` after the token `first`: n tokens into out.
+fn greedy(model: *Model, s: cuda.Stream, slot: u32, pos0: usize, first: i32, out: []i32, buf_all: []f32) !void {
+    const buf = buf_all[0..model.w.full.vocab];
+    var tok = first;
+    for (out, 0..) |*o, j| {
+        o.* = tok;
+        if (j + 1 == out.len) break;
+        try model.forward(s, &.{.{ .slot = slot, .pos = @intCast(pos0 + j), .token = tok }}, buf, null);
+        tok = argmax(buf);
+    }
+}
+
+pub fn run(gpa: std.mem.Allocator, ar: std.mem.Allocator, io: std.Io, driver: *const cuda.Driver, args: []const [:0]const u8, rank: usize, world: usize, comm: ?tp.Collective) !void {
+    var s = try cuda.Stream.init(driver, false);
+    defer s.deinit();
+    const context = env("MUSE_CONTEXT", 8192);
+    const G = env("MUSE_GREEDY", 32);
+    const max_layers: ?usize = if (env("MUSE_LAYERS", 0) > 0) env("MUSE_LAYERS", 0) else null;
+    var w = try muse.load.load(gpa, io, driver, args[2], rank, world, .{ .max_layers = max_layers, .log = rank == 0 });
+    defer w.deinit();
+    var k3 = try muse.exl3.Kernels.load(driver);
+    defer k3.deinit();
+    var model = try Model.init(gpa, driver, &w, &k3, comm, context, muse.forward.DECODE_ROWS, 2, s);
+    defer model.deinit();
+    const pr = try muse.prompt.Prompt.init(&model, gpa, muse.prompt.CAP, muse.prompt.EWIN, s);
+    defer pr.deinit();
+    const V = w.full.vocab;
+    if (rank == 0) std.debug.print("[prompt] {d} layers, chunks of {d} rows, experts window {d}, scratch {d:.2} GiB\n", .{ w.layers.len, pr.cap, pr.ewin, @as(f64, @floatFromInt(pr.bytes())) / (1 << 30) });
+    const plans_text = if (std.c.getenv("MUSE_PROMPT_PLANS")) |v| std.mem.span(v) else "r;100,r;1,r;17,256,1000,r;513,700,r";
+    const names_text = try std.Io.Dir.cwd().readFileAlloc(io, try std.fs.path.join(ar, &.{ args[3], "names.txt" }), ar, .limited(1 << 20));
+    const buf = try gpa.alloc(f32, muse.forward.DECODE_ROWS * V);
+    defer gpa.free(buf);
+    const ref_logits = try gpa.alloc(f32, V);
+    defer gpa.free(ref_logits);
+    const got = try gpa.alloc(f32, V);
+    defer gpa.free(got);
+    const ref_g = try gpa.alloc(i32, G);
+    defer gpa.free(ref_g);
+    const got_g = try gpa.alloc(i32, G);
+    defer gpa.free(got_g);
+    var fails: usize = 0;
+    var nit = std.mem.tokenizeAny(u8, names_text, " \r\n\t");
+    while (nit.next()) |name| {
+        const raw = try std.Io.Dir.cwd().readFileAlloc(io, try std.fmt.allocPrint(ar, "{s}/{s}.ids", .{ args[3], name }), ar, .limited(1 << 30));
+        const T = raw.len / 4;
+        if (T + G > context) return error.TextTooLong;
+        const ids = try ar.alloc(i64, T);
+        for (ids, 0..) |*x, j| x.* = std.mem.readInt(i32, raw[j * 4 ..][0..4], .little);
+        // the reference: decode windows of 128 rows on slot 0
+        var at: usize = 0;
+        var rows: [muse.forward.DECODE_ROWS]Row = undefined;
+        while (at < T) {
+            const n = @min(muse.forward.DECODE_ROWS, T - at);
+            for (0..n) |j| rows[j] = .{ .slot = 0, .pos = @intCast(at + j), .token = ids[at + j] };
+            try model.forward(s, rows[0..n], buf[0 .. n * V], null);
+            if (at + n == T) @memcpy(ref_logits, buf[(n - 1) * V ..][0..V]);
+            at += n;
+        }
+        try greedy(&model, s, 0, T, argmax(ref_logits), ref_g, buf);
+        var pit = std.mem.tokenizeScalar(u8, plans_text, ';');
+        while (pit.next()) |plan| {
+            var sizes: std.ArrayList(usize) = .empty;
+            defer sizes.deinit(gpa);
+            var cit = std.mem.tokenizeScalar(u8, plan, ',');
+            var used: usize = 0;
+            while (cit.next()) |c| {
+                const n = if (std.mem.eql(u8, c, "r")) T - used else try std.fmt.parseInt(usize, c, 10);
+                if (n == 0 or used + n > T) break;
+                var left = n;
+                while (left > 0) { // a size over the chunk cap splits into cap-row chunks
+                    const k = @min(left, pr.cap);
+                    try sizes.append(gpa, k);
+                    left -= k;
+                }
+                used += n;
+            }
+            if (used != T) continue; // a plan longer than the text
+            at = 0;
+            for (sizes.items) |n| {
+                try pr.chunk(s, 1, at, ids[at .. at + n]);
+                at += n;
+            }
+            try model.logitsTo(s, 1, got);
+            var maxd: f32 = 0;
+            var equal = true;
+            for (ref_logits, got) |a, b| {
+                if (@as(u32, @bitCast(a)) != @as(u32, @bitCast(b))) equal = false;
+                maxd = @max(maxd, @abs(a - b));
+            }
+            try greedy(&model, s, 1, T, argmax(got), got_g, buf);
+            var same: usize = 0;
+            for (ref_g, got_g) |a, b| same += @intFromBool(a == b);
+            if (!equal or same != G) fails += 1;
+            if (rank == 0) std.debug.print("PROMPT {s} T={d} chunks {any}: logits {s} (max |diff| {e:.3}), argmax {d}/{d}, greedy {d}/{d}\n", .{ name, T, sizes.items, if (equal) "byte-equal" else "DIFFER", maxd, argmax(got), argmax(ref_logits), same, G });
+        }
+    }
+    if (rank == 0) std.debug.print("PROMPT {s}: {d} plan(s) differ from decode rows\n", .{ if (fails == 0) "PASS" else "FAIL", fails });
+}
