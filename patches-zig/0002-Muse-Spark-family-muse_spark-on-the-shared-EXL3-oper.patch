diff --git a/zig/src/families/muse_spark/config.zig b/zig/src/families/muse_spark/config.zig
new file mode 100644
index 00000000..7d843ab4
--- /dev/null
+++ b/zig/src/families/muse_spark/config.zig
@@ -0,0 +1,300 @@
+//! Muse Spark Open's checkpoint facts (text model) and a rank's EXL3 cuts, as exllamav3's muse_spark reads them.
+
+const std = @import("std");
+
+pub const model_type = "muse_spark";
+pub const text_type = "muse_spark_text";
+pub const max_layers = 64;
+/// The tensors' prefix in the pack: the text model of the multimodal checkpoint.
+pub const prefix = "model.language_model.";
+
+pub const Config = struct {
+    layers: usize,
+    hidden: usize, // 8192
+    heads: usize, // query heads; a rank's under TP
+    kv_heads: usize,
+    head_dim: usize, // 64
+    window: usize, // past keys a sliding row sees: sliding_window - 1 (the reference mask counts the row itself)
+    full: [max_layers]bool = @splat(false), // full attention, else sliding
+    theta: [max_layers]f64 = @splat(0), // RoPE theta of the layer, 0 = NoPE
+    latent: usize, // moe_hidden_size: the experts' model width (4096)
+    width: usize, // moe_intermediate_size: an expert's width; a rank's under TP
+    experts: usize,
+    top_k: usize,
+    vocab: usize, // real tokens; the head's rows are padded to a multiple of 128
+    eps: f64, // rms_norm_eps: input, pre-ffn, pre-expert, qk, o and final norms
+    post_eps: f64, // post_norm_eps: post-attention, post-ffn and post-expert norms
+    qk_scale: f64, // qk_scale_factor: folds into the softmax scale
+    out_mult: f64, // output_multiplier: router logits and head pre-scale
+    softcap: f64, // final_logit_softcapping, 0 = none
+    gate_temp: f64, // residual_gate_temperature
+    route_scale: f64, // routed_scaling_factor
+    eos: [4]u32 = @splat(0),
+    eos_len: usize = 0,
+
+    pub fn isEos(c: Config, t: u32) bool {
+        return std.mem.indexOfScalar(u32, c.eos[0..c.eos_len], t) != null;
+    }
+    pub fn rope(c: Config, i: usize) bool {
+        return c.theta[i] != 0;
+    }
+    /// The softmax scale: qk_scale_factor * head_dim ** -0.5 (exllamav3's sm_scale), as a Python float.
+    pub fn smScale(c: Config) f64 {
+        return c.qk_scale * std.math.pow(f64, @floatFromInt(c.head_dim), -0.5);
+    }
+
+    /// config.json (+ generation_config.json's EOS ids); refuses every variant the forward does not wire.
+    pub fn parse(gpa: std.mem.Allocator, config_json: []const u8, generation_json: ?[]const u8) !Config {
+        const parsed = try std.json.parseFromSlice(std.json.Value, gpa, config_json, .{});
+        defer parsed.deinit();
+        const top = parsed.value.object;
+        if (!std.mem.eql(u8, str(top, "model_type") orelse "", model_type)) return error.NotMuseSpark;
+        const q = if (top.get("quantization_config")) |v| v.object else return error.NotExl3;
+        if (!std.mem.eql(u8, str(q, "quant_method") orelse "", "exl3")) return error.NotExl3;
+        if (!std.mem.eql(u8, str(q, "codebook") orelse "mul1", "mul1")) return error.NotMul1;
+        const o = (top.get("text_config") orelse return error.MissingField).object;
+        if (!std.mem.eql(u8, str(o, "model_type") orelse text_type, text_type)) return error.NotMuseSpark;
+        if (boolean(o, "attention_bias") or boolean(o, "tie_word_embeddings")) return error.Unsupported;
+        if (!std.mem.eql(u8, str(o, "hidden_act") orelse "silu", "silu")) return error.UnsupportedActivation;
+        if ((int(o, "num_shared_experts") orelse 0) != 0) return error.UnsupportedRouting;
+        if (o.get("rope_parameters")) |rp| if (rp == .object) {
+            if (!std.mem.eql(u8, str(rp.object, "rope_type") orelse "default", "default")) return error.UnsupportedRope;
+        };
+        var c: Config = .{
+            .layers = try need(o, "num_hidden_layers"),
+            .hidden = try need(o, "hidden_size"),
+            .heads = try need(o, "num_attention_heads"),
+            .kv_heads = try need(o, "num_key_value_heads"),
+            .head_dim = try need(o, "head_dim"),
+            .window = (try need(o, "sliding_window")) - 1,
+            .latent = try need(o, "moe_hidden_size"),
+            .width = try need(o, "moe_intermediate_size"),
+            .experts = try need(o, "num_local_experts"),
+            .top_k = try need(o, "num_experts_per_tok"),
+            .vocab = try need(o, "vocab_size"),
+            .eps = try numNeed(o, "rms_norm_eps"),
+            .post_eps = if (o.get("post_norm_eps")) |v| num(v) else try numNeed(o, "rms_norm_eps"),
+            .qk_scale = if (o.get("qk_scale_factor")) |v| num(v) else 1.0,
+            .out_mult = if (o.get("output_multiplier")) |v| num(v) else 1.0,
+            .softcap = if (o.get("final_logit_softcapping")) |v| num(v) else 0.0,
+            .gate_temp = try numNeed(o, "residual_gate_temperature"),
+            .route_scale = if (o.get("routed_scaling_factor")) |v| num(v) else 1.0,
+        };
+        if (c.layers > max_layers) return error.TooManyLayers;
+        if (c.head_dim != 64) return error.HeadDim; // the attention kernels: a lane holds dims l and l + 32
+        if (c.heads % c.kv_heads != 0 or c.heads / c.kv_heads != 8) return error.GroupSize; // a warp a query head of the group
+        if (c.top_k > 32 or c.experts > 1024) return error.UnsupportedRouting;
+        const types = (o.get("layer_types") orelse return error.MissingField).array.items;
+        if (types.len != c.layers) return error.LayerPattern;
+        if (o.get("mlp_layer_types")) |m| for (m.array.items) |t| {
+            if (!std.mem.eql(u8, t.string, "sparse")) return error.DenseMlp;
+        };
+        var default_theta: f64 = 500000.0;
+        if (o.get("rope_parameters")) |rp| if (rp == .object) if (rp.object.get("rope_theta")) |v| {
+            default_theta = num(v);
+        };
+        const thetas: ?[]std.json.Value = if (o.get("layer_rope_theta")) |v| v.array.items else null;
+        if (thetas != null and thetas.?.len != c.layers) return error.LayerPattern;
+        for (types, 0..) |t, i| {
+            if (std.mem.eql(u8, t.string, "full_attention")) {
+                c.full[i] = true;
+            } else if (!std.mem.eql(u8, t.string, "sliding_attention")) return error.LayerPattern;
+            c.theta[i] = if (thetas) |th| num(th[i]) else default_theta;
+        }
+        if (o.get("eos_token_id")) |v| c.addEos(v);
+        if (generation_json) |g| {
+            const gp = try std.json.parseFromSlice(std.json.Value, gpa, g, .{});
+            defer gp.deinit();
+            if (gp.value.object.get("eos_token_id")) |v| c.addEos(v);
+        }
+        return c;
+    }
+
+    fn addEos(c: *Config, v: std.json.Value) void {
+        switch (v) {
+            .integer => |i| c.pushEos(@intCast(i)),
+            .array => |a| for (a.items) |x| if (x == .integer) c.pushEos(@intCast(x.integer)),
+            else => {},
+        }
+    }
+    fn pushEos(c: *Config, t: u32) void {
+        if (c.isEos(t) or c.eos_len == c.eos.len) return;
+        c.eos[c.eos_len] = t;
+        c.eos_len += 1;
+    }
+
+    /// A rank's view under TP: heads, KV heads and the expert width split; the latent stays whole.
+    pub fn rankView(c: Config, world: usize) !Config {
+        if (world != 1 and world != 2) return error.World;
+        if (c.heads % world != 0 or c.kv_heads % world != 0) return error.HeadsSplit;
+        if (c.width % (128 * world) != 0 or c.latent % (128 * world) != 0) return error.WidthSplit;
+        if ((c.heads / world) * c.head_dim % 128 != 0 or (c.kv_heads / world) * c.head_dim % 128 != 0) return error.HeadsSplit;
+        var r = c;
+        r.heads = c.heads / world;
+        r.kv_heads = c.kv_heads / world;
+        r.width = c.width / world;
+        return r;
+    }
+};
+
+/// One EXL3 matrix a rank loads: its tensors' prefix and the cut: outputs (`n`) or inputs (`k`).
+pub const Cut = struct {
+    prefix: []const u8,
+    axis: enum { whole, n, k } = .whole,
+    lo: usize = 0,
+    hi: usize = 0,
+};
+
+/// The layer's matrices in load order: q, k, v, gate, o, pre_expert, post_expert, then (gate, up, down) per expert.
+pub const attn_mats = 5;
+pub const latent_mats = 2;
+
+/// Every EXL3 matrix of layer `i` a rank loads, by heads, latent halves and expert width; `buf` holds the prefixes.
+pub fn layerCuts(full: Config, i: usize, rank: usize, world: usize, buf: *std.ArrayList(u8), gpa: std.mem.Allocator, out: *std.ArrayList(Cut)) !void {
+    const hq = full.heads / world * full.head_dim;
+    const hk = full.kv_heads / world * full.head_dim;
+    const lat = full.latent / world;
+    const wid = full.width / world;
+    const r = rank;
+    const one = struct {
+        fn f(g: std.mem.Allocator, b: *std.ArrayList(u8), o: *std.ArrayList(Cut), comptime fmt: []const u8, args: anytype, axis: @FieldType(Cut, "axis"), lo: usize, hi: usize, w: usize) !void {
+            const start = b.items.len;
+            try b.print(g, prefix ++ fmt, args);
+            try o.append(g, .{ .prefix = b.items[start..], .axis = if (w == 1) .whole else axis, .lo = lo, .hi = hi });
+        }
+    }.f;
+    try one(gpa, buf, out, "layers.{d}.self_attn.q_proj", .{i}, .n, r * hq, (r + 1) * hq, world);
+    try one(gpa, buf, out, "layers.{d}.self_attn.k_proj", .{i}, .n, r * hk, (r + 1) * hk, world);
+    try one(gpa, buf, out, "layers.{d}.self_attn.v_proj", .{i}, .n, r * hk, (r + 1) * hk, world);
+    try one(gpa, buf, out, "layers.{d}.self_attn.gate_proj", .{i}, .n, r * hq, (r + 1) * hq, world);
+    try one(gpa, buf, out, "layers.{d}.self_attn.o_proj", .{i}, .k, r * hq, (r + 1) * hq, world);
+    try one(gpa, buf, out, "layers.{d}.mlp.pre_expert_proj", .{i}, .n, r * lat, (r + 1) * lat, world);
+    try one(gpa, buf, out, "layers.{d}.mlp.post_expert_proj", .{i}, .k, r * lat, (r + 1) * lat, world);
+    for (0..full.experts) |e| {
+        try one(gpa, buf, out, "layers.{d}.mlp.experts.{d}.gate_proj", .{ i, e }, .n, r * wid, (r + 1) * wid, world);
+        try one(gpa, buf, out, "layers.{d}.mlp.experts.{d}.up_proj", .{ i, e }, .n, r * wid, (r + 1) * wid, world);
+        try one(gpa, buf, out, "layers.{d}.mlp.experts.{d}.down_proj", .{ i, e }, .k, r * wid, (r + 1) * wid, world);
+    }
+}
+
+/// lm_head's rows of a rank in 128-row blocks of the padded head (1579 blocks: 790 + 789 at TP=2).
+pub fn headCut(n: usize, rank: usize, world: usize) Cut {
+    if (world == 1) return .{ .prefix = "lm_head", .lo = 0, .hi = n };
+    const blocks = n / 128;
+    const first = (blocks + 1) / 2;
+    const lo = if (rank == 0) 0 else first * 128;
+    const hi = if (rank == 0) first * 128 else n;
+    return .{ .prefix = "lm_head", .axis = .n, .lo = lo, .hi = hi };
+}
+
+/// Columns a rank's head slice occupies in the gather buffer: the widest rank's.
+pub fn headStride(n: usize, world: usize) usize {
+    return if (world == 1) n else ((n / 128 + 1) / 2) * 128;
+}
+
+fn str(o: std.json.ObjectMap, k: []const u8) ?[]const u8 {
+    const v = o.get(k) orelse return null;
+    return if (v == .string) v.string else null;
+}
+fn int(o: std.json.ObjectMap, k: []const u8) ?usize {
+    const v = o.get(k) orelse return null;
+    return switch (v) {
+        .integer => |i| @intCast(i),
+        else => null,
+    };
+}
+fn need(o: std.json.ObjectMap, k: []const u8) !usize {
+    return int(o, k) orelse error.MissingField;
+}
+fn num(v: std.json.Value) f64 {
+    return switch (v) {
+        .integer => |i| @floatFromInt(i),
+        .float => |f| f,
+        .number_string => |s| std.fmt.parseFloat(f64, s) catch 0,
+        else => 0,
+    };
+}
+fn numNeed(o: std.json.ObjectMap, k: []const u8) !f64 {
+    return num(o.get(k) orelse return error.MissingField);
+}
+fn boolean(o: std.json.ObjectMap, k: []const u8) bool {
+    const v = o.get(k) orelse return false;
+    return v == .bool and v.bool;
+}
+
+// The fields Config.parse reads, as the 2-layer dry-run pack's config.json has them (text_config of Muse Spark Open).
+const fixture =
+    \\{"model_type": "muse_spark", "quantization_config": {"quant_method": "exl3", "codebook": "mul1", "bits": 2.04},
+    \\ "text_config": {"attention_bias": false, "eos_token_id": 200001, "final_logit_softcapping": 20.0, "head_dim": 64,
+    \\ "hidden_act": "silu", "hidden_size": 8192, "intermediate_size": 16384, "layer_rope_theta": [500000.0, 0],
+    \\ "layer_types": ["sliding_attention", "full_attention"], "mlp_layer_types": ["sparse", "sparse"],
+    \\ "model_type": "muse_spark_text", "moe_hidden_size": 4096, "moe_intermediate_size": 4096,
+    \\ "num_attention_heads": 128, "num_experts_per_tok": 8, "num_hidden_layers": 2, "num_key_value_heads": 16,
+    \\ "num_local_experts": 256, "num_shared_experts": 0, "output_multiplier": 0.17677669529663687, "post_norm_eps": 1e-08,
+    \\ "qk_scale_factor": 5.4730064863875, "residual_gate_temperature": 0.3, "rms_norm_eps": 1e-05,
+    \\ "rope_parameters": {"rope_theta": 500000.0, "rope_type": "default"}, "routed_scaling_factor": 1.0,
+    \\ "sliding_window": 2048, "tie_word_embeddings": false, "vocab_size": 202048}}
+;
+
+test "Config.parse reads the 2-layer pack as exllamav3's MuseSparkConfig does" {
+    const c = try Config.parse(std.testing.allocator, fixture, "{\"eos_token_id\": [200001, 200007]}");
+    try std.testing.expectEqual(@as(usize, 2), c.layers);
+    try std.testing.expectEqual(@as(usize, 2047), c.window);
+    try std.testing.expect(!c.full[0] and c.full[1]);
+    try std.testing.expect(c.rope(0) and !c.rope(1));
+    try std.testing.expectEqual(@as(f64, 500000.0), c.theta[0]);
+    try std.testing.expectEqual(@as(f64, 1e-8), c.post_eps);
+    try std.testing.expectEqualSlices(u32, &.{ 200001, 200007 }, c.eos[0..c.eos_len]);
+    try std.testing.expectApproxEqRel(@as(f64, 5.4730064863875 / 8.0), c.smScale(), 1e-15);
+    const r = try c.rankView(2);
+    try std.testing.expectEqual(@as(usize, 64), r.heads);
+    try std.testing.expectEqual(@as(usize, 8), r.kv_heads);
+    try std.testing.expectEqual(@as(usize, 2048), r.width);
+    try std.testing.expectEqual(@as(usize, 4096), r.latent);
+}
+
+test "Config.parse refuses what the forward does not wire" {
+    const a = std.testing.allocator;
+    const bad = [_][2][]const u8{
+        .{ "\"num_shared_experts\": 0", "\"num_shared_experts\": 1" },
+        .{ "\"attention_bias\": false", "\"attention_bias\": true" },
+        .{ "\"mlp_layer_types\": [\"sparse\", \"sparse\"]", "\"mlp_layer_types\": [\"dense\", \"sparse\"]" },
+        .{ "\"head_dim\": 64", "\"head_dim\": 128" },
+        .{ "\"quant_method\": \"exl3\"", "\"quant_method\": \"fp8\"" },
+    };
+    for (bad) |b| {
+        const t = try std.mem.replaceOwned(u8, a, fixture, b[0], b[1]);
+        defer a.free(t);
+        try std.testing.expect(std.meta.isError(Config.parse(a, t, null)));
+    }
+}
+
+test "rank cuts" {
+    const a = std.testing.allocator;
+    const c = try Config.parse(a, fixture, null);
+    var buf: std.ArrayList(u8) = .empty;
+    defer buf.deinit(a);
+    try buf.ensureTotalCapacity(a, 1 << 20); // prefixes slice into it: no reallocation
+    var cuts: std.ArrayList(Cut) = .empty;
+    defer cuts.deinit(a);
+    try layerCuts(c, 1, 1, 2, &buf, a, &cuts);
+    try std.testing.expectEqual(@as(usize, attn_mats + latent_mats + 3 * 256), cuts.items.len);
+    try std.testing.expectEqualStrings("model.language_model.layers.1.self_attn.q_proj", cuts.items[0].prefix);
+    try std.testing.expectEqual(@as(usize, 64 * 64), cuts.items[0].lo); // q: heads 64..127
+    try std.testing.expectEqual(@as(usize, 8 * 64), cuts.items[1].lo); // k: KV heads 8..15
+    try std.testing.expectEqual(@as(usize, 16 * 64), cuts.items[1].hi);
+    try std.testing.expect(cuts.items[4].axis == .k); // o: input columns of its heads
+    try std.testing.expectEqual(@as(usize, 2048), cuts.items[5].lo); // pre_expert_proj: latent outputs 2048..4095
+    try std.testing.expect(cuts.items[6].axis == .k); // post_expert_proj: latent inputs
+    try std.testing.expectEqual(@as(usize, 2048), cuts.items[7].lo); // expert width 4096 / 2
+    try std.testing.expectEqualStrings("model.language_model.layers.1.mlp.experts.255.down_proj", cuts.items[cuts.items.len - 1].prefix);
+    cuts.clearRetainingCapacity();
+    try layerCuts(c, 0, 0, 1, &buf, a, &cuts);
+    try std.testing.expect(cuts.items[0].axis == .whole);
+    const h0 = headCut(202112, 0, 2);
+    const h1 = headCut(202112, 1, 2);
+    try std.testing.expectEqual(@as(usize, 101120), h0.hi);
+    try std.testing.expectEqual(@as(usize, 101120), h1.lo);
+    try std.testing.expectEqual(@as(usize, 202112), h1.hi);
+    try std.testing.expectEqual(@as(usize, 101120), headStride(202112, 2));
+}
diff --git a/zig/src/families/muse_spark/dflash2.zig b/zig/src/families/muse_spark/dflash2.zig
new file mode 100644
index 00000000..6dc31f39
--- /dev/null
+++ b/zig/src/families/muse_spark/dflash2.zig
@@ -0,0 +1,457 @@
+//! Muse Spark's DFlash2 drafter (RadixArk/Muse-Spark-Open-DFlash2) as an EXL3 pack, fed from the target's run.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const fwd = @import("forward.zig");
+const load_ = @import("load.zig");
+const dc = @import("dflash2_config.zig");
+const dl = @import("dflash2_load.zig");
+const exl3 = @import("exl3.zig");
+const Stream = cuda.Stream;
+
+pub const MAX_STREAMS = 16; // a draft pass's streams: 16 x block 8 = the EXL3 GEMV's 128 rows
+
+fn u(x: usize) u32 {
+    return @intCast(x);
+}
+fn ci(x: usize) c_int {
+    return @intCast(x);
+}
+
+/// A matrix: EXL3 (the drafter pack's quantised linears) or 16-bit dense rows [N, K] (an unquantised Linear).
+pub const Lin = union(enum) {
+    q: exl3.Linear,
+    dense: struct { w: u64, n: usize, k: usize, bf16: bool },
+
+    pub fn n(l: Lin) usize {
+        return switch (l) {
+            .q => |x| x.n,
+            .dense => |x| x.n,
+        };
+    }
+};
+
+pub const Conv = struct { proj: Lin, base: u64 }; // base fp32 [2, KT, D]
+
+pub const DLayer = struct {
+    in_norm: u64,
+    post_norm: u64,
+    q_norm: u64,
+    k_norm: u64,
+    q: exl3.Linear,
+    k: exl3.Linear,
+    v: exl3.Linear,
+    o: exl3.Linear,
+    gate: exl3.Linear,
+    up: exl3.Linear,
+    down: exl3.Linear,
+    aconv: Conv,
+    mconv: Conv,
+};
+
+pub const Drafter = struct {
+    m: *fwd.Model,
+    d: *const cuda.Driver,
+    gpa: std.mem.Allocator,
+    mod_m: cuda.Module, // dflash.cu: embed, taps, per-head norm + RoPE, cache stores, block attention, row take
+    mod: cuda.Module, // muse_dflash2
+    f: struct { embed: cuda.Function, tap: cuda.Function, norm_rope: cuda.Function, store: cuda.Function, attn: cuda.Function, take: cuda.Function },
+    g: struct { dense: cuda.Function, prep: cuda.Function, finish: cuda.Function, silu: cuda.Function, topk: cuda.Function, walk: cuda.Function },
+    arena: load_.Arena,
+    full: dc.DConfig,
+    c: dc.DConfig, // this rank's view
+    block: usize,
+    taps: []usize,
+    ring: usize,
+    scale: f32,
+    streams: usize,
+    graphs_on: bool,
+    fc: exl3.Linear,
+    fc_norm: u64,
+    layers: []DLayer,
+    norm: u64,
+    mask_emb: u64, // fp32 [D]: the target's embedding row of mask_token_id (raw: the reference skips embed_norm)
+    sel: Lin, // candidate_selector.hidden_projection [rank, D]
+    pcb: u64,
+    scb: u64,
+    cb_bf16: bool,
+    kc: []u64,
+    vc: []u64,
+    cos: u64,
+    sin: u64,
+    b: struct { tapbuf: u64, ctx16: u64, ctxg: u64, ctx: u64, kb: u64, vb: u64, xh: u64, z: u64, x32: u64, h: u64, c16: u64, dyn: u64, q16: u64, q32: u64, a: u64, part: u64, recv: u64, gb: u64, ub: u64, mm: u64, tk: u64, head: u64, top: u64, topg: u64, sg: u64, am: u64, in_tok: u64, in_pos0: u64, in_slot: u64, rpos: u64, rslot: u64, anc: u64, anc_idx: u64 },
+    h_anc: []u16 = &.{}, // the anchors' embedding rows staged here (anc bf16 [streams, D], anc_idx iota)
+    drafts: usize = 0,
+    graphs: [MAX_STREAMS + 1]?cuda.graph.Exec = @splat(null),
+
+    /// The drafter pack at `dir` on this rank; `taps_override`: target layers to tap (k-layer packs only).
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, m: *fwd.Model, dir: []const u8, s: Stream, graphs_on: bool, taps_override: ?[]const usize) !*Drafter {
+        const d = m.d;
+        const w = m.w;
+        const text = try dl.readFile(gpa, io, dir, "config.json");
+        defer gpa.free(text);
+        const full = try dc.DConfig.parse(gpa, text);
+        if (full.hidden != w.full.hidden) return error.HiddenMismatch;
+        if (full.vocab != w.full.vocab or full.mask_id >= w.full.vocab) return error.VocabMismatch;
+        // the target head already applies output_multiplier and the softcap (muse_softcap): the same, applied once
+        if (!dl.near(full.out_mult, w.full.out_mult) or !dl.near(full.softcap, w.full.softcap)) return error.HeadScaleMismatch;
+        const c = try full.rankView(w.world);
+        const dr = try gpa.create(Drafter);
+        errdefer gpa.destroy(dr);
+        dr.* = undefined;
+        dr.m = m;
+        dr.d = d;
+        dr.gpa = gpa;
+        dr.full = full;
+        dr.c = c;
+        dr.drafts = 0;
+        dr.graphs = @splat(null);
+        dr.graphs_on = graphs_on;
+        dr.block = full.block;
+        dr.ring = m.ring;
+        if (dr.ring < full.window + 2 * full.block) return error.RingShorterThanWindow;
+        dr.scale = @floatCast(std.math.pow(f64, @floatFromInt(full.head_dim), -0.5));
+        dr.streams = @min(m.slots, MAX_STREAMS);
+        const tl = taps_override orelse full.tapList();
+        if (tl.len != full.ntaps) return error.TapCount; // fc's input width is fixed by the checkpoint
+        dr.taps = try gpa.dupe(usize, tl);
+        errdefer gpa.free(dr.taps);
+        for (dr.taps, 0..) |t, i| if (t >= w.layers.len or (i > 0 and t < dr.taps[i - 1])) return error.TapPastLastLayer;
+        dr.mod_m = try cuda.Module.load(d, cuda.kernels.muse_dflash);
+        errdefer dr.mod_m.unload();
+        dr.mod = try cuda.Module.load(d, cuda.kernels.muse_dflash2);
+        errdefer dr.mod.unload();
+        dr.f = .{ .embed = try dr.mod_m.function("dr_block_embed"), .tap = try dr.mod_m.function("dr_tap"), .norm_rope = try dr.mod_m.function("dr_norm_rope"), .store = try dr.mod_m.function("dr_store"), .attn = try dr.mod_m.function("dr_attn"), .take = try dr.mod_m.function("dr_take") };
+        dr.g = .{ .dense = try dr.mod.function("dfl_dense"), .prep = try dr.mod.function("dfl_conv_prep"), .finish = try dr.mod.function("dfl_conv_finish"), .silu = try dr.mod.function("dfl_silu_mul"), .topk = try dr.mod.function("dfl_topk"), .walk = try dr.mod.function("dfl_walk") };
+        dr.arena = .{ .d = d, .gpa = gpa };
+        errdefer dr.arena.deinit();
+        try dl.loadWeights(dr, io, dir);
+        errdefer gpa.free(dr.layers);
+        try dl.allocState(dr, s);
+        errdefer {
+            gpa.free(dr.kc);
+            gpa.free(dr.vc);
+        }
+        try s.synchronize();
+        return dr;
+    }
+
+    pub fn deinit(dr: *Drafter) void {
+        const gpa = dr.gpa;
+        for (&dr.graphs) |*g| if (g.*) |*e| {
+            e.deinit();
+            g.* = null;
+        };
+        gpa.free(dr.h_anc);
+        gpa.free(dr.taps);
+        gpa.free(dr.layers);
+        gpa.free(dr.kc);
+        gpa.free(dr.vc);
+        dr.mod.unload();
+        dr.mod_m.unload();
+        dr.arena.deinit();
+        gpa.destroy(dr);
+    }
+
+    /// Device bytes the drafter holds on this rank (weights, caches, scratch).
+    pub fn bytes(dr: *const Drafter) usize {
+        return dr.arena.total;
+    }
+
+    pub fn zBytes(l: exl3.Linear, R: usize) usize {
+        return if (l.split[0] > 1) l.split[0] * R * l.n * 4 else 0;
+    }
+
+    fn proj(dr: *Drafter, s: Stream, l: exl3.Linear, x: u64, out: u64, out_f32: bool, n: usize) !void {
+        try dr.m.k3.linear(s, l, x, .f16, dr.b.xh, out, if (out_f32) .f32 else .f16, if (l.split[0] > 1) dr.b.z else 0, n);
+    }
+
+    fn projL(dr: *Drafter, s: Stream, l: Lin, x: u64, out: u64, out_f32: bool, n: usize) !void {
+        switch (l) {
+            .q => |q| try dr.proj(s, q, x, out, out_f32, n),
+            .dense => |w| {
+                var a: cuda.Args = .{};
+                a.add(x);
+                a.add(w.w);
+                a.add(@as(c_int, @intFromBool(w.bf16)));
+                a.add(out);
+                a.add(@as(c_int, @intFromBool(out_f32)));
+                a.add(ci(n));
+                a.add(ci(w.k));
+                a.add(ci(w.n));
+                try launch(dr.g.dense, s, (w.n + 7) / 8, (n + 7) / 8, 256, &a);
+            },
+        }
+    }
+
+    /// muse_rms: out fp16 = x * rsqrt(mean x^2 + eps) * w; parts > 0: x is the ranks' gathered column slices.
+    fn rms(dr: *Drafter, s: Stream, x: u64, x_half: bool, w: u64, out: u64, n: usize, parts: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(@as(c_int, @intFromBool(x_half)));
+        a.add(w);
+        a.add(out);
+        a.add(ci(dr.c.hidden));
+        a.add(@as(f32, @floatCast(dr.c.eps)));
+        a.add(ci(parts));
+        try launch(dr.m.f_rms, s, n, 1, fwd.NORM_THREADS, &a);
+    }
+
+    fn launch(f: cuda.Function, s: Stream, gx: usize, gy: usize, threads: usize, a: *cuda.Args) !void {
+        try cuda.launch.launch(f, .{ .grid = .{ .x = u(gx), .y = u(gy), .z = 1 }, .block = .{ .x = u(threads), .y = 1, .z = 1 } }, s, a);
+    }
+
+    /// The target's tap: residual rows after target layer `layer` (when tapped) into the tap buffer (fp16).
+    pub fn tap(dr: *Drafter, s: Stream, layer: usize, res: u64, n: usize) !void {
+        return dr.tapInto(s, layer, res, n, dr.b.tapbuf);
+    }
+
+    /// tap into another buffer of the same row layout ([rows, taps, D] fp16): the prompt path's chunk-wide taps.
+    pub fn tapInto(dr: *Drafter, s: Stream, layer: usize, res: u64, n: usize, buf: u64) !void {
+        for (dr.taps, 0..) |t, j| if (t == layer) {
+            var a: cuda.Args = .{};
+            a.add(res);
+            a.add(buf);
+            a.add(ci(dr.c.hidden));
+            a.add(ci(dr.taps.len));
+            a.add(ci(j));
+            try launch(dr.f.tap, s, n, 1, 256, &a);
+        };
+    }
+
+    /// The context update of the target's n rows: fc, hidden_norm, each layer's k (k_norm, RoPE) and v into the ring.
+    pub fn update(dr: *Drafter, s: Stream, n: usize) !void {
+        return dr.updateAt(s, dr.b.tapbuf, dr.m.b.pos, dr.m.b.slot, n);
+    }
+
+    /// update from explicit taps [n, taps, D] fp16 and the rows' positions / slots (n <= the target's window rows).
+    pub fn updateAt(dr: *Drafter, s: Stream, taps: u64, pos: u64, slot: u64, n: usize) !void {
+        const m = dr.m;
+        if (n > m.rows) return error.WindowTooWide;
+        try dr.proj(s, dr.fc, taps, dr.b.ctx16, false, n);
+        if (m.comm) |comm| {
+            try comm.allGather(dr.b.ctx16, dr.b.ctxg, n * dr.fc.n, .f16, s.handle);
+            try dr.rms(s, dr.b.ctxg, true, dr.fc_norm, dr.b.ctx, n, dr.fc.n);
+        } else try dr.rms(s, dr.b.ctx16, true, dr.fc_norm, dr.b.ctx, n, 0);
+        for (dr.layers, 0..) |L, i| {
+            try dr.proj(s, L.k, dr.b.ctx, dr.b.kb, false, n);
+            try dr.normRope(s, dr.b.kb, L.k_norm, pos, slot, 0, dr.kc[i], dr.c.kv_heads, n);
+            try dr.proj(s, L.v, dr.b.ctx, dr.b.vb, false, n);
+            try dr.store(s, dr.b.vb, pos, slot, dr.vc[i], n);
+        }
+    }
+
+    fn normRope(dr: *Drafter, s: Stream, in: u64, w: u64, pos: u64, slot: u64, out32: u64, cache: u64, nh: usize, n: usize) !void {
+        var a: cuda.Args = .{};
+        inline for (.{ in, w, dr.cos, dr.sin, pos, slot, out32, cache }) |p| a.add(p);
+        a.add(ci(nh));
+        a.add(ci(128));
+        a.add(ci(dr.ring));
+        a.add(@as(f32, @floatCast(dr.c.eps)));
+        try launch(dr.f.norm_rope, s, n, nh, 128, &a);
+    }
+
+    fn store(dr: *Drafter, s: Stream, in: u64, pos: u64, slot: u64, cache: u64, n: usize) !void {
+        var a: cuda.Args = .{};
+        inline for (.{ in, pos, slot, cache }) |p| a.add(p);
+        a.add(ci(dr.c.kv_heads));
+        a.add(ci(dr.ring));
+        try launch(dr.f.store, s, n, 1, 256, &a);
+    }
+
+    /// conv.prepare on h: the kernel projection into dyn, the first convolution into c16.
+    fn convPrep(dr: *Drafter, s: Stream, cv: Conv, n: usize) !void {
+        try dr.projL(s, cv.proj, dr.b.h, dr.b.dyn, false, n);
+        var a: cuda.Args = .{};
+        inline for (.{ dr.b.h, dr.b.dyn, cv.base, dr.b.c16 }) |p| a.add(p);
+        a.add(ci(dr.block));
+        a.add(ci(dr.c.hidden));
+        a.add(ci(dr.c.conv_k));
+        a.add(ci(dr.c.conv_g));
+        try launch(dr.g.prep, s, n, 1, 256, &a);
+    }
+
+    /// The sublayer's fp32 partials (part) gathered, summed in rank order, convolved (conv.finish) into the residual.
+    fn convFinish(dr: *Drafter, s: Stream, cv: Conv, n: usize) !void {
+        const D = dr.c.hidden;
+        var y0 = dr.b.part;
+        var y1: u64 = 0;
+        if (dr.m.comm) |comm| {
+            try comm.allGather(dr.b.part, dr.b.recv, n * D, .f32, s.handle);
+            y0 = dr.b.recv;
+            y1 = dr.b.recv + n * D * 4;
+        }
+        var a: cuda.Args = .{};
+        inline for (.{ dr.b.x32, y0, y1, dr.b.dyn, cv.base + dr.c.conv_k * D * 4 }) |p| a.add(p);
+        a.add(ci(dr.block));
+        a.add(ci(D));
+        a.add(ci(dr.c.conv_k));
+        a.add(ci(dr.c.conv_g));
+        try launch(dr.g.finish, s, n, 1, 256, &a);
+    }
+
+    /// Stage a draft: each stream's pending (anchor) token, its position and slot (the draft pass's fixed inputs).
+    pub fn stage(dr: *Drafter, tokens: []const i64, pos0: []const u32, slots: []const u32) !void {
+        const S = tokens.len;
+        if (S == 0 or S > dr.streams) return error.TooManyStreams;
+        var pz: [MAX_STREAMS]i32 = undefined;
+        var sz: [MAX_STREAMS]i32 = undefined;
+        var rp: [MAX_STREAMS * 16]i32 = undefined;
+        var rs: [MAX_STREAMS * 16]i32 = undefined;
+        for (0..S) |i| {
+            if (pos0[i] >= dr.m.context) return error.PastContext;
+            if (slots[i] >= dr.m.slots) return error.BadSlot;
+            if (tokens[i] < 0 or tokens[i] >= dr.full.vocab) return error.BadToken;
+            pz[i] = @intCast(pos0[i]);
+            sz[i] = @intCast(slots[i]);
+            for (0..dr.block) |b| {
+                rp[i * dr.block + b] = @intCast(pos0[i] + b);
+                rs[i * dr.block + b] = @intCast(slots[i]);
+            }
+        }
+        const d = dr.d;
+        try d.check(d.api.cuMemcpyHtoD_v2(dr.b.in_tok, std.mem.sliceAsBytes(tokens).ptr, S * 8), "draft in");
+        try dr.m.embedRows(tokens, dr.h_anc, dr.b.anc);
+        try d.check(d.api.cuMemcpyHtoD_v2(dr.b.in_pos0, @ptrCast(&pz), S * 4), "draft in");
+        try d.check(d.api.cuMemcpyHtoD_v2(dr.b.in_slot, @ptrCast(&sz), S * 4), "draft in");
+        try d.check(d.api.cuMemcpyHtoD_v2(dr.b.rpos, @ptrCast(&rp), S * dr.block * 4), "draft in");
+        try d.check(d.api.cuMemcpyHtoD_v2(dr.b.rslot, @ptrCast(&rs), S * dr.block * 4), "draft in");
+    }
+
+    /// The draft pass on staged inputs for S streams, kernels only: drafts [S, block - 1] (int32) left in `am`.
+    pub fn run(dr: *Drafter, s: Stream, S: usize) !void {
+        const m = dr.m;
+        const c = dr.c;
+        const B = dr.block;
+        const n = S * B;
+        const D = c.hidden;
+        const bb = &dr.b;
+        {
+            var a: cuda.Args = .{};
+            const es = m.embedSrc(bb.anc, bb.anc_idx);
+            inline for (.{ es[0], dr.mask_emb, es[1], bb.x32 }) |p| a.add(p);
+            a.add(ci(B));
+            a.add(ci(D));
+            try launch(dr.f.embed, s, n, 1, 256, &a);
+        }
+        for (dr.layers, 0..) |L, i| {
+            try dr.rms(s, bb.x32, false, L.in_norm, bb.h, n, 0);
+            try dr.convPrep(s, L.aconv, n);
+            try dr.proj(s, L.q, bb.c16, bb.q16, false, n);
+            try dr.normRope(s, bb.q16, L.q_norm, bb.rpos, bb.rslot, bb.q32, 0, c.heads, n);
+            try dr.proj(s, L.k, bb.c16, bb.kb, false, n);
+            try dr.normRope(s, bb.kb, L.k_norm, bb.rpos, bb.rslot, 0, dr.kc[i], c.kv_heads, n);
+            try dr.proj(s, L.v, bb.c16, bb.vb, false, n);
+            try dr.store(s, bb.vb, bb.rpos, bb.rslot, dr.vc[i], n);
+            {
+                var a: cuda.Args = .{};
+                inline for (.{ bb.q32, dr.kc[i], dr.vc[i], @as(u64, 0), bb.in_pos0, bb.in_slot, bb.a }) |p| a.add(p);
+                a.add(ci(B));
+                a.add(ci(c.window));
+                a.add(ci(dr.ring));
+                a.add(ci(c.heads));
+                a.add(ci(c.kv_heads));
+                a.add(dr.scale);
+                try launch(dr.f.attn, s, n, c.kv_heads, 256, &a); // a block per (row, KV head), a warp per head
+            }
+            try dr.proj(s, L.o, bb.a, bb.part, true, n);
+            try dr.convFinish(s, L.aconv, n);
+            try dr.rms(s, bb.x32, false, L.post_norm, bb.h, n, 0);
+            try dr.convPrep(s, L.mconv, n);
+            try dr.proj(s, L.gate, bb.c16, bb.gb, false, n);
+            try dr.proj(s, L.up, bb.c16, bb.ub, false, n);
+            {
+                var a: cuda.Args = .{};
+                inline for (.{ bb.gb, bb.ub, bb.mm }) |p| a.add(p);
+                a.add(@as(i64, @intCast(n * c.inter)));
+                try launch(dr.g.silu, s, @min((n * c.inter + 255) / 256, 4096), 1, 256, &a);
+            }
+            try dr.proj(s, L.down, bb.mm, bb.part, true, n);
+            try dr.convFinish(s, L.mconv, n);
+        }
+        try dr.rms(s, bb.x32, false, dr.norm, bb.h, n, 0);
+        const n1 = S * (B - 1);
+        {
+            var a: cuda.Args = .{};
+            a.add(bb.h);
+            a.add(bb.tk);
+            a.add(ci(B));
+            a.add(ci(D));
+            try launch(dr.f.take, s, n1, 1, 256, &a);
+        }
+        try dr.headTop(s, n1);
+        try dr.projL(s, dr.sel, bb.tk, bb.sg, false, n1);
+        var a: cuda.Args = .{};
+        a.add(if (m.comm != null) bb.topg else bb.top);
+        a.add(ci(m.w.world));
+        a.add(ci(n1));
+        a.add(bb.sg);
+        a.add(ci(c.sel_rank));
+        inline for (.{ dr.pcb, dr.scb }) |p| a.add(p);
+        a.add(@as(c_int, @intFromBool(dr.cb_bf16)));
+        a.add(bb.in_tok);
+        a.add(ci(B - 1));
+        a.add(bb.am);
+        try launch(dr.g.walk, s, S, 1, 512, &a);
+    }
+
+    /// The target's head on the draft rows (this rank's slice, scaled and softcapped), each rank's top 16, gathered.
+    fn headTop(dr: *Drafter, s: Stream, n1: usize) !void {
+        const m = dr.m;
+        const bb = &dr.b;
+        try dr.proj(s, m.w.head, bb.tk, bb.head, true, n1);
+        const vr = m.w.head.n;
+        {
+            var a: cuda.Args = .{};
+            a.add(bb.head);
+            a.add(@as(i64, @intCast(n1 * vr)));
+            a.add(@as(f32, @floatCast(m.w.full.out_mult)));
+            a.add(@as(f32, @floatCast(m.w.full.softcap)));
+            try launch(m.f_softcap, s, @min((n1 * vr + 255) / 256, 4096), 1, 256, &a);
+        }
+        var a: cuda.Args = .{};
+        a.add(bb.head);
+        a.add(ci(vr));
+        a.add(ci(@min(vr, m.w.full.vocab - m.w.head_lo)));
+        a.add(ci(m.w.head_lo));
+        a.add(bb.top);
+        try launch(dr.g.topk, s, n1, 1, 256, &a);
+        if (m.comm) |comm| try comm.allGather(bb.top, bb.topg, n1 * 32, .f32, s.handle);
+    }
+
+    /// A draft for S streams: drafts [S, block - 1] into `out` (row-major). Graphed per stream count when enabled.
+    pub fn draft(dr: *Drafter, s: Stream, tokens: []const i64, pos0: []const u32, slots: []const u32, out: []i32) !void {
+        try dr.stage(tokens, pos0, slots);
+        const S = tokens.len;
+        if (!dr.graphs_on) {
+            try dr.run(s, S);
+        } else if (dr.graphs[S]) |e| {
+            try e.launchOn(s);
+        } else {
+            try dr.run(s, S); // warm-up: writes the same cache rows the replay will
+            try s.synchronize();
+            try cuda.graph.beginCapture(s, .thread_local);
+            dr.run(s, S) catch |err| {
+                if (cuda.graph.endCapture(s)) |g| {
+                    var gg = g;
+                    gg.deinit();
+                } else |_| {}
+                return err;
+            };
+            var g = try cuda.graph.endCapture(s);
+            defer g.deinit();
+            dr.graphs[S] = try g.instantiate();
+            try dr.graphs[S].?.launchOn(s);
+        }
+        try s.synchronize();
+        const n1 = S * (dr.block - 1);
+        try dr.d.check(dr.d.api.cuMemcpyDtoH_v2(@ptrCast(out.ptr), dr.b.am, n1 * 4), "drafts");
+        dr.drafts += 1;
+    }
+};
+
+test "drafter modules" {
+    _ = dc;
+    _ = dl;
+}
diff --git a/zig/src/families/muse_spark/dflash2_config.zig b/zig/src/families/muse_spark/dflash2_config.zig
new file mode 100644
index 00000000..75e02302
--- /dev/null
+++ b/zig/src/families/muse_spark/dflash2_config.zig
@@ -0,0 +1,253 @@
+//! RadixArk's DFlash2 drafter for Muse Spark: its config and a rank's matrix cuts (z-lab/dflash semantics).
+
+const std = @import("std");
+const config = @import("config.zig");
+const Cut = config.Cut;
+
+pub const DConfig = struct {
+    hidden: usize, // 8192: the target's
+    inter: usize, // 28672 (a rank's under TP: rankView)
+    layers: usize, // 5
+    heads: usize, // 64 query heads (a rank's under TP)
+    kv_heads: usize, // 8
+    head_dim: usize, // 128
+    eps: f64, // rms_norm_eps: every drafter norm
+    theta: f64, // RoPE theta, NeoX over the whole head
+    window: usize, // sliding_window: keys q - k < window behind each query, the whole block ahead (is_causal false)
+    block: usize, // block_size: the anchor and block - 1 mask rows
+    mask_id: usize,
+    taps: [8]usize = @splat(0), // target layers whose OUTPUT (residual) feeds the context, increasing
+    ntaps: usize = 0,
+    conv_k: usize, // conv_kernel_size: taps of each grouped dynamic convolution
+    conv_g: usize, // conv_group_size: channels sharing a dynamic weight
+    sel_rank: usize, // selector_rank
+    sel_k: usize, // selector_top_k (the walk kernel takes 16)
+    out_mult: f64, // output_multiplier on the draft logits (the target head's own: applied once)
+    softcap: f64, // final_logit_softcapping (likewise)
+    vocab: usize,
+
+    pub fn tapList(c: *const DConfig) []const usize {
+        return c.taps[0..c.ntaps];
+    }
+
+    /// config.json of the drafter (the bf16 release or exllamav3's EXL3 export of it); refuses what is not wired.
+    pub fn parse(gpa: std.mem.Allocator, text: []const u8) !DConfig {
+        const parsed = try std.json.parseFromSlice(std.json.Value, gpa, text, .{});
+        defer parsed.deinit();
+        const top = parsed.value.object;
+        const arch = if (top.get("architectures")) |a| (if (a == .array and a.array.items.len > 0 and a.array.items[0] == .string) a.array.items[0].string else "") else "";
+        if (!std.mem.eql(u8, arch, "DFlash2DraftModel")) return error.NotDFlash2;
+        const df: ?std.json.ObjectMap = if (top.get("dflash_config")) |v| (if (v == .object) v.object else null) else null;
+        var c: DConfig = .{
+            .hidden = try need(top, "hidden_size"),
+            .inter = try need(top, "intermediate_size"),
+            .layers = try need(top, "num_hidden_layers"),
+            .heads = try need(top, "num_attention_heads"),
+            .kv_heads = try need(top, "num_key_value_heads"),
+            .head_dim = int(top, "head_dim") orelse return error.MissingField,
+            .eps = num(top.get("rms_norm_eps") orelse return error.MissingField),
+            .theta = 0,
+            .window = int(top, "sliding_window") orelse 2048,
+            .block = try pick(df, top, "block_size"),
+            .mask_id = try pick(df, top, "mask_token_id"),
+            .conv_k = pickOr(df, top, "conv_kernel_size", 2),
+            .conv_g = pickOr(df, top, "conv_group_size", 16),
+            .sel_rank = try pick(df, top, "selector_rank"),
+            .sel_k = try pick(df, top, "selector_top_k"),
+            .out_mult = pickNum(df, top, "output_multiplier", 1.0),
+            .softcap = pickNum(df, top, "final_logit_softcapping", 0.0),
+            .vocab = try need(top, "vocab_size"),
+        };
+        c.theta = if (top.get("rope_theta")) |v| num(v) else 0;
+        if (top.get("rope_parameters")) |rp| if (rp == .object) {
+            if (rp.object.get("rope_theta")) |v| c.theta = num(v);
+            if (!std.mem.eql(u8, str(rp.object, "rope_type") orelse "default", "default")) return error.UnsupportedRope;
+        };
+        if (c.theta == 0) c.theta = 10000.0;
+        if (boolean(top, "attention_bias")) return error.Unsupported;
+        if (!std.mem.eql(u8, str(top, "hidden_act") orelse "silu", "silu")) return error.UnsupportedActivation;
+        // the reference reads is_causal (default: causal on sliding layers); this checkpoint ships false
+        const causal = if (top.get("is_causal")) |v| (v == .bool and v.bool) else true;
+        if (causal) return error.CausalDrafter;
+        const lt = top.get("layer_types") orelse return error.LayerPattern;
+        if (lt.array.items.len != c.layers) return error.LayerPattern;
+        for (lt.array.items) |t| if (!std.mem.eql(u8, t.string, "sliding_attention")) return error.LayerPattern;
+        if (pickNum(df, top, "input_embedding_scale", 1.0) != 1.0) return error.Unsupported;
+        if (pickOr(df, top, "tap_shift", 0) != 0) return error.Unsupported; // DFlash2: hidden_states[id + 1] = layer id's output
+        const ids = (if (df) |d| d.get("target_layer_ids") else null) orelse top.get("target_layer_ids") orelse return error.MissingField;
+        for (ids.array.items) |v| {
+            if (c.ntaps == c.taps.len) return error.TooManyTaps;
+            c.taps[c.ntaps] = @intCast(v.integer);
+            if (c.ntaps > 0 and c.taps[c.ntaps] <= c.taps[c.ntaps - 1]) return error.TapsOutOfOrder;
+            c.ntaps += 1;
+        }
+        if (c.head_dim != 128) return error.HeadDim; // dflash.cu's norm/rope and attention: 128 threads a head
+        if (c.heads % c.kv_heads != 0 or c.heads / c.kv_heads > 8) return error.GroupWiderThan8;
+        if (c.sel_k != 16) return error.SelectorTopK; // dfl_walk: a warp a candidate, 16 warps
+        if (c.block < 2 or c.block > 16) return error.BlockSize;
+        if (c.conv_k == 0 or c.conv_k > c.block or c.conv_k > 4) return error.ConvKernel;
+        if (c.hidden % c.conv_g != 0) return error.ConvGroups;
+        if (c.sel_rank % 32 != 0 or c.sel_rank > 1024) return error.SelectorRank;
+        return c;
+    }
+
+    /// A rank's view: query / KV heads and the MLP width split (the context projection fc by outputs).
+    pub fn rankView(c: DConfig, world: usize) !DConfig {
+        if (world != 1 and world != 2) return error.World;
+        if (c.heads % world != 0 or c.kv_heads % world != 0) return error.HeadsSplit;
+        if ((c.kv_heads / world) * c.head_dim % 128 != 0) return error.HeadsSplit;
+        if (c.inter % (128 * world) != 0 or c.hidden % (128 * world) != 0) return error.WidthSplit;
+        var r = c;
+        r.heads = c.heads / world;
+        r.kv_heads = c.kv_heads / world;
+        r.inter = c.inter / world;
+        return r;
+    }
+};
+
+/// The drafter's matrices: fc, then per layer q, k, v, o, gate, up, down, the two convolutions' kernel projections.
+pub const Mat = enum { q, k, v, o, gate, up, down, aconv, mconv };
+pub const mat_names = [_][]const u8{ "self_attn.q_proj", "self_attn.k_proj", "self_attn.v_proj", "self_attn.o_proj", "mlp.gate_proj", "mlp.up_proj", "mlp.down_proj", "attention_conv.kernel_projection", "mlp_conv.kernel_projection" };
+
+/// A layer matrix's cut for `rank`: q / o by heads, k / v by KV heads, the MLP by width; kernel projections whole.
+pub fn layerCut(c: DConfig, mat: Mat, prefix: []const u8, rank: usize, world: usize) Cut {
+    if (world == 1) return .{ .prefix = prefix };
+    const hq = c.heads / world * c.head_dim;
+    const hk = c.kv_heads / world * c.head_dim;
+    const wi = c.inter / world;
+    const r = rank;
+    return switch (mat) {
+        .q => .{ .prefix = prefix, .axis = .n, .lo = r * hq, .hi = (r + 1) * hq },
+        .k, .v => .{ .prefix = prefix, .axis = .n, .lo = r * hk, .hi = (r + 1) * hk },
+        .o => .{ .prefix = prefix, .axis = .k, .lo = r * hq, .hi = (r + 1) * hq },
+        .gate, .up => .{ .prefix = prefix, .axis = .n, .lo = r * wi, .hi = (r + 1) * wi },
+        .down => .{ .prefix = prefix, .axis = .k, .lo = r * wi, .hi = (r + 1) * wi },
+        .aconv, .mconv => .{ .prefix = prefix },
+    };
+}
+
+/// fc (taps -> hidden) by outputs: each rank projects its half of the context row; the halves are gathered (fp16).
+pub fn fcCut(c: DConfig, rank: usize, world: usize) Cut {
+    if (world == 1) return .{ .prefix = "fc" };
+    const w = c.hidden / world;
+    return .{ .prefix = "fc", .axis = .n, .lo = rank * w, .hi = (rank + 1) * w };
+}
+
+/// Weight bytes a draft pass reads on one rank (bpw for the EXL3 matrices; the head and the context update excluded).
+pub fn passBytes(c: DConfig, world: usize, bpw: f64) f64 {
+    const H = @as(f64, @floatFromInt(c.hidden));
+    const q = H * @as(f64, @floatFromInt(c.heads * c.head_dim));
+    const kv = 2 * H * @as(f64, @floatFromInt(c.kv_heads * c.head_dim));
+    const mlp = 3 * H * @as(f64, @floatFromInt(c.inter));
+    const conv = 2 * H * @as(f64, @floatFromInt(2 * c.conv_k * (c.hidden / c.conv_g)));
+    const w: f64 = @floatFromInt(world);
+    return @as(f64, @floatFromInt(c.layers)) * ((2 * q + kv + mlp) / w + conv) * bpw / 8;
+}
+
+fn str(o: std.json.ObjectMap, k: []const u8) ?[]const u8 {
+    const v = o.get(k) orelse return null;
+    return if (v == .string) v.string else null;
+}
+fn int(o: std.json.ObjectMap, k: []const u8) ?usize {
+    const v = o.get(k) orelse return null;
+    return if (v == .integer) @intCast(v.integer) else null;
+}
+fn need(o: std.json.ObjectMap, k: []const u8) !usize {
+    return int(o, k) orelse error.MissingField;
+}
+fn num(v: std.json.Value) f64 {
+    return switch (v) {
+        .integer => |i| @floatFromInt(i),
+        .float => |f| f,
+        .number_string => |s| std.fmt.parseFloat(f64, s) catch 0,
+        else => 0,
+    };
+}
+fn boolean(o: std.json.ObjectMap, k: []const u8) bool {
+    const v = o.get(k) orelse return false;
+    return v == .bool and v.bool;
+}
+/// dflash_config->key first, then the top level (the reference's _draft_value).
+fn pickOr(df: ?std.json.ObjectMap, top: std.json.ObjectMap, k: []const u8, default: usize) usize {
+    if (df) |d| if (int(d, k)) |v| return v;
+    return int(top, k) orelse default;
+}
+fn pick(df: ?std.json.ObjectMap, top: std.json.ObjectMap, k: []const u8) !usize {
+    if (df) |d| if (int(d, k)) |v| return v;
+    return int(top, k) orelse error.MissingField;
+}
+fn pickNum(df: ?std.json.ObjectMap, top: std.json.ObjectMap, k: []const u8, default: f64) f64 {
+    if (df) |d| if (d.get(k)) |v| return num(v);
+    return if (top.get(k)) |v| num(v) else default;
+}
+
+// RadixArk/Muse-Spark-Open-DFlash2 @ 46c90f41's config.json (the fields parse reads).
+pub const fixture =
+    \\{"architectures": ["DFlash2DraftModel"], "attention_bias": false, "dflash_config": {"attention_mode": "gqa",
+    \\ "block_size": 8, "conv_group_size": 16, "conv_kernel_size": 2, "final_logit_softcapping": 20, "mask_token_id": 200002,
+    \\ "output_multiplier": 0.1767766952966369, "selector_rank": 256, "selector_top_k": 16,
+    \\ "target_layer_ids": [1, 16, 30, 44, 59]}, "head_dim": 128, "hidden_act": "silu", "hidden_size": 8192,
+    \\ "intermediate_size": 28672, "is_causal": false, "layer_types": ["sliding_attention", "sliding_attention",
+    \\ "sliding_attention", "sliding_attention", "sliding_attention"], "num_attention_heads": 64, "num_hidden_layers": 5,
+    \\ "num_key_value_heads": 8, "rms_norm_eps": 1e-05, "rope_parameters": {"rope_theta": 500000, "rope_type": "default"},
+    \\ "rope_theta": 500000, "sliding_window": 2048, "vocab_size": 202048}
+;
+
+test "DConfig.parse reads RadixArk's Muse Spark DFlash2" {
+    const c = try DConfig.parse(std.testing.allocator, fixture);
+    try std.testing.expectEqual(@as(usize, 5), c.layers);
+    try std.testing.expectEqual(@as(usize, 8), c.block);
+    try std.testing.expectEqual(@as(usize, 200002), c.mask_id);
+    try std.testing.expectEqualSlices(usize, &.{ 1, 16, 30, 44, 59 }, c.tapList());
+    try std.testing.expectEqual(@as(f64, 500000), c.theta);
+    try std.testing.expectEqual(@as(usize, 2048), c.window);
+    try std.testing.expectEqual(@as(usize, 2), c.conv_k);
+    try std.testing.expectEqual(@as(f64, 20), c.softcap);
+    try std.testing.expectApproxEqRel(@as(f64, 0.17677669529663687), c.out_mult, 1e-12);
+    const r = try c.rankView(2);
+    try std.testing.expectEqual(@as(usize, 32), r.heads);
+    try std.testing.expectEqual(@as(usize, 4), r.kv_heads);
+    try std.testing.expectEqual(@as(usize, 14336), r.inter);
+}
+
+test "DConfig.parse refuses what the drafter does not wire" {
+    const a = std.testing.allocator;
+    const bad = [_][2][]const u8{
+        .{ "\"is_causal\": false", "\"is_causal\": true" },
+        .{ "\"selector_top_k\": 16", "\"selector_top_k\": 8" },
+        .{ "\"head_dim\": 128", "\"head_dim\": 64" },
+        .{ "\"DFlash2DraftModel\"", "\"DFlashDraftModel\"" },
+        .{ "[1, 16, 30, 44, 59]", "[16, 1, 30, 44, 59]" },
+        .{ "\"sliding_attention\", \"sliding_attention\"]", "\"sliding_attention\", \"full_attention\"]" },
+    };
+    for (bad) |b| {
+        const t = try std.mem.replaceOwned(u8, a, fixture, b[0], b[1]);
+        defer a.free(t);
+        try std.testing.expect(std.meta.isError(DConfig.parse(a, t)));
+    }
+}
+
+test "drafter cuts at TP=2 sit on 128-column blocks" {
+    const c = try DConfig.parse(std.testing.allocator, fixture);
+    const q1 = layerCut(c, .q, "layers.0.self_attn.q_proj", 1, 2);
+    try std.testing.expectEqual(@as(usize, 4096), q1.lo);
+    try std.testing.expectEqual(@as(usize, 8192), q1.hi);
+    const k1 = layerCut(c, .k, "x", 1, 2);
+    try std.testing.expectEqual(@as(usize, 512), k1.lo);
+    try std.testing.expect(layerCut(c, .o, "x", 0, 2).axis == .k);
+    const d1 = layerCut(c, .down, "x", 1, 2);
+    try std.testing.expectEqual(@as(usize, 14336), d1.lo);
+    try std.testing.expect(d1.axis == .k);
+    try std.testing.expect(layerCut(c, .aconv, "x", 1, 2).axis == .whole);
+    try std.testing.expectEqual(@as(usize, 4096), fcCut(c, 1, 2).lo);
+    for (std.enums.values(Mat)) |m| {
+        const cc = layerCut(c, m, "x", 1, 2);
+        try std.testing.expect(cc.lo % 128 == 0 and cc.hi % 128 == 0);
+    }
+    try std.testing.expect(layerCut(c, .q, "x", 0, 1).axis == .whole);
+    // a draft pass reads about half the drafter a rank when split
+    const split = passBytes(c, 2, 4.0) / 1e9;
+    const repl = passBytes(c, 1, 4.0) / 1e9;
+    try std.testing.expect(split > 1.0 and split < 1.3);
+    try std.testing.expect(repl > 2.0 and repl < 2.4);
+}
diff --git a/zig/src/families/muse_spark/dflash2_load.zig b/zig/src/families/muse_spark/dflash2_load.zig
new file mode 100644
index 00000000..3b41179e
--- /dev/null
+++ b/zig/src/families/muse_spark/dflash2_load.zig
@@ -0,0 +1,197 @@
+//! The DFlash2 drafter's load on a rank: its EXL3 pack's weights (split like the target) and its device state.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const load_ = @import("load.zig");
+const dc = @import("dflash2_config.zig");
+const ml = @import("pack.zig");
+const dflash2 = @import("dflash2.zig");
+const Drafter = dflash2.Drafter;
+const DLayer = dflash2.DLayer;
+const Lin = dflash2.Lin;
+const Stream = cuda.Stream;
+const MAX_STREAMS = dflash2.MAX_STREAMS;
+
+fn ci(x: usize) c_int {
+    return @intCast(x);
+}
+
+/// The drafter pack's weights on this rank: fc, norms, selector and codebooks, the layers, the mask row.
+pub fn loadWeights(dr: *Drafter, io: std.Io, dir: []const u8) !void {
+    const gpa = dr.gpa;
+    const ar = &dr.arena;
+    const full = dr.full;
+    const rank = dr.m.w.rank;
+    const world = dr.m.w.world;
+    var ck = try core.Checkpoint.openModel(gpa, io, dir);
+    defer ck.close();
+    dr.fc = try ml.linear(gpa, ar, try ml.cut(gpa, try ml.readMat(gpa, &ck, "fc"), dc.fcCut(full, rank, world)));
+    if (dr.fc.k != full.ntaps * full.hidden) return error.FcWidth;
+    dr.fc_norm = try f32Up(gpa, ar, try ck.get("hidden_norm.weight"));
+    dr.norm = try f32Up(gpa, ar, try ck.get("norm.weight"));
+    dr.sel = try lin(gpa, ar, &ck, "candidate_selector.hidden_projection", .{ .prefix = "candidate_selector.hidden_projection" });
+    if (dr.sel.n() != full.sel_rank) return error.SelectorShape;
+    const pc = try codebook(&ck, "candidate_selector.predecessor_codebook");
+    const sc = try codebook(&ck, "candidate_selector.successor_codebook");
+    for ([_]core.safetensors.Tensor{ pc, sc }) |t| if (t.rank != 2 or t.shape[0] != full.vocab or t.shape[1] != full.sel_rank or t.dtype != pc.dtype or (t.dtype != .bf16 and t.dtype != .f16)) return error.CodebookShape;
+    dr.cb_bf16 = pc.dtype == .bf16;
+    dr.pcb = try ar.upload(pc.bytes);
+    dr.scb = try ar.upload(sc.bytes);
+    dr.layers = try gpa.alloc(DLayer, full.layers);
+    errdefer gpa.free(dr.layers);
+    var nb: [160]u8 = undefined;
+    var pb: [160]u8 = undefined;
+    for (dr.layers, 0..) |*L, i| {
+        L.in_norm = try f32Up(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, "layers.{d}.input_layernorm.weight", .{i})));
+        L.post_norm = try f32Up(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, "layers.{d}.post_attention_layernorm.weight", .{i})));
+        L.q_norm = try f32Up(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, "layers.{d}.self_attn.q_norm.weight", .{i})));
+        L.k_norm = try f32Up(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, "layers.{d}.self_attn.k_norm.weight", .{i})));
+        inline for (.{ "q", "k", "v", "o", "gate", "up", "down" }, 0..) |f, j| {
+            const prefix = try std.fmt.bufPrint(&pb, "layers.{d}.{s}", .{ i, dc.mat_names[j] });
+            const cut = dc.layerCut(full, @fromBackingInt(@intCast(j)), prefix, rank, world);
+            @field(L, f) = try ml.linear(gpa, ar, try ml.cut(gpa, try ml.readMat(gpa, &ck, prefix), cut));
+        }
+        inline for (.{ "aconv", "mconv" }, .{ "attention_conv", "mlp_conv" }, 7..) |f, cname, j| {
+            const prefix = try std.fmt.bufPrint(&pb, "layers.{d}.{s}", .{ i, dc.mat_names[j] });
+            @field(L, f).proj = try lin(gpa, ar, &ck, prefix, .{ .prefix = prefix });
+            if (@field(L, f).proj.n() != 2 * full.conv_k * (full.hidden / full.conv_g)) return error.ConvShape;
+            const bt = try ck.get(try std.fmt.bufPrint(&nb, "layers.{d}.{s}.base_kernel", .{ i, cname }));
+            if (bt.numel() != 2 * full.conv_k * full.hidden) return error.ConvShape;
+            @field(L, f).base = try f32Up(gpa, ar, bt);
+        }
+    }
+    // the mask rows: a shipped mask_embedding, else the target's (raw) embedding row of mask_token_id
+    if (ck.get("mask_embedding")) |t| {
+        dr.mask_emb = try f32Up(gpa, ar, t);
+    } else |_| {
+        const D = full.hidden;
+        const row = try gpa.alloc(u16, D);
+        defer gpa.free(row);
+        @memcpy(std.mem.sliceAsBytes(row), dr.m.w.embed_host[full.mask_id * D * 2 ..][0 .. D * 2]);
+        const f = try gpa.alloc(f32, D);
+        defer gpa.free(f);
+        for (row, f) |x, *o| o.* = @bitCast(@as(u32, x) << 16);
+        dr.mask_emb = try ar.upload(std.mem.sliceAsBytes(f));
+    }
+}
+
+/// The context caches, RoPE tables and draft-pass scratch on this rank.
+pub fn allocState(dr: *Drafter, s: Stream) !void {
+    const gpa = dr.gpa;
+    const ar = &dr.arena;
+    const m = dr.m;
+    const c = dr.c;
+    const D = c.hidden;
+    const L = dr.layers.len;
+    dr.kc = try gpa.alloc(u64, L);
+    errdefer gpa.free(dr.kc);
+    dr.vc = try gpa.alloc(u64, L);
+    errdefer gpa.free(dr.vc);
+    for (0..L) |i| {
+        dr.kc[i] = try ar.zeros(m.slots * dr.ring * c.kv_heads * 128 * 2);
+        dr.vc[i] = try ar.zeros(m.slots * dr.ring * c.kv_heads * 128 * 2);
+    }
+    const tlen = m.context + dr.block;
+    dr.cos = try ar.alloc(tlen * 64 * 4);
+    dr.sin = try ar.alloc(tlen * 64 * 4);
+    {
+        const f = try m.glue.function("muse_rope_tables");
+        var a: cuda.Args = .{};
+        a.add(dr.cos);
+        a.add(dr.sin);
+        a.add(ci(tlen));
+        a.add(c.theta);
+        a.add(ci(128));
+        try cuda.launch.launch(f, .{ .grid = .{ .x = 256, .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+    }
+    const R = m.rows;
+    const SB = dr.streams * dr.block;
+    const RR = @max(R, SB);
+    const S1 = dr.streams * (dr.block - 1);
+    const W = m.w.world;
+    const HQ = c.heads * 128;
+    const HK = c.kv_heads * 128;
+    const vr = m.w.head.n;
+    var max_z: usize = @max(Drafter.zBytes(dr.fc, R), Drafter.zBytes(m.w.head, S1));
+    for (dr.layers) |ly| {
+        inline for (.{ "q", "k", "v", "o", "gate", "up", "down" }) |f| max_z = @max(max_z, Drafter.zBytes(@field(ly, f), RR));
+        for ([_]Lin{ ly.aconv.proj, ly.mconv.proj }) |p| if (p == .q) {
+            max_z = @max(max_z, Drafter.zBytes(p.q, SB));
+        };
+    }
+    if (dr.sel == .q) max_z = @max(max_z, Drafter.zBytes(dr.sel.q, S1));
+    var b = &dr.b;
+    b.tapbuf = try ar.zeros(R * dr.taps.len * D * 2);
+    b.ctx16 = try ar.zeros(R * dr.fc.n * 2);
+    b.ctxg = if (W > 1) try ar.zeros(W * R * dr.fc.n * 2) else 0;
+    b.ctx = try ar.zeros(R * D * 2);
+    b.kb = try ar.zeros(RR * HK * 2);
+    b.vb = try ar.zeros(RR * HK * 2);
+    b.xh = try ar.zeros(RR * @max(dr.taps.len * D, @max(c.inter, HQ)) * 2);
+    b.z = try ar.zeros(@max(max_z, 4));
+    b.x32 = try ar.zeros(SB * D * 4);
+    b.h = try ar.zeros(SB * D * 2);
+    b.c16 = try ar.zeros(SB * D * 2);
+    b.dyn = try ar.zeros(SB * dr.layers[0].aconv.proj.n() * 2);
+    b.q16 = try ar.zeros(SB * HQ * 2);
+    b.q32 = try ar.zeros(SB * HQ * 4);
+    b.a = try ar.zeros(SB * HQ * 2);
+    b.part = try ar.zeros(SB * D * 4);
+    b.recv = if (W > 1) try ar.zeros(W * SB * D * 4) else 0;
+    b.gb = try ar.zeros(SB * c.inter * 2);
+    b.ub = try ar.zeros(SB * c.inter * 2);
+    b.mm = try ar.zeros(SB * c.inter * 2);
+    b.tk = try ar.zeros(S1 * D * 2);
+    b.head = try ar.zeros(S1 * vr * 4);
+    b.top = try ar.zeros(S1 * 32 * 4);
+    b.topg = if (W > 1) try ar.zeros(W * S1 * 32 * 4) else 0;
+    b.sg = try ar.zeros(S1 * c.sel_rank * 2);
+    b.am = try ar.zeros(S1 * 4);
+    b.in_tok = try ar.zeros(dr.streams * 8);
+    b.in_pos0 = try ar.zeros(dr.streams * 4);
+    b.in_slot = try ar.zeros(dr.streams * 4);
+    b.rpos = try ar.zeros(SB * 4);
+    b.rslot = try ar.zeros(SB * 4);
+    b.anc = try ar.zeros(dr.streams * D * 2);
+    {
+        var io_: [MAX_STREAMS]i64 = undefined;
+        for (&io_, 0..) |*x, j| x.* = @intCast(j);
+        b.anc_idx = try ar.upload(std.mem.sliceAsBytes(io_[0..dr.streams]));
+    }
+    dr.h_anc = try dr.gpa.alloc(u16, dr.streams * D);
+}
+
+pub fn near(a: f64, b: f64) bool {
+    return @abs(a - b) <= 1e-6 * @max(@abs(a), @abs(b));
+}
+
+pub fn readFile(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, name: []const u8) ![]u8 {
+    const path = try std.fs.path.join(gpa, &.{ dir, name });
+    defer gpa.free(path);
+    return std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 22));
+}
+
+fn f32Up(gpa: std.mem.Allocator, ar: *load_.Arena, t: core.safetensors.Tensor) !u64 {
+    const f = try ml.asF32(gpa, t);
+    defer gpa.free(f);
+    return ar.upload(std.mem.sliceAsBytes(f));
+}
+
+/// A replicated matrix: EXL3 when the pack quantised it, else its 16-bit rows (`{prefix}.weight`, [N, K]).
+fn lin(gpa: std.mem.Allocator, ar: *load_.Arena, ck: *core.Checkpoint, prefix: []const u8, cut: @import("config.zig").Cut) !Lin {
+    if (ml.readMat(gpa, ck, prefix)) |mat| {
+        return .{ .q = try ml.linear(gpa, ar, try ml.cut(gpa, mat, cut)) };
+    } else |_| {}
+    var nb: [192]u8 = undefined;
+    const t = try ck.get(try std.fmt.bufPrint(&nb, "{s}.weight", .{prefix}));
+    if (t.rank != 2 or (t.dtype != .bf16 and t.dtype != .f16)) return error.BadDenseMatrix;
+    return .{ .dense = .{ .w = try ar.upload(t.bytes), .n = t.shape[0], .k = t.shape[1], .bf16 = t.dtype == .bf16 } };
+}
+
+/// The selector codebooks: bare keys, or with `.weight` (older trainers), 16-bit.
+fn codebook(ck: *core.Checkpoint, key: []const u8) !core.safetensors.Tensor {
+    if (ck.get(key)) |t| return t else |_| {}
+    var nb: [128]u8 = undefined;
+    return ck.get(try std.fmt.bufPrint(&nb, "{s}.weight", .{key}));
+}
diff --git a/zig/src/families/muse_spark/draft_main.zig b/zig/src/families/muse_spark/draft_main.zig
new file mode 100644
index 00000000..9c36542b
--- /dev/null
+++ b/zig/src/families/muse_spark/draft_main.zig
@@ -0,0 +1,268 @@
+//! tf-muse dflash / drafted: the DFlash2 drafter's gates (docs/recipes/muse-spark.md), one GPU, a pair or TP=2.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const tp = @import("tp");
+const muse = @import("muse_spark");
+const Model = muse.forward.Model;
+const Row = muse.forward.Row;
+const Drafter = muse.dflash2.Drafter;
+
+pub const Mode = enum { dflash, drafted };
+pub const Knobs = struct { context: usize, n_greedy: usize, graphs: bool, max_layers: ?usize, rows_per: usize, dump_taps: bool };
+
+const Text = struct { name: []const u8, ids: []i32, out: std.ArrayList(i32) = .empty, plain: std.ArrayList(i32) = .empty };
+
+fn readAll(gpa: std.mem.Allocator, io: std.Io, path: []const u8) ![]u8 {
+    return std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 32));
+}
+fn writeAll(io: std.Io, path: []const u8, bytes: []const u8) !void {
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = path, .data = bytes });
+}
+
+const Ctx = struct {
+    gpa: std.mem.Allocator,
+    s: cuda.Stream,
+    model: *Model,
+    dr: *Drafter,
+    graphs: bool,
+    am: [muse.forward.DECODE_ROWS]i32 = undefined,
+
+    fn fwd(c: *Ctx, rows: []const Row) !void {
+        if (c.graphs) try c.model.graphed(c.s, rows, null) else try c.model.forward(c.s, rows, null, null);
+        try c.model.argmaxTo(c.s, rows.len, c.am[0..rows.len]);
+    }
+};
+
+/// One rank's run of `mode`: load the target and the drafter, every text, rank 0 writes OUT_DIR.
+pub fn run(mode: Mode, gpa: std.mem.Allocator, ar: std.mem.Allocator, io: std.Io, driver: *const cuda.Driver, args: []const [:0]const u8, rank: usize, world: usize, comm: ?tp.Collective, kn: Knobs) !void {
+    var s = try cuda.Stream.init(driver, false);
+    defer s.deinit();
+    var w = try muse.load.load(gpa, io, driver, args[2], rank, world, .{ .max_layers = kn.max_layers, .log = rank == 0 });
+    defer w.deinit();
+    var k3 = try muse.exl3.Kernels.load(driver);
+    defer k3.deinit();
+    var texts: std.ArrayList(Text) = .empty;
+    const names_text = try readAll(ar, io, try std.fs.path.join(ar, &.{ args[3], "names.txt" }));
+    var it = std.mem.tokenizeAny(u8, names_text, " \r\n\t");
+    while (it.next()) |name| {
+        const raw = try readAll(ar, io, try std.fmt.allocPrint(ar, "{s}/{s}.ids", .{ args[3], name }));
+        const ids = try ar.alloc(i32, raw.len / 4);
+        @memcpy(std.mem.sliceAsBytes(ids), raw[0 .. ids.len * 4]);
+        if (ids.len + kn.n_greedy + 16 > kn.context) return error.TextTooLong;
+        try texts.append(ar, .{ .name = name, .ids = ids });
+    }
+    const slots = if (mode == .drafted) @min(texts.items.len, muse.dflash2.MAX_STREAMS) else 1;
+    if (mode == .drafted and texts.items.len > slots) return error.TooManyTexts;
+    var model = try Model.init(gpa, driver, &w, &k3, comm, kn.context, muse.forward.DECODE_ROWS, slots, s);
+    defer model.deinit();
+    const ddir = try muse.engine.drafterDir(ar, args[2], if (std.c.getenv("TF_MUSE_DRAFTER")) |v| std.mem.span(v) else null);
+    var tb: [8]usize = undefined;
+    const dr = try Drafter.init(gpa, io, &model, ddir, s, kn.graphs, try tapsOverride(&tb));
+    defer dr.deinit();
+    model.dr = dr;
+    std.debug.print("[draft] rank {d}/{d}: target {d} layers ({d:.1} GiB), drafter {s} ({d:.2} GiB, taps {any}), {d} slots, {s}\n", .{ rank, world, w.layers.len, @as(f64, @floatFromInt(w.arena.total)) / (1 << 30), ddir, @as(f64, @floatFromInt(dr.bytes())) / (1 << 30), dr.taps, slots, if (kn.graphs) "graphed" else "eager" });
+    var c: Ctx = .{ .gpa = gpa, .s = s, .model = &model, .dr = dr, .graphs = kn.graphs };
+    switch (mode) {
+        .dflash => for (texts.items) |*t| try fixedProtocol(&c, ar, io, args[4], t, w.full, kn, rank == 0),
+        .drafted => try drafted(&c, ar, io, args[4], texts.items, w.full, kn, rank == 0),
+    }
+    std.debug.print("DONE {s} rank {d}\n", .{ @tagName(mode), rank });
+}
+
+/// The fixed protocol for one text (slot 0): the prompt a row at a time, then greedy steps that draft first.
+fn fixedProtocol(c: *Ctx, ar: std.mem.Allocator, io: std.Io, out_dir: []const u8, t: *Text, cfg: muse.Config, kn: Knobs, write: bool) !void {
+    const dr = c.dr;
+    const P = dr.block - 1;
+    const NT = dr.taps.len;
+    const D = cfg.hidden;
+    const T = t.ids.len;
+    var taps: std.ArrayList(u16) = .empty;
+    var drafts: std.ArrayList(i32) = .empty;
+    var seq: std.ArrayList(i32) = .empty;
+    try seq.appendSlice(ar, t.ids);
+    const row_buf = try ar.alloc(u16, NT * D);
+    var pending: i32 = 0;
+    for (0..T + kn.n_greedy) |j| {
+        if (j >= T) { // a greedy step: draft from the pending token at position j, then feed it
+            var out: [16]i32 = undefined;
+            try dr.draft(c.s, &.{pending}, &.{@intCast(j)}, &.{0}, &out);
+            try drafts.appendSlice(ar, out[0..P]);
+            try seq.append(ar, pending);
+        }
+        const tok: i32 = if (j < T) t.ids[j] else pending;
+        try c.fwd(&.{.{ .slot = 0, .pos = @intCast(j), .token = tok }});
+        if (kn.dump_taps) {
+            try c.s.synchronize();
+            try c.model.d.check(c.model.d.api.cuMemcpyDtoH_v2(@ptrCast(row_buf.ptr), dr.b.tapbuf, NT * D * 2), "taps");
+            try taps.appendSlice(ar, row_buf);
+        }
+        pending = c.am[0];
+        if (j >= T and cfg.isEos(@intCast(tok))) break;
+    }
+    const G = seq.items.len - T;
+    var acc_sum: usize = 0;
+    var hist: [17]usize = @splat(0);
+    for (0..G) |i| {
+        var a: usize = 0;
+        while (a < P and T + i + 1 + a < seq.items.len and drafts.items[i * P + a] == seq.items[T + i + 1 + a]) a += 1;
+        acc_sum += a;
+        hist[a] += 1;
+    }
+    std.debug.print("[dflash] {s}: prompt {d}, greedy {d}, mean accepted {d:.3} of {d} (counts by accepted {any})\n", .{ t.name, T, G, @as(f64, @floatFromInt(acc_sum)) / @as(f64, @floatFromInt(@max(G, 1))), P, hist[0 .. P + 1] });
+    if (!write) return;
+    try writeAll(io, try std.fmt.allocPrint(ar, "{s}/{s}.seq.i32", .{ out_dir, t.name }), std.mem.sliceAsBytes(seq.items));
+    try writeAll(io, try std.fmt.allocPrint(ar, "{s}/{s}.drafts.i32", .{ out_dir, t.name }), std.mem.sliceAsBytes(drafts.items));
+    if (kn.dump_taps) try writeAll(io, try std.fmt.allocPrint(ar, "{s}/{s}.taps.f16", .{ out_dir, t.name }), std.mem.sliceAsBytes(taps.items));
+}
+
+/// Prompts of every slot in windows of up to rows_per rows a slot; each slot's first greedy token.
+fn prefill(c: *Ctx, texts: []Text, rows_per: usize, first: []i32) !void {
+    var fed: [muse.dflash2.MAX_STREAMS]usize = @splat(0);
+    var rows: [muse.forward.DECODE_ROWS]Row = undefined;
+    var last: [muse.dflash2.MAX_STREAMS]usize = undefined;
+    const per = @min(rows_per, muse.forward.DECODE_ROWS / texts.len);
+    while (true) {
+        var n: usize = 0;
+        var who: [muse.dflash2.MAX_STREAMS]bool = @splat(false);
+        for (texts, 0..) |t, j| if (fed[j] < t.ids.len) {
+            const k = @min(per, t.ids.len - fed[j]);
+            for (0..k) |q| rows[n + q] = .{ .slot = @intCast(j), .pos = @intCast(fed[j] + q), .token = t.ids[fed[j] + q] };
+            n += k;
+            fed[j] += k;
+            last[j] = n - 1;
+            who[j] = fed[j] == t.ids.len;
+        };
+        if (n == 0) break;
+        try c.fwd(rows[0..n]);
+        for (0..texts.len) |j| if (who[j]) {
+            first[j] = c.am[last[j]];
+        };
+    }
+}
+
+/// Plain greedy, then the speculative loop on the same slots; every reply must be byte-identical.
+fn drafted(c: *Ctx, ar: std.mem.Allocator, io: std.Io, out_dir: []const u8, texts: []Text, cfg: muse.Config, kn: Knobs, write: bool) !void {
+    const S = texts.len;
+    const B = c.dr.block;
+    const MS = muse.dflash2.MAX_STREAMS;
+    var first: [MS]i32 = undefined;
+    var rows: [muse.forward.DECODE_ROWS]Row = undefined;
+    // plain: one row a slot a window
+    try prefill(c, texts, kn.rows_per, &first);
+    var pend: [MS]i32 = undefined;
+    var pos: [MS]usize = undefined;
+    var live: [MS]bool = @splat(true);
+    for (texts, 0..) |*t, j| {
+        pend[j] = first[j];
+        pos[j] = t.ids.len;
+        try t.plain.append(ar, first[j]);
+        live[j] = !cfg.isEos(@intCast(first[j])) and kn.n_greedy > 1;
+    }
+    while (true) {
+        var n: usize = 0;
+        var at: [MS]usize = undefined;
+        for (0..S) |j| if (live[j]) {
+            rows[n] = .{ .slot = @intCast(j), .pos = @intCast(pos[j]), .token = pend[j] };
+            at[j] = n;
+            n += 1;
+        };
+        if (n == 0) break;
+        try c.fwd(rows[0..n]);
+        for (texts, 0..) |*t, j| if (live[j]) {
+            pend[j] = c.am[at[j]];
+            pos[j] += 1;
+            try t.plain.append(ar, pend[j]);
+            if (t.plain.items.len >= kn.n_greedy or cfg.isEos(@intCast(pend[j]))) live[j] = false;
+        };
+    }
+    // speculative: draft, verify [pending, drafts] of every live slot in one window, accept while equal
+    try prefill(c, texts, kn.rows_per, &first);
+    var rounds: usize = 0;
+    var drafted_rows: usize = 0;
+    var accepted: usize = 0;
+    var stream_rounds: usize = 0;
+    var new_tokens: usize = 0;
+    for (texts, 0..) |*t, j| {
+        pend[j] = first[j];
+        pos[j] = t.ids.len;
+        try t.out.append(ar, first[j]);
+        live[j] = !cfg.isEos(@intCast(first[j])) and kn.n_greedy > 1;
+    }
+    while (true) {
+        var toks: [MS]i64 = undefined;
+        var p0: [MS]u32 = undefined;
+        var sl: [MS]u32 = undefined;
+        var idx: [MS]usize = undefined;
+        var m: usize = 0;
+        for (0..S) |j| if (live[j]) {
+            toks[m] = pend[j];
+            p0[m] = @intCast(pos[j]);
+            sl[m] = @intCast(j);
+            idx[m] = j;
+            m += 1;
+        };
+        if (m == 0) break;
+        var dout: [MS * 16]i32 = undefined;
+        try c.dr.draft(c.s, toks[0..m], p0[0..m], sl[0..m], &dout);
+        var n: usize = 0;
+        var at: [MS]usize = undefined;
+        var width: [MS]usize = undefined;
+        for (0..m) |q| {
+            const j = idx[q];
+            const left = kn.n_greedy - texts[j].out.items.len;
+            width[q] = @min(B, left);
+            at[q] = n;
+            for (0..width[q]) |r| rows[n + r] = .{ .slot = @intCast(j), .pos = @intCast(pos[j] + r), .token = if (r == 0) pend[j] else dout[q * (B - 1) + r - 1] };
+            n += width[q];
+        }
+        try c.fwd(rows[0..n]);
+        rounds += 1;
+        stream_rounds += m;
+        for (0..m) |q| {
+            const j = idx[q];
+            const t = &texts[j];
+            var a: usize = 0;
+            while (a + 1 < width[q] and dout[q * (B - 1) + a] == c.am[at[q] + a]) a += 1;
+            drafted_rows += width[q] - 1;
+            accepted += a;
+            for (0..a + 1) |k| {
+                const tok = c.am[at[q] + k];
+                try t.out.append(ar, tok);
+                new_tokens += 1;
+                if (t.out.items.len >= kn.n_greedy or cfg.isEos(@intCast(tok))) {
+                    live[j] = false;
+                    break;
+                }
+            }
+            pend[j] = t.out.items[t.out.items.len - 1];
+            pos[j] += a + 1;
+        }
+    }
+    var pass = true;
+    for (texts) |t| {
+        const same = std.mem.eql(i32, t.plain.items, t.out.items);
+        pass = pass and same;
+        var first_diff: usize = 0;
+        while (first_diff < @min(t.plain.items.len, t.out.items.len) and t.plain.items[first_diff] == t.out.items[first_diff]) first_diff += 1;
+        std.debug.print("[drafted] {s}: plain {d} tokens, drafted {d}: {s}", .{ t.name, t.plain.items.len, t.out.items.len, if (same) "identical\n" else "DIFFER\n" });
+        if (!same) std.debug.print(" at token {d}\n", .{first_diff});
+        if (write) {
+            try writeAll(io, try std.fmt.allocPrint(ar, "{s}/{s}.plain.i32", .{ out_dir, t.name }), std.mem.sliceAsBytes(t.plain.items));
+            try writeAll(io, try std.fmt.allocPrint(ar, "{s}/{s}.drafted.i32", .{ out_dir, t.name }), std.mem.sliceAsBytes(t.out.items));
+        }
+    }
+    std.debug.print("[drafted] {d} streams, {d} rounds, accepted {d} / drafted {d} ({d:.3}), {d:.2} tokens a stream-round: {s}\n", .{ S, rounds, accepted, drafted_rows, @as(f64, @floatFromInt(accepted)) / @as(f64, @floatFromInt(@max(drafted_rows, 1))), @as(f64, @floatFromInt(new_tokens)) / @as(f64, @floatFromInt(@max(stream_rounds, 1))), if (pass) "PASS" else "FAIL" });
+}
+
+/// TF_MUSE_DRAFT_TAPS=a,b,..: tap these target layers instead of the drafter's (plumbing checks on k-layer packs).
+fn tapsOverride(buf: []usize) !?[]const usize {
+    const v = std.mem.span(std.c.getenv("TF_MUSE_DRAFT_TAPS") orelse return null);
+    var n: usize = 0;
+    var it = std.mem.tokenizeScalar(u8, v, ',');
+    while (it.next()) |t| : (n += 1) {
+        if (n == buf.len) return error.TooManyTaps;
+        buf[n] = try std.fmt.parseInt(usize, t, 10);
+    }
+    return buf[0..n];
+}
diff --git a/zig/src/families/muse_spark/engine.zig b/zig/src/families/muse_spark/engine.zig
new file mode 100644
index 00000000..36dca068
--- /dev/null
+++ b/zig/src/families/muse_spark/engine.zig
@@ -0,0 +1,200 @@
+//! Muse Spark's engine on one rank: the model, its DFlash2 drafter (opt-in) and the plan-link steps rank 0 sends.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const tp = @import("tp");
+const load_ = @import("load.zig");
+const fwd = @import("forward.zig");
+const dflash2 = @import("dflash2.zig");
+const prompt_ = @import("prompt.zig");
+const kept = @import("kept.zig");
+const exl3 = @import("exl3.zig");
+
+/// The plan link's words: one GPU step each, executed by every rank in order.
+pub const Op = enum(i64) { hello = 0x3A5E, forward = 1, draft = 2, stop = 3, prompt = 4, cache = 5 };
+
+/// What rank 0 announces first so every rank builds the same model (the prompt path's chunking is prompt.zig's).
+pub const Setup = struct { context: usize, slots: usize, drafts: bool = false };
+
+const hello_version = 9;
+
+/// The hello words: [hello, version, context, slots, drafts].
+pub fn hello(su: Setup) [5]i64 {
+    return .{ @backingInt(Op.hello), hello_version, @intCast(su.context), @intCast(su.slots), @intFromBool(su.drafts) };
+}
+
+/// The setup a follower reads from rank 0's hello; another build's hello is refused.
+pub fn setupOf(words: []const i64) !Setup {
+    if (words.len < 2 or words[0] != @backingInt(Op.hello)) return error.NoHello;
+    if (words[1] != hello_version or words.len != 5) return error.OtherBuild;
+    return .{ .context = @intCast(words[2]), .slots = @intCast(words[3]), .drafts = words[4] != 0 };
+}
+
+/// The drafter pack: `given` (the same path on every rank), else `<pack>/dflash2`.
+pub fn drafterDir(gpa: std.mem.Allocator, pack: []const u8, given: ?[]const u8) ![]u8 {
+    if (given) |g| return gpa.dupe(u8, g);
+    return std.fmt.allocPrint(gpa, "{s}/dflash2", .{pack});
+}
+
+/// The model, its kernels and the TP session: what rank 0 serves and rank 1 follows.
+pub const Engine = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    w: load_.Weights,
+    k3: exl3.Kernels,
+    model: fwd.Model,
+    dr: ?*dflash2.Drafter = null,
+    pr: ?*prompt_.Prompt = null,
+    session: ?*tp.Session = null,
+    s: cuda.Stream,
+    logits: []f32, // [DECODE_ROWS, V] host
+    ids: [fwd.DECODE_ROWS]i32 = undefined, // device argmax of each row (Want.ids)
+    words: std.ArrayList(i64) = .empty,
+    copies: kept.Copies = undefined, // kept prompt states' windows (kept.zig), on every rank
+
+    /// Load everything on this rank; `session` null on one GPU, `drafter` null: `<pack>/dflash2` (with su.drafts).
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, su: Setup, session: ?*tp.Session, drafter: ?[]const u8) !*Engine {
+        const e = try gpa.create(Engine);
+        errdefer gpa.destroy(e);
+        e.* = .{ .gpa = gpa, .d = d, .w = undefined, .k3 = undefined, .model = undefined, .s = undefined, .logits = &.{}, .session = session };
+        const rank: usize = if (session) |ss| ss.cfg.rank else 0;
+        const world: usize = if (session) |ss| ss.cfg.world else 1;
+        e.s = try cuda.Stream.init(d, false);
+        errdefer e.s.deinit();
+        e.w = try load_.load(gpa, io, d, dir, rank, world, .{ .log = rank == 0 });
+        errdefer e.w.deinit();
+        e.k3 = try exl3.Kernels.load(d);
+        errdefer e.k3.deinit();
+        const comm = if (session) |ss| ss.comm() else null;
+        e.model = try fwd.Model.init(gpa, d, &e.w, &e.k3, comm, su.context, fwd.DECODE_ROWS, su.slots, e.s);
+        errdefer e.model.deinit();
+        if (su.drafts) {
+            const ddir = try drafterDir(gpa, dir, drafter);
+            defer gpa.free(ddir);
+            e.dr = try dflash2.Drafter.init(gpa, io, &e.model, ddir, e.s, true, null);
+            e.model.dr = e.dr;
+            if (rank == 0) std.log.info("muse drafter: {s}, block {d}, {d:.2} GiB on this rank (split over {d})", .{ ddir, e.dr.?.block, @as(f64, @floatFromInt(e.dr.?.bytes())) / (1 << 30), world });
+        }
+        errdefer if (e.dr) |dr| dr.deinit();
+        e.pr = try prompt_.Prompt.init(&e.model, gpa, prompt_.CAP, prompt_.EWIN, e.s);
+        if (rank == 0) std.log.info("muse prompt path: chunks of {d} rows, experts in {d}-row windows, {d:.2} GiB scratch", .{ e.pr.?.cap, e.pr.?.ewin, @as(f64, @floatFromInt(e.pr.?.bytes())) / (1 << 30) });
+        errdefer if (e.pr) |pr| pr.deinit();
+        e.copies = try kept.Copies.init(gpa, &e.model, e.dr);
+        errdefer e.copies.deinit();
+        e.logits = try gpa.alloc(f32, fwd.DECODE_ROWS * e.w.full.vocab);
+        return e;
+    }
+
+    pub fn deinit(e: *Engine) void {
+        const gpa = e.gpa;
+        e.words.deinit(gpa);
+        gpa.free(e.logits);
+        e.copies.deinit();
+        if (e.pr) |pr| pr.deinit();
+        if (e.dr) |dr| dr.deinit();
+        e.model.deinit();
+        e.k3.deinit();
+        e.w.deinit();
+        e.s.deinit();
+        gpa.destroy(e);
+    }
+
+    fn send(e: *Engine, words: []const i64) !void {
+        if (e.session) |ss| try ss.plan.send(words);
+    }
+
+    pub const Want = enum { none, ids, logits };
+
+    /// A graphed forward window on every rank; on rank 0 `ids` leaves each row's argmax in `ids`, `logits` [n, V].
+    pub fn forward(e: *Engine, rows: []const fwd.Row, want: Want) !void {
+        e.words.clearRetainingCapacity();
+        try e.words.appendSlice(e.gpa, &.{ @backingInt(Op.forward), @intCast(rows.len) });
+        for (rows) |r| try e.words.appendSlice(e.gpa, &.{ r.slot, r.pos, r.token });
+        try e.send(e.words.items);
+        try e.model.graphed(e.s, rows, if (want == .logits) e.logits[0 .. rows.len * e.w.full.vocab] else null);
+        if (want == .ids) try e.model.argmaxTo(e.s, rows.len, e.ids[0..rows.len]);
+    }
+
+    /// A prompt chunk on every rank: `tokens` at [p0, p0 + n) of `slot`; the last row's argmax or logits.
+    pub fn prompt(e: *Engine, slot: u32, p0: usize, tokens: []const i64, want: Want) !void {
+        const pr = e.pr orelse return error.NoPromptPath;
+        e.words.clearRetainingCapacity();
+        try e.words.appendSlice(e.gpa, &.{ @backingInt(Op.prompt), @intCast(tokens.len), slot, @intCast(p0) });
+        try e.words.appendSlice(e.gpa, tokens);
+        try e.send(e.words.items);
+        try pr.chunk(e.s, slot, p0, tokens);
+        switch (want) {
+            .none => try e.s.synchronize(),
+            .ids => try e.model.argmaxTo(e.s, 1, e.ids[0..1]),
+            .logits => try e.model.logitsTo(e.s, 1, e.logits[0..e.w.full.vocab]),
+        }
+    }
+
+    /// A draft pass on every rank: drafts [S, block - 1] into `out` (each stream's anchor token, position, slot).
+    pub fn draft(e: *Engine, tokens: []const i64, pos0: []const u32, slots: []const u32, out: []i32) !void {
+        e.words.clearRetainingCapacity();
+        try e.words.appendSlice(e.gpa, &.{ @backingInt(Op.draft), @intCast(tokens.len) });
+        for (tokens, pos0, slots) |t, p, s| try e.words.appendSlice(e.gpa, &.{ t, p, s });
+        try e.send(e.words.items);
+        try e.dr.?.draft(e.s, tokens, pos0, slots, out);
+    }
+
+    /// A kept state's step on every rank (kept.zig: save, restore, copy prefix, drop); rank 0 sends it first.
+    pub fn cache(e: *Engine, kind: kept.Kind, id: u64, slot: u32, slot2: u32, at: usize) !void {
+        try e.send(&kept.words(@backingInt(Op.cache), kind, id, slot, slot2, at));
+        switch (kind) {
+            .save => try e.copies.save(e.s, id, slot),
+            .restore => try e.copies.restore(e.s, id, slot),
+            .copy => try e.copies.copyPrefix(e.s, slot, slot2, at),
+            .drop => e.copies.drop(id),
+        }
+    }
+
+    /// One step from the plan link, on a follower; false at stop.
+    pub fn follow(e: *Engine, words: []const i64) !bool {
+        if (words.len < 2) return error.ShortPlan;
+        const op: Op = @fromBackingInt(@intCast(words[0]));
+        const n: usize = @intCast(words[1]);
+        switch (op) {
+            .forward => {
+                if (words.len != 2 + 3 * n or n > fwd.DECODE_ROWS) return error.BadPlan;
+                var rows: [fwd.DECODE_ROWS]fwd.Row = undefined;
+                for (0..n) |i| rows[i] = .{ .slot = @intCast(words[2 + 3 * i]), .pos = @intCast(words[3 + 3 * i]), .token = words[4 + 3 * i] };
+                try e.model.graphed(e.s, rows[0..n], null);
+            },
+            .draft => {
+                if (words.len != 2 + 3 * n or n > dflash2.MAX_STREAMS) return error.BadPlan;
+                const dr = e.dr orelse return error.NoDrafter;
+                var t: [dflash2.MAX_STREAMS]i64 = undefined;
+                var p: [dflash2.MAX_STREAMS]u32 = undefined;
+                var sl: [dflash2.MAX_STREAMS]u32 = undefined;
+                var out: [dflash2.MAX_STREAMS * 16]i32 = undefined;
+                for (0..n) |i| {
+                    t[i] = words[2 + 3 * i];
+                    p[i] = @intCast(words[3 + 3 * i]);
+                    sl[i] = @intCast(words[4 + 3 * i]);
+                }
+                try dr.draft(e.s, t[0..n], p[0..n], sl[0..n], &out);
+            },
+            .prompt => {
+                const pr = e.pr orelse return error.NoPromptPath;
+                if (words.len != 4 + n or n > pr.cap) return error.BadPlan;
+                try pr.chunk(e.s, @intCast(words[2]), @intCast(words[3]), words[4..]);
+                try e.s.synchronize();
+            },
+            .cache => try e.copies.follow(e.s, words),
+            .stop => return false,
+            .hello => return error.LateHello,
+        }
+        return true;
+    }
+};
+
+test "the hello carries the setup, and another build's is refused" {
+    const su: Setup = .{ .context = 131072, .slots = 4, .drafts = true };
+    try std.testing.expectEqual(su, try setupOf(&hello(su)));
+    const plain: Setup = .{ .context = 65536, .slots = 2 };
+    try std.testing.expectEqual(plain, try setupOf(&hello(plain)));
+    try std.testing.expectError(error.OtherBuild, setupOf(&.{ @backingInt(Op.hello), 7, 65536, 2, 0, 1024, 512, 1, 0 }));
+    try std.testing.expectError(error.NoHello, setupOf(&.{ 3, 0 }));
+}
diff --git a/zig/src/families/muse_spark/exl3.zig b/zig/src/families/muse_spark/exl3.zig
new file mode 100644
index 00000000..53a28c4c
--- /dev/null
+++ b/zig/src/families/muse_spark/exl3.zig
@@ -0,0 +1,205 @@
+//! Muse Spark's EXL3 layers on the shared operators (cuda.exl3 Linear, cuda.exl3_experts) plus its 32-member tiles.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const shared = cuda.exl3;
+const sx = cuda.exl3_experts;
+const launch_ = cuda.launch;
+
+const Driver = cuda.Driver;
+const Module = cuda.Module;
+const Function = cuda.Function;
+const Stream = cuda.Stream;
+const Args = cuda.Args;
+
+pub const DType = shared.DType;
+pub const Scratch = sx.Scratch;
+
+/// (K splits, warps a program) for a K x N layer: the shared linear's plan, the shape's alone.
+pub fn plan(k: usize, n: usize) [2]usize {
+    const p = shared.plan(k, n, 192, 8);
+    return .{ p.sk, p.wk };
+}
+
+/// One EXL3 linear layer in the strips layout ([N/128, K/16, 8, 4 * K2] words), mul1 codebook.
+pub const Linear = struct {
+    words: u64,
+    suh: u64, // fp16 [K]
+    svh: u64, // fp16 [N]
+    bias: u64 = 0, // fp16 [N] or 0
+    counters: u64, // int32 [8 * N / 128], zeroed once (the split tickets)
+    k: usize,
+    n: usize,
+    k2: u32,
+    split: [2]usize, // plan(k, n)
+
+    /// (words between k tiles, words between 128-column blocks) of the strips layout.
+    pub fn strides(l: Linear) [2]i64 {
+        const st = shared.strides(l.k, l.n, l.k2, true);
+        return .{ @intCast(st.k), @intCast(st.nb) };
+    }
+
+    /// The shared linear's view of this layer.
+    pub fn weight(l: Linear) shared.Weight {
+        const st = shared.strides(l.k, l.n, l.k2, true);
+        return .{ .trellis = l.words, .suh = l.suh, .svh = l.svh, .bias = l.bias, .k = @intCast(l.k), .n = @intCast(l.n), .halves = l.k2, .codebook = .mul1, .stride_k = st.k, .stride_nb = st.nb };
+    }
+};
+
+/// One layer's routed experts: device tables of trellis pointers and widths, stacked scales.
+pub const Experts = struct {
+    gate_ptr: u64, // int64 [E]
+    up_ptr: u64,
+    down_ptr: u64,
+    gate_k2: u64, // int32 [E]
+    up_k2: u64,
+    down_k2: u64,
+    suh_g: u64, // fp16 [E, D]
+    suh_u: u64,
+    svh_g: u64, // fp16 [E, I]
+    svh_u: u64,
+    suh_d: u64, // fp16 [E, I]
+    svh_d: u64, // fp16 [E, D]
+    count: usize, // E
+    dims: usize, // D
+    width: usize, // I (this rank's)
+    k2_gu: [2]u32, // (min, max) over gate and up
+    k2_d: [2]u32,
+    host_ptr: []const u64 = &.{}, // [gate E, up E, down E]
+    host_k2: []const i32 = &.{},
+
+    /// The shared experts' view: mul1, the fp32 SwiGLU (act_mode 1), no clamp.
+    pub fn layer(x: Experts) sx.Layer {
+        return .{ .gate = x.gate_ptr, .up = x.up_ptr, .down = x.down_ptr, .gate_k2 = x.gate_k2, .up_k2 = x.up_k2, .down_k2 = x.down_k2, .suh_g = x.suh_g, .suh_u = x.suh_u, .svh_g = x.svh_g, .svh_u = x.svh_u, .suh_d = x.suh_d, .svh_d = x.svh_d, .experts = x.count, .dims = x.dims, .width = x.width, .codebook = .mul1, .limit = 0, .act_mode = 1 };
+    }
+};
+
+/// The scratch parts' bytes for `rows` rows of `slots` slots (the shared scratch's, without its alignment).
+pub const Sizes = struct { xg: usize, xd: usize, z: usize, y: usize, ids: usize, members: usize };
+
+pub fn sizes(e: Experts, rows: usize, slots: usize) !Sizes {
+    const g_sk = try sx.plan(e.dims, e.width, true);
+    const d_sk = try sx.plan(e.width, e.dims, false);
+    const p = rows * slots;
+    const maxu = @min(p, e.count);
+    return .{ .xg = p * e.dims * 2, .xd = p * e.width * 2, .z = @max(2 * g_sk * e.width, d_sk * e.dims) * p * 4, .y = p * e.dims * 4, .ids = maxu * 4, .members = maxu * rows * 4 };
+}
+
+pub const Kernels = struct {
+    lin: shared.Linear,
+    ex: sx.Experts,
+    x2: Module, // experts2.cu: muse_grouped2
+    f_x2: Function,
+
+    pub fn load(d: *const Driver) !Kernels {
+        if (!cuda.kernels.available) return error.KernelsNotBuilt;
+        var k: Kernels = undefined;
+        k.lin = try shared.Linear.load(d);
+        errdefer k.lin.unload();
+        k.ex = try sx.Experts.load(d);
+        errdefer k.ex.unload();
+        k.x2 = try Module.load(d, cuda.kernels.muse_experts2);
+        errdefer k.x2.unload();
+        k.f_x2 = try k.x2.function("muse_grouped2");
+        return k;
+    }
+
+    pub fn deinit(k: *Kernels) void {
+        k.x2.unload();
+        k.ex.unload();
+        k.lin.unload();
+    }
+
+    /// xh (m, K) fp16 = Hadamard-rotated x * suh (the shared tf_exl3_rot_in).
+    pub fn rotIn(k: *const Kernels, s: Stream, x: u64, x_dtype: DType, suh: u64, xh: u64, m: usize, kk: usize) !void {
+        var a: Args = .{};
+        a.add(x);
+        a.add(suh);
+        a.add(xh);
+        a.add(@as(i32, @backingInt(x_dtype)));
+        a.add(@as(i32, @intCast(m)));
+        a.add(@as(i32, @intCast(kk)));
+        try launch_.launch(k.lin.rot_in, .{ .grid = .{ .x = u((kk / 128 + 3) / 4), .y = u(m), .z = 1 }, .block = .{ .x = 128, .y = 1, .z = 1 } }, s, &a);
+    }
+
+    /// y (m, N) = x @ W * svh (+ bias) through the shared linear; z: fp32 split partials when the plan splits K.
+    pub fn linear(k: *const Kernels, s: Stream, l: Linear, x: u64, x_dtype: DType, xh: u64, y: u64, y_dtype: DType, z: u64, m: usize) !void {
+        try k.lin.matmul(s, l.weight(), x, x_dtype, m, y, y_dtype, xh, z, l.counters);
+    }
+
+    /// The routed experts' per-slot fp32 outputs in sc.y [rows * slots, D] (shared runSlots; x fp16).
+    pub fn routed(k: *const Kernels, s: Stream, e: Experts, x: u64, x_stride: usize, pick: u64, rows: usize, sc: Scratch) !void {
+        try k.ex.runSlots(s, e.layer(), x, x_stride, .f16, pick, rows, sc);
+    }
+
+    /// routed() with the grouped GEMMs in 32-member tiles (wide windows): the same launches and bits otherwise.
+    pub fn routedWide(k: *const Kernels, s: Stream, e: Experts, x: u64, x_stride: usize, pick: u64, rows: usize, sc: Scratch) !void {
+        const l = e.layer();
+        const d, const w, const slots = .{ l.dims, l.width, sc.slots };
+        if (rows < 1 or rows > sc.rows or slots > 32) return error.WindowTooWide;
+        const g_sk = try sx.plan(d, w, true);
+        const d_sk = try sx.plan(w, d, false);
+        const p = rows * slots;
+        const maxu = @min(p, l.experts);
+        {
+            var a: Args = .{};
+            inline for (.{ pick, sc.ids, sc.count, sc.members }) |v| a.add(v);
+            inline for (.{ rows, slots, l.experts, rows }) |v| a.add(int(v));
+            try launch_.launch(k.ex.group, .{ .grid = .{ .x = 1, .y = 1, .z = 1 }, .block = .{ .x = 1024, .y = 1, .z = 1 }, .shared = u(rows * slots * 4) }, s, &a);
+        }
+        {
+            var a: Args = .{};
+            a.add(x);
+            a.add(int(x_stride));
+            a.add(@as(i32, @backingInt(DType.f16)));
+            inline for (.{ pick, l.suh_g, l.suh_u, sc.xg, sc.xu }) |v| a.add(v);
+            inline for (.{ d, slots, l.experts }) |v| a.add(int(v));
+            try launch_.launch(k.ex.rot_in, .{ .grid = .{ .x = u(p), .y = u(d / 128), .z = 2 }, .block = .{ .x = 32, .y = 1, .z = 1 } }, s, &a);
+        }
+        try k.grouped2(s, .{ sc.xg, sc.xu, l.gate, l.up, l.gate_k2, l.up_k2 }, sc, d, w, p, g_sk, rows, maxu, 2);
+        {
+            var a: Args = .{};
+            inline for (.{ sc.z, pick, l.svh_g, l.svh_u, l.suh_d, sc.xd }) |v| a.add(v);
+            inline for (.{ p, w, g_sk, l.experts }) |v| a.add(int(v));
+            a.add(l.limit);
+            a.add(l.act_mode);
+            try launch_.launch(k.ex.gateup, .{ .grid = .{ .x = u(p), .y = u(w / 128), .z = 1 }, .block = .{ .x = 32, .y = 1, .z = 1 } }, s, &a);
+        }
+        try k.grouped2(s, .{ sc.xd, sc.xd, l.down, l.down, l.down_k2, l.down_k2 }, sc, w, d, p, d_sk, rows, maxu, 1);
+        {
+            var a: Args = .{};
+            inline for (.{ sc.z, pick, l.svh_d, sc.y, @as(u64, 0), @as(u64, 0) }) |v| a.add(v);
+            inline for (.{ p, d, d_sk, l.experts, slots }) |v| a.add(int(v));
+            try launch_.launch(k.ex.down_combine, .{ .grid = .{ .x = u(rows), .y = u(d / 128), .z = 1 }, .block = .{ .x = u(32 * slots), .y = 1, .z = 1 } }, s, &a);
+        }
+    }
+
+    /// muse_grouped2 over (x0, x1, trellis tables 0 / 1, width tables 0 / 1): grid z = mats * sk * member tiles of 32.
+    fn grouped2(k: *const Kernels, s: Stream, t: [6]u64, sc: Scratch, kk: usize, n: usize, p: usize, sk: usize, maxm: usize, maxu: usize, mats: usize) !void {
+        if (kk % (16 * sk * 4) != 0 or n % 128 != 0) return error.UnevenSplit;
+        var a: Args = .{};
+        inline for (0..6) |i| a.add(t[i]);
+        inline for (.{ sc.ids, sc.count, sc.members, sc.z }) |v| a.add(v);
+        inline for (.{ kk, n, p, sk, maxm, sc.slots }) |v| a.add(int(v));
+        try launch_.launch(k.f_x2, .{ .grid = .{ .x = u(maxu), .y = u(n / 128), .z = u(mats * sk * ((maxm + 31) / 32)) }, .block = .{ .x = 128, .y = 1, .z = 1 } }, s, &a);
+    }
+};
+
+fn int(x: usize) i32 {
+    return @intCast(x);
+}
+
+fn u(x: usize) u32 {
+    return @intCast(x);
+}
+
+test "the shared plans at Muse Spark's shapes" {
+    const vectors = [_][4]usize{
+        .{ 8192, 8192, 1, 8 }, .{ 8192, 4096, 8, 4 },  .{ 8192, 512, 16, 4 },  .{ 4096, 8192, 1, 8 },
+        .{ 2048, 8192, 1, 8 }, .{ 8192, 2048, 16, 4 }, .{ 8192, 1024, 16, 4 }, .{ 8192, 101120, 1, 8 },
+        .{ 4096, 6144, 4, 4 }, .{ 4096, 76288, 1, 8 }, .{ 1024, 4096, 2, 4 },
+    };
+    for (vectors) |v| try std.testing.expectEqual([2]usize{ v[2], v[3] }, plan(v[0], v[1]));
+    try std.testing.expectEqual(@as(u32, 4), try sx.plan(4096, 2048, true));
+    try std.testing.expectEqual(@as(u32, 1), try sx.plan(2048, 4096, false));
+}
diff --git a/zig/src/families/muse_spark/forward.zig b/zig/src/families/muse_spark/forward.zig
new file mode 100644
index 00000000..da1a7921
--- /dev/null
+++ b/zig/src/families/muse_spark/forward.zig
@@ -0,0 +1,485 @@
+//! Muse Spark's decode forward: windows of decode rows (any slots, any positions), four all-gathers a layer at TP=2.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const tp = @import("tp");
+const load_ = @import("load.zig");
+const dflash2 = @import("dflash2.zig");
+const ops = @import("ops.zig");
+const exl3 = @import("exl3.zig");
+const Weights = load_.Weights;
+const Stream = cuda.Stream;
+
+pub const CK = 256; // keys an attention chunk
+pub const DECODE_ROWS = 128; // the EXL3 GEMV's row limit
+pub const NORM_THREADS = 1024;
+pub const BUCKET = 4096; // graphs: the smallest key bucket (full layers read bucket / CK chunks)
+pub const MAX_GRAPH_ROWS = 32; // wider windows (prompt chunks) run eagerly
+pub const MAX_CHUNKS = 64; // full layers' key chunks at most: chunks grow past CK keys with the context
+/// Graphs key windows under this bucket at it (at most the context): one graph a width, the same bits (graphed()).
+pub const GRAPH_BUCKET = 1 << 20;
+
+/// The key bucket of a window ending at end - 1: a power of two from BUCKET, at most the context (CK-rounded).
+pub fn bucketOf(context: usize, end: usize) usize {
+    const full = (context + CK - 1) / CK * CK;
+    return @min(full, @max(BUCKET, std.math.ceilPowerOfTwo(usize, end) catch unreachable));
+}
+
+/// Keys a full layer's chunk holds for a bucket: CK, or bucket / MAX_CHUNKS rounded up to CK past 16K keys.
+pub fn chunkKeys(bucket: usize) usize {
+    return @max(CK, std.mem.alignForward(usize, (bucket + MAX_CHUNKS - 1) / MAX_CHUNKS, CK));
+}
+
+/// linear_multi.cu's instantiations (EXL3 bits a weight; mul1 codebook, 4 warps).
+pub const multi_k2s = [_]u32{ 2, 3, 4, 5, 6, 8 };
+
+/// Key chunks a full layer's row at position pos reads eagerly (its own chunk width).
+pub fn rowChunks(context: usize, pos: usize) usize {
+    return pos / chunkKeys(bucketOf(context, pos + 1)) + 1;
+}
+
+/// One decode row: a stream's cache slot, its position, its input token.
+pub const Row = struct { slot: u32, pos: u32, token: i64 };
+
+/// Sliding cache rows a slot keeps: the window, the row itself and a window's other rows of the same slot.
+pub fn ringSize(window: usize, rows: usize) usize {
+    return std.mem.alignForward(usize, window + 1 + rows, 64);
+}
+
+fn u(x: usize) u32 {
+    return @intCast(x);
+}
+fn ci(x: usize) c_int {
+    return @intCast(x);
+}
+
+const Bufs = struct {
+    ids: u64, // i64 [R]
+    pos: u64, // i32 [R]
+    slot: u64, // i32 [R]
+    res: u64, // f32 [R, D]
+    x: u64, // f16 [R, D]: the normed sublayer input
+    xf: u64, // f32 [R, D]: the normed MoE input unrounded (the router's)
+    q: u64, // f16 [R, H * 64]
+    k: u64, // f16 [R, HK * 64]
+    v: u64,
+    g: u64, // f16 [R, H * 64]: the output gate's logits
+    qo: u64, // f16 [R, H * 64]
+    att: u64, // f16 [R, H * 64]: gated attention output
+    po: u64, // f32 [R, H, NCH, 64]
+    pm: u64,
+    pl: u64,
+    xh: u64, // f16 rot_in scratch [R, max K]
+    xh4: u64, // f16 [4, R, D]: q / k / v / gate's rotated inputs (one launch)
+    z4: u64, // f32: their split partials, one region each
+    z: u64, // f32 split partials
+    part: u64, // f32 [R, D]
+    logits: u64, // f32 [R, E]
+    pick: u64, // i32 [R, K]
+    wts: u64, // f32 [R, K]
+    lat: u64, // f16 [R, latent]
+    latn: u64, // f16 [R, latent]
+    acc: u64, // f16 [R, latent]
+    head: u64, // f32 [R, head stride]: this rank's head rows
+    recv: u64, // f32 [world, R, max(D, K * latent, head stride)]: all-gathers
+    latg: u64, // f16 [world, R, latent / world]: the gathered latent halves
+    am: u64, // i32 [R]
+    erow: u64, // bf16 [R, D]: the window's embedding rows, read through iota
+    iota: u64, // i64 [R]: 0 .. R - 1
+    sc: exl3.Scratch,
+};
+
+pub const Model = struct {
+    w: *const Weights,
+    d: *const cuda.Driver,
+    k3: *const exl3.Kernels,
+    comm: ?tp.Collective,
+    glue: cuda.Module,
+    attn: cuda.Module,
+    lin: cuda.Module, // linear_multi.cu: q / k / v / gate in one launch
+    f_multi: [multi_k2s.len]cuda.Function,
+    f_rotm: cuda.Function,
+    f_lin2: [multi_k2s.len][2]cuda.Function, // linear_body2 (32-row passes, the same bits) at 4 and 8 warps
+    f_embed: cuda.Function,
+    f_rms: cuda.Function,
+    f_gate: cuda.Function,
+    f_gate_c: cuda.Function, // the cluster versions (8 blocks a row, the same bits)
+    f_esum_c: cuda.Function,
+    f_router: cuda.Function,
+    f_topk: cuda.Function,
+    f_esum: cuda.Function,
+    f_softcap: cuda.Function,
+    f_argmax: cuda.Function,
+    f_prep: cuda.Function,
+    f_rows: cuda.Function,
+    f_merge: cuda.Function,
+    context: usize,
+    graphs: std.AutoHashMapUnmanaged([2]u32, cuda.graph.Exec) = .empty,
+    replays: usize = 0,
+    captures: usize = 0,
+    kv_bytes: usize = 0, // the KV caches' device bytes
+    ring: usize,
+    rows: usize,
+    slots: usize,
+    nch_max: usize,
+    kc: []u64,
+    vc: []u64,
+    cos: u64, // fp32 [context, 32] (one theta: every RoPE layer's)
+    sin: u64,
+    theta: f64,
+    b: Bufs,
+    arena: load_.Arena,
+    gpa: std.mem.Allocator,
+    h_erow: []u16 = &.{}, // host staging of the window's embedding rows
+    dr: ?*dflash2.Drafter = null, // fed inside run: taps after its layers, the context update after the last layer
+
+    /// fp16 K/V caches: full layers [slots, context, HK, 64], sliding layers rings of ringSize rows.
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const Weights, k3: *const exl3.Kernels, comm: ?tp.Collective, context: usize, rows: usize, slots: usize, s: Stream) !Model {
+        const cfg = w.cfg;
+        if (w.world > 1 and comm == null) return error.NeedComm;
+        if (rows > DECODE_ROWS or rows == 0) return error.TooManyRows;
+        var m: Model = undefined;
+        m.w = w;
+        m.d = d;
+        m.k3 = k3;
+        m.comm = if (w.world > 1) comm else null;
+        m.context = context;
+        m.graphs = .empty;
+        m.replays = 0;
+        m.captures = 0;
+        m.kv_bytes = 0;
+        m.ring = ringSize(cfg.window, rows);
+        m.rows = rows;
+        m.slots = slots;
+        m.nch_max = @max(@min(MAX_CHUNKS, (context + CK - 1) / CK), (cfg.window + 1 + CK - 1) / CK);
+        m.gpa = gpa;
+        m.dr = null;
+        m.arena = .{ .d = d, .gpa = gpa };
+        errdefer m.arena.deinit();
+        m.glue = try cuda.Module.load(d, cuda.kernels.muse_glue);
+        errdefer m.glue.unload();
+        m.attn = try cuda.Module.load(d, cuda.kernels.muse_attention);
+        errdefer m.attn.unload();
+        m.f_embed = try m.glue.function("muse_embed_norm");
+        m.f_rms = try m.glue.function("muse_rms");
+        m.f_gate = try m.glue.function("muse_gate_norm");
+        m.f_gate_c = try m.glue.function("muse_gate_norm_c");
+        m.f_esum_c = try m.glue.function("muse_expert_sum_c");
+        m.f_router = try m.glue.function("muse_router");
+        m.f_topk = try m.glue.function("muse_topk");
+        m.f_esum = try m.glue.function("muse_expert_sum");
+        m.f_softcap = try m.glue.function("muse_softcap");
+        m.f_argmax = try m.glue.function("muse_argmax");
+        m.f_prep = try m.attn.function("muse_qk_prep");
+        m.f_rows = try m.attn.function("muse_attn_rows");
+        m.f_merge = try m.attn.function("muse_attn_merge");
+        m.lin = try cuda.Module.load(d, cuda.kernels.muse_linear);
+        errdefer m.lin.unload();
+        inline for (multi_k2s, 0..) |k2, j| m.f_multi[j] = try m.lin.function(std.fmt.comptimePrint("muse_linear_multi_k{d}", .{k2}));
+        m.f_rotm = try m.lin.function("muse_rot_multi");
+        inline for (multi_k2s, 0..) |k2, j| inline for (.{ 4, 8 }, 0..) |wk, q| {
+            m.f_lin2[j][q] = try m.lin.function(std.fmt.comptimePrint("muse_linear2_k{d}_w{d}", .{ k2, wk }));
+        };
+        const ar = &m.arena;
+        const L = w.layers.len;
+        const HK = cfg.kv_heads;
+        const hd = cfg.head_dim;
+        m.kc = try gpa.alloc(u64, L);
+        m.vc = try gpa.alloc(u64, L);
+        for (0..L) |i| {
+            const n = if (cfg.full[i]) context else m.ring;
+            m.kc[i] = try ar.zeros(slots * n * HK * hd * 2);
+            m.vc[i] = try ar.zeros(slots * n * HK * hd * 2);
+            m.kv_bytes += 2 * slots * n * HK * hd * 2;
+        }
+        // RoPE tables: every RoPE layer of Muse Spark has the same theta (5e5); refuse a second one
+        m.theta = 0;
+        for (0..L) |i| if (cfg.rope(i)) {
+            if (m.theta != 0 and m.theta != cfg.theta[i]) return error.SeveralThetas;
+            m.theta = cfg.theta[i];
+        };
+        m.cos = try ar.alloc(context * (hd / 2) * 4);
+        m.sin = try ar.alloc(context * (hd / 2) * 4);
+        if (m.theta != 0) {
+            const f = try m.glue.function("muse_rope_tables");
+            var a: cuda.Args = .{};
+            a.add(m.cos);
+            a.add(m.sin);
+            a.add(ci(context));
+            a.add(m.theta);
+            a.add(ci(hd));
+            try cuda.launch.launch(f, .{ .grid = .{ .x = 256, .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+        }
+        const R = rows;
+        const D = cfg.hidden;
+        const HQ = cfg.heads * hd;
+        const HKD = HK * hd;
+        const lat = cfg.latent;
+        const vr = w.head_stride;
+        var max_z: usize = zBytes(w.head, R);
+        for (w.layers) |ly| inline for (.{ "q", "k", "v", "g", "o", "pre", "post" }) |f| {
+            max_z = @max(max_z, zBytes(@field(ly, f), R));
+        };
+        var b: Bufs = undefined;
+        b.ids = try ar.zeros(R * 8);
+        b.pos = try ar.zeros(R * 4);
+        b.slot = try ar.zeros(R * 4);
+        b.res = try ar.zeros(R * D * 4);
+        b.x = try ar.zeros(R * D * 2);
+        b.xf = try ar.zeros(R * D * 4);
+        b.q = try ar.zeros(R * HQ * 2);
+        b.k = try ar.zeros(R * HKD * 2);
+        b.v = try ar.zeros(R * HKD * 2);
+        b.g = try ar.zeros(R * HQ * 2);
+        b.qo = try ar.zeros(R * HQ * 2);
+        b.att = try ar.zeros(R * HQ * 2);
+        b.po = try ar.zeros(R * cfg.heads * m.nch_max * hd * 4);
+        b.pm = try ar.zeros(R * cfg.heads * m.nch_max * 4);
+        b.pl = try ar.zeros(R * cfg.heads * m.nch_max * 4);
+        b.xh = try ar.zeros(R * @max(D, HQ) * 2);
+        b.z = try ar.zeros(@max(max_z, 4));
+        var z4: usize = 0;
+        for (w.layers) |ly| z4 = @max(z4, zBytes(ly.q, R) + zBytes(ly.k, R) + zBytes(ly.v, R) + zBytes(ly.g, R));
+        b.xh4 = try ar.zeros(4 * R * D * 2);
+        b.z4 = try ar.zeros(@max(z4, 4));
+        b.part = try ar.zeros(R * D * 4);
+        b.logits = try ar.zeros(R * cfg.experts * 4);
+        b.pick = try ar.zeros(R * cfg.top_k * 4);
+        b.wts = try ar.zeros(R * cfg.top_k * 4);
+        b.lat = try ar.zeros(R * lat * 2);
+        b.latn = try ar.zeros(R * lat * 2);
+        b.acc = try ar.zeros(R * lat * 2);
+        b.head = try ar.zeros(R * vr * 4);
+        b.recv = if (w.world > 1) try ar.zeros(w.world * R * @max(@max(D, cfg.top_k * lat), vr) * 4) else 0;
+        b.latg = if (w.world > 1) try ar.zeros(R * lat * 2) else 0;
+        b.am = try ar.zeros(R * 4);
+        b.erow = try ar.zeros(R * D * 2);
+        {
+            const io_ = try gpa.alloc(i64, R);
+            defer gpa.free(io_);
+            for (io_, 0..) |*x, j| x.* = @intCast(j);
+            b.iota = try ar.upload(std.mem.sliceAsBytes(io_));
+        }
+        m.h_erow = try gpa.alloc(u16, R * D);
+        const first = w.layers[0].experts;
+        const sz = try exl3.sizes(first, R, cfg.top_k);
+        b.sc = .{ .xg = try ar.zeros(sz.xg), .xu = try ar.zeros(sz.xg), .xd = try ar.zeros(sz.xd), .z = try ar.zeros(sz.z), .y = try ar.zeros(sz.y), .ids = try ar.zeros(sz.ids), .count = try ar.zeros(4), .members = try ar.alloc(sz.members), .rows = R, .slots = cfg.top_k };
+        try d.check(d.api.cuMemsetD32_v2(b.sc.members, 0xFFFF_FFFF, sz.members / 4), "members -1");
+        m.b = b;
+        try s.synchronize();
+        return m;
+    }
+
+    fn zBytes(l: exl3.Linear, R: usize) usize {
+        return if (l.split[0] > 1) l.split[0] * R * l.n * 4 else 0;
+    }
+
+    pub fn deinit(m: *Model) void {
+        var it = m.graphs.valueIterator();
+        while (it.next()) |e| e.deinit();
+        m.graphs.deinit(m.gpa);
+        m.gpa.free(m.kc);
+        m.gpa.free(m.vc);
+        m.gpa.free(m.h_erow);
+        m.glue.unload();
+        m.attn.unload();
+        m.lin.unload();
+        m.arena.deinit();
+    }
+
+    pub const Tap = enum { input, attn, mlp };
+    /// A hook per layer: `.input` before it (teacher forcing), `.attn` after the gate, `.mlp` the block output.
+    pub const Capture = struct {
+        hook: *const fn (ctx: *anyopaque, what: Tap, layer: usize, dev: u64, n: usize) anyerror!void,
+        ctx: *anyopaque,
+        teacher: bool = false,
+    };
+
+    /// Rows' tokens, positions and slots into the fixed device inputs.
+    pub fn stage(m: *Model, rows: []const Row) !void {
+        if (rows.len == 0 or rows.len > m.rows) return error.WindowTooWide;
+        var ids: [DECODE_ROWS]i64 = undefined;
+        var pos: [DECODE_ROWS]i32 = undefined;
+        var slot: [DECODE_ROWS]i32 = undefined;
+        var per: [DECODE_ROWS]usize = @splat(0);
+        for (rows, 0..) |r, i| {
+            if (r.slot >= m.slots) return error.BadSlot;
+            if (r.pos >= m.context) return error.PastContext;
+            if (r.token < 0 or r.token >= m.w.full.vocab) return error.BadToken;
+            ids[i] = r.token;
+            pos[i] = @intCast(r.pos);
+            slot[i] = @intCast(r.slot);
+            per[r.slot] += 1;
+        }
+        for (per[0..m.slots]) |c| if (c + m.w.cfg.window + 1 > m.ring) return error.RingOverrun;
+        const n = rows.len;
+        try m.embedRows(ids[0..n], m.h_erow, m.b.erow);
+        try upload(m.d, m.b.ids, std.mem.sliceAsBytes(ids[0..n]));
+        try upload(m.d, m.b.pos, std.mem.sliceAsBytes(pos[0..n]));
+        try upload(m.d, m.b.slot, std.mem.sliceAsBytes(slot[0..n]));
+    }
+
+    /// The tokens' table rows (bf16) through host staging `h` into `dev` [n, D].
+    pub fn embedRows(m: *const Model, tokens: []const i64, h: []u16, dev: u64) !void {
+        const D = m.w.full.hidden;
+        const tab = m.w.embed_host;
+        if (h.len < tokens.len * D) return error.WindowTooWide;
+        for (tokens, 0..) |t, j| @memcpy(std.mem.sliceAsBytes(h[j * D ..][0..D]), tab[@as(usize, @intCast(t)) * D * 2 ..][0 .. D * 2]);
+        try upload(m.d, dev, std.mem.sliceAsBytes(h[0 .. tokens.len * D]));
+    }
+
+    /// The embedding launch's (table, ids): the staged rows and iota (the table stays on the host).
+    pub fn embedSrc(_: *const Model, erow: u64, iota: u64) [2]u64 {
+        return .{ erow, iota };
+    }
+
+    /// Eager decode window: softcapped fp32 logits of every row into `out` [n, vocab] (or none).
+    pub fn forward(m: *Model, s: Stream, rows: []const Row, out: ?[]f32, cap: ?Capture) !void {
+        try m.stage(rows);
+        var chunks: usize = 1; // the most any row's own chunking takes
+        for (rows) |r| chunks = @max(chunks, rowChunks(m.context, r.pos));
+        try m.run(s, rows.len, chunks, cap);
+        if (out) |o| try m.logitsTo(s, rows.len, o) else try s.synchronize();
+    }
+
+    /// Graphed decode window: a graph per (rows, key bucket) after an eager warm-up; replay bits equal eager bits.
+    pub fn graphed(m: *Model, s: Stream, rows: []const Row, out: ?[]f32) !void {
+        if (rows.len > MAX_GRAPH_ROWS) return m.forward(s, rows, out, null); // prompt windows: eager, the same bits
+        var end: usize = 0;
+        for (rows) |r| end = @max(end, r.pos + 1);
+        var bucket = bucketOf(m.context, end);
+        if (GRAPH_BUCKET > bucket) bucket = @min(GRAPH_BUCKET, (m.context + CK - 1) / CK * CK);
+        const chunks = (bucket + chunkKeys(bucket) - 1) / chunkKeys(bucket); // covers every row at or under bucket
+        const key: [2]u32 = .{ @intCast(rows.len), @intCast(bucket) };
+        try m.stage(rows);
+        if (m.graphs.get(key)) |exec| {
+            try exec.launchOn(s);
+            m.replays += 1;
+        } else {
+            try m.run(s, rows.len, chunks, null); // warm-up: writes the same cache rows the replay will
+            try s.synchronize();
+            try cuda.graph.beginCapture(s, .thread_local);
+            m.run(s, rows.len, chunks, null) catch |e| {
+                if (cuda.graph.endCapture(s)) |g| {
+                    var gg = g;
+                    gg.deinit();
+                } else |_| {}
+                return e;
+            };
+            var g = try cuda.graph.endCapture(s);
+            defer g.deinit();
+            const exec = try g.instantiate();
+            try m.graphs.put(m.gpa, key, exec);
+            try exec.launchOn(s);
+            m.captures += 1;
+        }
+        if (out) |o| try m.logitsTo(s, rows.len, o) else try s.synchronize();
+    }
+
+    pub const norm = ops.norm;
+    pub const normParts = ops.normParts;
+    pub const gateNormAt = ops.gateNormAt;
+    pub const qkvg = ops.qkvg;
+    pub const rowLaunch = ops.rowLaunch;
+    pub const proj = ops.proj;
+    pub const AttnIo = ops.AttnIo;
+    pub const attentionIo = ops.attentionIo;
+
+    /// The window's kernels on staged inputs, no host work; full layers read `chunks` key chunks (each row's width).
+    pub fn run(m: *Model, s: Stream, n: usize, chunks: usize, cap: ?Capture) !void {
+        const cfg = m.w.cfg;
+        const D = cfg.hidden;
+        if (chunks > m.nch_max) return error.TooManyChunks;
+        {
+            var a: cuda.Args = .{};
+            const es = m.embedSrc(m.b.erow, m.b.iota);
+            a.add(es[0]);
+            a.add(es[1]);
+            a.add(m.b.res);
+            a.add(ci(D));
+            a.add(@as(f32, @floatCast(cfg.eps)));
+            try cuda.launch.launch(m.f_embed, .{ .grid = .{ .x = u(n), .y = 1, .z = 1 }, .block = .{ .x = NORM_THREADS, .y = 1, .z = 1 } }, s, &a);
+        }
+        try m.norm(s, m.b.res, false, m.w.layers[0].in_norm, m.b.x, n, D, cfg.eps);
+        for (m.w.layers, 0..) |L, i| {
+            if (cap) |c| if (c.teacher) {
+                try c.hook(c.ctx, .input, i, m.b.res, n);
+                try m.norm(s, m.b.res, false, L.in_norm, m.b.x, n, D, cfg.eps);
+            };
+            try m.qkvg(s, L, m.b.x, m.b.q, m.b.k, m.b.v, m.b.g, n);
+            try ops.attention(m, s, i, n, chunks);
+            try m.proj(s, L.o, m.b.att, m.b.part, true, n);
+            try ops.gateNorm(m, s, m.b.part, 0, L.attn_ab, L.ffn_norm, m.b.xf, n);
+            if (cap) |c| try c.hook(c.ctx, .attn, i, m.b.res, n);
+            try ops.moe(m, s, L, n);
+            const after = if (i + 1 < m.w.layers.len) m.w.layers[i + 1].in_norm else m.w.norm;
+            try ops.gateNorm(m, s, m.b.part, L.post_ffn, L.mlp_ab, after, 0, n);
+            if (cap) |c| try c.hook(c.ctx, .mlp, i, m.b.res, n);
+            if (m.dr) |dr| if (cap == null) try dr.tap(s, i, m.b.res, n);
+        }
+        if (m.dr) |dr| if (cap == null) try dr.update(s, n);
+        try m.proj(s, m.w.head, m.b.x, m.b.head, true, n);
+        const cfgf = m.w.full;
+        var a: cuda.Args = .{};
+        a.add(m.b.head);
+        a.add(@as(i64, @intCast(n * m.w.head.n)));
+        a.add(@as(f32, @floatCast(cfgf.out_mult)));
+        a.add(@as(f32, @floatCast(cfgf.softcap)));
+        try cuda.launch.launch(m.f_softcap, .{ .grid = .{ .x = u(@min((n * m.w.head.n + 255) / 256, 4096)), .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+        // each rank's [n, its rows] block, gathered as n * stride elements a rank (rank 1's slice is a block shorter)
+        if (m.comm) |c| try c.allGather(m.b.head, m.b.recv, n * m.w.head_stride, .f32, s.handle);
+    }
+
+    /// Where the rows' head slices are: (rank 0's [n, w0], rank 1's [n, w1] offset in elements, w0, w1).
+    fn heads(m: *const Model, n: usize) struct { base: u64, part: usize, w0: usize, w1: usize } {
+        if (m.comm == null) return .{ .base = m.b.head, .part = 0, .w0 = m.w.head.n, .w1 = 0 };
+        const st = m.w.head_stride;
+        return .{ .base = m.b.recv, .part = n * st, .w0 = st, .w1 = m.w.head_rows - st }; // rank 1: the padded head's rest
+    }
+
+    /// Each row's argmax over the real vocabulary on the device; only the ids reach the host.
+    pub fn argmaxTo(m: *Model, s: Stream, n: usize, out: []i32) !void {
+        const h = m.heads(n);
+        var a: cuda.Args = .{};
+        a.add(h.base);
+        a.add(m.b.am);
+        a.add(ci(h.w0));
+        a.add(ci(h.w1));
+        a.add(@as(i64, @intCast(h.part)));
+        a.add(ci(m.w.full.vocab));
+        try cuda.launch.launch(m.f_argmax, .{ .grid = .{ .x = u(n), .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+        try s.synchronize();
+        try m.d.check(m.d.api.cuMemcpyDtoH_v2(@ptrCast(out.ptr), m.b.am, n * 4), "argmax");
+    }
+
+    /// The window's logits on the host: [n, vocab] (the head's padding rows dropped).
+    pub fn logitsTo(m: *Model, s: Stream, n: usize, out: []f32) !void {
+        const V = m.w.full.vocab;
+        const h = m.heads(n);
+        try s.synchronize();
+        for (0..n) |r| {
+            const c0 = @min(V, h.w0);
+            try m.d.check(m.d.api.cuMemcpyDtoH_v2(@ptrCast(out[r * V ..].ptr), h.base + r * h.w0 * 4, c0 * 4), "logits");
+            if (V > c0) try m.d.check(m.d.api.cuMemcpyDtoH_v2(@ptrCast(out[r * V + c0 ..].ptr), h.base + (h.part + r * h.w1) * 4, (V - c0) * 4), "logits");
+        }
+    }
+};
+
+fn upload(d: *const cuda.Driver, at: u64, bytes: []const u8) !void {
+    try d.check(d.api.cuMemcpyHtoD_v2(at, bytes.ptr, bytes.len), "upload");
+}
+
+test "chunks stay at 64 or fewer, and at CK keys up to 16K" {
+    try std.testing.expectEqual(@as(usize, 4096), bucketOf(4096, 2615));
+    try std.testing.expectEqual(@as(usize, 256), chunkKeys(4096));
+    try std.testing.expectEqual(@as(usize, 256), chunkKeys(16384));
+    try std.testing.expectEqual(@as(usize, 512), chunkKeys(32768));
+    try std.testing.expectEqual(@as(usize, 2048), chunkKeys(131072));
+    try std.testing.expectEqual(@as(usize, 40960), bucketOf(40960, 40000));
+    try std.testing.expect((40960 + chunkKeys(40960) - 1) / chunkKeys(40960) <= MAX_CHUNKS);
+}
+
+test "ring" {
+    try std.testing.expectEqual(@as(usize, 2176), ringSize(2047, 128));
+    try std.testing.expectEqual(@as(usize, 2112), ringSize(2047, 1));
+}
diff --git a/zig/src/families/muse_spark/kept.zig b/zig/src/families/muse_spark/kept.zig
new file mode 100644
index 00000000..93f3a494
--- /dev/null
+++ b/zig/src/families/muse_spark/kept.zig
@@ -0,0 +1,326 @@
+//! Muse Spark's kept prompt states: full-layer rows pinned in their slot, sliding and drafter rings copied.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const fwd = @import("forward.zig");
+const dflash2 = @import("dflash2.zig");
+
+/// A cache word on the plan link: [Op.cache, kind, id, slot, slot2, at].
+pub const Kind = enum(i64) { save = 0, restore = 1, copy = 2, drop = 3 };
+
+pub const WORDS = 6;
+
+/// A slot's span of one cache plane: `base + slot * bytes`, `bytes` long.
+const Plane = struct { base: u64, bytes: usize };
+
+/// Every rank's copies of kept states' windows, by id.
+pub const Copies = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    m: *const fwd.Model,
+    planes: []Plane = &.{}, // the sliding layers' K and V rings, then the drafter's
+    bytes: usize = 0, // one state's copy
+    map: std.AutoHashMapUnmanaged(u64, cuda.DeviceBuffer) = .empty,
+    held: usize = 0,
+
+    /// The planes a state copies: built after the drafter (when one is loaded) so its ring is in.
+    pub fn init(gpa: std.mem.Allocator, m: *const fwd.Model, dr: ?*const dflash2.Drafter) !Copies {
+        const cfg = m.w.cfg;
+        const L = m.w.layers.len;
+        var list: std.ArrayList(Plane) = .empty;
+        errdefer list.deinit(gpa);
+        const ring_row = cfg.kv_heads * cfg.head_dim * 2; // sliding caches are 16-bit
+        for (0..L) |i| if (!cfg.full[i]) {
+            try list.append(gpa, .{ .base = m.kc[i], .bytes = m.ring * ring_row });
+            try list.append(gpa, .{ .base = m.vc[i], .bytes = m.ring * ring_row });
+        };
+        if (dr) |x| for (x.kc, x.vc) |k, v| {
+            const b = x.ring * x.c.kv_heads * 128 * 2;
+            try list.append(gpa, .{ .base = k, .bytes = b });
+            try list.append(gpa, .{ .base = v, .bytes = b });
+        };
+        var c: Copies = .{ .gpa = gpa, .d = m.d, .m = m, .planes = try list.toOwnedSlice(gpa) };
+        for (c.planes) |p| c.bytes += p.bytes;
+        return c;
+    }
+
+    pub fn deinit(c: *Copies) void {
+        var it = c.map.valueIterator();
+        while (it.next()) |b| b.free();
+        c.map.deinit(c.gpa);
+        c.gpa.free(c.planes);
+        c.held = 0;
+    }
+
+    fn copy(c: *const Copies, s: cuda.Stream, dst: u64, src: u64, n: usize) !void {
+        if (n > 0) try c.d.check(c.d.api.cuMemcpyDtoDAsync_v2(dst, src, n, s.handle), "kept copy");
+    }
+
+    /// Copy `slot`'s windows into a new buffer kept as `id` (on `s`, after the chunk that ends at the mark).
+    pub fn save(c: *Copies, s: cuda.Stream, id: u64, slot: u32) !void {
+        if (slot >= c.m.slots) return error.BadSlot;
+        if (c.map.contains(id)) return error.KeptTwice;
+        var buf = try cuda.DeviceBuffer.alloc(c.d, c.bytes);
+        errdefer buf.free();
+        var off: usize = 0;
+        for (c.planes) |p| {
+            try c.copy(s, buf.ptr + off, p.base + slot * p.bytes, p.bytes);
+            off += p.bytes;
+        }
+        try c.map.put(c.gpa, id, buf);
+        c.held += c.bytes;
+    }
+
+    /// Kept `id`'s windows into `slot` (before the pass's first chunk).
+    pub fn restore(c: *Copies, s: cuda.Stream, id: u64, slot: u32) !void {
+        if (slot >= c.m.slots) return error.BadSlot;
+        const buf = c.map.get(id) orelse return error.NoSuchState;
+        var off: usize = 0;
+        for (c.planes) |p| {
+            try c.copy(s, p.base + slot * p.bytes, buf.ptr + off, p.bytes);
+            off += p.bytes;
+        }
+    }
+
+    /// The full layers' first `at` rows of slot `from` into `to`, for a resume in another slot.
+    pub fn copyPrefix(c: *const Copies, s: cuda.Stream, from: u32, to: u32, at: usize) !void {
+        const m = c.m;
+        const cfg = m.w.cfg;
+        if (from >= m.slots or to >= m.slots or from == to) return error.BadSlot;
+        if (at > m.context) return error.PastContext;
+        const row = cfg.kv_heads * cfg.head_dim * 2;
+        for (0..m.w.layers.len) |i| if (cfg.full[i]) {
+            for ([2]u64{ m.kc[i], m.vc[i] }) |base| try c.copy(s, base + to * m.context * row, base + from * m.context * row, at * row);
+        };
+    }
+
+    pub fn drop(c: *Copies, id: u64) void {
+        var kv = c.map.fetchRemove(id) orelse return;
+        kv.value.free();
+        c.held -= c.bytes;
+    }
+
+    /// A follower's cache word (after Op.cache): the same copy rank 0 made.
+    pub fn follow(c: *Copies, s: cuda.Stream, w: []const i64) !void {
+        if (w.len != WORDS) return error.BadPlan;
+        const kind: Kind = std.enums.fromInt(Kind, w[1]) orelse return error.BadPlan;
+        const id: u64 = @intCast(w[2]);
+        const slot: u32 = @intCast(w[3]);
+        switch (kind) {
+            .save => try c.save(s, id, slot),
+            .restore => try c.restore(s, id, slot),
+            .copy => try c.copyPrefix(s, slot, @intCast(w[4]), @intCast(w[5])),
+            .drop => c.drop(id),
+        }
+    }
+};
+
+/// The words of a cache step (Op.cache is the first word's value, passed in so this file needs no engine).
+pub fn words(op: i64, kind: Kind, id: u64, slot: u32, slot2: u32, at: usize) [WORDS]i64 {
+    return .{ op, @backingInt(kind), @intCast(id), slot, slot2, @intCast(at) };
+}
+
+/// One kept state on rank 0: the slot whose full-layer rows it pins, its position, its window copy's id.
+pub const State = struct {
+    id: u64,
+    slot: u32,
+    at: u32,
+    live: bool = true, // false once a pass rewrote rows under `at` (the cache drops it at its next lookup or eviction)
+    freed: bool = false, // its window copy is gone already (on every rank)
+    used: u64 = 0,
+};
+
+/// Rank 0's kept states and the slot choice that keeps them alive.
+pub const Pins = struct {
+    gpa: std.mem.Allocator,
+    states: std.ArrayList(*State) = .empty,
+    next: u64 = 1,
+    tick: u64 = 0,
+
+    pub fn deinit(p: *Pins) void {
+        for (p.states.items) |st| p.gpa.destroy(st);
+        p.states.deinit(p.gpa);
+    }
+
+    pub fn add(p: *Pins, slot: u32, at: u32) !*State {
+        const st = try p.gpa.create(State);
+        errdefer p.gpa.destroy(st);
+        p.tick += 1;
+        st.* = .{ .id = p.next, .slot = slot, .at = at, .used = p.tick };
+        try p.states.append(p.gpa, st);
+        p.next += 1;
+        return st;
+    }
+
+    pub fn remove(p: *Pins, st: *State) void {
+        if (std.mem.indexOfScalar(*State, p.states.items, st)) |i| _ = p.states.swapRemove(i);
+        p.gpa.destroy(st);
+    }
+
+    pub fn touch(p: *Pins, st: *State) void {
+        p.tick += 1;
+        st.used = p.tick;
+    }
+
+    /// The lowest slot of `free` (slot bits) that no live state pins.
+    pub fn unpinned(p: *const Pins, free: u32) ?u32 {
+        var bits = free;
+        while (bits != 0) : (bits &= bits - 1) {
+            const slot: u32 = @ctz(bits);
+            const pinned = for (p.states.items) |st| {
+                if (st.live and st.slot == slot) break true;
+            } else false;
+            if (!pinned) return slot;
+        }
+        return null;
+    }
+
+    /// Whether a live state of `slot` sits past `at` (a pass resumed at `at` there would end it).
+    pub fn later(p: *const Pins, slot: u32, at: u32) bool {
+        for (p.states.items) |st| if (st.live and st.slot == slot and st.at > at) return true;
+        return false;
+    }
+
+    /// A stream's slot from `free`: the lowest no live state pins, else the one whose newest state is oldest.
+    pub fn pick(p: *const Pins, free: u32) ?u32 {
+        if (free == 0) return null;
+        var best: ?u32 = null;
+        var best_used: u64 = std.math.maxInt(u64);
+        var bits = free;
+        while (bits != 0) : (bits &= bits - 1) {
+            const slot: u32 = @ctz(bits);
+            var newest: u64 = 0;
+            for (p.states.items) |st| if (st.live and st.slot == slot) {
+                newest = @max(newest, st.used);
+            };
+            if (newest == 0) return slot;
+            if (newest < best_used) {
+                best_used = newest;
+                best = slot;
+            }
+        }
+        return best;
+    }
+
+    /// A resume's slot: `st`'s own when free and safe, else a free unpinned one (prefix copied), else LRU (or null).
+    pub fn resumeSlot(p: *const Pins, free: u32, st: *const State) ?u32 {
+        const own = free & (@as(u32, 1) << @intCast(st.slot)) != 0;
+        if (own and !p.later(st.slot, st.at)) return st.slot;
+        if (p.unpinned(free)) |u| return u;
+        if (own) return st.slot;
+        return p.pick(free);
+    }
+
+    /// A pass on `slot` from `from` ends its live states past it; the first `out.len` go to `out` to free now.
+    pub fn overwrite(p: *Pins, slot: u32, from: u32, out: []*State) []*State {
+        var n: usize = 0;
+        for (p.states.items) |st| if (st.live and st.slot == slot and st.at > from) {
+            st.live = false;
+            if (n < out.len) {
+                out[n] = st;
+                n += 1;
+            }
+        };
+        return out[0..n];
+    }
+
+    pub fn liveCount(p: *const Pins) usize {
+        var n: usize = 0;
+        for (p.states.items) |st| n += @intFromBool(st.live);
+        return n;
+    }
+};
+
+/// The rows of a pass's next chunk from `at` of `len`: at most `cap`, ending at the next mark past `at` if sooner.
+pub fn chunkRows(at: usize, len: usize, cap: usize, marks: []const u32) usize {
+    var n = @min(cap, len - at);
+    for (marks) |mk| if (mk > at and mk < at + n) {
+        n = mk - at;
+        break;
+    };
+    return n;
+}
+
+test "chunks end at marks, the prompt's end or the cap" {
+    const t = std.testing;
+    try t.expectEqual(@as(usize, 1024), chunkRows(0, 5000, 1024, &.{}));
+    try t.expectEqual(@as(usize, 300), chunkRows(0, 5000, 1024, &.{ 300, 4000 }));
+    try t.expectEqual(@as(usize, 1024), chunkRows(300, 5000, 1024, &.{ 300, 4000 })); // the next mark is past the cap
+    try t.expectEqual(@as(usize, 1024), chunkRows(1024, 5000, 1024, &.{ 300, 4000 }));
+    try t.expectEqual(@as(usize, 952), chunkRows(3048, 5000, 1024, &.{ 300, 4000 }));
+    try t.expectEqual(@as(usize, 1000), chunkRows(4000, 5000, 1024, &.{ 300, 4000 }));
+    try t.expectEqual(@as(usize, 1), chunkRows(2047, 4096, 128, &.{2048})); // the sliding window's edge
+    try t.expectEqual(@as(usize, 128), chunkRows(2048, 4096, 128, &.{2048}));
+    try t.expectEqual(@as(usize, 5), chunkRows(4091, 4096, 128, &.{5000})); // a mark past the prompt cuts nothing
+}
+
+test "slot choice keeps live states: free unpinned slots first, then the least recently used" {
+    const t = std.testing;
+    var p: Pins = .{ .gpa = t.allocator };
+    defer p.deinit();
+    try t.expectEqual(@as(?u32, 0), p.pick(0b1111));
+    try t.expectEqual(@as(?u32, null), p.pick(0));
+    const a = try p.add(0, 4096); // conversation A on slot 0
+    const b = try p.add(1, 9000); // B on slot 1
+    try t.expectEqual(@as(?u32, 2), p.pick(0b1111)); // a new conversation takes an unpinned slot
+    try t.expectEqual(@as(?u32, 0), p.pick(0b0011)); // only pinned slots: A was used longest ago
+    p.touch(a);
+    try t.expectEqual(@as(?u32, 1), p.pick(0b0011)); // now B is
+    try t.expectEqual(@as(?u32, 2), p.unpinned(0b1111));
+    try t.expectEqual(@as(?u32, null), p.unpinned(0b0011));
+    try t.expect(p.later(0, 2048) and !p.later(0, 4096) and !p.later(2, 0));
+    var out: [4]*State = undefined;
+    try t.expectEqual(@as(usize, 0), p.overwrite(1, 9000, &out).len); // a pass resumed at B's own mark keeps B
+    try t.expect(b.live);
+    const ended = p.overwrite(1, 0, &out); // a fresh pass on slot 1 ends B
+    try t.expectEqual(@as(usize, 1), ended.len);
+    try t.expectEqual(b, ended[0]);
+    try t.expect(!b.live and a.live);
+    try t.expectEqual(@as(usize, 1), p.liveCount());
+    try t.expectEqual(@as(?u32, 1), p.pick(0b0011)); // a slot whose states all ended is unpinned again
+    p.remove(b);
+    try t.expectEqual(@as(usize, 1), p.states.items.len);
+}
+
+test "a resume at an earlier mark ends the later states of its slot only" {
+    const t = std.testing;
+    var p: Pins = .{ .gpa = t.allocator };
+    defer p.deinit();
+    const h = try p.add(0, 2048); // the history's mark
+    const r = try p.add(0, 6000); // the reply's warm end
+    const o = try p.add(1, 6000); // another slot's
+    var out: [1]*State = undefined;
+    const ended = p.overwrite(0, 2048, &out); // an edited last message resumes at the history
+    try t.expectEqual(@as(usize, 1), ended.len);
+    try t.expectEqual(r, ended[0]);
+    try t.expect(h.live and !r.live and o.live);
+    _ = try p.add(1, 7000);
+    try t.expectEqual(@as(usize, 1), p.overwrite(1, 0, &out).len); // two end, one fits `out`: the other keeps its copy
+    try t.expectEqual(@as(usize, 1), p.liveCount()); // the history's mark only
+    try t.expect(h.live and !o.live);
+}
+
+test "a resume takes its own slot unless that ends later states or the slot is busy" {
+    const t = std.testing;
+    var p: Pins = .{ .gpa = t.allocator };
+    defer p.deinit();
+    const sys = try p.add(0, 1500); // a shared system block's state
+    try t.expectEqual(@as(?u32, 0), p.resumeSlot(0b1111, sys)); // nothing later on slot 0: resume in place
+    const conv = try p.add(0, 8000); // the conversation that kept it went on
+    try t.expectEqual(@as(?u32, 1), p.resumeSlot(0b1111, sys)); // another conversation copies the prefix to slot 1
+    try t.expectEqual(@as(?u32, 0), p.resumeSlot(0b1111, conv)); // the conversation itself resumes in place
+    try t.expectEqual(@as(?u32, 1), p.resumeSlot(0b1110, conv)); // its slot busy: an unpinned free one
+    _ = try p.add(2, 100);
+    _ = try p.add(3, 100);
+    try t.expectEqual(@as(?u32, 0), p.resumeSlot(0b1101, sys)); // no unpinned slot: its own, ending the later state
+    p.touch(sys);
+    try t.expectEqual(@as(?u32, 2), p.resumeSlot(0b1100, conv)); // busy and no unpinned: the least recently used
+    try t.expectEqual(@as(?u32, null), p.resumeSlot(0, conv));
+}
+
+test "cache words round-trip the plan link" {
+    const w = words(5, .copy, 7, 2, 3, 70000);
+    try std.testing.expectEqual(@as(i64, 5), w[0]);
+    try std.testing.expectEqual(Kind.copy, std.enums.fromInt(Kind, w[1]).?);
+    try std.testing.expectEqual(@as(i64, 70000), w[5]);
+}
diff --git a/zig/src/families/muse_spark/load.zig b/zig/src/families/muse_spark/load.zig
new file mode 100644
index 00000000..18bf6ed4
--- /dev/null
+++ b/zig/src/families/muse_spark/load.zig
@@ -0,0 +1,252 @@
+//! A rank's share of a Muse Spark EXL3 pack on the GPU: the tensor set and its host-side constants (pack.zig reads).
+
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const config = @import("config.zig");
+const ml = @import("pack.zig");
+const exl3 = @import("exl3.zig");
+const Config = config.Config;
+
+pub const Arena = ml.Arena;
+const P = config.prefix;
+
+pub const Layer = struct {
+    in_norm: u64, // fp32 [D]: 1 + w (centred RMS before attention)
+    ffn_norm: u64, // fp32 [D]: 1 + w (centred RMS before the MoE)
+    post_ffn: u64, // fp32 [D]: 1 + w (input-scaled RMS after the MoE)
+    attn_ab: u64, // fp32 [2, D]: the post-attention residual gate's alpha, beta
+    mlp_ab: u64, // fp32 [2, D]
+    q: exl3.Linear,
+    k: exl3.Linear,
+    v: exl3.Linear,
+    g: exl3.Linear, // the full-width output gate
+    o: exl3.Linear, // a rank's input columns: partial outputs under TP
+    router: u64, // [E, D]: bf16 when every fp32 value is a bf16 (exact), else fp32
+    router_bf16: bool,
+    bias: u64, // fp32 [E]: e_score_correction_bias
+    pre: exl3.Linear, // pre_expert_proj D -> latent (a rank's latent outputs under TP)
+    pre_norm: u64, // fp32 [latent]: 1 + w
+    post: exl3.Linear, // post_expert_proj latent -> D (a rank's latent inputs under TP)
+    expert_norm: u64, // fp32 [latent]: 1 + w (input-scaled RMS of each expert's output)
+    experts: exl3.Experts,
+};
+
+pub const Weights = struct {
+    full: Config,
+    cfg: Config, // this rank's view
+    rank: usize,
+    world: usize,
+    embed_host: []const u8 = &.{}, // bf16 [V, D]: read in place from the pack's mapped file, rows staged per window
+    embed_file: ?core.safetensors.File = null,
+    io: ?std.Io = null,
+    layers: []const Layer,
+    norm: u64, // fp32 [D]: w (the final norm is weighted by w, not 1 + w)
+    head: exl3.Linear, // a rank's 128-row blocks of the padded head
+    head_lo: usize, // its first vocabulary row
+    head_stride: usize, // columns a rank's slice takes in a gather
+    head_rows: usize, // the padded head's rows, every rank's together (202112)
+    arena: Arena,
+    gpa: std.mem.Allocator,
+
+    pub fn deinit(w: *Weights) void {
+        if (w.embed_file) |*f| f.close(w.io.?);
+        for (w.layers) |L| {
+            w.gpa.free(L.experts.host_ptr);
+            w.gpa.free(L.experts.host_k2);
+        }
+        w.gpa.free(w.layers);
+        w.arena.deinit();
+    }
+};
+
+/// Options for partial packs: the first `max_layers` layers only (a k-layer pack, or a check on fewer).
+pub const Options = struct { max_layers: ?usize = null, log: bool = false };
+
+pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, model_dir: []const u8, rank: usize, world: usize, opt: Options) !Weights {
+    const cfg_text = try readFile(gpa, io, model_dir, "config.json");
+    defer gpa.free(cfg_text);
+    const gen_text = readFile(gpa, io, model_dir, "generation_config.json") catch null;
+    defer if (gen_text) |g| gpa.free(g);
+    var full = try Config.parse(gpa, cfg_text, gen_text);
+    if (opt.max_layers) |m| full.layers = @min(full.layers, m);
+    const view = try full.rankView(world);
+    var ck = try core.Checkpoint.openModel(gpa, io, model_dir);
+    defer ck.close();
+    var w: Weights = .{ .full = full, .cfg = view, .rank = rank, .world = world, .layers = &.{}, .norm = 0, .head = undefined, .head_lo = 0, .head_stride = 0, .head_rows = 0, .arena = .{ .d = d, .gpa = gpa }, .gpa = gpa };
+    errdefer w.deinit();
+    const ar = &w.arena;
+    const emb = try ck.get(P ++ "embed_tokens.weight");
+    if (emb.dtype != .bf16 or emb.shape[0] != full.vocab or emb.shape[1] != full.hidden) return error.BadEmbedding;
+    // the embedding stays out of GPU memory: token rows are copied from the pack's file mapping into each window
+    const name = P ++ "embed_tokens.weight";
+    for (ck.files.items) |*f| if (f.get(name) != null) {
+        w.embed_file = try core.safetensors.File.open(gpa, io, f.path);
+        w.io = io;
+        break;
+    };
+    const et = w.embed_file.?.get(name) orelse return error.BadEmbedding;
+    w.embed_host = et.bytes;
+
+    var names: std.ArrayList(u8) = .empty;
+    defer names.deinit(gpa);
+    try names.ensureTotalCapacity(gpa, 1 << 20);
+    var cuts: std.ArrayList(config.Cut) = .empty;
+    defer cuts.deinit(gpa);
+    var nb: [256]u8 = undefined;
+    const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    var layers: std.ArrayList(Layer) = .empty;
+    errdefer {
+        for (layers.items) |L| {
+            gpa.free(L.experts.host_ptr);
+            gpa.free(L.experts.host_k2);
+        }
+        layers.deinit(gpa);
+    }
+    for (0..full.layers) |i| {
+        names.clearRetainingCapacity();
+        cuts.clearRetainingCapacity();
+        try config.layerCuts(full, i, rank, world, &names, gpa, &cuts);
+        var L: Layer = undefined;
+        L.in_norm = try plusOne(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.input_layernorm.weight", .{i})), 1.0);
+        L.ffn_norm = try plusOne(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.pre_feedforward_layernorm.weight", .{i})), 1.0);
+        L.post_ffn = try plusOne(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.post_feedforward_layernorm.weight", .{i})), 1.0);
+        L.attn_ab = try gates(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.post_attention_residual_gate.gate", .{i})), full.gate_temp);
+        L.mlp_ab = try gates(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.post_feedforward_residual_gate.gate", .{i})), full.gate_temp);
+        inline for (.{ "q", "k", "v", "g", "o", "pre", "post" }, 0..) |f, j| @field(L, f) = try ml.linear(gpa, ar, try ml.cut(gpa, try ml.readMat(gpa, &ck, cuts.items[j].prefix), cuts.items[j]));
+        const ex = cuts.items[config.attn_mats + config.latent_mats ..];
+        L.experts = try experts(gpa, ar, &ck, full, ex);
+        errdefer {
+            gpa.free(L.experts.host_ptr);
+            gpa.free(L.experts.host_k2);
+        }
+        L.pre_norm = try plusOne(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.mlp.pre_expert_norm.weight", .{i})), 1.0);
+        L.expert_norm = try plusOne(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.mlp.experts.post_expert_norm.weight", .{i})), 1.0);
+        const r = try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.mlp.gate.weight", .{i}));
+        if (r.rank != 2 or r.shape[0] != full.experts or r.shape[1] != full.hidden) return error.BadRouter;
+        const rf = try ml.asF32(gpa, r);
+        defer gpa.free(rf);
+        L.router_bf16 = for (rf) |x| {
+            if (ml.bf16Round(x) != x) break false;
+        } else true;
+        if (L.router_bf16) {
+            const rb = try gpa.alloc(u16, rf.len);
+            defer gpa.free(rb);
+            for (rf, rb) |x, *o| o.* = @intCast(@as(u32, @bitCast(x)) >> 16);
+            L.router = try ar.upload(std.mem.sliceAsBytes(rb));
+        } else L.router = try ar.upload(std.mem.sliceAsBytes(rf));
+        L.bias = try plusOne(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.mlp.gate.e_score_correction_bias", .{i})), 0.0);
+        try layers.append(gpa, L);
+        ck.release(); // the uploaded layer's pages leave the mapping and the page cache
+        if (opt.log and (i % 8 == 7 or i == full.layers - 1)) {
+            const s = @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e9;
+            std.debug.print("[tensorfold] muse_spark (zig): {d}/{d} layers in {d:.0}s, {d:.1} GiB\n", .{ i + 1, full.layers, s, @as(f64, @floatFromInt(ar.total)) / (1 << 30) });
+        }
+    }
+    gpa.free(w.layers);
+    w.layers = try layers.toOwnedSlice(gpa);
+    w.norm = try plusOne(gpa, ar, try ck.get(P ++ "norm.weight"), 0.0);
+    const hm = try ml.readMat(gpa, &ck, "lm_head");
+    if (hm.n() < full.vocab) return error.BadHead;
+    const hc = config.headCut(hm.n(), rank, world);
+    w.head_lo = hc.lo;
+    w.head_stride = config.headStride(hm.n(), world);
+    w.head_rows = hm.n();
+    w.head = try ml.linear(gpa, ar, try ml.cut(gpa, hm, hc));
+    ck.release();
+    return w;
+}
+
+/// A norm weight as fp32 `bias + w` (exllamav3's constant_bias: 1 for the centred and input-scaled norms, else 0).
+fn plusOne(gpa: std.mem.Allocator, ar: *Arena, t: core.safetensors.Tensor, bias: f32) !u64 {
+    const f = try ml.asF32(gpa, t);
+    defer gpa.free(f);
+    for (f) |*x| x.* = bias + x.*;
+    return ar.upload(std.mem.sliceAsBytes(f));
+}
+
+/// MuseSparkBlock._alpha_beta: w = g / T, beta = sigmoid(w), alpha = sqrt(max(sigmoid(-w) * (1 + beta), 1e-3)).
+fn gates(gpa: std.mem.Allocator, ar: *Arena, t: core.safetensors.Tensor, temp: f64) !u64 {
+    const g = try ml.asF32(gpa, t);
+    defer gpa.free(g);
+    const ab = try gpa.alloc(f32, 2 * g.len);
+    defer gpa.free(ab);
+    const tf: f32 = @floatCast(temp);
+    for (g, 0..) |x, j| {
+        const v = x / tf;
+        const beta = 1.0 / (1.0 + @exp(-v));
+        const sn = 1.0 / (1.0 + @exp(v));
+        ab[j] = @sqrt(@max(sn * (1.0 + beta), 1e-3));
+        ab[g.len + j] = beta;
+    }
+    return ar.upload(std.mem.sliceAsBytes(ab));
+}
+
+/// experts.prepare: per expert (gate, up, down) cut trellises in the stored layout, referenced by pointer tables.
+fn experts(gpa: std.mem.Allocator, ar: *Arena, ck: *core.Checkpoint, full: Config, cuts: []const config.Cut) !exl3.Experts {
+    const E = full.experts;
+    if (cuts.len != 3 * E) return error.ExpertCuts;
+    const ptrs = try gpa.alloc(u64, 3 * E); // kept: Experts.host_ptr
+    errdefer gpa.free(ptrs);
+    const k2s = try gpa.alloc(i32, 3 * E); // kept: Experts.host_k2
+    errdefer gpa.free(k2s);
+    var st: [6]std.ArrayList(f16) = @splat(.empty); // suh_g, suh_u, svh_g, svh_u, suh_d, svh_d
+    defer for (&st) |*l| l.deinit(gpa);
+    var lo: [2]u32 = .{ 99, 99 };
+    var hi: [2]u32 = .{ 0, 0 };
+    var dims: usize = 0;
+    var width: usize = 0;
+    for (0..E) |e| for (0..3) |j| {
+        const m = try ml.cut(gpa, try ml.readMat(gpa, ck, cuts[3 * e + j].prefix), cuts[3 * e + j]);
+        defer m.deinit(gpa);
+        ptrs[j * E + e] = try ar.upload(std.mem.sliceAsBytes(m.trellis));
+        k2s[j * E + e] = @intCast(m.k2);
+        const g: usize = if (j == 2) 1 else 0;
+        lo[g] = @min(lo[g], m.k2);
+        hi[g] = @max(hi[g], m.k2);
+        switch (j) {
+            0 => {
+                dims = m.k();
+                width = m.n();
+                try st[0].appendSlice(gpa, m.suh);
+                try st[2].appendSlice(gpa, m.svh);
+            },
+            1 => {
+                try st[1].appendSlice(gpa, m.suh);
+                try st[3].appendSlice(gpa, m.svh);
+            },
+            else => {
+                if (m.n() != dims or m.k() != width) return error.ExpertShapes;
+                try st[4].appendSlice(gpa, m.suh);
+                try st[5].appendSlice(gpa, m.svh);
+            },
+        }
+    };
+    return .{
+        .gate_ptr = try ar.upload(std.mem.sliceAsBytes(ptrs[0..E])),
+        .up_ptr = try ar.upload(std.mem.sliceAsBytes(ptrs[E .. 2 * E])),
+        .down_ptr = try ar.upload(std.mem.sliceAsBytes(ptrs[2 * E ..])),
+        .gate_k2 = try ar.upload(std.mem.sliceAsBytes(k2s[0..E])),
+        .up_k2 = try ar.upload(std.mem.sliceAsBytes(k2s[E .. 2 * E])),
+        .down_k2 = try ar.upload(std.mem.sliceAsBytes(k2s[2 * E ..])),
+        .suh_g = try ar.upload(std.mem.sliceAsBytes(st[0].items)),
+        .suh_u = try ar.upload(std.mem.sliceAsBytes(st[1].items)),
+        .svh_g = try ar.upload(std.mem.sliceAsBytes(st[2].items)),
+        .svh_u = try ar.upload(std.mem.sliceAsBytes(st[3].items)),
+        .suh_d = try ar.upload(std.mem.sliceAsBytes(st[4].items)),
+        .svh_d = try ar.upload(std.mem.sliceAsBytes(st[5].items)),
+        .count = E,
+        .dims = dims,
+        .width = width,
+        .k2_gu = .{ lo[0], hi[0] },
+        .k2_d = .{ lo[1], hi[1] },
+        .host_ptr = ptrs,
+        .host_k2 = k2s,
+    };
+}
+
+fn readFile(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, name: []const u8) ![]u8 {
+    const path = try std.fs.path.join(gpa, &.{ dir, name });
+    defer gpa.free(path);
+    return std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 22));
+}
diff --git a/zig/src/families/muse_spark/m1_main.zig b/zig/src/families/muse_spark/m1_main.zig
new file mode 100644
index 00000000..b670032e
--- /dev/null
+++ b/zig/src/families/muse_spark/m1_main.zig
@@ -0,0 +1,313 @@
+//! tf-muse: teacher-forced decode rows against an answer key, its checks and `follow` (docs/recipes/muse-spark.md).
+
+const std = @import("std");
+const cuda = @import("cuda");
+const tp = @import("tp");
+const muse = @import("muse_spark");
+const pair = @import("pair.zig");
+const draft_main = @import("draft_main.zig");
+const prompt_main = @import("prompt_main.zig");
+const Model = muse.forward.Model;
+
+fn env(name: [*:0]const u8, default: usize) usize {
+    const v = std.c.getenv(name) orelse return default;
+    return std.fmt.parseInt(usize, std.mem.span(v), 10) catch default;
+}
+
+const Text = struct {
+    name: []const u8,
+    ids: []i32,
+    states: ?[]f32 = null, // teacher: [L + 1, T, D]
+    logits: []f32, // [T, V]
+    res: ?[]f32 = null, // [L, T, D]
+    attn: ?[]f32 = null,
+    greedy: std.ArrayList(i32) = .empty,
+    fed: usize = 0,
+    last: usize = 0, // row of its last logits in the window buffer
+};
+
+const Win = struct { text: usize, pos: usize };
+
+const Ctx = struct {
+    d: *const cuda.Driver,
+    s: cuda.Stream,
+    texts: []Text,
+    win: []Win,
+    layers: usize,
+    D: usize,
+    host: []f32, // [R, D]
+};
+
+fn hook(ctx: *anyopaque, what: Model.Tap, layer: usize, dev: u64, n: usize) anyerror!void {
+    const c: *Ctx = @ptrCast(@alignCast(ctx));
+    const D = c.D;
+    switch (what) {
+        .input => {
+            for (c.win[0..n], 0..) |w, r| {
+                const t = c.texts[w.text];
+                const st = t.states orelse return error.NoTeacher;
+                const T = t.ids.len;
+                if (w.pos >= T) { // greedy rows: keep ours
+                    try c.s.synchronize();
+                    try c.d.check(c.d.api.cuMemcpyDtoH_v2(@ptrCast(c.host[r * D ..].ptr), dev + r * D * 4, D * 4), "teacher keep");
+                    continue;
+                }
+                @memcpy(c.host[r * D ..][0..D], st[(layer * T + w.pos) * D ..][0..D]);
+            }
+            try c.s.synchronize();
+            try c.d.check(c.d.api.cuMemcpyHtoD_v2(dev, @ptrCast(c.host.ptr), n * D * 4), "teacher");
+        },
+        .attn, .mlp => {
+            try c.s.synchronize();
+            try c.d.check(c.d.api.cuMemcpyDtoH_v2(@ptrCast(c.host.ptr), dev, n * D * 4), "capture");
+            for (c.win[0..n], 0..) |w, r| {
+                const t = c.texts[w.text];
+                const T = t.ids.len;
+                if (w.pos >= T) continue;
+                const dst = (if (what == .mlp) t.res else t.attn) orelse continue;
+                @memcpy(dst[(layer * T + w.pos) * D ..][0..D], c.host[r * D ..][0..D]);
+            }
+        },
+    }
+}
+
+fn readAll(gpa: std.mem.Allocator, io: std.Io, path: []const u8) ![]u8 {
+    return std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 34));
+}
+
+fn writeAll(io: std.Io, path: []const u8, bytes: []const u8) !void {
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = path, .data = bytes });
+}
+
+fn argmax(xs: []const f32) i32 {
+    var best: usize = 0;
+    for (xs, 0..) |x, i| if (x > xs[best]) {
+        best = i;
+    };
+    return @intCast(best);
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len >= 3 and std.mem.eql(u8, args[1], "follow")) return follow(init.gpa, init.io, args[2], if (args.len >= 4) args[3] else null);
+    const mode: ?draft_main.Mode = if (args.len >= 2) std.meta.stringToEnum(draft_main.Mode, args[1]) else null;
+    const prompt_check = args.len >= 2 and std.mem.eql(u8, args[1], "prompt");
+    if (args.len < 5 or (mode == null and !prompt_check and !std.mem.eql(u8, args[1], "m1"))) {
+        std.debug.print("usage: tf-muse m1 MODEL IN_DIR OUT_DIR   (knobs: MUSE_ROWS, MUSE_SLOTS, MUSE_LAYERS, MUSE_CONTEXT, MUSE_GREEDY, MUSE_CAPTURE, MUSE_TEACHER, MUSE_GRAPHS)\n" ++
+            "       tf-muse dflash|drafted MODEL IN_DIR OUT_DIR   (the DFlash2 drafter's gates, TF_MUSE_DRAFTER: draft_main.zig)\n" ++
+            "       tf-muse prompt MODEL IN_DIR OUT_DIR   (the prompt path against decode rows: prompt_main.zig)\n" ++
+            "       tf-muse follow MODEL [DRAFTER]   (TP rank 1 behind tensorfold-native serve on rank 0; TF_TP_* as rank 0's;\n" ++
+            "                                        DRAFTER: rank 0's --drafter, else MODEL/dflash2)\n", .{});
+        return 2;
+    }
+    const gpa = init.gpa;
+    const ar = init.arena.allocator();
+    const io = init.io;
+    const rows_per = env("MUSE_ROWS", 1);
+    const slots = env("MUSE_SLOTS", 1);
+    const context = env("MUSE_CONTEXT", 4096);
+    const n_greedy = env("MUSE_GREEDY", 32);
+    const capture = env("MUSE_CAPTURE", 0) != 0;
+    const teacher = env("MUSE_TEACHER", 0) != 0;
+    const graphs = env("MUSE_GRAPHS", 0) != 0; // graphed windows (no captures): logits must equal the eager run's bits
+    if (graphs and (capture or teacher)) return error.GraphsTakeNoCaptures;
+    const max_layers: ?usize = if (env("MUSE_LAYERS", 0) > 0) env("MUSE_LAYERS", 0) else null;
+    if (rows_per * slots > muse.forward.DECODE_ROWS) return error.WindowTooWide;
+
+    const kn: Knobs = .{ .rows_per = rows_per, .slots = slots, .context = context, .n_greedy = n_greedy, .capture = capture, .teacher = teacher, .graphs = graphs, .max_layers = max_layers, .mode = mode, .dk = .{ .context = env("MUSE_CONTEXT", 8192), .n_greedy = env("MUSE_GREEDY", 64), .graphs = env("MUSE_GRAPHS", 1) != 0 and env("MUSE_PAIR", 0) == 0, .max_layers = max_layers, .rows_per = env("MUSE_ROWS", 32), .dump_taps = env("MUSE_DUMP_TAPS", 0) != 0 }, .prompt = prompt_check };
+    const pair_mode = env("MUSE_PAIR", 0) != 0; // both ranks of TP=2 in this process on one GPU (an in-process gather)
+    const tpc: ?tp.Config = if (!pair_mode and std.c.getenv("TF_TP_WORLD") != null) try tp.Config.fromEnv() else null;
+    const world: usize = if (pair_mode) 2 else if (tpc) |c| c.world else 1;
+    const rank: usize = if (tpc) |c| c.rank else 0;
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, if (tpc) |c| @intCast(c.device) else 0);
+    defer ctx.deinit();
+    if (pair_mode) {
+        if (graphs and mode == null) return error.PairIsEager; // the in-process gather syncs on the host
+        var pr: pair.Pair = .{ .d = &driver };
+        var r1: pair.Rank = .{ .pair = &pr, .rank = 1 };
+        var r0: pair.Rank = .{ .pair = &pr, .rank = 0 };
+        var err1: ?anyerror = null;
+        const th = try std.Thread.spawn(.{}, pairRank, .{ gpa, io, &driver, &ctx, args, kn, r1.collective(), &err1 });
+        runRank(gpa, ar, io, &driver, args, 0, 2, r0.collective(), kn) catch |e| {
+            pr.abort();
+            th.join();
+            return e;
+        };
+        th.join();
+        if (err1) |e| return e;
+        std.debug.print("DONE m1 pair\n", .{});
+        return 0;
+    }
+    var session: tp.Session = undefined;
+    if (world > 1) try session.open(&driver, tpc.?, @import("tp_kernel").mailbox);
+    // a failed rank only closes: its hang-up fails the peer fast (exit 70) instead of leaving it in a collective
+    defer if (world > 1) session.close();
+    try runRank(gpa, ar, io, &driver, args, rank, world, if (world > 1) session.comm() else null, kn);
+    if (world > 1) { // the stop: rank 0 (dumps written) announces it, then both meet, so neither close fails the other
+        if (rank == 0) session.announceStop();
+        try session.comm().barrier();
+        std.debug.print("STOPPED rank {d}: both ranks done\n", .{rank});
+    }
+    return 0;
+}
+
+const Knobs = struct { rows_per: usize, slots: usize, context: usize, n_greedy: usize, capture: bool, teacher: bool, graphs: bool, max_layers: ?usize, mode: ?draft_main.Mode = null, dk: draft_main.Knobs, prompt: bool = false };
+
+fn pairRank(gpa: std.mem.Allocator, io: std.Io, driver: *const cuda.Driver, ctx: *const cuda.Context, args: []const [:0]const u8, kn: Knobs, comm: tp.Collective, err: *?anyerror) void {
+    ctx.makeCurrent() catch |e| {
+        err.* = e;
+        return;
+    };
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    runRank(gpa, arena.allocator(), io, driver, args, 1, 2, comm, kn) catch |e| {
+        std.debug.print("[m1] rank 1: {s}\n", .{@errorName(e)});
+        err.* = e;
+        comm.vtable.abort(comm.ptr); // rank 0 leaves its next gather instead of waiting forever
+    };
+}
+
+/// One rank's m1: load, every text's windows, rank 0 writes the dumps.
+fn runRank(gpa: std.mem.Allocator, ar: std.mem.Allocator, io: std.Io, driver: *const cuda.Driver, args: []const [:0]const u8, rank: usize, world: usize, comm: ?tp.Collective, kn: Knobs) !void {
+    if (kn.mode) |md| return draft_main.run(md, gpa, ar, io, driver, args, rank, world, comm, kn.dk);
+    if (kn.prompt) return prompt_main.run(gpa, ar, io, driver, args, rank, world, comm);
+    var s = try cuda.Stream.init(driver, false);
+    defer s.deinit();
+    const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    var w = try muse.load.load(gpa, io, driver, args[2], rank, world, .{ .max_layers = kn.max_layers, .log = rank == 0 });
+    defer w.deinit();
+    var k3 = try muse.exl3.Kernels.load(driver);
+    defer k3.deinit();
+    var model = try Model.init(gpa, driver, &w, &k3, comm, kn.context, kn.rows_per * kn.slots, kn.slots, s);
+    defer model.deinit();
+    const L = w.layers.len;
+    const D = w.cfg.hidden;
+    const V = w.full.vocab;
+    std.debug.print("[m1] rank {d}/{d}: loaded {d} layers in {d:.0}s ({d:.1} GiB weights, {d:.1} GiB model buffers); rows {d} x slots {d}, context {d}\n", .{ rank, world, L, @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e9, @as(f64, @floatFromInt(w.arena.total)) / (1 << 30), @as(f64, @floatFromInt(model.arena.total)) / (1 << 30), kn.rows_per, kn.slots, kn.context });
+
+    // texts
+    const names_path = try std.fs.path.join(ar, &.{ args[3], "names.txt" });
+    const names_text = try readAll(ar, io, names_path);
+    var texts: std.ArrayList(Text) = .empty;
+    var it = std.mem.tokenizeAny(u8, names_text, " \r\n\t");
+    while (it.next()) |name| {
+        const raw = try readAll(ar, io, try std.fmt.allocPrint(ar, "{s}/{s}.ids", .{ args[3], name }));
+        const ids = try ar.alloc(i32, raw.len / 4);
+        @memcpy(std.mem.sliceAsBytes(ids), raw[0 .. ids.len * 4]);
+        if (ids.len + kn.n_greedy > kn.context) return error.TextTooLong;
+        var t: Text = .{ .name = name, .ids = ids, .logits = try gpa.alloc(f32, ids.len * V) };
+        if (kn.teacher) {
+            const st = try readAll(gpa, io, try std.fmt.allocPrint(ar, "{s}/{s}.states.f32", .{ args[3], name }));
+            if (st.len < L * ids.len * D * 4) return error.TeacherStatesShort;
+            t.states = @alignCast(std.mem.bytesAsSlice(f32, st));
+        }
+        if (kn.capture) {
+            t.res = try gpa.alloc(f32, L * ids.len * D);
+            t.attn = try gpa.alloc(f32, L * ids.len * D);
+        }
+        try texts.append(ar, t);
+    }
+    const R = kn.rows_per * kn.slots;
+    const win = try ar.alloc(Win, R);
+    const host = try ar.alloc(f32, R * D);
+    const out = try gpa.alloc(f32, R * V);
+    defer gpa.free(out);
+    var cc: Ctx = .{ .d = driver, .s = s, .texts = texts.items, .win = win, .layers = L, .D = D, .host = host };
+    const cap: ?Model.Capture = if (kn.capture or kn.teacher) .{ .hook = &hook, .ctx = &cc, .teacher = kn.teacher } else null;
+
+    const t1 = std.Io.Clock.awake.now(io).toNanoseconds();
+    var windows: usize = 0;
+    var total_rows: usize = 0;
+    var b: usize = 0;
+    while (b < texts.items.len) : (b += kn.slots) {
+        const batch = texts.items[b..@min(b + kn.slots, texts.items.len)];
+        while (true) {
+            var rows: std.ArrayList(muse.forward.Row) = .empty;
+            defer rows.deinit(gpa);
+            for (batch, 0..) |*t, j| {
+                const T = t.ids.len;
+                if (t.fed < T) {
+                    const k = @min(kn.rows_per, T - t.fed);
+                    for (0..k) |q| {
+                        win[rows.items.len] = .{ .text = b + j, .pos = t.fed + q };
+                        try rows.append(gpa, .{ .slot = @intCast(j), .pos = @intCast(t.fed + q), .token = t.ids[t.fed + q] });
+                    }
+                    t.fed += k;
+                    t.last = rows.items.len - 1;
+                } else if (t.greedy.items.len < kn.n_greedy) {
+                    const nxt = argmax(out[t.last * V ..][0..V]);
+                    try t.greedy.append(gpa, nxt);
+                    if (t.greedy.items.len == kn.n_greedy or w.full.isEos(@intCast(nxt))) {
+                        if (w.full.isEos(@intCast(nxt))) while (t.greedy.items.len < kn.n_greedy) try t.greedy.append(gpa, -1);
+                        continue;
+                    }
+                    win[rows.items.len] = .{ .text = b + j, .pos = t.fed };
+                    try rows.append(gpa, .{ .slot = @intCast(j), .pos = @intCast(t.fed), .token = nxt });
+                    t.fed += 1;
+                    t.last = rows.items.len - 1;
+                }
+            }
+            if (rows.items.len == 0) break;
+            if (kn.graphs) try model.graphed(s, rows.items, out[0 .. rows.items.len * V]) else try model.forward(s, rows.items, out[0 .. rows.items.len * V], cap);
+            windows += 1;
+            total_rows += rows.items.len;
+            for (rows.items, win[0..rows.items.len], 0..) |r, wv, i| {
+                const t = &texts.items[wv.text];
+                if (r.pos < t.ids.len) @memcpy(t.logits[r.pos * V ..][0..V], out[i * V ..][0..V]);
+            }
+        }
+    }
+    const secs = @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t1)) / 1e9;
+    std.debug.print("[m1] {d} windows, {d} rows in {d:.1}s ({s}; not a speed number); graphs captured {d}, replayed {d}\n", .{ windows, total_rows, secs, if (kn.graphs) "graphed" else "eager", model.captures, model.replays });
+    for (texts.items) |*t| if (rank == 0) {
+        try writeAll(io, try std.fmt.allocPrint(ar, "{s}/{s}.logits.f32", .{ args[4], t.name }), std.mem.sliceAsBytes(t.logits));
+        try writeAll(io, try std.fmt.allocPrint(ar, "{s}/{s}.greedy.i32", .{ args[4], t.name }), std.mem.sliceAsBytes(t.greedy.items));
+        if (t.res) |x| try writeAll(io, try std.fmt.allocPrint(ar, "{s}/{s}.res.f32", .{ args[4], t.name }), std.mem.sliceAsBytes(x));
+        if (t.attn) |x| try writeAll(io, try std.fmt.allocPrint(ar, "{s}/{s}.attn.f32", .{ args[4], t.name }), std.mem.sliceAsBytes(x));
+        std.debug.print("[m1] {s}: {d} tokens, greedy {any}\n", .{ t.name, t.ids.len, t.greedy.items[0..@min(8, t.greedy.items.len)] });
+    };
+    for (texts.items) |*t| {
+        gpa.free(t.logits);
+        if (t.res) |x| gpa.free(x);
+        if (t.attn) |x| gpa.free(x);
+        if (t.states) |x| gpa.free(std.mem.sliceAsBytes(x));
+        t.greedy.deinit(gpa);
+    }
+    std.debug.print("DONE m1 rank {d}\n", .{rank});
+}
+
+/// Rank 1 behind the native server: the model rank 0 announces (hello), then every step rank 0 sends, until it stops.
+fn follow(gpa: std.mem.Allocator, io: std.Io, model_dir: []const u8, drafter: ?[]const u8) !u8 {
+    const cfg = try tp.Config.fromEnv();
+    if (cfg.world < 2 or cfg.rank == 0) return error.FollowNeedsRankOne;
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, @intCast(cfg.device));
+    defer ctx.deinit();
+    var session: tp.Session = undefined;
+    try session.open(&driver, cfg, @import("tp_kernel").mailbox);
+    defer {
+        session.announceStop();
+        session.close();
+    }
+    var buf: std.ArrayList(i64) = .empty;
+    defer buf.deinit(gpa);
+    const su = try muse.engine.setupOf(try session.plan.recvGrow(gpa, &buf));
+    std.debug.print("[follow] rank {d}: context {d}, {d} slots\n", .{ cfg.rank, su.context, su.slots });
+    const e = try muse.engine.Engine.init(gpa, io, &driver, model_dir, su, &session, drafter);
+    defer e.deinit();
+    std.debug.print("[follow] loaded; following\n", .{});
+    var steps: usize = 0;
+    while (true) {
+        const words = session.plan.recvGrow(gpa, &buf) catch |err| switch (err) {
+            error.PeerClosed => break,
+            else => return err,
+        };
+        if (!try e.follow(words)) break;
+        steps += 1;
+    }
+    std.debug.print("[follow] stopped after {d} steps\n", .{steps});
+    return 0;
+}
