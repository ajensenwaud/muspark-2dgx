From 27ebf3c0bacf6e95326ce9aeca91153754f31aec Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Sun, 11 Oct 2026 19:03:59 +0700
Subject: [PATCH 12/60] TP RoCE: no RDMA write past 1 MiB, and boot refuses any
 setting that would ask for one

A post of about 9.6 MB faulted a DGX Spark's HCA. roce_guard.max_write (1 MiB, a constant) is checked in stripes()
before the slot bounds, so the verbs wire, the shm wire and the proxy refuse a larger post with error.WriteTooLarge
before any verb, whatever the slot size. Roce.init refuses a slot past it. Config.parse fails boot with a clear
message when TF_TP_MAILBOX_MAX_KB would make the RoCE slot pass 1 MiB; the value is never clamped.

Tests: a 9.57 MB and a 1 MiB + 16 post are refused in a 10 MiB slot and reach no verb, a 1 MiB post goes out; boot
refuses TF_TP_MAILBOX_MAX_KB 1028, 2048 and 16384 and keeps 1024.

(cherry picked from commit 649e78800076019d521213b00048d80175c401b7)
---
 zig/src/fabric/tp/config.zig         |  7 ++++
 zig/src/fabric/tp/roce.zig           |  1 +
 zig/src/fabric/tp/roce_fake.zig      |  7 ++--
 zig/src/fabric/tp/roce_guard.zig     | 12 ++++++-
 zig/src/fabric/tp/roce_post_test.zig | 48 ++++++++++++++++++++++++++--
 5 files changed, 69 insertions(+), 6 deletions(-)

diff --git a/zig/src/fabric/tp/config.zig b/zig/src/fabric/tp/config.zig
index ddc0c2a1..d8232977 100644
--- a/zig/src/fabric/tp/config.zig
+++ b/zig/src/fabric/tp/config.zig
@@ -16,6 +16,9 @@ pub const Fallback = enum { nccl, @"error" };
 
 pub const Error = error{BadSetting};
 
+/// RoCE's per-write cap (roce_guard.max_write): on the roce backend a slot past it fails boot, never clamped.
+pub const max_rdma_write: usize = @import("roce_guard.zig").max_write;
+
 /// TF_TP_PLAN_PIN: the CPU the plan threads pin to at their first plan (auto: the highest cpu_capacity).
 pub const PlanPin = union(enum) { auto, cpu: u32 };
 
@@ -76,6 +79,10 @@ pub const Config = struct {
             return error.BadSetting;
         };
         c.mailbox_max_bytes = 1024 * try int(usize, get, "TF_TP_MAILBOX_MAX_KB", 256, 4, 16 * 1024);
+        if (c.backend == .roce and c.mailbox_max_bytes > max_rdma_write) {
+            log.warn("TF_TP_MAILBOX_MAX_KB={d}: a RoCE write is capped at {d} KiB; refusing to start", .{ c.mailbox_max_bytes / 1024, max_rdma_write / 1024 });
+            return error.BadSetting;
+        }
         c.mailbox_timeout_ns = try seconds(get, "TF_TP_MAILBOX_TIMEOUT_S", 120, 0.001, 86400);
         if (get("TF_TP_FAILFAST")) |v| c.failfast = !(std.mem.eql(u8, v, "0") or std.mem.eql(u8, v, "off"));
         c.grace_ns = try seconds(get, "TF_TP_FAILFAST_GRACE_S", 1.0, 0, 60);
diff --git a/zig/src/fabric/tp/roce.zig b/zig/src/fabric/tp/roce.zig
index 7806fd60..e3695929 100644
--- a/zig/src/fabric/tp/roce.zig
+++ b/zig/src/fabric/tp/roce.zig
@@ -142,6 +142,7 @@ pub const Roce = struct {
     /// Both ranks call it after the bootstrap; any rank failing makes all return `error.RoceUnavailable` (collective).
     pub fn init(d: ?*const cuda.Driver, b: *Bootstrap, image: []const u8, o: Options) !*Roce {
         if (b.world != 2) return error.Unsupported;
+        if (o.max_bytes > guard.max_write) return error.WriteTooLarge; // a slot no post could fill in one write
         const slot = std.mem.alignForward(usize, o.max_bytes, 4096);
         const len = regionBytes(slot);
         const r = try std.heap.page_allocator.create(Roce);
diff --git a/zig/src/fabric/tp/roce_fake.zig b/zig/src/fabric/tp/roce_fake.zig
index e556c199..a6b02db7 100644
--- a/zig/src/fabric/tp/roce_fake.zig
+++ b/zig/src/fabric/tp/roce_fake.zig
@@ -10,6 +10,8 @@ pub const send_off = 8192;
 /// What the HCAs hold (posted, not completed); every count comes from the work requests themselves.
 pub const Fake = struct {
     pub var region: []const u8 = &.{};
+    /// The wire's slot (`Hw.wire`), every data write's bound with the send slots.
+    pub var slot_bytes: u64 = slot;
     pub var lag: u32 = 1;
     pub var polls: u64 = 0;
     pub var queue: [2][512]u64 = undefined;
@@ -44,7 +46,7 @@ pub const Fake = struct {
             if (w.send_flags & abi.send_inline == 0) {
                 const sge = w.sg_list[0];
                 const lo = @intFromPtr(region.ptr);
-                if (sge.addr < lo + send_off or sge.addr + sge.length > lo + send_off + 2 * slot) outside += 1;
+                if (sge.addr < lo + send_off or sge.addr + sge.length > lo + send_off + 2 * slot_bytes) outside += 1;
                 max_write = @max(max_write, sge.length);
                 sum += sge.length;
             }
@@ -82,7 +84,8 @@ pub const Hw = struct {
     mr: [2]abi.Mr = undefined,
 
     pub fn wire(hw: *Hw, region: []u8) rv.VerbsWire {
-        var w: rv.VerbsWire = .{ .v = undefined, .traffic_class = 0, .recv_off = send_off + 2 * slot, .flag_off = 4096, .send_off = send_off, .slot_bytes = slot, .region = region };
+        const s = Fake.slot_bytes;
+        var w: rv.VerbsWire = .{ .v = undefined, .traffic_class = 0, .recv_off = send_off + 2 * s, .flag_off = 4096, .send_off = send_off, .slot_bytes = s, .region = region };
         for (0..2) |i| {
             hw.ctx[i].ops = .{ ._before_poll = @splat(null), .poll_cq = Fake.pollCq, ._before_post = @splat(null), .post_send = Fake.postSend, .post_recv = undefined, ._after = @splat(null) };
             hw.qp[i].qp_num = @intCast(i);
diff --git a/zig/src/fabric/tp/roce_guard.zig b/zig/src/fabric/tp/roce_guard.zig
index 6851f9a6..8f85247a 100644
--- a/zig/src/fabric/tp/roce_guard.zig
+++ b/zig/src/fabric/tp/roce_guard.zig
@@ -4,7 +4,10 @@ const std = @import("std");
 pub const max_hcas = 2;
 pub const flag_stride = 128;
 
-pub const Error = error{OutOfRegion};
+pub const Error = error{ OutOfRegion, WriteTooLarge };
+
+/// The largest RDMA write a post may make, whatever the slot (a 9.6 MB post faulted a DGX Spark's HCA); never raised.
+pub const max_write: u32 = 1 << 20;
 
 /// Both ranks' region layout (roce.zig's): byte offsets and the registered length every post must stay inside.
 pub const Layout = struct { send: u64, recv: u64, flags: u64, slot: u64, len: u64 };
@@ -15,6 +18,7 @@ pub const Stripe = struct { local: u64, remote: u64, len: u32, flag: u64 };
 /// Slot `slot`'s first `padded` bytes striped over `n_hca` HCAs; error.OutOfRegion before any verb past a slot or MR.
 pub fn stripes(l: Layout, n_hca: u32, slot: u32, padded: u32, out: *[max_hcas]Stripe) Error!void {
     if (n_hca == 0 or n_hca > max_hcas or slot > 1) return error.OutOfRegion;
+    if (padded > max_write) return error.WriteTooLarge;
     if (padded == 0 or padded % 16 != 0 or padded > l.slot) return error.OutOfRegion;
     const packs = padded / 16;
     var offset: u64 = 0;
@@ -57,6 +61,12 @@ test "a post past its slot, a third slot, an unpadded or empty post, or no HCA i
     try std.testing.expectError(error.OutOfRegion, stripes(l, 2, 0, 0, &s));
     try std.testing.expectError(error.OutOfRegion, stripes(l, 0, 0, 16, &s));
     try std.testing.expectError(error.OutOfRegion, stripes(l, 3, 0, 16, &s));
+    var big = l;
+    big.slot = 10 << 20;
+    big.recv = big.send + 2 * big.slot;
+    big.len = big.send + 4 * big.slot;
+    try std.testing.expectError(error.WriteTooLarge, stripes(big, 2, 0, max_write + 16, &s));
+    try stripes(big, 2, 0, max_write, &s);
     var short = l;
     short.len -= 16;
     try std.testing.expectError(error.OutOfRegion, stripes(short, 2, 1, @intCast(l.slot), &s));
diff --git a/zig/src/fabric/tp/roce_post_test.zig b/zig/src/fabric/tp/roce_post_test.zig
index fe931e1e..3e815c2c 100644
--- a/zig/src/fabric/tp/roce_post_test.zig
+++ b/zig/src/fabric/tp/roce_post_test.zig
@@ -2,19 +2,61 @@
 const std = @import("std");
 const fake = @import("roce_fake.zig");
 const Roce = @import("roce.zig").Roce;
+const Config = @import("config.zig").Config;
 const Fake = fake.Fake;
 
 test "a post past its slot is refused before any verb; a full slot posts inside the region" {
-    const region = try std.testing.allocator.alignedAlloc(u8, .fromByteUnits(4096), Roce.regionBytes(fake.slot));
+    const small: u64 = 64 << 10;
+    const region = try std.testing.allocator.alignedAlloc(u8, .fromByteUnits(4096), Roce.regionBytes(small));
     defer std.testing.allocator.free(region);
     Fake.region = region;
+    Fake.slot_bytes = small;
+    defer Fake.slot_bytes = fake.slot;
     Fake.reset(1);
     var hw: fake.Hw = .{};
     var w = hw.wire(region);
-    try std.testing.expectError(error.OutOfRegion, w.post(1, 1, fake.slot + 16));
+    try std.testing.expectError(error.OutOfRegion, w.post(1, 1, small + 16));
     try std.testing.expectError(error.OutOfRegion, w.post(2, 1, 16));
     try std.testing.expectEqual(@as(u64, 0), Fake.posts);
-    try w.post(1, 1, fake.slot);
+    try w.post(1, 1, small);
     try std.testing.expectEqual(@as(u64, 2), Fake.posts);
     try std.testing.expectEqual(@as(u64, 0), Fake.outside);
 }
+
+test "no RDMA write past 1 MiB, whatever the slot: a 9.57 MB and a 1 MiB + 16 post refused in a 10 MiB slot" {
+    const big: u64 = 10 << 20;
+    const region = try std.testing.allocator.alignedAlloc(u8, .fromByteUnits(4096), Roce.regionBytes(big));
+    defer std.testing.allocator.free(region);
+    Fake.region = region;
+    Fake.slot_bytes = big;
+    defer Fake.slot_bytes = fake.slot;
+    Fake.reset(1);
+    var hw: fake.Hw = .{};
+    var w = hw.wire(region);
+    try std.testing.expectError(error.WriteTooLarge, w.post(0, 1, 9_568_256));
+    try std.testing.expectError(error.WriteTooLarge, w.post(1, 1, (1 << 20) + 16));
+    try std.testing.expectEqual(@as(u64, 0), Fake.posts);
+    try w.post(0, 1, 1 << 20);
+    try std.testing.expectEqual(@as(u64, 1 << 20), Fake.max_write * 2);
+}
+
+const Env = struct {
+    var pairs: []const [2][]const u8 = &.{};
+
+    fn get(name: []const u8) ?[]const u8 {
+        for (pairs) |p| if (std.mem.eql(u8, p[0], name)) return p[1];
+        return null;
+    }
+};
+
+test "boot refuses a RoCE slot past 1 MiB (TF_TP_MAILBOX_MAX_KB), never clamping it" {
+    for ([_][]const u8{ "1028", "2048", "16384" }) |kb| {
+        Env.pairs = &.{ .{ "TF_COMM_BACKEND", "roce" }, .{ "TF_TP_MAILBOX_MAX_KB", kb } };
+        try std.testing.expectError(error.BadSetting, Config.parse(&Env.get));
+    }
+    Env.pairs = &.{ .{ "TF_COMM_BACKEND", "roce" }, .{ "TF_TP_MAILBOX_MAX_KB", "1024" } };
+    try std.testing.expectEqual(@as(usize, 1 << 20), (try Config.parse(&Env.get)).mailbox_max_bytes);
+    // the cap is RoCE's: the same-host mailbox keeps its larger slots
+    Env.pairs = &.{ .{ "TF_COMM_BACKEND", "mailbox" }, .{ "TF_TP_MAILBOX_MAX_KB", "4096" } };
+    try std.testing.expectEqual(@as(usize, 4 << 20), (try Config.parse(&Env.get)).mailbox_max_bytes);
+}
