+        }
+        return out.buffered();
+    }
+
+    /// The QPs to error: the HCAs stop sending and refuse the peer's writes, and what was posted completes as flushed.
+    pub fn halt(w: *VerbsWire) bool {
+        var ok = true;
+        for (w.hcas[0..w.n_hca]) |h| {
+            var a: abi.QpAttr = .{ .qp_state = abi.qps_err };
