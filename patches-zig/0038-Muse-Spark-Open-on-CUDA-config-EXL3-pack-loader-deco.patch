diff --git a/zig/src/families/muse_spark/config.zig b/zig/src/families/muse_spark/config.zig
new file mode 100644
index 00000000..8c0edfc0
--- /dev/null
+++ b/zig/src/families/muse_spark/config.zig
@@ -0,0 +1,304 @@
+//! Muse Spark Open's checkpoint facts (text model) and a rank's share of its EXL3 pack, as exllamav3's muse_spark reads them.
+
+const std = @import("std");
+
+pub const model_type = "muse_spark";
+pub const text_type = "muse_spark_text";
+pub const max_layers = 64;
+/// The tensors' prefix in the pack: the text model of the multimodal checkpoint.
+pub const prefix = "model.language_model.";
+
+pub const Config = struct {
+    layers: usize,
+    hidden: usize, // 8192
+    heads: usize, // query heads; a rank's under TP
+    kv_heads: usize,
+    head_dim: usize, // 64
+    window: usize, // past keys a sliding row sees: sliding_window - 1 (the reference mask counts the row itself)
+    full: [max_layers]bool = @splat(false), // full attention, else sliding
+    theta: [max_layers]f64 = @splat(0), // RoPE theta of the layer, 0 = NoPE
+    latent: usize, // moe_hidden_size: the experts' model width (4096)
+    width: usize, // moe_intermediate_size: an expert's width; a rank's under TP
+    experts: usize,
+    top_k: usize,
+    vocab: usize, // real tokens; the head's rows are padded to a multiple of 128
+    eps: f64, // rms_norm_eps: input, pre-ffn, pre-expert, qk, o and final norms
+    post_eps: f64, // post_norm_eps: post-attention, post-ffn and post-expert norms
+    qk_scale: f64, // qk_scale_factor: folds into the softmax scale
+    out_mult: f64, // output_multiplier: router logits and head pre-scale
+    softcap: f64, // final_logit_softcapping, 0 = none
+    gate_temp: f64, // residual_gate_temperature
+    route_scale: f64, // routed_scaling_factor
+    eos: [4]u32 = @splat(0),
+    eos_len: usize = 0,
+
+    pub fn isEos(c: Config, t: u32) bool {
+        return std.mem.indexOfScalar(u32, c.eos[0..c.eos_len], t) != null;
+    }
+    pub fn rope(c: Config, i: usize) bool {
+        return c.theta[i] != 0;
+    }
+    /// The softmax scale: qk_scale_factor * head_dim ** -0.5 (exllamav3's sm_scale), as a Python float.
+    pub fn smScale(c: Config) f64 {
+        return c.qk_scale * std.math.pow(f64, @floatFromInt(c.head_dim), -0.5);
+    }
+
+    /// config.json (+ generation_config.json's EOS ids); refuses every variant the forward does not wire.
+    pub fn parse(gpa: std.mem.Allocator, config_json: []const u8, generation_json: ?[]const u8) !Config {
+        const parsed = try std.json.parseFromSlice(std.json.Value, gpa, config_json, .{});
+        defer parsed.deinit();
+        const top = parsed.value.object;
+        if (!std.mem.eql(u8, str(top, "model_type") orelse "", model_type)) return error.NotMuseSpark;
+        const q = if (top.get("quantization_config")) |v| v.object else return error.NotExl3;
+        if (!std.mem.eql(u8, str(q, "quant_method") orelse "", "exl3")) return error.NotExl3;
+        if (!std.mem.eql(u8, str(q, "codebook") orelse "mul1", "mul1")) return error.NotMul1;
+        const o = (top.get("text_config") orelse return error.MissingField).object;
+        if (!std.mem.eql(u8, str(o, "model_type") orelse text_type, text_type)) return error.NotMuseSpark;
+        if (boolean(o, "attention_bias") or boolean(o, "tie_word_embeddings")) return error.Unsupported;
+        if (!std.mem.eql(u8, str(o, "hidden_act") orelse "silu", "silu")) return error.UnsupportedActivation;
+        if ((int(o, "num_shared_experts") orelse 0) != 0) return error.UnsupportedRouting;
+        if (o.get("rope_parameters")) |rp| if (rp == .object) {
+            if (!std.mem.eql(u8, str(rp.object, "rope_type") orelse "default", "default")) return error.UnsupportedRope;
+        };
+        var c: Config = .{
+            .layers = try need(o, "num_hidden_layers"),
+            .hidden = try need(o, "hidden_size"),
+            .heads = try need(o, "num_attention_heads"),
+            .kv_heads = try need(o, "num_key_value_heads"),
+            .head_dim = try need(o, "head_dim"),
+            .window = (try need(o, "sliding_window")) - 1,
+            .latent = try need(o, "moe_hidden_size"),
+            .width = try need(o, "moe_intermediate_size"),
+            .experts = try need(o, "num_local_experts"),
+            .top_k = try need(o, "num_experts_per_tok"),
+            .vocab = try need(o, "vocab_size"),
+            .eps = try numNeed(o, "rms_norm_eps"),
+            .post_eps = if (o.get("post_norm_eps")) |v| num(v) else try numNeed(o, "rms_norm_eps"),
+            .qk_scale = if (o.get("qk_scale_factor")) |v| num(v) else 1.0,
+            .out_mult = if (o.get("output_multiplier")) |v| num(v) else 1.0,
+            .softcap = if (o.get("final_logit_softcapping")) |v| num(v) else 0.0,
+            .gate_temp = try numNeed(o, "residual_gate_temperature"),
+            .route_scale = if (o.get("routed_scaling_factor")) |v| num(v) else 1.0,
+        };
+        if (c.layers > max_layers) return error.TooManyLayers;
+        if (c.head_dim != 64) return error.HeadDim; // the attention kernels: a lane holds dims l and l + 32
+        if (c.heads % c.kv_heads != 0 or c.heads / c.kv_heads != 8) return error.GroupSize; // a warp a query head of the group
+        if (c.top_k > 32 or c.experts > 1024) return error.UnsupportedRouting;
+        const types = (o.get("layer_types") orelse return error.MissingField).array.items;
+        if (types.len != c.layers) return error.LayerPattern;
+        if (o.get("mlp_layer_types")) |m| for (m.array.items) |t| {
+            if (!std.mem.eql(u8, t.string, "sparse")) return error.DenseMlp;
+        };
+        var default_theta: f64 = 500000.0;
+        if (o.get("rope_parameters")) |rp| if (rp == .object) if (rp.object.get("rope_theta")) |v| {
+            default_theta = num(v);
+        };
+        const thetas: ?[]std.json.Value = if (o.get("layer_rope_theta")) |v| v.array.items else null;
+        if (thetas != null and thetas.?.len != c.layers) return error.LayerPattern;
+        for (types, 0..) |t, i| {
+            if (std.mem.eql(u8, t.string, "full_attention")) {
+                c.full[i] = true;
+            } else if (!std.mem.eql(u8, t.string, "sliding_attention")) return error.LayerPattern;
+            c.theta[i] = if (thetas) |th| num(th[i]) else default_theta;
+        }
+        if (o.get("eos_token_id")) |v| c.addEos(v);
+        if (generation_json) |g| {
+            const gp = try std.json.parseFromSlice(std.json.Value, gpa, g, .{});
+            defer gp.deinit();
+            if (gp.value.object.get("eos_token_id")) |v| c.addEos(v);
+        }
+        return c;
+    }
+
+    fn addEos(c: *Config, v: std.json.Value) void {
+        switch (v) {
+            .integer => |i| c.pushEos(@intCast(i)),
+            .array => |a| for (a.items) |x| if (x == .integer) c.pushEos(@intCast(x.integer)),
+            else => {},
+        }
+    }
+    fn pushEos(c: *Config, t: u32) void {
+        if (c.isEos(t) or c.eos_len == c.eos.len) return;
+        c.eos[c.eos_len] = t;
+        c.eos_len += 1;
+    }
+
+    /// A rank's view under tensor parallelism: heads, KV heads and the expert width split; the latent stays whole
+    /// (each rank holds the gathered latent and the per-expert sums), see docs/ZIG-MUSE.md.
+    pub fn rankView(c: Config, world: usize) !Config {
+        if (world != 1 and world != 2) return error.World;
+        if (c.heads % world != 0 or c.kv_heads % world != 0) return error.HeadsSplit;
+        if (c.width % (128 * world) != 0 or c.latent % (128 * world) != 0) return error.WidthSplit;
+        if ((c.heads / world) * c.head_dim % 128 != 0 or (c.kv_heads / world) * c.head_dim % 128 != 0) return error.HeadsSplit;
+        var r = c;
+        r.heads = c.heads / world;
+        r.kv_heads = c.kv_heads / world;
+        r.width = c.width / world;
+        return r;
+    }
+};
+
+/// One EXL3 matrix a rank loads: its tensors' prefix and the cut: outputs (`n`) or inputs (`k`).
+pub const Cut = struct {
+    prefix: []const u8,
+    axis: enum { whole, n, k } = .whole,
+    lo: usize = 0,
+    hi: usize = 0,
+};
+
+/// The layer's matrices in load order: q, k, v, gate, o, pre_expert, post_expert, then (gate, up, down) per expert.
+pub const attn_mats = 5;
+pub const latent_mats = 2;
+
+/// Every EXL3 matrix of layer `i` a rank loads; `buf` holds the prefixes (reserve it so they do not move).
+/// Under TP: q / gate / o by query heads, k / v by KV heads, the latent projections by latent halves (pre by outputs,
+/// post by inputs), experts by width (gate / up by outputs, down by inputs).
+pub fn layerCuts(full: Config, i: usize, rank: usize, world: usize, buf: *std.ArrayList(u8), gpa: std.mem.Allocator, out: *std.ArrayList(Cut)) !void {
+    const hq = full.heads / world * full.head_dim;
+    const hk = full.kv_heads / world * full.head_dim;
+    const lat = full.latent / world;
+    const wid = full.width / world;
+    const r = rank;
+    const one = struct {
+        fn f(g: std.mem.Allocator, b: *std.ArrayList(u8), o: *std.ArrayList(Cut), comptime fmt: []const u8, args: anytype, axis: @FieldType(Cut, "axis"), lo: usize, hi: usize, w: usize) !void {
+            const start = b.items.len;
+            try b.print(g, prefix ++ fmt, args);
+            try o.append(g, .{ .prefix = b.items[start..], .axis = if (w == 1) .whole else axis, .lo = lo, .hi = hi });
+        }
+    }.f;
+    try one(gpa, buf, out, "layers.{d}.self_attn.q_proj", .{i}, .n, r * hq, (r + 1) * hq, world);
+    try one(gpa, buf, out, "layers.{d}.self_attn.k_proj", .{i}, .n, r * hk, (r + 1) * hk, world);
+    try one(gpa, buf, out, "layers.{d}.self_attn.v_proj", .{i}, .n, r * hk, (r + 1) * hk, world);
+    try one(gpa, buf, out, "layers.{d}.self_attn.gate_proj", .{i}, .n, r * hq, (r + 1) * hq, world);
+    try one(gpa, buf, out, "layers.{d}.self_attn.o_proj", .{i}, .k, r * hq, (r + 1) * hq, world);
+    try one(gpa, buf, out, "layers.{d}.mlp.pre_expert_proj", .{i}, .n, r * lat, (r + 1) * lat, world);
+    try one(gpa, buf, out, "layers.{d}.mlp.post_expert_proj", .{i}, .k, r * lat, (r + 1) * lat, world);
+    for (0..full.experts) |e| {
+        try one(gpa, buf, out, "layers.{d}.mlp.experts.{d}.gate_proj", .{ i, e }, .n, r * wid, (r + 1) * wid, world);
+        try one(gpa, buf, out, "layers.{d}.mlp.experts.{d}.up_proj", .{ i, e }, .n, r * wid, (r + 1) * wid, world);
+        try one(gpa, buf, out, "layers.{d}.mlp.experts.{d}.down_proj", .{ i, e }, .k, r * wid, (r + 1) * wid, world);
+    }
+}
+
+/// lm_head's rows of a rank, on 128-row blocks of the padded head (`n` rows, 202112 = 1579 blocks: 790 + 789).
+/// The ranks' slices differ by at most one block; gathers carry `headStride` columns a rank.
+pub fn headCut(n: usize, rank: usize, world: usize) Cut {
+    if (world == 1) return .{ .prefix = "lm_head", .lo = 0, .hi = n };
+    const blocks = n / 128;
+    const first = (blocks + 1) / 2;
+    const lo = if (rank == 0) 0 else first * 128;
+    const hi = if (rank == 0) first * 128 else n;
+    return .{ .prefix = "lm_head", .axis = .n, .lo = lo, .hi = hi };
+}
+
+/// Columns a rank's head slice occupies in the gather buffer: the widest rank's.
+pub fn headStride(n: usize, world: usize) usize {
+    return if (world == 1) n else ((n / 128 + 1) / 2) * 128;
+}
+
+fn str(o: std.json.ObjectMap, k: []const u8) ?[]const u8 {
+    const v = o.get(k) orelse return null;
+    return if (v == .string) v.string else null;
+}
+fn int(o: std.json.ObjectMap, k: []const u8) ?usize {
+    const v = o.get(k) orelse return null;
+    return switch (v) {
+        .integer => |i| @intCast(i),
+        else => null,
+    };
+}
+fn need(o: std.json.ObjectMap, k: []const u8) !usize {
+    return int(o, k) orelse error.MissingField;
+}
+fn num(v: std.json.Value) f64 {
+    return switch (v) {
+        .integer => |i| @floatFromInt(i),
+        .float => |f| f,
+        .number_string => |s| std.fmt.parseFloat(f64, s) catch 0,
+        else => 0,
+    };
+}
+fn numNeed(o: std.json.ObjectMap, k: []const u8) !f64 {
+    return num(o.get(k) orelse return error.MissingField);
+}
+fn boolean(o: std.json.ObjectMap, k: []const u8) bool {
+    const v = o.get(k) orelse return false;
+    return v == .bool and v.bool;
+}
+
+// The fields Config.parse reads, as the 2-layer dry-run pack's config.json has them (text_config of Muse Spark Open).
+const fixture =
+    \\{"model_type": "muse_spark", "quantization_config": {"quant_method": "exl3", "codebook": "mul1", "bits": 2.04},
+    \\ "text_config": {"attention_bias": false, "eos_token_id": 200001, "final_logit_softcapping": 20.0, "head_dim": 64,
+    \\ "hidden_act": "silu", "hidden_size": 8192, "intermediate_size": 16384, "layer_rope_theta": [500000.0, 0],
+    \\ "layer_types": ["sliding_attention", "full_attention"], "mlp_layer_types": ["sparse", "sparse"],
+    \\ "model_type": "muse_spark_text", "moe_hidden_size": 4096, "moe_intermediate_size": 4096,
+    \\ "num_attention_heads": 128, "num_experts_per_tok": 8, "num_hidden_layers": 2, "num_key_value_heads": 16,
+    \\ "num_local_experts": 256, "num_shared_experts": 0, "output_multiplier": 0.17677669529663687, "post_norm_eps": 1e-08,
+    \\ "qk_scale_factor": 5.4730064863875, "residual_gate_temperature": 0.3, "rms_norm_eps": 1e-05,
+    \\ "rope_parameters": {"rope_theta": 500000.0, "rope_type": "default"}, "routed_scaling_factor": 1.0,
+    \\ "sliding_window": 2048, "tie_word_embeddings": false, "vocab_size": 202048}}
+;
+
+test "Config.parse reads the 2-layer pack as exllamav3's MuseSparkConfig does" {
+    const c = try Config.parse(std.testing.allocator, fixture, "{\"eos_token_id\": [200001, 200007]}");
+    try std.testing.expectEqual(@as(usize, 2), c.layers);
+    try std.testing.expectEqual(@as(usize, 2047), c.window);
+    try std.testing.expect(!c.full[0] and c.full[1]);
+    try std.testing.expect(c.rope(0) and !c.rope(1));
+    try std.testing.expectEqual(@as(f64, 500000.0), c.theta[0]);
+    try std.testing.expectEqual(@as(f64, 1e-8), c.post_eps);
+    try std.testing.expectEqualSlices(u32, &.{ 200001, 200007 }, c.eos[0..c.eos_len]);
+    try std.testing.expectApproxEqRel(@as(f64, 5.4730064863875 / 8.0), c.smScale(), 1e-15);
+    const r = try c.rankView(2);
+    try std.testing.expectEqual(@as(usize, 64), r.heads);
+    try std.testing.expectEqual(@as(usize, 8), r.kv_heads);
+    try std.testing.expectEqual(@as(usize, 2048), r.width);
+    try std.testing.expectEqual(@as(usize, 4096), r.latent);
+}
+
+test "Config.parse refuses what the forward does not wire" {
+    const a = std.testing.allocator;
+    const bad = [_][2][]const u8{
+        .{ "\"num_shared_experts\": 0", "\"num_shared_experts\": 1" },
+        .{ "\"attention_bias\": false", "\"attention_bias\": true" },
+        .{ "\"mlp_layer_types\": [\"sparse\", \"sparse\"]", "\"mlp_layer_types\": [\"dense\", \"sparse\"]" },
+        .{ "\"head_dim\": 64", "\"head_dim\": 128" },
+        .{ "\"quant_method\": \"exl3\"", "\"quant_method\": \"fp8\"" },
+    };
+    for (bad) |b| {
+        const t = try std.mem.replaceOwned(u8, a, fixture, b[0], b[1]);
+        defer a.free(t);
+        try std.testing.expect(std.meta.isError(Config.parse(a, t, null)));
+    }
+}
+
+test "rank cuts" {
+    const a = std.testing.allocator;
+    const c = try Config.parse(a, fixture, null);
+    var buf: std.ArrayList(u8) = .empty;
+    defer buf.deinit(a);
+    try buf.ensureTotalCapacity(a, 1 << 20); // prefixes slice into it: no reallocation
+    var cuts: std.ArrayList(Cut) = .empty;
+    defer cuts.deinit(a);
+    try layerCuts(c, 1, 1, 2, &buf, a, &cuts);
+    try std.testing.expectEqual(@as(usize, attn_mats + latent_mats + 3 * 256), cuts.items.len);
+    try std.testing.expectEqualStrings("model.language_model.layers.1.self_attn.q_proj", cuts.items[0].prefix);
+    try std.testing.expectEqual(@as(usize, 64 * 64), cuts.items[0].lo); // q: heads 64..127
+    try std.testing.expectEqual(@as(usize, 8 * 64), cuts.items[1].lo); // k: KV heads 8..15
+    try std.testing.expectEqual(@as(usize, 16 * 64), cuts.items[1].hi);
+    try std.testing.expect(cuts.items[4].axis == .k); // o: input columns of its heads
+    try std.testing.expectEqual(@as(usize, 2048), cuts.items[5].lo); // pre_expert_proj: latent outputs 2048..4095
+    try std.testing.expect(cuts.items[6].axis == .k); // post_expert_proj: latent inputs
+    try std.testing.expectEqual(@as(usize, 2048), cuts.items[7].lo); // expert width 4096 / 2
+    try std.testing.expectEqualStrings("model.language_model.layers.1.mlp.experts.255.down_proj", cuts.items[cuts.items.len - 1].prefix);
+    cuts.clearRetainingCapacity();
+    try layerCuts(c, 0, 0, 1, &buf, a, &cuts);
+    try std.testing.expect(cuts.items[0].axis == .whole);
+    const h0 = headCut(202112, 0, 2);
+    const h1 = headCut(202112, 1, 2);
+    try std.testing.expectEqual(@as(usize, 101120), h0.hi);
+    try std.testing.expectEqual(@as(usize, 101120), h1.lo);
+    try std.testing.expectEqual(@as(usize, 202112), h1.hi);
+    try std.testing.expectEqual(@as(usize, 101120), headStride(202112, 2));
+}
diff --git a/zig/src/families/muse_spark/forward.zig b/zig/src/families/muse_spark/forward.zig
new file mode 100644
index 00000000..7c2aef3e
--- /dev/null
+++ b/zig/src/families/muse_spark/forward.zig
@@ -0,0 +1,459 @@
+//! Muse Spark's decode forward on one GPU: windows of decode rows (any slots, any positions), EXL3 projections and
+//! experts (the MiMo-V2 kernels), hand CUDA attention and glue (kernels/cuda/muse_spark). TP=2 is planned, not wired.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const load_ = @import("load.zig");
+const exl3 = cuda.exl3;
+const Weights = load_.Weights;
+const Stream = cuda.Stream;
+
+pub const CK = 256; // keys an attention chunk
+pub const DECODE_ROWS = 128; // the EXL3 GEMV's row limit
+pub const NORM_THREADS = 1024;
+
+/// One decode row: a stream's cache slot, its position, its input token.
+pub const Row = struct { slot: u32, pos: u32, token: i64 };
+
+/// Sliding cache rows a slot keeps: the window, the row itself and a window's other rows of the same slot.
+pub fn ringSize(window: usize, rows: usize) usize {
+    return std.mem.alignForward(usize, window + 1 + rows, 64);
+}
+
+fn u(x: usize) u32 {
+    return @intCast(x);
+}
+fn ci(x: usize) c_int {
+    return @intCast(x);
+}
+
+const Bufs = struct {
+    ids: u64, // i64 [R]
+    pos: u64, // i32 [R]
+    slot: u64, // i32 [R]
+    res: u64, // f32 [R, D]
+    x: u64, // f16 [R, D]: the normed sublayer input
+    q: u64, // f16 [R, H * 64]
+    k: u64, // f16 [R, HK * 64]
+    v: u64,
+    g: u64, // f16 [R, H * 64]: the output gate's logits
+    qo: u64, // f16 [R, H * 64]
+    att: u64, // f16 [R, H * 64]: gated attention output
+    po: u64, // f32 [R, H, NCH, 64]
+    pm: u64,
+    pl: u64,
+    xh: u64, // f16 rot_in scratch [R, max K]
+    z: u64, // f32 split partials
+    part: u64, // f32 [R, D]
+    logits: u64, // f32 [R, E]
+    pick: u64, // i32 [R, K]
+    wts: u64, // f32 [R, K]
+    lat: u64, // f16 [R, latent]
+    latn: u64, // f16 [R, latent]
+    acc: u64, // f16 [R, latent]
+    head: u64, // f32 [R, head rows]
+    am: u64, // i32 [R]
+    sc: exl3.Scratch,
+};
+
+pub const Model = struct {
+    w: *const Weights,
+    d: *const cuda.Driver,
+    k3: *const exl3.Kernels,
+    glue: cuda.Module,
+    attn: cuda.Module,
+    f_embed: cuda.Function,
+    f_rms: cuda.Function,
+    f_gate: cuda.Function,
+    f_router: cuda.Function,
+    f_topk: cuda.Function,
+    f_esum: cuda.Function,
+    f_softcap: cuda.Function,
+    f_argmax: cuda.Function,
+    f_prep: cuda.Function,
+    f_rows: cuda.Function,
+    f_merge: cuda.Function,
+    context: usize,
+    ring: usize,
+    rows: usize,
+    slots: usize,
+    nch_max: usize,
+    kc: []u64,
+    vc: []u64,
+    cos: u64, // fp32 [context, 32] (one theta: every RoPE layer's)
+    sin: u64,
+    theta: f64,
+    b: Bufs,
+    arena: load_.Arena,
+    gpa: std.mem.Allocator,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const Weights, k3: *const exl3.Kernels, context: usize, rows: usize, slots: usize, s: Stream) !Model {
+        const cfg = w.cfg;
+        if (w.world != 1) return error.TensorParallelNotWired;
+        if (rows > DECODE_ROWS or rows == 0) return error.TooManyRows;
+        var m: Model = undefined;
+        m.w = w;
+        m.d = d;
+        m.k3 = k3;
+        m.context = context;
+        m.ring = ringSize(cfg.window, rows);
+        m.rows = rows;
+        m.slots = slots;
+        m.nch_max = @max((context + CK - 1) / CK, (cfg.window + 1 + CK - 1) / CK);
+        m.gpa = gpa;
+        m.arena = .{ .d = d, .gpa = gpa };
+        errdefer m.arena.deinit();
+        m.glue = try cuda.Module.load(d, cuda.kernels.muse_glue);
+        errdefer m.glue.unload();
+        m.attn = try cuda.Module.load(d, cuda.kernels.muse_attention);
+        errdefer m.attn.unload();
+        m.f_embed = try m.glue.function("muse_embed_norm");
+        m.f_rms = try m.glue.function("muse_rms");
+        m.f_gate = try m.glue.function("muse_gate_norm");
+        m.f_router = try m.glue.function("muse_router");
+        m.f_topk = try m.glue.function("muse_topk");
+        m.f_esum = try m.glue.function("muse_expert_sum");
+        m.f_softcap = try m.glue.function("muse_softcap");
+        m.f_argmax = try m.glue.function("muse_argmax");
+        m.f_prep = try m.attn.function("muse_qk_prep");
+        m.f_rows = try m.attn.function("muse_attn_rows");
+        m.f_merge = try m.attn.function("muse_attn_merge");
+        const ar = &m.arena;
+        const L = w.layers.len;
+        const HK = cfg.kv_heads;
+        const hd = cfg.head_dim;
+        m.kc = try gpa.alloc(u64, L);
+        m.vc = try gpa.alloc(u64, L);
+        for (0..L) |i| {
+            const n = if (cfg.full[i]) context else m.ring;
+            m.kc[i] = try ar.zeros(slots * n * HK * hd * 2);
+            m.vc[i] = try ar.zeros(slots * n * HK * hd * 2);
+        }
+        // RoPE tables: every RoPE layer of Muse Spark has the same theta (5e5); refuse a second one
+        m.theta = 0;
+        for (0..L) |i| if (cfg.rope(i)) {
+            if (m.theta != 0 and m.theta != cfg.theta[i]) return error.SeveralThetas;
+            m.theta = cfg.theta[i];
+        };
+        m.cos = try ar.alloc(context * (hd / 2) * 4);
+        m.sin = try ar.alloc(context * (hd / 2) * 4);
+        if (m.theta != 0) {
+            const f = try m.glue.function("muse_rope_tables");
+            var a: cuda.Args = .{};
+            a.add(m.cos);
+            a.add(m.sin);
+            a.add(ci(context));
+            a.add(m.theta);
+            a.add(ci(hd));
+            try cuda.launch.launch(f, .{ .grid = .{ .x = 256, .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+        }
+        const R = rows;
+        const D = cfg.hidden;
+        const HQ = cfg.heads * hd;
+        const HKD = HK * hd;
+        const lat = cfg.latent;
+        const vr = w.head.n;
+        var max_z: usize = zBytes(w.head, R);
+        for (w.layers) |ly| inline for (.{ "q", "k", "v", "g", "o", "pre", "post" }) |f| {
+            max_z = @max(max_z, zBytes(@field(ly, f), R));
+        };
+        var b: Bufs = undefined;
+        b.ids = try ar.zeros(R * 8);
+        b.pos = try ar.zeros(R * 4);
+        b.slot = try ar.zeros(R * 4);
+        b.res = try ar.zeros(R * D * 4);
+        b.x = try ar.zeros(R * D * 2);
+        b.q = try ar.zeros(R * HQ * 2);
+        b.k = try ar.zeros(R * HKD * 2);
+        b.v = try ar.zeros(R * HKD * 2);
+        b.g = try ar.zeros(R * HQ * 2);
+        b.qo = try ar.zeros(R * HQ * 2);
+        b.att = try ar.zeros(R * HQ * 2);
+        b.po = try ar.zeros(R * cfg.heads * m.nch_max * hd * 4);
+        b.pm = try ar.zeros(R * cfg.heads * m.nch_max * 4);
+        b.pl = try ar.zeros(R * cfg.heads * m.nch_max * 4);
+        b.xh = try ar.zeros(R * @max(D, HQ) * 2);
+        b.z = try ar.zeros(@max(max_z, 4));
+        b.part = try ar.zeros(R * D * 4);
+        b.logits = try ar.zeros(R * cfg.experts * 4);
+        b.pick = try ar.zeros(R * cfg.top_k * 4);
+        b.wts = try ar.zeros(R * cfg.top_k * 4);
+        b.lat = try ar.zeros(R * lat * 2);
+        b.latn = try ar.zeros(R * lat * 2);
+        b.acc = try ar.zeros(R * lat * 2);
+        b.head = try ar.zeros(R * vr * 4);
+        b.am = try ar.zeros(R * 4);
+        const first = w.layers[0].experts;
+        const cfg_gu = try exl3.defaultConfig(first.dims, first.width, true);
+        const cfg_d = try exl3.defaultConfig(first.width, first.dims, false);
+        const sz = exl3.Scratch.bytes(first, R, cfg.top_k, cfg_gu, cfg_d);
+        b.sc = .{ .xg = try ar.zeros(sz.xg), .xu = try ar.zeros(sz.xg), .xd = try ar.zeros(sz.xd), .z = try ar.zeros(sz.z), .y = try ar.zeros(sz.y), .ids = try ar.zeros(sz.ids), .count = try ar.zeros(4), .members = try ar.alloc(sz.members), .rows = R, .slots = cfg.top_k, .cfg_gu = cfg_gu, .cfg_d = cfg_d };
+        try d.check(d.api.cuMemsetD32_v2(b.sc.members, 0xFFFF_FFFF, sz.members / 4), "members -1");
+        m.b = b;
+        try s.synchronize();
+        return m;
+    }
+
+    fn zBytes(l: exl3.Linear, R: usize) usize {
+        return if (l.split[0] > 1) l.split[0] * R * l.n * 4 else 0;
+    }
+
+    pub fn deinit(m: *Model) void {
+        m.gpa.free(m.kc);
+        m.gpa.free(m.vc);
+        m.glue.unload();
+        m.attn.unload();
+        m.arena.deinit();
+    }
+
+    pub const Tap = enum { input, attn, mlp };
+    /// A hook per layer: `.input` before the layer (res may be overwritten: teacher forcing renormalises after it),
+    /// `.attn` after the attention gate, `.mlp` the block output. `dev`: fp32 [n, D].
+    pub const Capture = struct {
+        hook: *const fn (ctx: *anyopaque, what: Tap, layer: usize, dev: u64, n: usize) anyerror!void,
+        ctx: *anyopaque,
+        teacher: bool = false,
+    };
+
+    /// Rows' tokens, positions and slots into the fixed device inputs.
+    pub fn stage(m: *Model, rows: []const Row) !void {
+        if (rows.len == 0 or rows.len > m.rows) return error.WindowTooWide;
+        var ids: [DECODE_ROWS]i64 = undefined;
+        var pos: [DECODE_ROWS]i32 = undefined;
+        var slot: [DECODE_ROWS]i32 = undefined;
+        var per: [DECODE_ROWS]usize = @splat(0);
+        for (rows, 0..) |r, i| {
+            if (r.slot >= m.slots) return error.BadSlot;
+            if (r.pos >= m.context) return error.PastContext;
+            if (r.token < 0 or r.token >= m.w.full.vocab) return error.BadToken;
+            ids[i] = r.token;
+            pos[i] = @intCast(r.pos);
+            slot[i] = @intCast(r.slot);
+            per[r.slot] += 1;
+        }
+        for (per[0..m.slots]) |c| if (c + m.w.cfg.window + 1 > m.ring) return error.RingOverrun;
+        const n = rows.len;
+        try upload(m.d, m.b.ids, std.mem.sliceAsBytes(ids[0..n]));
+        try upload(m.d, m.b.pos, std.mem.sliceAsBytes(pos[0..n]));
+        try upload(m.d, m.b.slot, std.mem.sliceAsBytes(slot[0..n]));
+    }
+
+    /// Eager decode window: softcapped fp32 logits of every row into `out` [n, vocab] (or none).
+    pub fn forward(m: *Model, s: Stream, rows: []const Row, out: ?[]f32, cap: ?Capture) !void {
+        try m.stage(rows);
+        var end: usize = 0;
+        for (rows) |r| end = @max(end, r.pos);
+        try m.run(s, rows.len, end / CK + 1, cap);
+        if (out) |o| try m.logitsTo(s, rows.len, o) else try s.synchronize();
+    }
+
+    fn norm(m: *Model, s: Stream, x: u64, x_half: bool, w: u64, out: u64, n: usize, dim: usize, eps: f64) !void {
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(@as(c_int, @intFromBool(x_half)));
+        a.add(w);
+        a.add(out);
+        a.add(ci(dim));
+        a.add(@as(f32, @floatCast(eps)));
+        try cuda.launch.launch(m.f_rms, .{ .grid = .{ .x = u(n), .y = 1, .z = 1 }, .block = .{ .x = NORM_THREADS, .y = 1, .z = 1 } }, s, &a);
+    }
+
+    /// res = res * alpha + rms(y') * beta, then x = half(rms(res) * w_next) (muse_gate_norm).
+    fn gateNorm(m: *Model, s: Stream, y: u64, scale: u64, ab: u64, w_next: u64, n: usize) !void {
+        const cfg = m.w.cfg;
+        var a: cuda.Args = .{};
+        a.add(m.b.res);
+        a.add(y);
+        a.add(@as(u64, 0));
+        a.add(scale);
+        a.add(@as(c_int, @intFromBool(scale != 0)));
+        a.add(@as(f32, @floatCast(cfg.post_eps)));
+        a.add(ab);
+        a.add(w_next);
+        a.add(@as(f32, @floatCast(cfg.eps)));
+        a.add(m.b.x);
+        a.add(ci(cfg.hidden));
+        try cuda.launch.launch(m.f_gate, .{ .grid = .{ .x = u(n), .y = 1, .z = 1 }, .block = .{ .x = NORM_THREADS, .y = 1, .z = 1 } }, s, &a);
+    }
+
+    /// An EXL3 projection of n rows: x [n, K] fp16 -> out [n, N] fp16 or fp32.
+    fn proj(m: *Model, s: Stream, l: exl3.Linear, x: u64, out: u64, out_f32: bool, n: usize) !void {
+        try m.k3.linear(s, l, x, .f16, m.b.xh, out, if (out_f32) .f32 else .f16, if (l.split[0] > 1) m.b.z else 0, n);
+    }
+
+    fn attention(m: *Model, s: Stream, i: usize, n: usize, chunks: usize) !void {
+        const cfg = m.w.cfg;
+        const H = cfg.heads;
+        const HK = cfg.kv_heads;
+        const full = cfg.full[i];
+        const len = if (full) m.context else m.ring;
+        {
+            var a: cuda.Args = .{};
+            inline for (.{ m.b.q, m.b.k, m.b.v, m.cos, m.sin }) |p| a.add(p);
+            a.add(@as(c_int, @intFromBool(cfg.rope(i))));
+            inline for (.{ m.b.pos, m.b.slot, m.b.qo, m.kc[i], m.vc[i] }) |p| a.add(p);
+            a.add(ci(len));
+            a.add(ci(H));
+            a.add(ci(HK));
+            a.add(@as(f32, @floatCast(cfg.eps)));
+            try cuda.launch.launch(m.f_prep, .{ .grid = .{ .x = u(n), .y = u(H + HK), .z = 1 }, .block = .{ .x = 32, .y = 1, .z = 1 } }, s, &a);
+        }
+        const win: usize = if (full) 0 else cfg.window;
+        const nch: usize = if (full) chunks else (cfg.window + 1 + CK - 1) / CK;
+        {
+            var a: cuda.Args = .{};
+            inline for (.{ m.b.qo, m.kc[i], m.vc[i], m.b.pos, m.b.slot, m.b.po, m.b.pm, m.b.pl }) |p| a.add(p);
+            a.add(ci(len));
+            a.add(ci(nch));
+            a.add(ci(CK));
+            a.add(ci(win));
+            a.add(ci(H));
+            a.add(ci(HK));
+            a.add(@as(f32, @floatCast(cfg.smScale())));
+            try cuda.launch.launch(m.f_rows, .{ .grid = .{ .x = u(n), .y = u(HK), .z = u(nch) }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+        }
+        {
+            var a: cuda.Args = .{};
+            inline for (.{ m.b.po, m.b.pm, m.b.pl }) |p| a.add(p);
+            a.add(ci(nch));
+            a.add(m.b.g);
+            a.add(m.b.att);
+            a.add(ci(H));
+            a.add(@as(f32, @floatCast(cfg.eps)));
+            a.add(@as(c_int, @intFromBool(full)));
+            try cuda.launch.launch(m.f_merge, .{ .grid = .{ .x = u(n), .y = u(H / 8), .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+        }
+    }
+
+    /// MuseSparkMoE on the normed x: router (fp32), latent projection and norm, routed experts with the
+    /// per-expert norm, back to the model width into part (fp32).
+    fn moe(m: *Model, s: Stream, L: load_.Layer, n: usize) !void {
+        const cfg = m.w.cfg;
+        const E = cfg.experts;
+        const K = cfg.top_k;
+        {
+            var a: cuda.Args = .{};
+            a.add(m.b.x);
+            a.add(L.router);
+            a.add(@as(c_int, @intFromBool(L.router_bf16)));
+            a.add(m.b.logits);
+            a.add(ci(cfg.hidden));
+            a.add(ci(E));
+            try cuda.launch.launch(m.f_router, .{ .grid = .{ .x = u((E + 7) / 8), .y = u(n), .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+        }
+        {
+            var a: cuda.Args = .{};
+            a.add(m.b.logits);
+            a.add(L.bias);
+            a.add(ci(E));
+            a.add(ci(K));
+            a.add(@as(f32, @floatCast(cfg.out_mult)));
+            a.add(@as(f32, @floatCast(cfg.route_scale)));
+            a.add(m.b.pick);
+            a.add(m.b.wts);
+            const t = std.math.ceilPowerOfTwo(usize, @max(E, 32)) catch unreachable;
+            try cuda.launch.launch(m.f_topk, .{ .grid = .{ .x = u(n), .y = 1, .z = 1 }, .block = .{ .x = u(t), .y = 1, .z = 1 } }, s, &a);
+        }
+        try m.proj(s, L.pre, m.b.x, m.b.lat, false, n);
+        try m.norm(s, m.b.lat, true, L.pre_norm, m.b.latn, n, cfg.latent, cfg.eps);
+        // routed experts: group, rotate, gate / up, SwiGLU (fp32), down; per-slot outputs in sc.y [n * K, latent]
+        const k3 = m.k3;
+        const e = L.experts;
+        const sc = m.b.sc;
+        const p = n * K;
+        const w = sc.window(E, n);
+        try k3.group(s, m.b.pick, sc.ids, sc.count, sc.members, n, K, E, w[1]);
+        try k3.expertsRotIn(s, m.b.latn, false, cfg.latent, m.b.pick, e.suh_g, e.suh_u, sc.xg, sc.xu, n, e.dims, K, E);
+        const gu = sc.cfg_gu;
+        try k3.grouped(s, .{ .x0 = sc.xg, .x1 = sc.xu, .tp0 = e.gate_ptr, .tp1 = e.up_ptr, .k2_0 = e.gate_k2, .k2_1 = e.up_k2, .uids = sc.ids, .ucount = sc.count, .members = sc.members, .z = sc.z, .mats = 2, .k = e.dims, .n = e.width, .p = p, .sk = gu[2], .slots = K, .maxm = w[1], .nexp_max = w[0], .nt = gu[0], .warps = gu[1], .pf = gu[3], .lo = e.k2_gu[0], .hi = e.k2_gu[1] });
+        try k3.gateupEpilogue(s, sc.z, m.b.pick, e.svh_g, e.svh_u, e.suh_d, sc.xd, n, p, e.width, gu[2], K, E, std.math.inf(f32), 1);
+        const dn = sc.cfg_d;
+        try k3.grouped(s, .{ .x0 = sc.xd, .x1 = sc.xd, .tp0 = e.down_ptr, .tp1 = e.down_ptr, .k2_0 = e.down_k2, .k2_1 = e.down_k2, .uids = sc.ids, .ucount = sc.count, .members = sc.members, .z = sc.z, .mats = 1, .k = e.width, .n = e.dims, .p = p, .sk = dn[2], .slots = K, .maxm = w[1], .nexp_max = w[0], .nt = dn[0], .warps = dn[1], .pf = dn[3], .lo = e.k2_d[0], .hi = e.k2_d[1] });
+        try k3.downEpilogue(s, sc.z, m.b.pick, e.svh_d, sc.y, n, p, e.dims, dn[2], K, E);
+        {
+            var a: cuda.Args = .{};
+            a.add(sc.y);
+            a.add(@as(u64, 0));
+            a.add(m.b.wts);
+            a.add(L.expert_norm);
+            a.add(@as(f32, @floatCast(cfg.post_eps)));
+            a.add(m.b.acc);
+            a.add(ci(cfg.latent));
+            a.add(ci(K));
+            try cuda.launch.launch(m.f_esum, .{ .grid = .{ .x = u(n), .y = 1, .z = 1 }, .block = .{ .x = NORM_THREADS, .y = 1, .z = 1 } }, s, &a);
+        }
+        try m.proj(s, L.post, m.b.acc, m.b.part, true, n);
+    }
+
+    /// The window's kernels on staged inputs, no host work; full layers read `chunks` key chunks of CK.
+    pub fn run(m: *Model, s: Stream, n: usize, chunks: usize, cap: ?Capture) !void {
+        const cfg = m.w.cfg;
+        const D = cfg.hidden;
+        if (chunks > m.nch_max) return error.TooManyChunks;
+        {
+            var a: cuda.Args = .{};
+            a.add(m.w.embed);
+            a.add(m.b.ids);
+            a.add(m.b.res);
+            a.add(ci(D));
+            a.add(@as(f32, @floatCast(cfg.eps)));
+            try cuda.launch.launch(m.f_embed, .{ .grid = .{ .x = u(n), .y = 1, .z = 1 }, .block = .{ .x = NORM_THREADS, .y = 1, .z = 1 } }, s, &a);
+        }
+        try m.norm(s, m.b.res, false, m.w.layers[0].in_norm, m.b.x, n, D, cfg.eps);
+        for (m.w.layers, 0..) |L, i| {
+            if (cap) |c| if (c.teacher) {
+                try c.hook(c.ctx, .input, i, m.b.res, n);
+                try m.norm(s, m.b.res, false, L.in_norm, m.b.x, n, D, cfg.eps);
+            };
+            try m.proj(s, L.q, m.b.x, m.b.q, false, n);
+            try m.proj(s, L.k, m.b.x, m.b.k, false, n);
+            try m.proj(s, L.v, m.b.x, m.b.v, false, n);
+            try m.proj(s, L.g, m.b.x, m.b.g, false, n);
+            try m.attention(s, i, n, chunks);
+            try m.proj(s, L.o, m.b.att, m.b.part, true, n);
+            try m.gateNorm(s, m.b.part, 0, L.attn_ab, L.ffn_norm, n);
+            if (cap) |c| try c.hook(c.ctx, .attn, i, m.b.res, n);
+            try m.moe(s, L, n);
+            const after = if (i + 1 < m.w.layers.len) m.w.layers[i + 1].in_norm else m.w.norm;
+            try m.gateNorm(s, m.b.part, L.post_ffn, L.mlp_ab, after, n);
+            if (cap) |c| try c.hook(c.ctx, .mlp, i, m.b.res, n);
+        }
+        try m.proj(s, m.w.head, m.b.x, m.b.head, true, n);
+        const cfgf = m.w.full;
+        var a: cuda.Args = .{};
+        a.add(m.b.head);
+        a.add(@as(i64, @intCast(n * m.w.head.n)));
+        a.add(@as(f32, @floatCast(cfgf.out_mult)));
+        a.add(@as(f32, @floatCast(cfgf.softcap)));
+        try cuda.launch.launch(m.f_softcap, .{ .grid = .{ .x = u(@min((n * m.w.head.n + 255) / 256, 4096)), .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+    }
+
+    /// Each row's argmax over the real vocabulary on the device; only the ids reach the host.
+    pub fn argmaxTo(m: *Model, s: Stream, n: usize, out: []i32) !void {
+        var a: cuda.Args = .{};
+        a.add(m.b.head);
+        a.add(m.b.am);
+        a.add(ci(n));
+        a.add(ci(m.w.head.n));
+        a.add(ci(m.w.full.vocab));
+        try cuda.launch.launch(m.f_argmax, .{ .grid = .{ .x = u(n), .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+        try s.synchronize();
+        try m.d.check(m.d.api.cuMemcpyDtoH_v2(@ptrCast(out.ptr), m.b.am, n * 4), "argmax");
+    }
+
+    /// The window's logits on the host: [n, vocab] (the head's padding rows dropped).
+    pub fn logitsTo(m: *Model, s: Stream, n: usize, out: []f32) !void {
+        const V = m.w.full.vocab;
+        try s.synchronize();
+        for (0..n) |r| try m.d.check(m.d.api.cuMemcpyDtoH_v2(@ptrCast(out[r * V ..].ptr), m.b.head + r * m.w.head.n * 4, V * 4), "logits");
+    }
+};
+
+fn upload(d: *const cuda.Driver, at: u64, bytes: []const u8) !void {
+    try d.check(d.api.cuMemcpyHtoD_v2(at, bytes.ptr, bytes.len), "upload");
+}
+
+test "ring" {
+    try std.testing.expectEqual(@as(usize, 2176), ringSize(2047, 128));
+    try std.testing.expectEqual(@as(usize, 2112), ringSize(2047, 1));
+}
diff --git a/zig/src/families/muse_spark/load.zig b/zig/src/families/muse_spark/load.zig
new file mode 100644
index 00000000..3bd328be
--- /dev/null
+++ b/zig/src/families/muse_spark/load.zig
@@ -0,0 +1,248 @@
+//! A rank's share of a Muse Spark EXL3 pack on the GPU. The EXL3 pack helpers (arena, trellis reads, cuts, strips)
+//! are MiMo-V2's (families/mimo_v2/load.zig); what is Muse's is the tensor set and the host-side constants.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const mimo = @import("mimo_v2");
+const config = @import("config.zig");
+const exl3 = cuda.exl3;
+const Config = config.Config;
+
+pub const Arena = mimo.load.Arena;
+const ml = mimo.load;
+const P = config.prefix;
+
+pub const Layer = struct {
+    in_norm: u64, // fp32 [D]: 1 + w (centred RMS before attention)
+    ffn_norm: u64, // fp32 [D]: 1 + w (centred RMS before the MoE)
+    post_ffn: u64, // fp32 [D]: 1 + w (input-scaled RMS after the MoE)
+    attn_ab: u64, // fp32 [2, D]: the post-attention residual gate's alpha, beta
+    mlp_ab: u64, // fp32 [2, D]
+    q: exl3.Linear,
+    k: exl3.Linear,
+    v: exl3.Linear,
+    g: exl3.Linear, // the full-width output gate
+    o: exl3.Linear, // a rank's input columns: partial outputs under TP
+    router: u64, // [E, D]: bf16 when every fp32 value is a bf16 (exact), else fp32
+    router_bf16: bool,
+    bias: u64, // fp32 [E]: e_score_correction_bias
+    pre: exl3.Linear, // pre_expert_proj D -> latent (a rank's latent outputs under TP)
+    pre_norm: u64, // fp32 [latent]: 1 + w
+    post: exl3.Linear, // post_expert_proj latent -> D (a rank's latent inputs under TP)
+    expert_norm: u64, // fp32 [latent]: 1 + w (input-scaled RMS of each expert's output)
+    experts: exl3.Experts,
+};
+
+pub const Weights = struct {
+    full: Config,
+    cfg: Config, // this rank's view
+    rank: usize,
+    world: usize,
+    embed: u64, // bf16 [V, D], every rank whole
+    layers: []const Layer,
+    norm: u64, // fp32 [D]: w (the final norm is weighted by w, not 1 + w)
+    head: exl3.Linear, // a rank's 128-row blocks of the padded head
+    head_lo: usize, // its first vocabulary row
+    head_stride: usize, // columns a rank's slice takes in a gather
+    arena: Arena,
+    gpa: std.mem.Allocator,
+
+    pub fn deinit(w: *Weights) void {
+        for (w.layers) |L| {
+            w.gpa.free(L.experts.host_ptr);
+            w.gpa.free(L.experts.host_k2);
+        }
+        w.gpa.free(w.layers);
+        w.arena.deinit();
+    }
+};
+
+/// Options for partial packs: the first `max_layers` layers only (a k-layer pack, or a check on fewer).
+pub const Options = struct { max_layers: ?usize = null, log: bool = false };
+
+pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, model_dir: []const u8, rank: usize, world: usize, opt: Options) !Weights {
+    const cfg_text = try readFile(gpa, io, model_dir, "config.json");
+    defer gpa.free(cfg_text);
+    const gen_text = readFile(gpa, io, model_dir, "generation_config.json") catch null;
+    defer if (gen_text) |g| gpa.free(g);
+    var full = try Config.parse(gpa, cfg_text, gen_text);
+    if (opt.max_layers) |m| full.layers = @min(full.layers, m);
+    const view = try full.rankView(world);
+    var ck = try core.Checkpoint.openModel(gpa, io, model_dir);
+    defer ck.close();
+    var w: Weights = .{ .full = full, .cfg = view, .rank = rank, .world = world, .embed = 0, .layers = &.{}, .norm = 0, .head = undefined, .head_lo = 0, .head_stride = 0, .arena = .{ .d = d, .gpa = gpa }, .gpa = gpa };
+    errdefer w.deinit();
+    const ar = &w.arena;
+    const emb = try ck.get(P ++ "embed_tokens.weight");
+    if (emb.dtype != .bf16 or emb.shape[0] != full.vocab or emb.shape[1] != full.hidden) return error.BadEmbedding;
+    w.embed = try ar.upload(emb.bytes);
+
+    var names: std.ArrayList(u8) = .empty;
+    defer names.deinit(gpa);
+    try names.ensureTotalCapacity(gpa, 1 << 20);
+    var cuts: std.ArrayList(config.Cut) = .empty;
+    defer cuts.deinit(gpa);
+    var nb: [256]u8 = undefined;
+    const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    var layers: std.ArrayList(Layer) = .empty;
+    errdefer {
+        for (layers.items) |L| {
+            gpa.free(L.experts.host_ptr);
+            gpa.free(L.experts.host_k2);
+        }
+        layers.deinit(gpa);
+    }
+    for (0..full.layers) |i| {
+        names.clearRetainingCapacity();
+        cuts.clearRetainingCapacity();
+        try config.layerCuts(full, i, rank, world, &names, gpa, &cuts);
+        var L: Layer = undefined;
+        L.in_norm = try plusOne(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.input_layernorm.weight", .{i})), 1.0);
+        L.ffn_norm = try plusOne(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.pre_feedforward_layernorm.weight", .{i})), 1.0);
+        L.post_ffn = try plusOne(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.post_feedforward_layernorm.weight", .{i})), 1.0);
+        L.attn_ab = try gates(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.post_attention_residual_gate.gate", .{i})), full.gate_temp);
+        L.mlp_ab = try gates(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.post_feedforward_residual_gate.gate", .{i})), full.gate_temp);
+        inline for (.{ "q", "k", "v", "g", "o", "pre", "post" }, 0..) |f, j| @field(L, f) = try ml.linear(gpa, ar, try ml.cut(gpa, try ml.readMat(gpa, &ck, cuts.items[j].prefix), mc(cuts.items[j])));
+        const ex = cuts.items[config.attn_mats + config.latent_mats ..];
+        L.experts = try experts(gpa, ar, &ck, full, ex);
+        errdefer {
+            gpa.free(L.experts.host_ptr);
+            gpa.free(L.experts.host_k2);
+        }
+        L.pre_norm = try plusOne(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.mlp.pre_expert_norm.weight", .{i})), 1.0);
+        L.expert_norm = try plusOne(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.mlp.experts.post_expert_norm.weight", .{i})), 1.0);
+        const r = try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.mlp.gate.weight", .{i}));
+        if (r.rank != 2 or r.shape[0] != full.experts or r.shape[1] != full.hidden) return error.BadRouter;
+        const rf = try ml.asF32(gpa, r);
+        defer gpa.free(rf);
+        L.router_bf16 = for (rf) |x| {
+            if (ml.bf16Round(x) != x) break false;
+        } else true;
+        if (L.router_bf16) {
+            const rb = try gpa.alloc(u16, rf.len);
+            defer gpa.free(rb);
+            for (rf, rb) |x, *o| o.* = @intCast(@as(u32, @bitCast(x)) >> 16);
+            L.router = try ar.upload(std.mem.sliceAsBytes(rb));
+        } else L.router = try ar.upload(std.mem.sliceAsBytes(rf));
+        L.bias = try plusOne(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, P ++ "layers.{d}.mlp.gate.e_score_correction_bias", .{i})), 0.0);
+        try layers.append(gpa, L);
+        if (opt.log and (i % 8 == 7 or i == full.layers - 1)) {
+            const s = @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e9;
+            std.debug.print("[tensorfold] muse_spark (zig): {d}/{d} layers in {d:.0}s, {d:.1} GiB\n", .{ i + 1, full.layers, s, @as(f64, @floatFromInt(ar.total)) / (1 << 30) });
+        }
+    }
+    gpa.free(w.layers);
+    w.layers = try layers.toOwnedSlice(gpa);
+    w.norm = try plusOne(gpa, ar, try ck.get(P ++ "norm.weight"), 0.0);
+    const hm = try ml.readMat(gpa, &ck, "lm_head");
+    if (hm.n() < full.vocab) return error.BadHead;
+    const hc = config.headCut(hm.n(), rank, world);
+    w.head_lo = hc.lo;
+    w.head_stride = config.headStride(hm.n(), world);
+    w.head = try ml.linear(gpa, ar, try ml.cut(gpa, hm, mc(hc)));
+    return w;
+}
+
+/// The same cut in MiMo-V2's type (its `cut` does the trellis slicing).
+fn mc(c: config.Cut) mimo.config.Cut {
+    return .{ .prefix = c.prefix, .axis = switch (c.axis) {
+        .whole => .whole,
+        .n => .n,
+        .k => .k,
+    }, .lo = c.lo, .hi = c.hi };
+}
+
+/// A norm weight as fp32 `bias + w` (exllamav3's constant_bias: 1 for the centred and input-scaled norms, 0 for the rest).
+fn plusOne(gpa: std.mem.Allocator, ar: *Arena, t: core.safetensors.Tensor, bias: f32) !u64 {
+    const f = try ml.asF32(gpa, t);
+    defer gpa.free(f);
+    for (f) |*x| x.* = bias + x.*;
+    return ar.upload(std.mem.sliceAsBytes(f));
+}
+
+/// MuseSparkBlock._alpha_beta: w = g / T, beta = sigmoid(w), alpha = sqrt(max(sigmoid(-w) * (1 + beta), 1e-3)); [alpha, beta].
+fn gates(gpa: std.mem.Allocator, ar: *Arena, t: core.safetensors.Tensor, temp: f64) !u64 {
+    const g = try ml.asF32(gpa, t);
+    defer gpa.free(g);
+    const ab = try gpa.alloc(f32, 2 * g.len);
+    defer gpa.free(ab);
+    const tf: f32 = @floatCast(temp);
+    for (g, 0..) |x, j| {
+        const v = x / tf;
+        const beta = 1.0 / (1.0 + @exp(-v));
+        const sn = 1.0 / (1.0 + @exp(v));
+        ab[j] = @sqrt(@max(sn * (1.0 + beta), 1e-3));
+        ab[g.len + j] = beta;
+    }
+    return ar.upload(std.mem.sliceAsBytes(ab));
+}
+
+/// experts.prepare: per expert (gate, up, down) cut trellises in the stored layout, referenced by pointer tables.
+fn experts(gpa: std.mem.Allocator, ar: *Arena, ck: *core.Checkpoint, full: Config, cuts: []const config.Cut) !exl3.Experts {
+    const E = full.experts;
+    if (cuts.len != 3 * E) return error.ExpertCuts;
+    const ptrs = try gpa.alloc(u64, 3 * E); // kept: Experts.host_ptr
+    errdefer gpa.free(ptrs);
+    const k2s = try gpa.alloc(i32, 3 * E); // kept: Experts.host_k2
+    errdefer gpa.free(k2s);
+    var st: [6]std.ArrayList(f16) = @splat(.empty); // suh_g, suh_u, svh_g, svh_u, suh_d, svh_d
+    defer for (&st) |*l| l.deinit(gpa);
+    var lo: [2]u32 = .{ 99, 99 };
+    var hi: [2]u32 = .{ 0, 0 };
+    var dims: usize = 0;
+    var width: usize = 0;
+    for (0..E) |e| for (0..3) |j| {
+        const m = try ml.cut(gpa, try ml.readMat(gpa, ck, cuts[3 * e + j].prefix), mc(cuts[3 * e + j]));
+        defer m.deinit(gpa);
+        ptrs[j * E + e] = try ar.upload(std.mem.sliceAsBytes(m.trellis));
+        k2s[j * E + e] = @intCast(m.k2);
+        const g: usize = if (j == 2) 1 else 0;
+        lo[g] = @min(lo[g], m.k2);
+        hi[g] = @max(hi[g], m.k2);
+        switch (j) {
+            0 => {
+                dims = m.k();
+                width = m.n();
+                try st[0].appendSlice(gpa, m.suh);
+                try st[2].appendSlice(gpa, m.svh);
+            },
+            1 => {
+                try st[1].appendSlice(gpa, m.suh);
+                try st[3].appendSlice(gpa, m.svh);
+            },
+            else => {
+                if (m.n() != dims or m.k() != width) return error.ExpertShapes;
+                try st[4].appendSlice(gpa, m.suh);
+                try st[5].appendSlice(gpa, m.svh);
+            },
+        }
+    };
+    return .{
+        .gate_ptr = try ar.upload(std.mem.sliceAsBytes(ptrs[0..E])),
+        .up_ptr = try ar.upload(std.mem.sliceAsBytes(ptrs[E .. 2 * E])),
+        .down_ptr = try ar.upload(std.mem.sliceAsBytes(ptrs[2 * E ..])),
+        .gate_k2 = try ar.upload(std.mem.sliceAsBytes(k2s[0..E])),
+        .up_k2 = try ar.upload(std.mem.sliceAsBytes(k2s[E .. 2 * E])),
+        .down_k2 = try ar.upload(std.mem.sliceAsBytes(k2s[2 * E ..])),
+        .suh_g = try ar.upload(std.mem.sliceAsBytes(st[0].items)),
+        .suh_u = try ar.upload(std.mem.sliceAsBytes(st[1].items)),
+        .svh_g = try ar.upload(std.mem.sliceAsBytes(st[2].items)),
+        .svh_u = try ar.upload(std.mem.sliceAsBytes(st[3].items)),
+        .suh_d = try ar.upload(std.mem.sliceAsBytes(st[4].items)),
+        .svh_d = try ar.upload(std.mem.sliceAsBytes(st[5].items)),
+        .count = E,
+        .dims = dims,
+        .width = width,
+        .k2_gu = .{ lo[0], hi[0] },
+        .k2_d = .{ lo[1], hi[1] },
+        .host_ptr = ptrs,
+        .host_k2 = k2s,
+    };
+}
+
+fn readFile(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, name: []const u8) ![]u8 {
+    const path = try std.fs.path.join(gpa, &.{ dir, name });
+    defer gpa.free(path);
+    return std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 22));
+}
diff --git a/zig/src/families/muse_spark/m1_main.zig b/zig/src/families/muse_spark/m1_main.zig
new file mode 100644
index 00000000..afc2a0dd
--- /dev/null
+++ b/zig/src/families/muse_spark/m1_main.zig
@@ -0,0 +1,217 @@
+//! tf-muse: Muse Spark's decode forward on one GPU against exllamav3's answer key (tools/g5 in the recipe).
+//!   tf-muse m1 MODEL IN_DIR OUT_DIR
+//! IN_DIR: names.txt (a text a line), <name>.ids (int32), and with MUSE_TEACHER=1 <name>.states.f32 (fp32 [layers + 1,
+//! T, D]: the embedding norm's output, then each block's output, from the reference). Every prompt token is fed as a
+//! decode row (teacher-forced), then MUSE_GREEDY tokens greedily. OUT_DIR: <name>.logits.f32 [T, vocab],
+//! <name>.greedy.i32, and with MUSE_CAPTURE=1 <name>.res.f32 / <name>.attn.f32 (fp32 [layers, T, D]).
+//! Knobs: MUSE_ROWS (prompt rows a text a window, 1), MUSE_SLOTS (texts sharing a window, 1), MUSE_LAYERS (first
+//! layers only), MUSE_CONTEXT (4096), MUSE_GREEDY (32), MUSE_CAPTURE, MUSE_TEACHER.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const muse = @import("muse_spark");
+const Model = muse.forward.Model;
+
+fn env(name: [*:0]const u8, default: usize) usize {
+    const v = std.c.getenv(name) orelse return default;
+    return std.fmt.parseInt(usize, std.mem.span(v), 10) catch default;
+}
+
+const Text = struct {
+    name: []const u8,
+    ids: []i32,
+    states: ?[]f32 = null, // teacher: [L + 1, T, D]
+    logits: []f32, // [T, V]
+    res: ?[]f32 = null, // [L, T, D]
+    attn: ?[]f32 = null,
+    greedy: std.ArrayList(i32) = .empty,
+    fed: usize = 0,
+    last: usize = 0, // row of its last logits in the window buffer
+};
+
+const Win = struct { text: usize, pos: usize };
+
+const Ctx = struct {
+    d: *const cuda.Driver,
+    s: cuda.Stream,
+    texts: []Text,
+    win: []Win,
+    layers: usize,
+    D: usize,
+    host: []f32, // [R, D]
+};
+
+fn hook(ctx: *anyopaque, what: Model.Tap, layer: usize, dev: u64, n: usize) anyerror!void {
+    const c: *Ctx = @ptrCast(@alignCast(ctx));
+    const D = c.D;
+    switch (what) {
+        .input => {
+            for (c.win[0..n], 0..) |w, r| {
+                const t = c.texts[w.text];
+                const st = t.states orelse return error.NoTeacher;
+                const T = t.ids.len;
+                if (w.pos >= T) { // greedy rows: keep ours
+                    try c.s.synchronize();
+                    try c.d.check(c.d.api.cuMemcpyDtoH_v2(@ptrCast(c.host[r * D ..].ptr), dev + r * D * 4, D * 4), "teacher keep");
+                    continue;
+                }
+                @memcpy(c.host[r * D ..][0..D], st[(layer * T + w.pos) * D ..][0..D]);
+            }
+            try c.s.synchronize();
+            try c.d.check(c.d.api.cuMemcpyHtoD_v2(dev, @ptrCast(c.host.ptr), n * D * 4), "teacher");
+        },
+        .attn, .mlp => {
+            try c.s.synchronize();
+            try c.d.check(c.d.api.cuMemcpyDtoH_v2(@ptrCast(c.host.ptr), dev, n * D * 4), "capture");
+            for (c.win[0..n], 0..) |w, r| {
+                const t = c.texts[w.text];
+                const T = t.ids.len;
+                if (w.pos >= T) continue;
+                const dst = (if (what == .mlp) t.res else t.attn) orelse continue;
+                @memcpy(dst[(layer * T + w.pos) * D ..][0..D], c.host[r * D ..][0..D]);
+            }
+        },
+    }
+}
+
+fn readAll(gpa: std.mem.Allocator, io: std.Io, path: []const u8) ![]u8 {
+    return std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 34));
+}
+
+fn writeAll(io: std.Io, path: []const u8, bytes: []const u8) !void {
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = path, .data = bytes });
+}
+
+fn argmax(xs: []const f32) i32 {
+    var best: usize = 0;
+    for (xs, 0..) |x, i| if (x > xs[best]) {
+        best = i;
+    };
+    return @intCast(best);
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len < 5 or !std.mem.eql(u8, args[1], "m1")) {
+        std.debug.print("usage: tf-muse m1 MODEL IN_DIR OUT_DIR   (knobs: MUSE_ROWS, MUSE_SLOTS, MUSE_LAYERS, MUSE_CONTEXT, MUSE_GREEDY, MUSE_CAPTURE, MUSE_TEACHER)\n", .{});
+        return 2;
+    }
+    const gpa = init.gpa;
+    const ar = init.arena.allocator();
+    const io = init.io;
+    const rows_per = env("MUSE_ROWS", 1);
+    const slots = env("MUSE_SLOTS", 1);
+    const context = env("MUSE_CONTEXT", 4096);
+    const n_greedy = env("MUSE_GREEDY", 32);
+    const capture = env("MUSE_CAPTURE", 0) != 0;
+    const teacher = env("MUSE_TEACHER", 0) != 0;
+    const max_layers: ?usize = if (env("MUSE_LAYERS", 0) > 0) env("MUSE_LAYERS", 0) else null;
+    if (rows_per * slots > muse.forward.DECODE_ROWS) return error.WindowTooWide;
+
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var s = try cuda.Stream.init(&driver, false);
+    defer s.deinit();
+    const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    var w = try muse.load.load(gpa, io, &driver, args[2], 0, 1, .{ .max_layers = max_layers, .log = true });
+    defer w.deinit();
+    var k3 = try cuda.exl3.Kernels.load(&driver);
+    defer k3.deinit();
+    var model = try Model.init(gpa, &driver, &w, &k3, context, rows_per * slots, slots, s);
+    defer model.deinit();
+    const L = w.layers.len;
+    const D = w.cfg.hidden;
+    const V = w.full.vocab;
+    std.debug.print("[m1] loaded {d} layers in {d:.0}s ({d:.1} GiB weights, {d:.1} GiB model buffers); rows {d} x slots {d}, context {d}\n", .{ L, @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e9, @as(f64, @floatFromInt(w.arena.total)) / (1 << 30), @as(f64, @floatFromInt(model.arena.total)) / (1 << 30), rows_per, slots, context });
+
+    // texts
+    const names_path = try std.fs.path.join(ar, &.{ args[3], "names.txt" });
+    const names_text = try readAll(ar, io, names_path);
+    var texts: std.ArrayList(Text) = .empty;
+    var it = std.mem.tokenizeAny(u8, names_text, " \r\n\t");
+    while (it.next()) |name| {
+        const raw = try readAll(ar, io, try std.fmt.allocPrint(ar, "{s}/{s}.ids", .{ args[3], name }));
+        const ids = try ar.alloc(i32, raw.len / 4);
+        @memcpy(std.mem.sliceAsBytes(ids), raw[0 .. ids.len * 4]);
+        if (ids.len + n_greedy > context) return error.TextTooLong;
+        var t: Text = .{ .name = name, .ids = ids, .logits = try gpa.alloc(f32, ids.len * V) };
+        if (teacher) {
+            const st = try readAll(gpa, io, try std.fmt.allocPrint(ar, "{s}/{s}.states.f32", .{ args[3], name }));
+            if (st.len < L * ids.len * D * 4) return error.TeacherStatesShort;
+            t.states = @alignCast(std.mem.bytesAsSlice(f32, st));
+        }
+        if (capture) {
+            t.res = try gpa.alloc(f32, L * ids.len * D);
+            t.attn = try gpa.alloc(f32, L * ids.len * D);
+        }
+        try texts.append(ar, t);
+    }
+    const R = rows_per * slots;
+    const win = try ar.alloc(Win, R);
+    const host = try ar.alloc(f32, R * D);
+    const out = try gpa.alloc(f32, R * V);
+    defer gpa.free(out);
+    var cc: Ctx = .{ .d = &driver, .s = s, .texts = texts.items, .win = win, .layers = L, .D = D, .host = host };
+    const cap: ?Model.Capture = if (capture or teacher) .{ .hook = &hook, .ctx = &cc, .teacher = teacher } else null;
+
+    const t1 = std.Io.Clock.awake.now(io).toNanoseconds();
+    var windows: usize = 0;
+    var total_rows: usize = 0;
+    var b: usize = 0;
+    while (b < texts.items.len) : (b += slots) {
+        const batch = texts.items[b..@min(b + slots, texts.items.len)];
+        while (true) {
+            var rows: std.ArrayList(muse.forward.Row) = .empty;
+            defer rows.deinit(gpa);
+            for (batch, 0..) |*t, j| {
+                const T = t.ids.len;
+                if (t.fed < T) {
+                    const k = @min(rows_per, T - t.fed);
+                    for (0..k) |q| {
+                        win[rows.items.len] = .{ .text = b + j, .pos = t.fed + q };
+                        try rows.append(gpa, .{ .slot = @intCast(j), .pos = @intCast(t.fed + q), .token = t.ids[t.fed + q] });
+                    }
+                    t.fed += k;
+                    t.last = rows.items.len - 1;
+                } else if (t.greedy.items.len < n_greedy) {
+                    const nxt = argmax(out[t.last * V ..][0..V]);
+                    try t.greedy.append(gpa, nxt);
+                    if (t.greedy.items.len == n_greedy or w.full.isEos(@intCast(nxt))) {
+                        if (w.full.isEos(@intCast(nxt))) while (t.greedy.items.len < n_greedy) try t.greedy.append(gpa, -1);
+                        continue;
+                    }
+                    win[rows.items.len] = .{ .text = b + j, .pos = t.fed };
+                    try rows.append(gpa, .{ .slot = @intCast(j), .pos = @intCast(t.fed), .token = nxt });
+                    t.fed += 1;
+                    t.last = rows.items.len - 1;
+                }
+            }
+            if (rows.items.len == 0) break;
+            try model.forward(s, rows.items, out[0 .. rows.items.len * V], cap);
+            windows += 1;
+            total_rows += rows.items.len;
+            for (rows.items, win[0..rows.items.len], 0..) |r, wv, i| {
+                const t = &texts.items[wv.text];
+                if (r.pos < t.ids.len) @memcpy(t.logits[r.pos * V ..][0..V], out[i * V ..][0..V]);
+            }
+        }
+    }
+    const secs = @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t1)) / 1e9;
+    std.debug.print("[m1] {d} windows, {d} rows in {d:.1}s (eager, with captures: not a speed number)\n", .{ windows, total_rows, secs });
+    for (texts.items) |*t| {
+        try writeAll(io, try std.fmt.allocPrint(ar, "{s}/{s}.logits.f32", .{ args[4], t.name }), std.mem.sliceAsBytes(t.logits));
+        try writeAll(io, try std.fmt.allocPrint(ar, "{s}/{s}.greedy.i32", .{ args[4], t.name }), std.mem.sliceAsBytes(t.greedy.items));
+        if (t.res) |x| try writeAll(io, try std.fmt.allocPrint(ar, "{s}/{s}.res.f32", .{ args[4], t.name }), std.mem.sliceAsBytes(x));
+        if (t.attn) |x| try writeAll(io, try std.fmt.allocPrint(ar, "{s}/{s}.attn.f32", .{ args[4], t.name }), std.mem.sliceAsBytes(x));
+        std.debug.print("[m1] {s}: {d} tokens, greedy {any}\n", .{ t.name, t.ids.len, t.greedy.items[0..@min(8, t.greedy.items.len)] });
+        gpa.free(t.logits);
+        if (t.res) |x| gpa.free(x);
+        if (t.attn) |x| gpa.free(x);
+        if (t.states) |x| gpa.free(std.mem.sliceAsBytes(x));
+        t.greedy.deinit(gpa);
+    }
+    std.debug.print("DONE m1\n", .{});
+    return 0;
+}
