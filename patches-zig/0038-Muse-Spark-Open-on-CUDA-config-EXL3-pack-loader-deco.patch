diff --git a/zig/kernels/cuda/muse_spark/attention.cu b/zig/kernels/cuda/muse_spark/attention.cu
new file mode 100644
index 00000000..5e77b82e
--- /dev/null
+++ b/zig/kernels/cuda/muse_spark/attention.cu
@@ -0,0 +1,185 @@
+// Muse Spark's decode attention: head_dim 64, eight query heads a KV head, sliding window or full, RoPE or NoPE,
+// no sinks. Hand CUDA (no Python TensorFold family to take Triton cubins from): docs/ZIG-MUSE.md in the recipe.
+//   muse_qk_prep:  weightless RMS norm of q and k per head, NeoX RoPE (rope layers), q to QO, k and v into the cache
+//   muse_attn_rows: a block per (row, KV head, key chunk): its 8 query heads as 8 warps over shared K / V tiles,
+//                   online softmax, partial (o, max, sum) per chunk
+//   muse_attn_merge: chunks merged, half output, weightless o_norm per head, times sigmoid(gate)
+
+#include <cstdint>
+#include <cuda_fp16.h>
+#include <math_constants.h>
+
+namespace {
+
+__device__ __forceinline__ float warp_sum(float v) {
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) v += __shfl_xor_sync(0xffffffffu, v, o);
+    return v;
+}
+__device__ __forceinline__ float warp_max(float v) {
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) v = fmaxf(v, __shfl_xor_sync(0xffffffffu, v, o));
+    return v;
+}
+
+constexpr int HD = 64;    // head dim
+constexpr int G = 8;      // query heads a KV head
+constexpr int TILE = 32;  // keys a tile
+constexpr int KP = 33;    // K tile row stride in 32-bit words (64 halves + 2): conflict-free row-per-lane reads
+
+}  // namespace
+
+// Grid (rows, H + HK), a warp a head: q heads first, then KV heads (which also write v). Lane l holds dims l, l + 32.
+// cache [slots, LEN, HK, 64]; a row's cache row is pos % LEN (LEN = context for full layers, the ring for sliding).
+extern "C" __global__ void muse_qk_prep(const __half* __restrict__ q, const __half* __restrict__ k,
+                                        const __half* __restrict__ v, const float* __restrict__ cos_t,
+                                        const float* __restrict__ sin_t, int rope, const int32_t* __restrict__ pos,
+                                        const int32_t* __restrict__ slot, __half* __restrict__ qo,
+                                        __half* __restrict__ kc, __half* __restrict__ vc, int LEN, int H, int HK,
+                                        float eps) {
+    const int r = blockIdx.x, h = blockIdx.y, lane = threadIdx.x;
+    const bool is_q = h < H;
+    const int kh = h - H;
+    const __half* src = is_q ? q + ((int64_t)r * H + h) * HD : k + ((int64_t)r * HK + kh) * HD;
+    const float x0 = __half2float(src[lane]), x1 = __half2float(src[lane + 32]);
+    const float rs = rsqrtf(warp_sum(x0 * x0 + x1 * x1) / (float)HD + eps);
+    float a = x0 * rs, b = x1 * rs;
+    const int p = pos[r];
+    if (rope) {
+        const float c = cos_t[(int64_t)p * 32 + lane], s = sin_t[(int64_t)p * 32 + lane];
+        const float a2 = a * c - b * s, b2 = b * c + a * s;
+        a = a2;
+        b = b2;
+    }
+    if (is_q) {
+        __half* o = qo + ((int64_t)r * H + h) * HD;
+        o[lane] = __float2half_rn(a);
+        o[lane + 32] = __float2half_rn(b);
+        return;
+    }
+    const int64_t at = (((int64_t)slot[r] * LEN + p % LEN) * HK + kh) * HD;
+    kc[at + lane] = __float2half_rn(a);
+    kc[at + lane + 32] = __float2half_rn(b);
+    const __half* vs = v + ((int64_t)r * HK + kh) * HD;
+    vc[at + lane] = vs[lane];
+    vc[at + lane + 32] = vs[lane + 32];
+}
+
+// Grid (rows, HK, NCH), 256 threads. Keys of row r: [lo, pos] with lo = max(0, pos - win) (win 0: from key 0);
+// chunk c takes [lo + c * CK, lo + (c + 1) * CK). Partials: po [rows, H, NCH, 64], pm / pl [rows, H, NCH].
+extern "C" __global__ void __launch_bounds__(256)
+    muse_attn_rows(const __half* __restrict__ qo, const __half* __restrict__ kc, const __half* __restrict__ vc,
+                   const int32_t* __restrict__ pos, const int32_t* __restrict__ slot, float* __restrict__ po,
+                   float* __restrict__ pm, float* __restrict__ pl, int LEN, int NCH, int CK, int win, int H, int HK,
+                   float scale) {
+    __shared__ uint32_t ks[TILE * KP];
+    __shared__ __half2 vs[TILE * 32];
+    __shared__ float qs[G][HD];
+    const int r = blockIdx.x, kvh = blockIdx.y, c = blockIdx.z;
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int h = kvh * G + warp;
+    const int p = pos[r];
+    const int lo = win > 0 ? max(0, p - win) : 0;
+    const int start = lo + c * CK;
+    const int end = min(start + CK, p + 1);
+    const int64_t out = ((int64_t)r * H + h) * NCH + c;
+    if (start >= end) {
+        if (lane == 0) {
+            pm[out] = -CUDART_INF_F;
+            pl[out] = 0.f;
+        }
+        po[out * HD + lane] = 0.f;
+        po[out * HD + lane + 32] = 0.f;
+        return;
+    }
+    {
+        const __half* qr = qo + ((int64_t)r * H + h) * HD;
+        qs[warp][lane] = __half2float(qr[lane]) * scale;
+        qs[warp][lane + 32] = __half2float(qr[lane + 32]) * scale;
+    }
+    const int64_t base = (int64_t)slot[r] * LEN;
+    float m = -CUDART_INF_F, l = 0.f, o0 = 0.f, o1 = 0.f;
+    for (int t0 = start; t0 < end; t0 += TILE) {
+        __syncthreads();
+        {
+            const int row = threadIdx.x >> 3, part = threadIdx.x & 7;  // a key row is 8 x 16 bytes
+            if (t0 + row < end) {
+                const int64_t at = ((base + (t0 + row) % LEN) * HK + kvh) * HD + part * 8;
+                const uint4 kk = *(const uint4*)(kc + at);
+                const uint4 vv = *(const uint4*)(vc + at);
+                uint32_t* kd = ks + row * KP + part * 4;
+                kd[0] = kk.x;
+                kd[1] = kk.y;
+                kd[2] = kk.z;
+                kd[3] = kk.w;
+                *(uint4*)(vs + row * 32 + part * 4) = vv;
+            }
+        }
+        __syncthreads();
+        const int nk = min(TILE, end - t0);
+        float s = -CUDART_INF_F;
+        if (lane < nk) {
+            float acc = 0.f;
+            const uint32_t* kr = ks + lane * KP;
+#pragma unroll 8
+            for (int w = 0; w < 32; ++w) {
+                const uint32_t u = kr[w];
+                const float2 kf = __half22float2(*(const __half2*)&u);
+                acc += qs[warp][2 * w] * kf.x + qs[warp][2 * w + 1] * kf.y;
+            }
+            s = acc;
+        }
+        const float mt = warp_max(s);
+        const float mn = fmaxf(m, mt);
+        const float corr = expf(m - mn);  // m = -inf on the first tile: 0
+        const float pj = lane < nk ? expf(s - mn) : 0.f;
+        l = l * corr + warp_sum(pj);
+        o0 *= corr;
+        o1 *= corr;
+        for (int j = 0; j < nk; ++j) {
+            const float pb = __shfl_sync(0xffffffffu, pj, j);
+            const float2 vf = __half22float2(vs[j * 32 + lane]);
+            o0 += pb * vf.x;
+            o1 += pb * vf.y;
+        }
+        m = mn;
+    }
+    if (lane == 0) {
+        pm[out] = m;
+        pl[out] = l;
+    }
+    po[out * HD + 2 * lane] = o0;
+    po[out * HD + 2 * lane + 1] = o1;
+}
+
+// Grid (rows, H / 8), 8 warps: a warp a head. o = merged chunks / sum -> half (the attention output), o_norm
+// (weightless RMS over the head, eps) -> half, then the full-width gate: gate_mode 0 (SlidingAttention: o * half(
+// sigmoid(g))) or 1 (Attention, ext.mul_sigmoid_: o * sigmoid(g)), half. out [rows, H * 64].
+extern "C" __global__ void muse_attn_merge(const float* __restrict__ po, const float* __restrict__ pm,
+                                           const float* __restrict__ pl, int NCH, const __half* __restrict__ g,
+                                           __half* __restrict__ out, int H, float eps, int gate_mode) {
+    const int r = blockIdx.x, h = blockIdx.y * 8 + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+    const int64_t b = ((int64_t)r * H + h) * NCH;
+    float M = -CUDART_INF_F;
+    for (int c = 0; c < NCH; ++c) M = fmaxf(M, pm[b + c]);
+    float L = 0.f, o0 = 0.f, o1 = 0.f;
+    for (int c = 0; c < NCH; ++c) {
+        const float l = pl[b + c];
+        if (l == 0.f) continue;
+        const float f = expf(pm[b + c] - M);
+        L += l * f;
+        o0 += po[(b + c) * HD + 2 * lane] * f;
+        o1 += po[(b + c) * HD + 2 * lane + 1] * f;
+    }
+    const float a0 = __half2float(__float2half_rn(o0 / L)), a1 = __half2float(__float2half_rn(o1 / L));
+    const float rs = rsqrtf(warp_sum(a0 * a0 + a1 * a1) / (float)HD + eps);
+    const float n0 = __half2float(__float2half_rn(a0 * rs)), n1 = __half2float(__float2half_rn(a1 * rs));
+    const int64_t at = ((int64_t)r * H + h) * HD + 2 * lane;
+    float s0 = 1.f / (1.f + expf(-__half2float(g[at]))), s1 = 1.f / (1.f + expf(-__half2float(g[at + 1])));
+    if (gate_mode == 0) {
+        s0 = __half2float(__float2half_rn(s0));
+        s1 = __half2float(__float2half_rn(s1));
+    }
+    out[at] = __float2half_rn(n0 * s0);
+    out[at + 1] = __float2half_rn(n1 * s1);
+}
diff --git a/zig/kernels/cuda/muse_spark/glue.cu b/zig/kernels/cuda/muse_spark/glue.cu
new file mode 100644
index 00000000..28b139df
--- /dev/null
+++ b/zig/kernels/cuda/muse_spark/glue.cu
@@ -0,0 +1,284 @@
+// Muse Spark's decode glue: norms, residual gates, router, the per-expert norm and sum, the softcapped head.
+// Each op follows exllamav3's muse_spark modules (the parity oracle) in its roundings; fp32 inside.
+// Built with the glue flags (no contraction, IEEE division and square root): zig/build/cuda.zig.
+
+#include <cstdint>
+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#include <math_constants.h>
+
+namespace {
+
+constexpr int kMaxPer = 16;  // values a thread holds: rows up to 1024 * 16 wide
+
+__device__ __forceinline__ float bf16r(float x) { return __bfloat162float(__float2bfloat16_rn(x)); }
+
+__device__ __forceinline__ float warp_sum(float v) {
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) v += __shfl_xor_sync(0xffffffffu, v, o);
+    return v;
+}
+
+// Sum over the block (blockDim.x a multiple of 32, at most 1024); every thread gets the total.
+__device__ float block_sum(float v) {
+    __shared__ float part[32];
+    __shared__ float total;
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5, nw = blockDim.x >> 5;
+    v = warp_sum(v);
+    __syncthreads();
+    if (lane == 0) part[warp] = v;
+    __syncthreads();
+    if (warp == 0) {
+        float s = lane < nw ? part[lane] : 0.f;
+        s = warp_sum(s);
+        if (lane == 0) total = s;
+    }
+    __syncthreads();
+    return total;
+}
+
+}  // namespace
+
+// x = rms(embed[ids].float()) (Embedding then the weightless embed_norm, fp32 out). A block a row.
+extern "C" __global__ void muse_embed_norm(const uint16_t* __restrict__ table, const int64_t* __restrict__ ids,
+                                           float* __restrict__ out, int D, float eps) {
+    const int64_t r = blockIdx.x;
+    const uint16_t* row = table + ids[r] * (int64_t)D;
+    float v[kMaxPer];
+    float ss = 0.f;
+    int n = 0;
+    for (int d = threadIdx.x; d < D; d += blockDim.x, ++n) {
+        v[n] = __uint_as_float(((uint32_t)row[d]) << 16);
+        ss += v[n] * v[n];
+    }
+    const float rs = rsqrtf(block_sum(ss) / (float)D + eps);
+    n = 0;
+    for (int d = threadIdx.x; d < D; d += blockDim.x, ++n) out[r * D + d] = v[n] * rs;
+}
+
+// out = half(x * rsqrt(mean(x^2) + eps) * w) (RMSNorm: w = 1 + weight for the centred norms, weight, or none).
+// x fp32 (x_half 0) or fp16 (1). A block a row.
+extern "C" __global__ void muse_rms(const void* __restrict__ x, int x_half, const float* __restrict__ w,
+                                    __half* __restrict__ out, int D, float eps) {
+    const int64_t r = blockIdx.x;
+    float v[kMaxPer];
+    float ss = 0.f;
+    int n = 0;
+    for (int d = threadIdx.x; d < D; d += blockDim.x, ++n) {
+        v[n] = x_half ? __half2float(((const __half*)x)[r * D + d]) : ((const float*)x)[r * D + d];
+        ss += v[n] * v[n];
+    }
+    const float rs = rsqrtf(block_sum(ss) / (float)D + eps);
+    n = 0;
+    for (int d = threadIdx.x; d < D; d += blockDim.x, ++n) {
+        float y = v[n] * rs;
+        if (w) y = y * w[d];
+        out[r * D + d] = __float2half_rn(y);
+    }
+}
+
+// A sublayer's end and the next norm (MuseSparkBlock): y' = y (+ y2) [* scale, rounded to bf16 when round_bf16];
+// yn = y' * rsqrt(mean(y'^2) + post_eps); res = res * alpha + yn * beta; x = half(rms(res) * w_next).
+// ab: fp32 [2, D] (alpha, beta). y2: the other rank's partial or null. A block a row.
+extern "C" __global__ void muse_gate_norm(float* __restrict__ res, const float* __restrict__ y,
+                                          const float* __restrict__ y2, const float* __restrict__ scale,
+                                          int round_bf16, float post_eps, const float* __restrict__ ab,
+                                          const float* __restrict__ w_next, float next_eps, __half* __restrict__ x,
+                                          int D) {
+    const int64_t r = blockIdx.x;
+    float v[kMaxPer];
+    float ss = 0.f;
+    int n = 0;
+    for (int d = threadIdx.x; d < D; d += blockDim.x, ++n) {
+        float t = y[r * D + d];
+        if (y2) t = t + y2[r * D + d];
+        if (scale) {
+            t = t * scale[d];
+            if (round_bf16) t = bf16r(t);
+        }
+        v[n] = t;
+        ss += t * t;
+    }
+    const float rs = rsqrtf(block_sum(ss) / (float)D + post_eps);
+    float ss2 = 0.f;
+    n = 0;
+    for (int d = threadIdx.x; d < D; d += blockDim.x, ++n) {
+        const float yn = v[n] * rs;
+        const float h = res[r * D + d] * ab[d] + yn * ab[D + d];
+        res[r * D + d] = h;
+        v[n] = h;
+        ss2 += h * h;
+    }
+    const float rs2 = rsqrtf(block_sum(ss2) / (float)D + next_eps);
+    n = 0;
+    for (int d = threadIdx.x; d < D; d += blockDim.x, ++n) x[r * D + d] = __float2half_rn(v[n] * rs2 * w_next[d]);
+}
+
+// Router logits in fp32: out[r, e] = x[r].float() . W[e] (F.linear(x.float(), router_weight)); W bf16 or fp32.
+// Grid (E / 8, rows), 8 warps: a warp an expert.
+extern "C" __global__ void muse_router(const __half* __restrict__ x, const void* __restrict__ W, int w_bf16,
+                                       float* __restrict__ out, int D, int E) {
+    const int r = blockIdx.y, warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int e = blockIdx.x * 8 + warp;
+    if (e >= E) return;
+    const __half* xr = x + (int64_t)r * D;
+    float acc = 0.f;
+    if (w_bf16) {
+        const uint16_t* wr = (const uint16_t*)W + (int64_t)e * D;
+        for (int d = lane; d < D; d += 32) acc += __half2float(xr[d]) * __uint_as_float(((uint32_t)wr[d]) << 16);
+    } else {
+        const float* wr = (const float*)W + (int64_t)e * D;
+        for (int d = lane; d < D; d += 32) acc += __half2float(xr[d]) * wr[d];
+    }
+    acc = warp_sum(acc);
+    if (lane == 0) out[(int64_t)r * E + e] = acc;
+}
+
+// MuseSparkTopkRouter: s = sigmoid(logits * mult); the top K of s + bias; weights s / (sum + 1e-15) * scale.
+// Picks are written in increasing expert id (the order exllamav3's index_add_ sums them). A block a row, E threads.
+extern "C" __global__ void muse_topk(const float* __restrict__ logits, const float* __restrict__ bias, int E, int K,
+                                     float mult, float scale, int32_t* __restrict__ pick, float* __restrict__ wts) {
+    __shared__ float bv[1024];
+    __shared__ int bi[1024];
+    __shared__ int sel[32];
+    __shared__ float sc[1024];
+    const int r = blockIdx.x, t = threadIdx.x;
+    float c = -CUDART_INF_F;
+    if (t < E) {
+        const float s = 1.f / (1.f + expf(-(logits[(int64_t)r * E + t] * mult)));
+        sc[t] = s;
+        c = s + bias[t];
+    }
+    for (int k = 0; k < K; ++k) {
+        bv[t] = c;
+        bi[t] = t;
+        __syncthreads();
+        for (int o = blockDim.x >> 1; o > 0; o >>= 1) {
+            if (t < o) {
+                const float v = bv[t + o];
+                const int i = bi[t + o];
+                if (v > bv[t] || (v == bv[t] && i < bi[t])) {
+                    bv[t] = v;
+                    bi[t] = i;
+                }
+            }
+            __syncthreads();
+        }
+        if (t == 0) sel[k] = bi[0];
+        __syncthreads();
+        if (t == sel[k]) c = -CUDART_INF_F;
+        __syncthreads();
+    }
+    if (t == 0) {
+        float sum = 0.f;
+        for (int k = 0; k < K; ++k) sum += sc[sel[k]];
+        const float den = sum + 1e-15f;
+        int ord[32];
+        for (int k = 0; k < K; ++k) ord[k] = sel[k];
+        for (int i = 1; i < K; ++i) {
+            const int v = ord[i];
+            int j = i - 1;
+            while (j >= 0 && ord[j] > v) {
+                ord[j + 1] = ord[j];
+                --j;
+            }
+            ord[j + 1] = v;
+        }
+        for (int k = 0; k < K; ++k) {
+            pick[r * K + k] = ord[k];
+            wts[r * K + k] = (sc[ord[k]] / den) * scale;
+        }
+    }
+}
+
+// The routed sum (MuseSparkMoE.forward): per slot, y (+ y2) [L] scaled by (1 + w) and rounded to bf16, normalised
+// (post_expert_norm, eps), times its routing weight, added in slot order to acc = 0; out = half(acc). A block a row.
+extern "C" __global__ void muse_expert_sum(const float* __restrict__ y, const float* __restrict__ y2,
+                                           const float* __restrict__ wts, const float* __restrict__ scale, float eps,
+                                           __half* __restrict__ out, int L, int K) {
+    const int64_t r = blockIdx.x;
+    float acc[kMaxPer];
+    float v[kMaxPer];
+    int n = 0;
+    for (int d = threadIdx.x; d < L; d += blockDim.x, ++n) acc[n] = 0.f;
+    for (int k = 0; k < K; ++k) {
+        const int64_t p = r * K + k;
+        float ss = 0.f;
+        n = 0;
+        for (int d = threadIdx.x; d < L; d += blockDim.x, ++n) {
+            float t = y[p * L + d];
+            if (y2) t = t + y2[p * L + d];
+            t = bf16r(t * scale[d]);
+            v[n] = t;
+            ss += t * t;
+        }
+        const float rs = rsqrtf(block_sum(ss) / (float)L + eps);
+        const float wk = wts[p];
+        n = 0;
+        for (int d = threadIdx.x; d < L; d += blockDim.x, ++n) acc[n] = acc[n] + (v[n] * rs) * wk;
+    }
+    n = 0;
+    for (int d = threadIdx.x; d < L; d += blockDim.x, ++n) out[r * L + d] = __float2half_rn(acc[n]);
+}
+
+// The head: x = x * mult, then cap * tanh(x / cap) when cap > 0 (Linear pre_scale, ext.softcap), in place.
+extern "C" __global__ void muse_softcap(float* __restrict__ x, int64_t n, float mult, float cap) {
+    for (int64_t i = blockIdx.x * (int64_t)blockDim.x + threadIdx.x; i < n; i += (int64_t)gridDim.x * blockDim.x) {
+        float v = x[i] * mult;
+        if (cap > 0.f) v = tanhf(v / cap) * cap;
+        x[i] = v;
+    }
+}
+
+// argmax over the first `vocab` columns of the gathered head (rank-major [world, n, stride]; rank k's columns are
+// vocabulary rows k * stride ..): the first index of the maximum; a NaN counts as the maximum. out int32 [n].
+extern "C" __global__ void muse_argmax(const float* __restrict__ recv, int32_t* __restrict__ out, int n, int stride,
+                                       int vocab) {
+    __shared__ float bv[256];
+    __shared__ int bi[256];
+    const int r = blockIdx.x, tid = threadIdx.x;
+    float best = -CUDART_INF_F;
+    int idx = 0x7fffffff;
+    for (int c = tid; c < vocab; c += 256) {
+        const int k = c / stride, j = c % stride;
+        const float v = recv[((int64_t)k * n + r) * stride + j];
+        const bool nan_v = v != v, nan_b = best != best;
+        if (idx == 0x7fffffff || (nan_v && !nan_b) || (!nan_b && v > best)) {
+            best = v;
+            idx = c;
+        }
+    }
+    bv[tid] = best;
+    bi[tid] = idx;
+    __syncthreads();
+    for (int o = 128; o > 0; o >>= 1) {
+        if (tid < o) {
+            const float v = bv[tid + o], b = bv[tid];
+            const int i = bi[tid + o];
+            const bool nv = v != v, nb = b != b;
+            const bool take = i != 0x7fffffff && (bi[tid] == 0x7fffffff || (nv && !nb) ||
+                                                  (nv == nb && (nv ? i < bi[tid] : (v > b || (v == b && i < bi[tid])))));
+            if (take) {
+                bv[tid] = v;
+                bi[tid] = i;
+            }
+        }
+        __syncthreads();
+    }
+    if (tid == 0) out[r] = bi[0];
+}
+
+// RoPE tables (NeoX, full head): cos / sin [context, dim / 2] of p * theta ** (-2j / dim), in fp64 then fp32.
+extern "C" __global__ void muse_rope_tables(float* __restrict__ cos_out, float* __restrict__ sin_out, int context,
+                                            double theta, int dim) {
+    const int half = dim / 2;
+    const int64_t n = (int64_t)context * half;
+    for (int64_t i = blockIdx.x * (int64_t)blockDim.x + threadIdx.x; i < n; i += (int64_t)gridDim.x * blockDim.x) {
+        const int j = (int)(i % half);
+        const int64_t p = i / half;
+        const double inv = 1.0 / pow(theta, (double)(2 * j) / (double)dim);
+        const double ang = (double)p * inv;
+        cos_out[i] = __double2float_rn(cos(ang));
+        sin_out[i] = __double2float_rn(sin(ang));
+    }
+}
