From 5f35feb544cd0577925478fd01af3277536328e4 Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Sun, 18 Oct 2026 08:22:51 +1100
Subject: [PATCH 48/60] Muse Spark lanes: family width 8 without the drafter
 too, so plain streams share rounds

---
 zig/src/families/muse_spark/native.zig | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/zig/src/families/muse_spark/native.zig b/zig/src/families/muse_spark/native.zig
index 2571cc81..b7cce7f6 100644
--- a/zig/src/families/muse_spark/native.zig
+++ b/zig/src/families/muse_spark/native.zig
@@ -380,7 +380,8 @@ pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: [
     return .{
         .backend = own.l.backend(),
         .facts = own.l.facts(),
-        .rows = @intCast(own.l.block()),
+        // shared rounds need a family width >= 2 (lanes Config): 8 rows (exact_width) also without the drafter
+        .rows = @intCast(@max(own.l.block(), 8)),
         .stream_bytes = 0,
         .free_streams = @intCast(su.slots),
         .ctx = own,
-- 
