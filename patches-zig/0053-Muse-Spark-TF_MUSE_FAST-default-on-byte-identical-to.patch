+    pub fn qkvg(m: *Model, s: Stream, L: load_.Layer, x: u64, q: u64, k: u64, v: u64, g: u64, n: usize) !void {
+        const ls = [4]exl3.Linear{ L.q, L.k, L.v, L.g };
