+pub const HcaError = error{
+    /// no active Ethernet port with an IPv4 RoCE v2 GID on this host
+    NoRoceDevice,
+    /// this host's ports share no IPv4 /24 with the peer's: NCCL would not reach the peer on them either
+    NoSharedSubnet,
+};
