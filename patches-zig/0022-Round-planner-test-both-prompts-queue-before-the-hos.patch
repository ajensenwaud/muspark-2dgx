From 6d9d9e147e0b8bd94732fe0749f6a68b1ba684b1 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Sun, 11 Oct 2026 06:52:10 +0700
Subject: [PATCH 22/60] Round planner test: both prompts queue before the host
 starts, and its waits time out

The second prompt was submitted after start(), so a loaded scheduler could let the first finish its pieces before
the second arrived: no queued admission, and the test's waits > 0 check failed. Both are queued now before the first
round. Each wait gives up after 10 s, and a timed-out wait stops the host thread before the test's frame is gone.

(cherry picked from commit e9f9210be2ed986edc61cbe57e5d431570215ce4)
---
 zig/src/core/lane_rounds_test.zig | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/zig/src/core/lane_rounds_test.zig b/zig/src/core/lane_rounds_test.zig
index 61374484..4a59e380 100644
--- a/zig/src/core/lane_rounds_test.zig
+++ b/zig/src/core/lane_rounds_test.zig
@@ -91,14 +91,15 @@ test "a round planner: prompts in pieces between the other streams' decode round
                 else => {},
             }
         }
-        fn wait(b: *@This()) Reason {
-            while (true) {
+        fn wait(b: *@This()) !Reason {
+            for (0..10_000) |_| { // 10 s
                 b.mutex.lockUncancelable(std.testing.io);
                 const d = b.done;
                 b.mutex.unlock(std.testing.io);
                 if (d) |r| return r;
                 std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
             }
+            return error.Timeout;
         }
     };
     const p1 = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6, 5, 3 };
@@ -110,11 +111,15 @@ test "a round planner: prompts in pieces between the other streams' decode round
     const r1: Request = .{ .prompt = &p1, .max_tokens = 40 };
     const r2: Request = .{ .prompt = &p2, .max_tokens = 12 };
     const e = host.engine();
-    try host.start();
+    // both queued before the first round, so the second waits whatever the scheduler does
     try e.submit(1, &r1, .{ .ctx = &b1, .event = Box.event });
     try e.submit(2, &r2, .{ .ctx = &b2, .event = Box.event });
-    try std.testing.expectEqual(Reason.length, b1.wait());
-    try std.testing.expectEqual(Reason.length, b2.wait());
+    try host.start();
+    {
+        errdefer host.stop(); // a timed-out wait stops the host thread before this frame goes
+        try std.testing.expectEqual(Reason.length, try b1.wait());
+        try std.testing.expectEqual(Reason.length, try b2.wait());
+    }
     host.stop();
     // the replies are the whole-prompt path's tokens
     for ([_]struct { p: []const u32, b: *Box }{ .{ .p = &p1, .b = &b1 }, .{ .p = &p2, .b = &b2 } }) |c| {
