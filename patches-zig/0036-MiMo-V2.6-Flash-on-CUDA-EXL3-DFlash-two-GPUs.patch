+//! MiMo-V2's decode forward, launch for launch as the Python engine's: captured Triton, EXL3 and glue kernels.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const tp = @import("tp");
+const load_ = @import("load.zig");
+const dflash = @import("dflash.zig");
+const exl3 = cuda.exl3;
+const aot = cuda.aot;
+const Weights = load_.Weights;
+const Stream = cuda.Stream;
+
+pub const CK = 256; // attention.CK: keys a decode chunk
+pub const BN = 64;
+pub const GP = 16;
+pub const PROMPT_CHUNK = 16384; // forward.PROMPT_CHUNK: sizes the sliding ring
+pub const DECODE_ROWS = 128; // ops.DECODE_ROWS: the EXL3 GEMV's row limit
+pub const BUCKET = 8192; // graphs.BUCKET
+pub const MAX_GRAPH_ROWS = 32; // graphs.MAX_ROWS: the widest chain graphed
+
+/// One decode row: a stream's cache slot, its position, its input token.
+pub const Row = struct { slot: u32, pos: u32, token: i64 };
+
+/// attention.ring_size
+pub fn ringSize(rows: usize, window: usize) usize {
+    return (rows + window + BN - 1) / BN * BN;
+}
+
+fn pow2(x: usize) usize {
+    return std.math.ceilPowerOfTwo(usize, x) catch unreachable;
+}
+
+const p = aot.ptr;
+fn ci(name: []const u8, v: usize) aot.Const {
+    return aot.ci(name, @intCast(v));
+}
+fn ii(name: []const u8, v: usize) aot.Arg {
+    return aot.int(name, @intCast(v));
+}
+fn u(x: usize) u32 {
+    return @intCast(x);
+}
+
+/// Device scratch for up to `rows` decode rows.
+const Bufs = struct {
+    ids: u64, // i64 [R]
+    pos: u64, // i32 [R]
+    slot: u64, // i32 [R]
+    res: u64, // f32 [R, D]
+    x: u64, // f16 [R, D]
+    q: u64, // f16 [R, H * 192]
+    k: u64, // f16 [R, HK * 192]
+    v: u64,
+    qo: u64, // f16 [R, H, 192]
+    att: u64, // f16 [R, H, 128]
+    po: u64, // f32 [R * NCH * H * 128]
+    pm: u64,
+    pl: u64,
+    xh: u64, // f16 rot_in scratch [R, max K]
+    z: u64, // f32 split partials
+    part: u64, // f32 [R, D]
+    recv: u64, // f32 [2, R, max(D, Vr)]
+    sum: u64, // f32 [R, D]
+    logits: u64, // f32 [R, E]
+    pick: u64, // i32 [R, 8]
+    wts: u64, // f32 [R, 8]
+    g: u64, // f16 [R, ND]
+    up: u64,
+    h: u64,
+    head: u64, // f32 [R, Vr]
+    am: u64, // i32 [R]: device argmax of each row
+    sc: exl3.Scratch,
+};
+
+pub const Model = struct {
+    w: *const Weights,
+    d: *const cuda.Driver,
+    set: *const aot.Set,
+    k3: *const exl3.Kernels,
+    glue: cuda.Module,
+    f_embed: cuda.Function,
+    f_add2: cuda.Function,
+    f_argmax: cuda.Function,
+    comm: ?tp.Collective,
+    context: usize,
+    ring: usize,
+    rows: usize,
+    slots: usize,
+    nch_max: usize,
+    graphs: std.AutoHashMapUnmanaged([2]u32, cuda.graph.Exec) = .empty,
+    dr: ?*dflash.Drafter = null,
+    replays: usize = 0,
+    captures: usize = 0,
+    kc: []u64,
+    vc: []u64,
+    cos_full: u64,
+    sin_full: u64,
+    cos_swa: u64,
+    sin_swa: u64,
+    scale: f32,
+    b: Bufs,
+    arena: load_.Arena,
+    gpa: std.mem.Allocator,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const Weights, set: *const aot.Set, k3: *const exl3.Kernels, comm: ?tp.Collective, context: usize, rows: usize, slots: usize, s: Stream) !Model {
+        const cfg = w.cfg;
+        var m: Model = undefined;
+        m.w = w;
+        m.d = d;
+        m.set = set;
+        m.k3 = k3;
+        m.comm = if (w.world > 1) comm orelse return error.NeedComm else null;
+        m.context = context;
+        m.ring = ringSize(PROMPT_CHUNK, cfg.window);
+        if (rows > DECODE_ROWS) return error.TooManyRows;
+        m.rows = rows;
+        m.slots = slots;
+        m.graphs = .empty;
+        m.dr = null;
+        m.replays = 0;
+        m.captures = 0;
+        m.nch_max = (context + CK - 1) / CK; // a graph's bucket / CK at most, and max(pos) / CK + 1 eagerly
+        m.gpa = gpa;
+        m.arena = .{ .d = d, .gpa = gpa };
+        errdefer m.arena.deinit();
+        m.glue = try cuda.Module.load(d, cuda.kernels.mimo_glue);
+        m.f_embed = try m.glue.function("mimo_embed_f32");
+        m.f_add2 = try m.glue.function("mimo_add2_f32");
+        m.f_argmax = try m.glue.function("mimo_argmax");
+        const ar = &m.arena;
+        // caches: keys [1, LEN, HK, 192], values [1, LEN, HK, 128], zeroed (forward.Model.__init__)
+        m.kc = try gpa.alloc(u64, cfg.layers);
+        m.vc = try gpa.alloc(u64, cfg.layers);
+        for (0..cfg.layers) |i| {
+            const n = if (cfg.full[i]) context else m.ring;
+            const hk = cfg.kvHeads(i);
+            m.kc[i] = try ar.zeros(slots * n * hk * 192 * 2);
+            m.vc[i] = try ar.zeros(slots * n * hk * 128 * 2);
+        }
+        // rope tables per theta: cos, sin [context, rope_dim / 2] fp32
+        const half = cfg.rope_dim / 2;
+        const rope = try m.glue.function("mimo_rope_tables");
+        inline for (.{ .{ "cos_full", "sin_full", cfg.theta_full }, .{ "cos_swa", "sin_swa", cfg.theta_swa } }) |t| {
+            @field(m, t[0]) = try ar.alloc(context * half * 4);
+            @field(m, t[1]) = try ar.alloc(context * half * 4);
+            var a: cuda.Args = .{};
+            a.add(@field(m, t[0]));
+            a.add(@field(m, t[1]));
+            a.add(@as(c_int, @intCast(context)));
+            a.add(@as(f64, t[2]));
+            a.add(@as(c_int, @intCast(cfg.rope_dim)));
+            try cuda.launch.launch(rope, .{ .grid = .{ .x = 256, .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+        }
+        // qk_dim ** -0.5 as Python's float(), then fp32
+        m.scale = @floatCast(std.math.pow(f64, @floatFromInt(cfg.qk_dim), -0.5));
+        // scratch
+        const R = rows;
+        const D = cfg.hidden;
+        const H = cfg.heads;
+        const hk_max = @max(cfg.kv_full, cfg.kv_swa);
+        const vr = w.head.n;
+        const nd = cfg.dense_width / w.world;
+        var max_k: usize = @max(D, H * 128);
+        max_k = @max(max_k, nd);
+        var max_z: usize = 0;
+        for (w.layers) |L| {
+            inline for (.{ "q", "k", "v", "o" }) |f| max_z = @max(max_z, zBytes(@field(L, f), R));
+            if (L.gate) |g| max_z = @max(max_z, zBytes(g, R));
+            if (L.up) |g| max_z = @max(max_z, zBytes(g, R));
+            if (L.down) |g| max_z = @max(max_z, zBytes(g, R));
+        }
+        max_z = @max(max_z, zBytes(w.head, R));
+        var b: Bufs = undefined;
+        b.ids = try ar.zeros(R * 8);
+        b.pos = try ar.zeros(R * 4);
+        b.slot = try ar.zeros(R * 4);
+        b.res = try ar.zeros(R * D * 4);
+        b.x = try ar.zeros(R * D * 2);
+        b.q = try ar.zeros(R * H * 192 * 2);
+        b.k = try ar.zeros(R * hk_max * 192 * 2);
+        b.v = try ar.zeros(R * hk_max * 192 * 2);
+        b.qo = try ar.zeros(R * H * 192 * 2);
+        b.att = try ar.zeros(R * H * 128 * 2);
+        b.po = try ar.zeros(R * m.nch_max * H * 128 * 4);
+        b.pm = try ar.zeros(R * m.nch_max * H * 4);
+        b.pl = try ar.zeros(R * m.nch_max * H * 4);
+        b.xh = try ar.zeros(R * max_k * 2);
+        b.z = try ar.zeros(@max(max_z, 4));
+        b.part = try ar.zeros(R * D * 4);
+        b.recv = try ar.zeros(2 * R * @max(D, vr) * 4);
+        b.sum = try ar.zeros(R * D * 4);
+        b.logits = try ar.zeros(R * cfg.experts * 4);
+        b.pick = try ar.zeros(R * cfg.top_k * 4);
+        b.wts = try ar.zeros(R * cfg.top_k * 4);
+        b.g = try ar.zeros(R * nd * 2);
+        b.up = try ar.zeros(R * nd * 2);
+        b.h = try ar.zeros(R * nd * 2);
+        b.head = try ar.zeros(R * vr * 4);
+        b.am = try ar.zeros(R * 4);
+        // experts.Scratch(ex, WINDOW, top_k): the decode path's (rows only size it)
+        const first = for (w.layers) |L| {
+            if (L.experts) |e| break e;
+        } else return error.NoMoE;
+        const cfg_gu = try exl3.defaultConfig(first.dims, first.width, true);
+        const cfg_d = try exl3.defaultConfig(first.width, first.dims, false);
+        const sz = exl3.Scratch.bytes(first, R, cfg.top_k, cfg_gu, cfg_d);
+        b.sc = .{ .xg = try ar.zeros(sz.xg), .xu = try ar.zeros(sz.xg), .xd = try ar.zeros(sz.xd), .z = try ar.zeros(sz.z), .y = try ar.zeros(sz.y), .ids = try ar.zeros(sz.ids), .count = try ar.zeros(4), .members = try ar.alloc(sz.members), .rows = R, .slots = cfg.top_k, .cfg_gu = cfg_gu, .cfg_d = cfg_d };
+        try d.check(d.api.cuMemsetD32_v2(b.sc.members, 0xFFFF_FFFF, sz.members / 4), "members -1");
+        m.b = b;
+        try s.synchronize();
+        return m;
+    }
+
+    fn zBytes(l: exl3.Linear, R: usize) usize {
+        return if (l.split[0] > 1) l.split[0] * R * l.n * 4 else 0;
+    }
+
+    pub fn deinit(m: *Model) void {
+        var it = m.graphs.valueIterator();
+        while (it.next()) |e| e.deinit();
+        m.graphs.deinit(m.gpa);
+        m.gpa.free(m.kc);
+        m.gpa.free(m.vc);
+        m.glue.unload();
+        m.arena.deinit();
+    }
+
+    /// The fp32 residual (or partial) of `n` rows summed over the ranks in rank order (forward._sum).
+    fn sum(m: *Model, s: Stream, part: u64, n: usize) !u64 {
+        const c = m.comm orelse return part;
+        const D = m.w.cfg.hidden;
+        try c.allGather(part, m.b.recv, n * D, .f32, s.handle);
+        try m.add2(s, m.b.recv, m.b.recv + n * D * 4, m.b.sum, n * D);
+        return m.b.sum;
+    }
+
+    pub fn add2(m: *Model, s: Stream, a_: u64, b_: u64, out: u64, n: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(a_);
+        a.add(b_);
+        a.add(out);
+        a.add(@as(i64, @intCast(n)));
+        try cuda.launch.launch(m.f_add2, .{ .grid = .{ .x = u(@min((n + 255) / 256, 1024)), .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+    }
+
+    fn rms(m: *Model, s: Stream, x: u64, w: u64, out: u64, n: usize) !void {
+        const D = m.w.cfg.hidden;
+        try m.set.run(s, "_rms", .{ u(n), 1, 1 }, &.{ p("X", "*fp32", x), p("W", "*fp32", w), p("OUT", "*fp16", out) }, &.{ ci("N", D), aot.cf("EPS", @floatCast(m.w.cfg.eps)), ci("BLOCK", pow2(D)) });
+    }
+
+    /// The ranks' partials summed into the residual and RMS-normed into `out` (forward._sum, ops._add_rms).
+    fn sumNorm(m: *Model, s: Stream, part: u64, w: u64, out: u64, n: usize) !void {
+        try m.addRms(s, try m.sum(s, part, n), w, out, n);
+    }
+
+    fn addRms(m: *Model, s: Stream, x: u64, w: u64, out: u64, n: usize) !void {
+        const D = m.w.cfg.hidden;
+        try m.set.run(s, "_add_rms", .{ u(n), 1, 1 }, &.{ p("X", "*fp32", x), p("RES", "*fp32", m.b.res), p("W", "*fp32", w), p("OUT", "*fp16", out) }, &.{ ci("N", D), aot.cf("EPS", @floatCast(m.w.cfg.eps)), ci("BLOCK", pow2(D)) });
+    }
+
+    /// ops.Proj on the decode path: Exl3Linear(x [n, K] fp16) -> out [n, N] (fp16, or fp32 for o / down / head).
+    fn proj(m: *Model, s: Stream, l: exl3.Linear, x: u64, out: u64, out_f32: bool, n: usize) !void {
+        if (n > 128) return error.DecodeRows;
+        try m.k3.linear(s, l, x, .f16, m.b.xh, out, if (out_f32) .f32 else .f16, if (l.split[0] > 1) m.b.z else 0, n);
+    }
+
+    pub const Tap = enum { attn, mlp, att };
+    pub const Capture = struct {
+        hook: ?*const fn (ctx: *anyopaque, what: Tap, layer: usize, dev: u64, bytes: usize) anyerror!void = null,
+        ctx: *anyopaque = undefined,
+    };
+
+    /// Rows' tokens, positions and slots into the fixed device inputs (graphs.Staged.refresh).
+    pub fn stage(m: *Model, rows: []const Row) !void {
+        const cfg = m.w.cfg;
+        if (rows.len == 0 or rows.len > m.rows) return error.WindowTooWide;
+        var ids: [DECODE_ROWS]i64 = undefined;
+        var pos: [DECODE_ROWS]i32 = undefined;
+        var slot: [DECODE_ROWS]i32 = undefined;
+        for (rows, 0..) |r, i| {
+            if (r.slot >= m.slots) return error.BadSlot;
+            if (r.pos >= m.context) return error.PastContext;
+            ids[i] = r.token;
+            pos[i] = @intCast(r.pos);
+            slot[i] = @intCast(r.slot);
+        }
+        // forward.check: a chain's rows must fit the sliding ring before its first row reads the window back
+        var per: [DECODE_ROWS]usize = @splat(0);
+        for (rows) |r| per[r.slot] += 1;
+        for (per[0..m.slots]) |c| if (c > m.ring - cfg.window) return error.RingOverrun;
+        const n = rows.len;
+        try upload(m.d, m.b.ids, std.mem.sliceAsBytes(ids[0..n]));
+        try upload(m.d, m.b.pos, std.mem.sliceAsBytes(pos[0..n]));
+        try upload(m.d, m.b.slot, std.mem.sliceAsBytes(slot[0..n]));
+    }
+
+    /// Eager decode window: fp32 logits of every row into `out` [n, V] (Model.forward(prompt=False, rows=all)).
+    pub fn forward(m: *Model, s: Stream, rows: []const Row, out: ?[]f32, cap: ?Capture) !void {
+        try m.stage(rows);
+        var end: usize = 0;
+        for (rows) |r| end = @max(end, r.pos);
+        try m.run(s, rows.len, end / CK + 1, cap);
+        if (out) |o| try m.logitsTo(s, rows.len, o) else try s.synchronize();
+    }
+
+    /// graphs.Graphs.forward: a graph per (rows, key bucket), captured after a warm-up; wider chains run eagerly.
+    pub fn graphed(m: *Model, s: Stream, rows: []const Row, out: ?[]f32) !void {
+        var per: [DECODE_ROWS]usize = @splat(0);
+        var end: usize = 0;
+        for (rows) |r| {
+            per[r.slot] += 1;
+            end = @max(end, r.pos + 1);
+        }
+        if (std.mem.max(usize, per[0..m.slots]) > MAX_GRAPH_ROWS) return m.forward(s, rows, out, null);
+        const full = (m.context + CK - 1) / CK * CK;
+        const bucket = @min(full, @max(BUCKET, std.math.ceilPowerOfTwo(usize, end) catch unreachable));
+        const key: [2]u32 = .{ @intCast(rows.len), @intCast(bucket) };
+        try m.stage(rows);
+        if (m.graphs.get(key)) |exec| {
+            try exec.launchOn(s);
+            m.replays += 1;
+        } else {
+            try m.run(s, rows.len, bucket / CK, null); // warm-up: writes the same cache rows the replay will
+            try s.synchronize();
+            try cuda.graph.beginCapture(s, .thread_local);
+            m.run(s, rows.len, bucket / CK, null) catch |e| {
+                if (cuda.graph.endCapture(s)) |g| {
+                    var gg = g;
+                    gg.deinit();
+                } else |_| {}
+                return e;
+            };
+            var g = try cuda.graph.endCapture(s);
+            defer g.deinit();
+            const exec = try g.instantiate();
+            try m.graphs.put(m.gpa, key, exec);
+            try exec.launchOn(s);
+            m.captures += 1;
+        }
+        if (out) |o| try m.logitsTo(s, rows.len, o) else try s.synchronize();
+    }
+
+    /// attention._qkv, then attention.rows and _merge: sliding layers over the window with sinks, full from key 0.
+    fn attention(m: *Model, s: Stream, i: usize, layer_sinks: u64, n: usize, chunks: usize) !void {
+        const cfg = m.w.cfg;
+        const H = cfg.heads;
+        const hk = cfg.kvHeads(i);
+        const full = cfg.full[i];
+        const len = if (full) m.context else m.ring;
+        try m.set.run(s, "_qkv", .{ u(n), u(H + 2 * hk), 1 }, &.{
+            p("Q", "*fp16", m.b.q),                                 p("K", "*fp16", m.b.k),                                 p("V", "*fp16", m.b.v),
+            p("COS", "*fp32", if (full) m.cos_full else m.cos_swa), p("SIN", "*fp32", if (full) m.sin_full else m.sin_swa), p("POS", "*i32", m.b.pos),
+            p("SLOT", "*i32", m.b.slot),                            p("QO", "*fp16", m.b.qo),                               p("KC", "*fp16", m.kc[i]),
+            p("VC", "*fp16", m.vc[i]),                              ii("LEN", len),
+        }, &.{ ci("H", H), ci("HK", hk), ci("RD", cfg.rope_dim) });
+        const win: usize = if (full) 0 else cfg.window;
+        const nch: usize = if (full) chunks else (cfg.window + CK - 1) / CK + 1;
+        try m.set.run(s, "_rows", .{ u(n), u(hk), u(nch) }, &.{
+            p("Q", "*fp16", m.b.qo),   p("KC", "*fp16", m.kc[i]),   p("VC", "*fp16", m.vc[i]),
+            p("POS", "*i32", m.b.pos), p("SLOT", "*i32", m.b.slot), p("PO", "*fp32", m.b.po),
+            p("PM", "*fp32", m.b.pm),  p("PL", "*fp32", m.b.pl),    ii("LEN", len),
+            ii("NCH", nch),
+        }, &.{ ci("H", H), ci("HK", hk), ci("G", H / hk), ci("WIN", win), aot.cf("SCALE", m.scale), ci("CK", CK), ci("BN", BN), ci("GP", GP) });
+        const sinks = if (full) 0 else layer_sinks;
+        try m.set.run(s, "_merge", .{ u(n), u(H), 1 }, &.{
+            p("PO", "*fp32", m.b.po),                               p("PM", "*fp32", m.b.pm),   p("PL", "*fp32", m.b.pl),
+            p("SINKS", "*fp32", if (sinks != 0) sinks else m.b.pm), p("OUT", "*fp16", m.b.att), ii("NCH", nch),
+        }, &.{ ci("H", H), ci("HAS_SINK", @intFromBool(sinks != 0)) });
+    }
+
+    /// The window's kernels on staged inputs, no host work; full layers read `chunks` key chunks of CK.
+    pub fn run(m: *Model, s: Stream, n: usize, chunks: usize, cap: ?Capture) !void {
+        const cfg = m.w.cfg;
+        const D = cfg.hidden;
+        const H = cfg.heads;
+        if (chunks > m.nch_max) return error.TooManyChunks;
+        // res = embed[ids].float()
+        {
+            var a: cuda.Args = .{};
+            a.add(m.w.embed);
+            a.add(m.b.ids);
+            a.add(m.b.res);
+            a.add(@as(c_int, @intCast(D)));
+            try cuda.launch.launch(m.f_embed, .{ .grid = .{ .x = u(n), .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+        }
+        try m.rms(s, m.b.res, m.w.layers[0].input_norm, m.b.x, n);
+        for (m.w.layers, 0..) |L, i| {
+            try m.proj(s, L.q, m.b.x, m.b.q, false, n);
+            try m.proj(s, L.k, m.b.x, m.b.k, false, n);
+            try m.proj(s, L.v, m.b.x, m.b.v, false, n);
+            try m.attention(s, i, L.sinks, n, chunks);
+            if (cap) |c| if (c.hook) |h| try h(c.ctx, .att, i, m.b.att, n * H * 128 * 2);
+            try m.proj(s, L.o, m.b.att, m.b.part, true, n);
+            try m.sumNorm(s, m.b.part, L.post_norm, m.b.x, n);
+            if (cap) |c| if (c.hook) |h| try h(c.ctx, .attn, i, m.b.res, n * D * 4);
+            if (L.experts) |e| {
+                // moe.MoE: router logits (shared.router's tile by row count), top 8 (sigmoid + bias), routed experts
+                const bm = routerTile(n);
+                const be: usize, const bk: usize = if (bm == 16) .{ 32, 256 } else .{ 64, 64 };
+                try m.set.run(s, "_router", .{ u((n + bm - 1) / bm), u((cfg.experts + be - 1) / be), 1 }, &.{
+                    p("X", "*fp16", m.b.x), p("W", "*fp16", L.router), p("OUT", "*fp32", m.b.logits), ii("M", n), ii("x_stride", D),
+                }, &.{ ci("D", D), ci("NE", cfg.experts), ci("BM", bm), ci("BLOCK_E", be), ci("BK", bk) });
+                try m.set.run(s, "_topk", .{ u(n), 1, 1 }, &.{
+                    p("L", "*fp32", m.b.logits), p("BIAS", "*fp32", L.bias), p("PICK", "*i32", m.b.pick), p("WTS", "*fp32", m.b.wts), aot.float("SCALE", L.route_scale),
+                }, &.{ ci("NE", cfg.experts), ci("TOPK", cfg.top_k), ci("BLOCK", pow2(cfg.experts)), ci("KP", pow2(cfg.top_k)) });
+                try m.k3.routed(s, m.b.x, false, D, m.b.pick, m.b.wts, e, m.b.sc, m.b.part, n, std.math.inf(f32), 1, true);
+            } else {
+                try m.proj(s, L.gate.?, m.b.x, m.b.g, false, n);
+                try m.proj(s, L.up.?, m.b.x, m.b.up, false, n);
+                const nd = L.gate.?.n;
+                try m.set.run(s, "_silu_mul", .{ u(n), u(nd / 1024), 1 }, &.{ p("G", "*fp16", m.b.g), p("U", "*fp16", m.b.up), p("OUT", "*fp16", m.b.h) }, &.{ ci("N", nd), ci("BLOCK", 1024) });
+                try m.proj(s, L.down.?, m.b.h, m.b.part, true, n);
+            }
+            const after = if (i + 1 < m.w.layers.len) m.w.layers[i + 1].input_norm else m.w.norm;
+            try m.sumNorm(s, m.b.part, after, m.b.x, n);
+            if (cap) |c| if (c.hook) |h| try h(c.ctx, .mlp, i, m.b.res, n * D * 4);
+            if (m.dr) |dr| if (cap == null) try dr.tap(s, i, m.b.res, n);
+        }
+        if (m.dr) |dr| if (cap == null) try dr.update(s, n);
+        // _head / _logits: this rank's vocab slice; gathered over the ranks into recv [world, n, Vr]
+        try m.proj(s, m.w.head, m.b.x, m.b.head, true, n);
+        if (m.comm) |c| try c.allGather(m.b.head, m.b.recv, n * m.w.head.n, .f32, s.handle);
+    }
+
+    /// Each row's argmax (torch.argmax over the gathered vocab) on the device; only the ids reach the host.
+    pub fn argmaxTo(m: *Model, s: Stream, n: usize, out: []i32) !void {
+        var a: cuda.Args = .{};
+        a.add(if (m.comm != null) m.b.recv else m.b.head);
+        a.add(m.b.am);
+        a.add(@as(c_int, @intCast(m.w.world)));
+        a.add(@as(c_int, @intCast(n)));
+        a.add(@as(c_int, @intCast(m.w.head.n)));
+        try cuda.launch.launch(m.f_argmax, .{ .grid = .{ .x = u(n), .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+        try s.synchronize();
+        try m.d.check(m.d.api.cuMemcpyDtoH_v2(@ptrCast(out.ptr), m.b.am, n * 4), "argmax");
+    }
+
+    /// The window's logits on the host: row r = [rank 0's slice, rank 1's slice, ...] (permute(1, 0, 2)).
+    pub fn logitsTo(m: *Model, s: Stream, n: usize, out: []f32) !void {
+        const vr = m.w.head.n;
+        try s.synchronize();
+        if (m.comm == null) return m.d.check(m.d.api.cuMemcpyDtoH_v2(@ptrCast(out.ptr), m.b.head, n * vr * 4), "logits");
+        for (0..n) |r| for (0..m.w.world) |k| {
+            try m.d.check(m.d.api.cuMemcpyDtoH_v2(@ptrCast(out[(r * m.w.world + k) * vr ..].ptr), m.b.recv + ((k * n + r) * vr) * 4, vr * 4), "logits");
+        };
+    }
+};
+
+/// shared._tile: rows a router program takes (16 to 128).
+pub fn routerTile(n: usize) usize {
+    for ([_]usize{ 16, 32, 64, 128 }) |b| if (n <= b) return b;
+    return 128;
+}
+
+fn upload(d: *const cuda.Driver, at: u64, bytes: []const u8) !void {
+    try d.check(d.api.cuMemcpyHtoD_v2(at, bytes.ptr, bytes.len), "upload");
+}
+
+/// torch.argmax of fp32 logits: the first index of the largest value (NaN counts as largest).
+pub fn argmax(xs: []const f32) usize {
+    var best: usize = 0;
+    for (xs, 0..) |x, i| {
+        const b = xs[best];
+        if (std.math.isNan(b)) return best;
+        if (std.math.isNan(x) or x > b) best = i;
+    }
+    return best;
+}
+
+test "ring size and argmax" {
+    try std.testing.expectEqual(@as(usize, 16512), ringSize(16384, 128));
+    try std.testing.expectEqual(@as(usize, 1), argmax(&.{ 1.0, 3.0, 3.0, 2.0 }));
+}
diff --git a/zig/src/families/mimo_v2/load.zig b/zig/src/families/mimo_v2/load.zig
new file mode 100644
index 00000000..95434882
--- /dev/null
+++ b/zig/src/families/mimo_v2/load.zig
@@ -0,0 +1,358 @@
+//! A rank's share of a MiMo-V2 EXL3 pack on the GPU, laid out as the Python family's weights.load builds it.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const config = @import("config.zig");
+const exl3 = cuda.exl3;
+const fmt = core.exl3_format;
+const Config = config.Config;
+
+/// Device memory in large blocks, handed out 256-byte aligned (one cuMemAlloc per block, not per tensor).
+pub const Arena = struct {
+    d: *const cuda.Driver,
+    gpa: std.mem.Allocator,
+    blocks: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    used: usize = 0,
+    total: usize = 0,
+    pub const block_bytes: usize = 1 << 30;
+
+    pub fn alloc(a: *Arena, bytes: usize) !u64 {
+        const n = std.mem.alignForward(usize, @max(bytes, 1), 256);
+        if (a.blocks.items.len == 0 or a.used + n > a.blocks.items[a.blocks.items.len - 1].len) {
+            try a.blocks.append(a.gpa, try cuda.DeviceBuffer.alloc(a.d, @max(block_bytes, n)));
+            a.used = 0;
+        }
+        const b = a.blocks.items[a.blocks.items.len - 1];
+        const at = b.ptr + a.used;
+        a.used += n;
+        a.total += n;
+        return at;
+    }
+    pub fn upload(a: *Arena, bytes: []const u8) !u64 {
+        const at = try a.alloc(bytes.len);
+        try check(a.d, a.d.api.cuMemcpyHtoD_v2(at, bytes.ptr, bytes.len));
+        return at;
+    }
+    pub fn zeros(a: *Arena, bytes: usize) !u64 {
+        const at = try a.alloc(bytes);
+        try check(a.d, a.d.api.cuMemsetD8_v2(at, 0, std.mem.alignForward(usize, @max(bytes, 1), 256)));
+        return at;
+    }
+    pub fn deinit(a: *Arena) void {
+        for (a.blocks.items) |*b| b.free();
+        a.blocks.deinit(a.gpa);
+    }
+};
+
+fn check(d: *const cuda.Driver, r: anytype) !void {
+    try d.check(r, "mimo_v2 load");
+}
+
+/// An EXL3 matrix on the host: trellis int16 [tk, tn, 8 * k2], suh fp16 [K], svh fp16 [N].
+pub const Mat = struct {
+    trellis: []i16,
+    suh: []f16,
+    svh: []f16,
+    tk: usize,
+    tn: usize,
+    k2: u32,
+
+    pub fn deinit(m: Mat, a: std.mem.Allocator) void {
+        a.free(m.trellis);
+        a.free(m.suh);
+        a.free(m.svh);
+    }
+    pub fn k(m: Mat) usize {
+        return m.tk * 16;
+    }
+    pub fn n(m: Mat) usize {
+        return m.tn * 16;
+    }
+};
+
+pub fn readMat(a: std.mem.Allocator, ck: *core.Checkpoint, prefix: []const u8) !Mat {
+    var nb: [256]u8 = undefined;
+    if ((ck.get(try std.fmt.bufPrint(&nb, "{s}.mul1", .{prefix})) catch null) == null) return error.NotMul1;
+    const t = try ck.get(try std.fmt.bufPrint(&nb, "{s}.trellis", .{prefix}));
+    if (t.dtype != .i16 or t.rank != 3 or t.shape[2] % 8 != 0) return error.BadTrellis;
+    const tr = try a.alloc(i16, t.numel());
+    errdefer a.free(tr);
+    @memcpy(std.mem.sliceAsBytes(tr), t.bytes);
+    const suh = try scales(a, ck, prefix, "suh", t.shape[0] * 16);
+    errdefer a.free(suh);
+    return .{ .trellis = tr, .suh = suh, .svh = try scales(a, ck, prefix, "svh", t.shape[1] * 16), .tk = t.shape[0], .tn = t.shape[1], .k2 = @intCast(t.shape[2] / 8) };
+}
+
+fn scales(a: std.mem.Allocator, ck: *core.Checkpoint, prefix: []const u8, part: []const u8, size: usize) ![]f16 {
+    var nb: [256]u8 = undefined;
+    const t = try ck.get(try std.fmt.bufPrint(&nb, "{s}.{s}", .{ prefix, part }));
+    const out = try a.alloc(f16, size);
+    errdefer a.free(out);
+    if (t.dtype == .f16 and t.numel() == size) {
+        @memcpy(std.mem.sliceAsBytes(out), t.bytes);
+    } else if (t.dtype == .i16 and t.numel() * 16 == size) {
+        const w = try a.alloc(i16, t.numel());
+        defer a.free(w);
+        @memcpy(std.mem.sliceAsBytes(w), t.bytes);
+        fmt.unpackSigns(w, out);
+    } else return error.BadScales;
+    return out;
+}
+
+/// weights.py cut(): outputs [lo, hi) (trellis columns, svh) or inputs [lo, hi) (trellis rows, suh); `m` is freed.
+pub fn cut(a: std.mem.Allocator, m: Mat, c: config.Cut) !Mat {
+    if (c.axis == .whole) return m;
+    defer m.deinit(a);
+    const w = 8 * @as(usize, m.k2);
+    if (c.lo % 128 != 0 or c.hi % 128 != 0) return error.CutNotOnBlock;
+    if (c.axis == .n) {
+        const tn = (c.hi - c.lo) / 16;
+        const tr = try a.alloc(i16, m.tk * tn * w);
+        for (0..m.tk) |kt| @memcpy(tr[kt * tn * w ..][0 .. tn * w], m.trellis[(kt * m.tn + c.lo / 16) * w ..][0 .. tn * w]);
+        return .{ .trellis = tr, .suh = try a.dupe(f16, m.suh), .svh = try a.dupe(f16, m.svh[c.lo..c.hi]), .tk = m.tk, .tn = tn, .k2 = m.k2 };
+    }
+    const tk = (c.hi - c.lo) / 16;
+    return .{ .trellis = try a.dupe(i16, m.trellis[(c.lo / 16) * m.tn * w ..][0 .. tk * m.tn * w]), .suh = try a.dupe(f16, m.suh[c.lo..c.hi]), .svh = try a.dupe(f16, m.svh), .tk = tk, .tn = m.tn, .k2 = m.k2 };
+}
+
+/// linear.strips: trellis int32 words [K/16, N/16, W] -> [N/128, K/16, 8, W].
+pub fn strips(a: std.mem.Allocator, m: Mat) ![]u32 {
+    const w32 = 4 * @as(usize, m.k2);
+    const words: []align(2) const u32 = std.mem.bytesAsSlice(u32, std.mem.sliceAsBytes(m.trellis));
+    const out = try a.alloc(u32, words.len);
+    for (0..m.tk) |kt| for (0..m.tn / 8) |nb8| for (0..8) |j| {
+        @memcpy(out[((nb8 * m.tk + kt) * 8 + j) * w32 ..][0..w32], words[((kt * m.tn) + nb8 * 8 + j) * w32 ..][0..w32]);
+    };
+    return out;
+}
+
+/// Exl3Linear.from_tensors (strips) on the device, with its zeroed split counters.
+pub fn linear(a: std.mem.Allocator, ar: *Arena, m: Mat) !exl3.Linear {
+    if (m.k() % 128 != 0 or m.n() % 128 != 0) return error.NotBlocked;
+    const st = try strips(a, m);
+    defer a.free(st);
+    return .{
+        .words = try ar.upload(std.mem.sliceAsBytes(st)),
+        .suh = try ar.upload(std.mem.sliceAsBytes(m.suh)),
+        .svh = try ar.upload(std.mem.sliceAsBytes(m.svh)),
+        .counters = try ar.zeros(8 * (m.n() / 128) * 4),
+        .k = m.k(),
+        .n = m.n(),
+        .k2 = m.k2,
+        .split = exl3.plan(m.k(), m.n()),
+    };
+}
+
+/// torch's float -> bfloat16 (round to nearest even; NaN kept quiet).
+pub fn bf16Round(x: f32) f32 {
+    const u: u32 = @bitCast(x);
+    if (std.math.isNan(x)) return @bitCast((u | 0x0040_0000) & 0xFFFF_0000);
+    const r = u + 0x7FFF + ((u >> 16) & 1);
+    return @bitCast(r & 0xFFFF_0000);
+}
+
+/// A tensor as fp32 (`.float()`): bf16, fp16 or fp32 storage.
+pub fn asF32(a: std.mem.Allocator, t: core.safetensors.Tensor) ![]f32 {
+    const n = t.numel();
+    const out = try a.alloc(f32, n);
+    switch (t.dtype) {
+        .f32 => @memcpy(std.mem.sliceAsBytes(out), t.bytes),
+        .bf16 => for (out, 0..) |*o, i| {
+            o.* = @bitCast(@as(u32, std.mem.readInt(u16, t.bytes[2 * i ..][0..2], .little)) << 16);
+        },
+        .f16 => for (out, 0..) |*o, i| {
+            o.* = @floatCast(@as(f16, @bitCast(std.mem.readInt(u16, t.bytes[2 * i ..][0..2], .little))));
+        },
+        else => return error.BadDType,
+    }
+    return out;
+}
+
+pub const Layer = struct {
+    input_norm: u64, // fp32 [D]
+    post_norm: u64,
+    q: exl3.Linear,
+    k: exl3.Linear,
+    v: exl3.Linear, // 192 a head: V + 64 pad
+    o: exl3.Linear, // a rank's input columns: partial outputs under TP
+    sinks: u64 = 0, // fp32 [H] of this rank's heads, or 0
+    experts: ?exl3.Experts = null,
+    router: u64 = 0, // fp16 [E, D]
+    bias: u64 = 0, // fp32 [E]
+    route_scale: f32 = 1.0,
+    gate: ?exl3.Linear = null, // the dense MLP (layer 0)
+    up: ?exl3.Linear = null,
+    down: ?exl3.Linear = null,
+};
+
+pub const Weights = struct {
+    full: Config,
+    cfg: Config, // this rank's view
+    rank: usize,
+    world: usize,
+    embed: u64, // bf16 [V, D], every rank whole
+    layers: []Layer,
+    norm: u64,
+    head: exl3.Linear, // a rank's V / world rows
+    arena: Arena,
+    gpa: std.mem.Allocator,
+
+    pub fn deinit(w: *Weights) void {
+        for (w.layers) |L| if (L.experts) |e| {
+            w.gpa.free(e.host_ptr);
+            w.gpa.free(e.host_k2);
+        };
+        w.gpa.free(w.layers);
+        w.arena.deinit();
+    }
+};
+
+pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, model_dir: []const u8, rank: usize, world: usize, log: bool) !Weights {
+    const cfg_text = try readFile(gpa, io, model_dir, "config.json");
+    defer gpa.free(cfg_text);
+    const gen_text = readFile(gpa, io, model_dir, "generation_config.json") catch null;
+    defer if (gen_text) |g| gpa.free(g);
+    const full = try Config.parse(gpa, cfg_text, gen_text);
+    const view = try full.rankView(world);
+    var ck = try core.Checkpoint.openModel(gpa, io, model_dir);
+    defer ck.close();
+    var w: Weights = .{ .full = full, .cfg = view, .rank = rank, .world = world, .embed = 0, .layers = try gpa.alloc(Layer, full.layers), .norm = 0, .head = undefined, .arena = .{ .d = d, .gpa = gpa }, .gpa = gpa };
+    errdefer w.deinit();
+    const ar = &w.arena;
+    const emb = try ck.get("model.embed_tokens.weight");
+    if (emb.dtype != .bf16) return error.EmbedNotBf16; // weights.py: .to(bfloat16) of bf16 storage is the identity
+    w.embed = try ar.upload(emb.bytes);
+
+    var names: std.ArrayList(u8) = .empty;
+    defer names.deinit(gpa);
+    try names.ensureTotalCapacity(gpa, 1 << 20);
+    var cuts: std.ArrayList(config.Cut) = .empty;
+    defer cuts.deinit(gpa);
+    var nb: [256]u8 = undefined;
+    const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    for (0..full.layers) |i| {
+        names.clearRetainingCapacity();
+        cuts.clearRetainingCapacity();
+        try config.layerCuts(full, i, rank, world, &names, gpa, &cuts);
+        const L = &w.layers[i];
+        L.* = .{ .input_norm = 0, .post_norm = 0, .q = undefined, .k = undefined, .v = undefined, .o = undefined };
+        L.input_norm = try f32Upload(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, "model.layers.{d}.input_layernorm.weight", .{i})));
+        L.post_norm = try f32Upload(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, "model.layers.{d}.post_attention_layernorm.weight", .{i})));
+        inline for (.{ "q", "k", "v", "o" }, 0..) |f, j| @field(L, f) = try linear(gpa, ar, try cut(gpa, try readMat(gpa, &ck, cuts.items[j].prefix), cuts.items[j]));
+        if (if (full.full[i]) full.sinks_full else full.sinks_swa) {
+            const s = try asF32(gpa, try ck.get(try std.fmt.bufPrint(&nb, "model.layers.{d}.self_attn.attention_sink_bias", .{i})));
+            defer gpa.free(s);
+            L.sinks = try ar.upload(std.mem.sliceAsBytes(s[rank * view.heads .. (rank + 1) * view.heads]));
+        }
+        if (full.moe[i]) {
+            L.experts = try experts(gpa, ar, &ck, full, cuts.items[4..]);
+            const r = try ck.get(try std.fmt.bufPrint(&nb, "model.layers.{d}.mlp.gate.weight", .{i}));
+            const rf = try asF32(gpa, r);
+            defer gpa.free(rf);
+            const r16 = try gpa.alloc(f16, rf.len); // .to(bfloat16) then .to(fp16 ACT); weights.py checks it is exact
+            defer gpa.free(r16);
+            for (rf, r16) |x, *o| {
+                const b = bf16Round(x);
+                o.* = @floatCast(b);
+                if (@as(f32, @floatCast(o.*)) != b) return error.RouterNotExact;
+            }
+            L.router = try ar.upload(std.mem.sliceAsBytes(r16));
+            L.bias = try f32Upload(gpa, ar, try ck.get(try std.fmt.bufPrint(&nb, "model.layers.{d}.mlp.gate.e_score_correction_bias", .{i})));
+            L.route_scale = if (i == config.interm_div_layer) config.interm_div else 1.0;
+        } else {
+            L.gate = try linear(gpa, ar, try cut(gpa, try readMat(gpa, &ck, cuts.items[4].prefix), cuts.items[4]));
+            L.up = try linear(gpa, ar, try cut(gpa, try readMat(gpa, &ck, cuts.items[5].prefix), cuts.items[5]));
+            L.down = try linear(gpa, ar, try cut(gpa, try readMat(gpa, &ck, cuts.items[6].prefix), cuts.items[6]));
+        }
+        if (log and (i % 8 == 7 or i == full.layers - 1)) {
+            const s = @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e9;
+            std.debug.print("[tensorfold] mimo_v2 (zig): {d}/{d} layers in {d:.0}s, {d:.1} GiB\n", .{ i + 1, full.layers, s, @as(f64, @floatFromInt(ar.total)) / (1 << 30) });
+        }
+    }
+    w.norm = try f32Upload(gpa, ar, try ck.get("model.norm.weight"));
+    const hc = config.headCut(full, rank, world);
+    w.head = try linear(gpa, ar, try cut(gpa, try readMat(gpa, &ck, hc.prefix), hc));
+    return w;
+}
+
+fn f32Upload(gpa: std.mem.Allocator, ar: *Arena, t: core.safetensors.Tensor) !u64 {
+    const f = try asF32(gpa, t);
+    defer gpa.free(f);
+    return ar.upload(std.mem.sliceAsBytes(f));
+}
+
+/// experts.prepare: per expert (gate, up, down) cut trellises in the stored layout, referenced by pointer tables.
+fn experts(gpa: std.mem.Allocator, ar: *Arena, ck: *core.Checkpoint, full: Config, cuts: []const config.Cut) !exl3.Experts {
+    const E = full.experts;
+    if (cuts.len != 3 * E) return error.ExpertCuts;
+    const ptrs = try gpa.alloc(u64, 3 * E); // kept: Experts.host_ptr
+    errdefer gpa.free(ptrs);
+    const k2s = try gpa.alloc(i32, 3 * E); // kept: Experts.host_k2
+    errdefer gpa.free(k2s);
+    var st: [6]std.ArrayList(f16) = @splat(.empty); // suh_g, suh_u, svh_g, svh_u, suh_d, svh_d
+    defer for (&st) |*l| l.deinit(gpa);
+    var lo: [2]u32 = .{ 99, 99 };
+    var hi: [2]u32 = .{ 0, 0 };
+    var dims: usize = 0;
+    var width: usize = 0;
+    for (0..E) |e| for (0..3) |j| {
+        const m = try cut(gpa, try readMat(gpa, ck, cuts[3 * e + j].prefix), cuts[3 * e + j]);
+        defer m.deinit(gpa);
+        ptrs[j * E + e] = try ar.upload(std.mem.sliceAsBytes(m.trellis));
+        k2s[j * E + e] = @intCast(m.k2);
+        const g: usize = if (j == 2) 1 else 0;
+        lo[g] = @min(lo[g], m.k2);
+        hi[g] = @max(hi[g], m.k2);
+        switch (j) {
+            0 => {
+                dims = m.k();
+                width = m.n();
+                try st[0].appendSlice(gpa, m.suh);
+                try st[2].appendSlice(gpa, m.svh);
+            },
+            1 => {
+                try st[1].appendSlice(gpa, m.suh);
+                try st[3].appendSlice(gpa, m.svh);
+            },
+            else => {
+                try st[4].appendSlice(gpa, m.suh);
+                try st[5].appendSlice(gpa, m.svh);
+            },
+        }
+    };
+    return .{
+        .gate_ptr = try ar.upload(std.mem.sliceAsBytes(ptrs[0..E])),
+        .up_ptr = try ar.upload(std.mem.sliceAsBytes(ptrs[E .. 2 * E])),
+        .down_ptr = try ar.upload(std.mem.sliceAsBytes(ptrs[2 * E ..])),
+        .gate_k2 = try ar.upload(std.mem.sliceAsBytes(k2s[0..E])),
+        .up_k2 = try ar.upload(std.mem.sliceAsBytes(k2s[E .. 2 * E])),
+        .down_k2 = try ar.upload(std.mem.sliceAsBytes(k2s[2 * E ..])),
+        .suh_g = try ar.upload(std.mem.sliceAsBytes(st[0].items)),
+        .suh_u = try ar.upload(std.mem.sliceAsBytes(st[1].items)),
+        .svh_g = try ar.upload(std.mem.sliceAsBytes(st[2].items)),
+        .svh_u = try ar.upload(std.mem.sliceAsBytes(st[3].items)),
+        .suh_d = try ar.upload(std.mem.sliceAsBytes(st[4].items)),
+        .svh_d = try ar.upload(std.mem.sliceAsBytes(st[5].items)),
+        .count = E,
+        .dims = dims,
+        .width = width,
+        .k2_gu = .{ lo[0], hi[0] },
+        .k2_d = .{ lo[1], hi[1] },
+        .host_ptr = ptrs,
+        .host_k2 = k2s,
+    };
+}
+
+fn readFile(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, name: []const u8) ![]u8 {
+    const path = try std.fs.path.join(gpa, &.{ dir, name });
+    defer gpa.free(path);
+    return std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 22));
+}
+
+test "bf16 rounding is torch's" {
+    try std.testing.expectEqual(@as(u32, 0x3F80_0000), @as(u32, @bitCast(bf16Round(1.0))));
+    try std.testing.expectEqual(@as(u32, 0x3F80_0000), @as(u32, @bitCast(bf16Round(@bitCast(@as(u32, 0x3F80_8000)))))); // tie to even
+    try std.testing.expectEqual(@as(u32, 0x3F82_0000), @as(u32, @bitCast(bf16Round(@bitCast(@as(u32, 0x3F81_8000)))))); // tie to even (up)
+    try std.testing.expectEqual(@as(u32, 0x3F81_0000), @as(u32, @bitCast(bf16Round(@bitCast(@as(u32, 0x3F80_8001))))));
+}
diff --git a/zig/src/families/mimo_v2/m1_main.zig b/zig/src/families/mimo_v2/m1_main.zig
new file mode 100644
index 00000000..d4c17852
--- /dev/null
+++ b/zig/src/families/mimo_v2/m1_main.zig
@@ -0,0 +1,182 @@
+//! tf-mimo: rank 1 behind the server (follow) and the decode forward against the Python engine's bytes (m1).
+
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const tp = @import("tp");
+const mimo = @import("mimo_v2");
+
+const prompts = [_][]const u8{ "en_story", "zh_explain", "code_py", "math", "tool_json", "edit", "list", "short" };
+
+const Cmp = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    s: cuda.Stream,
+    ora: *const core.safetensors.File,
+    name: []const u8,
+    step: usize,
+    rank: usize,
+    first_fail: ?[]const u8 = null,
+    checked: usize = 0,
+    host: []u8,
+};
+
+fn hook(ctx: *anyopaque, what: mimo.forward.Model.Tap, layer: usize, dev: u64, bytes: usize) anyerror!void {
+    const c: *Cmp = @ptrCast(@alignCast(ctx));
+    var nb: [128]u8 = undefined;
+    const key = switch (what) {
+        .attn => try std.fmt.bufPrint(&nb, "{s}.s{d}.attn.{d}", .{ c.name, c.step, layer }),
+        .mlp => try std.fmt.bufPrint(&nb, "{s}.s{d}.res.{d}", .{ c.name, c.step, layer }),
+        .att => try std.fmt.bufPrint(&nb, "{s}.s{d}.att.{d}", .{ c.name, c.step, layer }),
+    };
+    const want = c.ora.get(key) orelse return; // attention outputs exist only at two layers
+    try c.s.synchronize();
+    if (want.bytes.len != bytes) {
+        std.debug.print("FAIL {s}: {d} bytes, oracle {d}\n", .{ key, bytes, want.bytes.len });
+        return error.Shape;
+    }
+    try c.d.check(c.d.api.cuMemcpyDtoH_v2(@ptrCast(c.host.ptr), dev, bytes), "capture");
+    c.checked += 1;
+    if (std.mem.eql(u8, c.host[0..bytes], want.bytes)) return;
+    if (c.first_fail == null) {
+        c.first_fail = try c.gpa.dupe(u8, key);
+        report(key, c.host[0..bytes], want.bytes, what == .att);
+    }
+}
+
+fn report(key: []const u8, got: []const u8, want: []const u8, half: bool) void {
+    var diff: usize = 0;
+    var worst: f64 = 0;
+    var first: ?usize = null;
+    const n = if (half) got.len / 2 else got.len / 4;
+    for (0..n) |i| {
+        const g: f64, const w: f64 = if (half) .{ @floatCast(@as(f16, @bitCast(std.mem.readInt(u16, got[2 * i ..][0..2], .little)))), @floatCast(@as(f16, @bitCast(std.mem.readInt(u16, want[2 * i ..][0..2], .little)))) } else .{ @floatCast(@as(f32, @bitCast(std.mem.readInt(u32, got[4 * i ..][0..4], .little)))), @floatCast(@as(f32, @bitCast(std.mem.readInt(u32, want[4 * i ..][0..4], .little)))) };
+        if (g != w) {
+            diff += 1;
+            if (first == null) first = i;
+            worst = @max(worst, @abs(g - w) / @max(@abs(w), 1e-6));
+        }
+    }
+    std.debug.print("FIRST DIFF {s}: {d} of {d} values differ (first at {?d}), worst relative {e}\n", .{ key, diff, n, first, worst });
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    const cmd: []const u8 = if (args.len >= 2) args[1] else "";
+    const is_m1 = args.len >= 5 and std.mem.eql(u8, cmd, "m1");
+    const is_follow = args.len >= 4 and std.mem.eql(u8, cmd, "follow");
+    if (!is_m1 and !is_follow) {
+        std.debug.print("usage: tf-mimo m1 MODEL ORACLE(rank<R>.safetensors) AOT_DIR [CONTEXT]\n" ++
+            "       tf-mimo follow MODEL AOT_DIR   (TP rank 1 behind tensorfold-native serve on rank 0)\n", .{});
+        return 2;
+    }
+    const gpa = init.gpa;
+    const io = init.io;
+    const context: usize = if (args.len > 5) try std.fmt.parseInt(usize, args[5], 10) else 4096;
+    const cfg = try tp.Config.fromEnv();
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, @intCast(cfg.device));
+    defer ctx.deinit();
+    var session: tp.Session = undefined;
+    const world: usize = cfg.world;
+    if (world > 1) try session.open(&driver, cfg, @import("tp_kernel").mailbox);
+    defer if (world > 1) {
+        session.announceStop(); // a clean stop: the peer exits 0 instead of failing fast (70) when this rank ends first
+        session.close();
+    };
+    const rank: usize = cfg.rank;
+    if (is_follow) return follow(gpa, io, &driver, &session, args[2], args[3]);
+    var s = try cuda.Stream.init(&driver, false);
+    defer s.deinit();
+
+    const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    var w = try mimo.load.load(gpa, io, &driver, args[2], rank, world, rank == 0);
+    defer w.deinit();
+    var k3 = try cuda.exl3.Kernels.load(&driver);
+    defer k3.deinit();
+    var set = try cuda.aot.Set.load(gpa, io, &driver, ctx.device, args[4]);
+    defer set.deinit();
+    const comm = if (world > 1) session.comm() else null;
+    var model = try mimo.forward.Model.init(gpa, &driver, &w, &set, &k3, comm, context, 1, 1, s);
+    defer model.deinit();
+    std.debug.print("[m1] rank {d}: loaded in {d:.0}s ({d:.1} GiB weights)\n", .{ rank, @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e9, @as(f64, @floatFromInt(w.arena.total)) / (1 << 30) });
+
+    var ora = try core.safetensors.File.open(gpa, io, args[3]);
+    defer ora.close(io);
+    const V = w.full.vocab;
+    const logits = try gpa.alloc(f32, V);
+    defer gpa.free(logits);
+    const host = try gpa.alloc(u8, 1 << 20);
+    defer gpa.free(host);
+    var cmp: Cmp = .{ .gpa = gpa, .d = &driver, .s = s, .ora = &ora, .name = "", .step = 0, .rank = rank, .host = host };
+    var total_steps: usize = 0;
+    var argmax_ok: usize = 0;
+    var logits_ok: usize = 0;
+    var logits_n: usize = 0;
+    var all_ok = true;
+    var nb: [128]u8 = undefined;
+    for (prompts) |name| {
+        const ids_t = ora.get(try std.fmt.bufPrint(&nb, "{s}.ids", .{name})) orelse return error.NoIds;
+        const greedy_t = ora.get(try std.fmt.bufPrint(&nb, "{s}.greedy", .{name})) orelse return error.NoGreedy;
+        const am_t = ora.get(try std.fmt.bufPrint(&nb, "{s}.argmax", .{name})) orelse return error.NoArgmax;
+        const lg_t = ora.get(try std.fmt.bufPrint(&nb, "{s}.logits", .{name})) orelse return error.NoLogits;
+        const ids = std.mem.bytesAsSlice(i32, @as([]align(1) const u8, ids_t.bytes));
+        const greedy = std.mem.bytesAsSlice(i32, @as([]align(1) const u8, greedy_t.bytes));
+        const am = std.mem.bytesAsSlice(i32, @as([]align(1) const u8, am_t.bytes));
+        // the sequence the capture fed: the prompt, then each greedy token that was not EOS
+        var seq: std.ArrayList(i64) = .empty;
+        defer seq.deinit(gpa);
+        for (ids) |t| try seq.append(gpa, t);
+        for (greedy) |t| if (!w.full.isEos(@intCast(t))) try seq.append(gpa, t);
+        var ok_here: usize = 0;
+        var first_bad: ?usize = null;
+        cmp.name = name;
+        const nsteps = am.len;
+        for (0..nsteps) |step| {
+            cmp.step = step;
+            const deep = step < 4;
+            try model.forward(s, &.{.{ .slot = 0, .pos = @intCast(step), .token = seq.items[step] }}, logits, if (deep) .{ .hook = &hook, .ctx = &cmp } else null);
+            const got = mimo.forward.argmax(logits);
+            if (got == am[step]) ok_here += 1 else if (first_bad == null) first_bad = step;
+            if (step < lg_t.shape[0]) {
+                logits_n += 1;
+                const want = lg_t.bytes[step * V * 4 ..][0 .. V * 4];
+                if (std.mem.eql(u8, std.mem.sliceAsBytes(logits), want)) logits_ok += 1 else if (cmp.first_fail == null) {
+                    cmp.first_fail = try std.fmt.allocPrint(gpa, "{s}.logits[{d}]", .{ name, step });
+                    report(cmp.first_fail.?, std.mem.sliceAsBytes(logits), want, false);
+                }
+            }
+        }
+        total_steps += nsteps;
+        argmax_ok += ok_here;
+        if (first_bad != null) all_ok = false;
+        std.debug.print("[m1] rank {d} {s}: {d} steps, argmax equal at {d}{s}\n", .{ rank, name, nsteps, ok_here, if (first_bad) |b| try std.fmt.bufPrint(&nb, " (first difference at step {d})", .{b}) else "" });
+    }
+    const exact = all_ok and cmp.first_fail == null and logits_ok == logits_n;
+    std.debug.print("{s} m1 rank {d}: argmax {d}/{d} steps; logits byte-equal {d}/{d}; {d} layer captures checked{s}{s}\n", .{ if (exact) "PASS" else "FAIL", rank, argmax_ok, total_steps, logits_ok, logits_n, cmp.checked, if (cmp.first_fail != null) "; first difference " else "", cmp.first_fail orelse "" });
+    return if (exact) 0 else 1;
+}
+
+/// Rank 1 behind the native server: the model rank 0 announces (hello), then every step rank 0 sends, until it stops.
+fn follow(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, session: *tp.Session, model_dir: []const u8, aot_dir: []const u8) !u8 {
+    if (session.cfg.world < 2 or session.cfg.rank == 0) return error.FollowNeedsRankOne;
+    var buf: std.ArrayList(i64) = .empty;
+    defer buf.deinit(gpa);
+    const su = try mimo.engine.setupOf(try session.plan.recvGrow(gpa, &buf));
+    std.debug.print("[follow] rank {d}: context {d}, {d} slots, drafter {s}\n", .{ session.cfg.rank, su.context, su.slots, if (su.drafts) "on" else "off" });
+    const e = try mimo.engine.Engine.init(gpa, io, d, model_dir, aot_dir, su, session);
+    defer e.deinit();
+    std.debug.print("[follow] loaded; following\n", .{});
+    var steps: usize = 0;
+    while (true) {
+        const words = session.plan.recvGrow(gpa, &buf) catch |err| switch (err) {
+            error.PeerClosed => break,
+            else => return err,
+        };
+        if (!try e.follow(words)) break;
+        steps += 1;
+    }
+    std.debug.print("[follow] stopped after {d} steps\n", .{steps});
+    return 0;
+}
diff --git a/zig/src/families/mimo_v2/native.zig b/zig/src/families/mimo_v2/native.zig
new file mode 100644
index 00000000..2c7f3e21
--- /dev/null
+++ b/zig/src/families/mimo_v2/native.zig
@@ -0,0 +1,415 @@
+//! MiMo-V2.6-Flash behind the native server: the lane backend over engine.zig, on one GPU or two TP ranks.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const tp = @import("tp");
+const fwd = @import("forward.zig");
+const engine = @import("engine.zig");
+const prompt_mod = @import("prompt.zig");
+const be = lanes.backend;
+const Engine = engine.Engine;
+
+pub const model_type = "mimo_v2";
+pub const formats: []const []const u8 = &.{"exl3"};
+pub const default_context: i64 = 131072;
+pub const max_segments: u32 = 1;
+pub const prompt_rows: u32 = fwd.DECODE_ROWS;
+
+/// The server's settings: `lanes` (--parallel) is the streams' cache slots.
+pub const Options = struct { context: usize, drafts: bool, segments: usize = 1, slide: bool = false, lanes: u32 = 4 };
+pub const LoneRun = *const fn (ctx: *anyopaque, s: *lanes.Stream, hooks: *anyopaque, committed: *const fn (*anyopaque) void, yield: *const fn (*anyopaque) bool, resumed: bool) anyerror!bool;
+
+pub const Loaded = struct {
+    backend: be.Backend,
+    facts: lanes.Model,
+    rows: u32,
+    stream_bytes: usize,
+    free_streams: u32 = 1,
+    ctx: *anyopaque,
+    deinit: *const fn (*anyopaque) void,
+    lone: ?LoneRun = null,
+    target: *anyopaque, // no prompt cache (no snap_* decls): never read
+    learns: ?*anyopaque = null, // no --slide
+    learn_bytes: usize = 0,
+};
+
+/// The acceptance of DFlash drafts at depth 1, 2, ... given the ones before, until a stream has its own.
+const draft_prior = [_]f64{ 0.789, 0.78, 0.801, 0.833, 0.833, 0.846, 0.825 };
+
+/// A lone stream's forward of r rows against one row (r = 1 .. 8) and a draft pass, as the Python decoder prices them.
+const depth_costs = [_]f64{ 1.00, 1.26, 1.50, 1.75, 2.01, 2.25, 2.46, 2.67 };
+const draft_cost = 0.25;
+/// A round's extra cost per 1,000 positions past 9,000: a step and a row, in units of a 22.7 ms one-row forward.
+const depth_ctx = [2]f64{ 0.0723 / 22.7, 0.0060 / 22.7 };
+const first_copy_rows = 6; // a lone stream's first copy window
+const prompt_min = 256; // prompts under this many tokens run as decode rows, longer ones on the prompt path
+
+const Lane = struct { slot: u32, held: [16]u32 = undefined, nheld: u32 = 0 };
+const ring = 1024;
+
+pub const Lanes = struct {
+    gpa: std.mem.Allocator,
+    e: *Engine,
+    lanes: std.AutoHashMapUnmanaged(*const lanes.Stream, Lane) = .empty,
+    free: u32, // slot bits
+    drawn: [ring]u32 = undefined,
+    next: u64 = 0,
+    costs: [8]lanes.config.Cost = undefined,
+    shared: [32]lanes.config.Cost = undefined,
+    nshared: usize = 0,
+    draft_ms: f64 = 0,
+
+    fn of(p: *anyopaque) *Lanes {
+        return @ptrCast(@alignCast(p));
+    }
+
+    pub fn backend(l: *Lanes) be.Backend {
+        return .{ .ptr = l, .vtable = &.{ .prefill = prefillFn, .first = firstFn, .queue = queueFn, .read = readFn, .verify = verifyFn, .keep = keepFn, .draft = draftFn, .release = releaseFn } };
+    }
+
+    pub fn facts(l: *const Lanes) lanes.Model {
+        const drafting = l.e.dr != null;
+        const B: u32 = if (l.e.dr) |dr| @intCast(dr.block) else 1;
+        return .{
+            .exact_width = B,
+            .gpu_tokens = false,
+            .mtp = drafting,
+            .speculate = drafting,
+            .speculate_early = false,
+            .draft_prior = &draft_prior,
+            .drafts = B - 1,
+            .window_costs = l.costs[0..B],
+            .mtp_step_ms = l.draft_ms,
+            .hidden_rows = true,
+            .batch_rows = fwd.DECODE_ROWS,
+            .max_streams = @intCast(l.e.model.slots),
+            .shared_costs = l.shared[0..l.nshared],
+            .draft_streams = true,
+            .geometric_depth = true,
+            .geometric_costs = &depth_costs,
+            .geometric_draft_cost = draft_cost,
+            .geometric_ctx = depth_ctx,
+            .first_copy_rows = first_copy_rows,
+        };
+    }
+
+    /// Graphed forward costs at load on distinct tokens (identical rows share experts and price wide windows too low).
+    pub fn measure(l: *Lanes, io: std.Io) !void {
+        const e = l.e;
+        const B: usize = if (e.dr) |dr| dr.block else 1;
+        var rows: [32]fwd.Row = undefined;
+        const reps = 16; // windows; shared rows below take 8
+        var rng = std.Random.DefaultPrng.init(0x31A0);
+        const V = e.w.full.vocab;
+        for (1..B + 1) |w| {
+            for (0..w) |j| rows[j] = .{ .slot = 0, .pos = @intCast(64 + j), .token = 0 };
+            l.costs[w - 1] = .{ .width = @intCast(w), .ms = try l.time(io, rows[0..w], reps, &rng, V) };
+        }
+        l.nshared = 0;
+        const S = e.model.slots;
+        for (2..33) |n| {
+            for (0..n) |j| rows[j] = .{ .slot = @intCast(j % S), .pos = @intCast(64 + j / S), .token = 0 };
+            l.shared[l.nshared] = .{ .width = @intCast(n), .ms = try l.time(io, rows[0..n], 8, &rng, V) };
+            l.nshared += 1;
+        }
+        if (e.dr != null) {
+            var out: [16]i32 = undefined;
+            for (0..3) |_| try e.draft(&.{1000}, &.{64}, &.{0}, &out);
+            var dms: [16]f64 = undefined;
+            for (&dms, 0..) |*m, i| {
+                const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+                try e.draft(&.{@intCast(1000 + 7919 * i)}, &.{64}, &.{0}, &out);
+                m.* = @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e6;
+            }
+            std.mem.sort(f64, &dms, {}, std.sort.asc(f64));
+            l.draft_ms = dms[8];
+        }
+        std.log.info("mimo costs (distinct tokens): window ms {d:.2} .. {d:.2} (1 .. {d} rows), shared 8 / 16 / 32 rows {d:.2} / {d:.2} / {d:.2}, draft {d:.2}", .{ l.costs[0].ms, l.costs[B - 1].ms, B, l.shared[6].ms, l.shared[14].ms, l.shared[l.nshared - 1].ms, l.draft_ms });
+    }
+
+    /// Median ms of `reps` graphed forwards of `rows`, each on fresh pseudo-random tokens, after warm replays.
+    fn time(l: *Lanes, io: std.Io, rows: []fwd.Row, reps: usize, rng: *std.Random.DefaultPrng, V: usize) !f64 {
+        const fill = struct {
+            fn f(rs: []fwd.Row, r: *std.Random.DefaultPrng, v: usize) void {
+                for (rs) |*x| x.token = @intCast(1000 + r.random().uintLessThan(usize, v - 2000));
+            }
+        }.f;
+        for (0..3) |_| { // capture, then warm
+            fill(rows, rng, V);
+            try l.e.forward(rows, .ids);
+        }
+        try l.e.s.synchronize();
+        var ms: [32]f64 = undefined;
+        const n = @min(reps, ms.len);
+        for (0..n) |i| {
+            fill(rows, rng, V);
+            const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+            try l.e.forward(rows, .ids);
+            try l.e.s.synchronize();
+            ms[i] = @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e6;
+        }
+        std.mem.sort(f64, ms[0..n], {}, std.sort.asc(f64));
+        return ms[n / 2];
+    }
+
+    fn take(l: *Lanes, token: u32) u64 {
+        const h = l.next;
+        l.drawn[h % ring] = token;
+        l.next += 1;
+        return h;
+    }
+
+    fn value(l: *const Lanes, feed: be.Feed) u32 {
+        return switch (feed) {
+            .handle => |h| l.drawn[h % ring],
+            .value => |v| v,
+        };
+    }
+
+    fn rowOf(l: *Lanes, r: usize) []const f32 {
+        const V = l.e.w.full.vocab;
+        return l.e.logits[r * V ..][0..V];
+    }
+
+    fn prefillFn(p: *anyopaque, s: *lanes.Stream) anyerror!void {
+        const l = of(p);
+        const e = l.e;
+        const ids = s.prompt();
+        const B: usize = if (e.dr) |dr| dr.block else 1;
+        if (ids.len == 0 or ids.len + s.max_new + B > e.model.context) return error.PromptTooLong;
+        const gop = try l.lanes.getOrPut(l.gpa, s);
+        if (!gop.found_existing) {
+            if (l.free == 0) {
+                l.lanes.removeByPtr(gop.key_ptr);
+                return error.NoFreeSlot;
+            }
+            const slot: u32 = @ctz(l.free);
+            l.free &= ~(@as(u32, 1) << @intCast(slot));
+            gop.value_ptr.* = .{ .slot = slot };
+        }
+        gop.value_ptr.nheld = 0;
+        const slot = gop.value_ptr.slot;
+        s.cached = 0;
+        const greedy = s.sampling == null or s.sampling.?.temperature <= 0;
+        if (ids.len >= prompt_min) {
+            const pr = e.pr;
+            // the prompt path: Python's lone-stream chunks, split to this engine's chunk rows (prompt.plan)
+            const cuts = try prompt_mod.plan(l.gpa, 0, ids.len, pr.cap);
+            defer l.gpa.free(cuts);
+            var at: usize = 0;
+            for (cuts) |n| {
+                if (s.isCancelled()) return error.Cancelled;
+                const last = at + n == ids.len;
+                try e.promptChunk(slot, at, ids[at .. at + n], if (!last) .none else if (greedy) .ids else .logits);
+                if (last) _ = l.take(if (greedy) @intCast(e.ids[0]) else try draw(l.gpa, l.rowOf(0), s.sampling, ids.len));
+                at += n;
+            }
+            return;
+        }
+        var rows: [fwd.DECODE_ROWS]fwd.Row = undefined;
+        var at: usize = 0;
+        while (at < ids.len) {
+            if (s.isCancelled()) return error.Cancelled;
+            const n = @min(fwd.DECODE_ROWS, ids.len - at);
+            for (0..n) |j| rows[j] = .{ .slot = slot, .pos = @intCast(at + j), .token = ids[at + j] };
+            const last = at + n == ids.len;
+            try e.forward(rows[0..n], if (!last) .none else if (greedy) .ids else .logits);
+            if (last) _ = l.take(if (greedy) @intCast(e.ids[n - 1]) else try draw(l.gpa, l.rowOf(n - 1), s.sampling, ids.len));
+            at += n;
+        }
+    }
+
+    fn firstFn(p: *anyopaque, s: *lanes.Stream, position: u64) anyerror!u64 {
+        const l = of(p);
+        if (position != s.prompt_len) return error.PositionMismatch;
+        return l.next - 1;
+    }
+
+    fn queueFn(_: *anyopaque, _: *lanes.Stream, _: be.Feed, _: u64) anyerror!u64 {
+        return error.NotPipelined;
+    }
+
+    fn readFn(p: *anyopaque, handle: u64) anyerror!u32 {
+        const l = of(p);
+        if (handle >= l.next or l.next - handle > ring) return error.NoSuchToken;
+        return l.drawn[handle % ring];
+    }
+
+    /// Every window's rows in one forward; each row drawn with its stream's sampling at its keyed position.
+    fn verifyFn(p: *anyopaque, windows: []const be.Window, out: []be.Verified) anyerror!void {
+        const l = of(p);
+        var rows: [fwd.DECODE_ROWS]fwd.Row = undefined;
+        var n: usize = 0;
+        for (windows) |w| {
+            if (w.parents != null) return error.TreesNotBuilt;
+            const lane = l.lanes.getPtr(w.stream) orelse return error.UnknownStream;
+            if (n + w.rows() > rows.len) return error.WindowTooWide;
+            if (w.held > lane.nheld) return error.NoHeldDrafts;
+            for (0..w.rows()) |r| {
+                const tok: u32 = if (r == 0) w.pending else if (w.held > 0) lane.held[r - 1] else w.tokens[r - 1];
+                rows[n] = .{ .slot = lane.slot, .pos = @intCast(w.positions[r] - 1), .token = tok };
+                n += 1;
+            }
+        }
+        var all_greedy = true;
+        for (windows) |w| if (w.stream.sampling) |sm| if (sm.temperature > 0) {
+            all_greedy = false;
+        };
+        try l.e.forward(rows[0..n], if (all_greedy) .ids else .logits);
+        var r0: usize = 0;
+        for (windows, out) |w, *o| {
+            const lane = l.lanes.getPtr(w.stream).?;
+            for (0..w.rows()) |r| o.sampled[r] = if (all_greedy) @intCast(l.e.ids[r0 + r]) else try draw(l.gpa, l.rowOf(r0 + r), w.stream.sampling, w.positions[r]);
+            if (w.held > 0) @memcpy(o.drafts, lane.held[0..w.held]) else @memcpy(o.drafts, w.tokens);
+            r0 += w.rows();
+        }
+    }
+
+    fn keepFn(_: *anyopaque, _: []const be.Window, paths: []const []const u32) anyerror!void {
+        for (paths) |path| {
+            if (path.len == 0) return error.EmptyPath;
+            for (path, 0..) |r, i| if (r != i) return error.TreesNotBuilt;
+        }
+    }
+
+    /// One draft pass for every request that asks for drafts (their contexts are fed already).
+    fn draftFn(p: *anyopaque, requests: []const be.DraftRequest) anyerror!void {
+        const l = of(p);
+        const dr = l.e.dr orelse return error.NoDraftHead;
+        var toks: [16]i64 = undefined;
+        var pos0: [16]u32 = undefined;
+        var sl: [16]u32 = undefined;
+        var who: [16]*Lane = undefined;
+        var depth: [16]u32 = undefined;
+        var n: usize = 0;
+        for (requests) |r| {
+            const lane = l.lanes.getPtr(r.stream) orelse return error.UnknownStream;
+            lane.nheld = 0;
+            if (r.depth == 0) continue;
+            if (n == toks.len) return error.TooManyStreams;
+            const pending: u32 = if (r.follow.len > 0) r.follow[r.follow.len - 1] else l.value(r.first orelse return error.NoFirstToken);
+            toks[n] = pending;
+            pos0[n] = @intCast(r.position - 1);
+            sl[n] = lane.slot;
+            who[n] = lane;
+            depth[n] = @min(r.depth, @as(u32, @intCast(dr.block - 1)));
+            n += 1;
+        }
+        if (n == 0) return;
+        var out: [16 * 16]i32 = undefined;
+        try l.e.draft(toks[0..n], pos0[0..n], sl[0..n], &out);
+        for (0..n) |i| {
+            for (0..depth[i]) |j| who[i].held[j] = @intCast(out[i * (dr.block - 1) + j]);
+            who[i].nheld = depth[i];
+        }
+    }
+
+    fn releaseFn(p: *anyopaque, s: *lanes.Stream) void {
+        const l = of(p);
+        const kv = l.lanes.fetchRemove(s) orelse return;
+        l.free |= @as(u32, 1) << @intCast(kv.value.slot);
+    }
+};
+
+/// The token for a row: the first maximum when greedy (or temperature 0), else the keyed sampler over the top-k.
+pub fn draw(gpa: std.mem.Allocator, row: []const f32, settings: ?lanes.Sampling, position: u64) !u32 {
+    const best = fwd.argmax(row);
+    if (!std.math.isFinite(row[best])) return error.NonfiniteLogits;
+    const sampling = settings orelse return @intCast(best);
+    if (sampling.temperature <= 0) return @intCast(best);
+    const k = if (sampling.top_k == 0) row.len else @min(row.len, sampling.top_k);
+    const values = try gpa.alloc(f64, k);
+    defer gpa.free(values);
+    const ids = try gpa.alloc(u64, k);
+    defer gpa.free(ids);
+    var filled: usize = 0;
+    for (row, 0..) |x32, id| {
+        const x: f64 = x32;
+        if (k == row.len) {
+            values[id] = x;
+            ids[id] = id;
+            continue;
+        }
+        if (filled == k and x <= values[k - 1]) continue;
+        var at = @min(filled, k - 1);
+        while (at > 0 and x > values[at - 1]) : (at -= 1) {
+            values[at] = values[at - 1];
+            ids[at] = ids[at - 1];
+        }
+        values[at] = x;
+        ids[at] = id;
+        filled = @min(filled + 1, k);
+    }
+    return @intCast(try lanes.sampling.choose(gpa, values, ids, position, sampling));
+}
+
+const Owned = struct { gpa: std.mem.Allocator, e: *Engine, l: Lanes, session: ?*tp.Session };
+
+/// The native family entry: TF_TP_* for two ranks (rank 0 serves; `tf-mimo follow` on rank 1) and a captured set.
+pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, kernels: ?[]const u8, o: Options) !Loaded {
+    const aot_dir = kernels orelse return error.NoCapturedTritonSet; // TENSORFOLD_CUDA_KERNELS
+    if (o.lanes == 0 or o.lanes > 16) return error.Slots;
+    const su: engine.Setup = .{ .context = o.context, .slots = o.lanes, .drafts = o.drafts };
+    var session: ?*tp.Session = null;
+    const cfg = tp.Config.fromEnv() catch null;
+    if (cfg) |c| if (c.world > 1) {
+        if (c.rank != 0) return error.FollowerServes; // rank 1 runs `tf-mimo follow`
+        const ss = try gpa.create(tp.Session);
+        errdefer gpa.destroy(ss);
+        try ss.open(ctx.d, c, @import("tp_kernel").mailbox); // RoCE needs the mailbox kernel (TF_COMM_BACKEND=roce)
+        session = ss;
+        try ss.plan.send(&engine.hello(su));
+    };
+    errdefer if (session) |ss| {
+        ss.announceStop();
+        ss.close();
+        gpa.destroy(ss);
+    };
+    const e = try Engine.init(gpa, io, ctx.d, dir, aot_dir, su, session);
+    errdefer e.deinit();
+    const own = try gpa.create(Owned);
+    errdefer gpa.destroy(own);
+    own.* = .{ .gpa = gpa, .e = e, .l = .{ .gpa = gpa, .e = e, .free = if (su.slots == 32) ~@as(u32, 0) else (@as(u32, 1) << @intCast(su.slots)) - 1 }, .session = session };
+    try own.l.measure(io);
+    return .{
+        .backend = own.l.backend(),
+        .facts = own.l.facts(),
+        .rows = if (e.dr) |dr| @intCast(dr.block) else 1,
+        .stream_bytes = 0,
+        .free_streams = @intCast(su.slots),
+        .ctx = own,
+        .deinit = release,
+        .target = own,
+    };
+}
+
+/// The weights this rank loads: the checkpoint over TF_TP_WORLD ranks (the drafter and embeddings, whole on each).
+pub fn rankWeights(total: u64) u64 {
+    const text = std.mem.span(std.c.getenv("TF_TP_WORLD") orelse return total);
+    const world = std.fmt.parseInt(u64, text, 10) catch 1;
+    return total / @max(world, 1);
+}
+
+pub fn explain(_: ?*anyopaque, err: anyerror) ?[]const u8 {
+    return switch (err) {
+        error.PromptTooLong => "the prompt and its reply exceed this server's context window: shorten it or lower max_tokens",
+        error.NoFreeSlot => "every stream slot is busy: retry once another request ends",
+        else => null,
+    };
+}
+
+fn release(p: *anyopaque) void {
+    const own: *Owned = @ptrCast(@alignCast(p));
+    if (own.session) |ss| {
+        ss.plan.send(&.{ @backingInt(engine.Op.stop), 0 }) catch {};
+    }
+    own.l.lanes.deinit(own.gpa);
+    own.e.deinit();
+    if (own.session) |ss| {
+        ss.announceStop();
+        ss.close();
+        own.gpa.destroy(ss);
+    }
+    own.gpa.destroy(own);
+}
diff --git a/zig/src/families/mimo_v2/prompt.zig b/zig/src/families/mimo_v2/prompt.zig
new file mode 100644
index 00000000..6361b0fc
--- /dev/null
+++ b/zig/src/families/mimo_v2/prompt.zig
@@ -0,0 +1,457 @@
+//! MiMo-V2's prompt path, launch for launch as the Python engine's prompt chunks (forward(prompt=True)).
+
+const std = @import("std");
+const cuda = @import("cuda");
+const load_ = @import("load.zig");
+const fwd = @import("forward.zig");
+const exl3 = cuda.exl3;
+const aot = cuda.aot;
+const Stream = cuda.Stream;
+const Model = fwd.Model;
+
+pub const EXPERTS_MIN = 256; // moe.PROMPT_EXPERTS_MIN
+pub const EXPERTS_FROM = 3072; // chunk rows from which experts run per expert on the prompt GEMM, else grouped
+pub const GROUPED_ROWS = 1024; // the grouped experts kernel's window under EXPERTS_FROM
+pub const TOKENS_PER_UPDATE = 1024; // dflash.TOKENS_PER_UPDATE
+pub const HAD_SCALE: f32 = 0.08838834764831845; // prefill.HAD_SCALE, as the fp32 constexpr
+const BM_GEMM = 128; // prefill.tiles
+const PROMPT_BM = 8; // attention.BM
+
+const p = aot.ptr;
+fn ci(name: []const u8, v: usize) aot.Const {
+    return aot.ci(name, @intCast(v));
+}
+fn ii(name: []const u8, v: usize) aot.Arg {
+    return aot.int(name, @intCast(v));
+}
+fn u(x: usize) u32 {
+    return @intCast(x);
+}
+fn pow2(x: usize) usize {
+    return std.math.ceilPowerOfTwo(usize, x) catch unreachable;
+}
+
+pub const Prompt = struct {
+    m: *Model,
+    gpa: std.mem.Allocator,
+    cap: usize, // rows a chunk
+    ar: load_.Arena,
+    f_count: cuda.Function,
+    f_order: cuda.Function,
+    f_gather: cuda.Function,
+    f_combine: cuda.Function,
+    // rows [cap]
+    ids: u64,
+    pos: u64,
+    slot: u64,
+    res: u64,
+    x: u64,
+    q: u64,
+    k: u64,
+    v: u64,
+    qo: u64,
+    att: u64,
+    po: u64,
+    pm: u64,
+    pl: u64,
+    xh: u64,
+    part: u64,
+    recv: u64,
+    summed: u64,
+    logits: u64,
+    pick: u64,
+    wts: u64,
+    g: u64,
+    up: u64,
+    h: u64,
+    wq: u64, // fp16 [max K * N]: W_q decoded a call
+    had: u64, // bf16 [128, 128]
+    // per-expert prompt MoE: copies [cap * k]
+    counts: u64,
+    starts: u64,
+    order: u64,
+    inv: u64,
+    xs: u64,
+    ws: u64,
+    eg: u64,
+    eu: u64,
+    eh: u64,
+    ed: u64,
+    sc: exl3.Scratch, // the grouped kernel's, for chunks under EXPERTS_FROM rows (in windows of sc.rows)
+    taps: u64, // drafter: the chunk's last TOKENS_PER_UPDATE rows' taps
+    h_ids: []i64,
+    h_pos: []i32,
+    h_slot: []i32,
+    h_counts: []i32,
+    h_starts: []i32,
+
+    pub fn init(m: *Model, gpa: std.mem.Allocator, cap: usize, s: Stream) !*Prompt {
+        const w = m.w;
+        const cfg = w.cfg;
+        const pr = try gpa.create(Prompt);
+        errdefer gpa.destroy(pr);
+        pr.* = undefined;
+        pr.m = m;
+        pr.gpa = gpa;
+        pr.cap = cap;
+        pr.ar = .{ .d = m.d, .gpa = gpa };
+        errdefer pr.ar.deinit();
+        pr.f_count = try m.glue.function("mimo_moe_count");
+        pr.f_order = try m.glue.function("mimo_moe_order");
+        pr.f_gather = try m.glue.function("mimo_moe_gather");
+        pr.f_combine = try m.glue.function("mimo_moe_combine");
+        const ar = &pr.ar;
+        const R = cap;
+        const D = cfg.hidden;
+        const H = cfg.heads;
+        const hk = @max(cfg.kv_full, cfg.kv_swa);
+        const nd = cfg.dense_width / w.world;
+        const nch = (cfg.window + fwd.CK - 1) / fwd.CK + 1;
+        var max_k: usize = @max(D, H * 128);
+        max_k = @max(max_k, nd);
+        var max_kn: usize = 0;
+        var ex: ?exl3.Experts = null;
+        for (w.layers) |L| {
+            inline for (.{ "q", "k", "v", "o" }) |f| max_kn = @max(max_kn, @field(L, f).k * @field(L, f).n);
+            inline for (.{ "gate", "up", "down" }) |f| if (@field(L, f)) |l| {
+                max_kn = @max(max_kn, l.k * l.n);
+            };
+            if (L.experts) |e| {
+                max_kn = @max(max_kn, e.dims * e.width);
+                if (ex == null) ex = e;
+            }
+        }
+        const e0 = ex orelse return error.NoMoE;
+        const I = e0.width;
+        const K8 = cfg.top_k;
+        pr.ids = try ar.zeros(R * 8);
+        pr.pos = try ar.zeros(R * 4);
+        pr.slot = try ar.zeros(R * 4);
+        pr.res = try ar.zeros(R * D * 4);
+        pr.x = try ar.zeros(R * D * 2);
+        pr.q = try ar.zeros(R * H * 192 * 2);
+        pr.k = try ar.zeros(R * hk * 192 * 2);
+        pr.v = try ar.zeros(R * hk * 192 * 2);
+        pr.qo = try ar.zeros(R * H * 192 * 2);
+        pr.att = try ar.zeros(R * H * 128 * 2);
+        pr.po = try ar.zeros(R * nch * H * 128 * 4);
+        pr.pm = try ar.zeros(R * nch * H * 4);
+        pr.pl = try ar.zeros(R * nch * H * 4);
+        pr.xh = try ar.zeros(R * max_k * 2);
+        pr.part = try ar.zeros(R * D * 4);
+        pr.recv = try ar.zeros(2 * R * D * 4);
+        pr.summed = try ar.zeros(R * D * 4);
+        pr.logits = try ar.zeros(R * cfg.experts * 4);
+        pr.pick = try ar.zeros(R * K8 * 4);
+        pr.wts = try ar.zeros(R * K8 * 4);
+        pr.g = try ar.zeros(R * nd * 2);
+        pr.up = try ar.zeros(R * nd * 2);
+        pr.h = try ar.zeros(R * nd * 2);
+        pr.wq = try ar.zeros(max_kn * 2);
+        pr.counts = try ar.zeros(cfg.experts * 4);
+        pr.starts = try ar.zeros(cfg.experts * 4);
+        pr.order = try ar.zeros(R * K8 * 4);
+        pr.inv = try ar.zeros(R * K8 * 4);
+        pr.xs = try ar.zeros(R * K8 * D * 2);
+        pr.ws = try ar.zeros(R * K8 * 4);
+        pr.eg = try ar.zeros(R * K8 * I * 2);
+        pr.eu = try ar.zeros(R * K8 * I * 2);
+        pr.eh = try ar.zeros(R * K8 * I * 2);
+        pr.ed = try ar.zeros(R * K8 * D * 4);
+        // prefill.Workspace.hadamard: +-1 by the parity of popcount(i & j), bf16
+        var hb: [128 * 128]u16 = undefined;
+        for (0..128) |i| for (0..128) |j| {
+            hb[i * 128 + j] = if (@popCount(i & j) & 1 == 1) 0xBF80 else 0x3F80;
+        };
+        pr.had = try ar.upload(std.mem.sliceAsBytes(&hb));
+        const rows_g = @min(GROUPED_ROWS, R);
+        const cfg_gu = try exl3.defaultConfig(e0.dims, e0.width, true);
+        const cfg_d = try exl3.defaultConfig(e0.width, e0.dims, false);
+        const sz = exl3.Scratch.bytes(e0, rows_g, K8, cfg_gu, cfg_d);
+        pr.sc = .{ .xg = try ar.zeros(sz.xg), .xu = try ar.zeros(sz.xg), .xd = try ar.zeros(sz.xd), .z = try ar.zeros(sz.z), .y = try ar.zeros(sz.y), .ids = try ar.zeros(sz.ids), .count = try ar.zeros(4), .members = try ar.alloc(sz.members), .rows = rows_g, .slots = K8, .cfg_gu = cfg_gu, .cfg_d = cfg_d };
+        try m.d.check(m.d.api.cuMemsetD32_v2(pr.sc.members, 0xFFFF_FFFF, sz.members / 4), "members -1");
+        pr.taps = if (m.dr) |dr| try ar.zeros(@min(R, TOKENS_PER_UPDATE) * dr.taps.len * D * 2) else 0; // fp16, as the tap buffer
+        pr.h_ids = try gpa.alloc(i64, R);
+        pr.h_pos = try gpa.alloc(i32, R);
+        pr.h_slot = try gpa.alloc(i32, R);
+        pr.h_counts = try gpa.alloc(i32, cfg.experts);
+        pr.h_starts = try gpa.alloc(i32, cfg.experts);
+        try s.synchronize();
+        return pr;
+    }
+
+    pub fn deinit(pr: *Prompt) void {
+        pr.gpa.free(pr.h_ids);
+        pr.gpa.free(pr.h_pos);
+        pr.gpa.free(pr.h_slot);
+        pr.gpa.free(pr.h_counts);
+        pr.gpa.free(pr.h_starts);
+        pr.ar.deinit();
+        pr.gpa.destroy(pr);
+    }
+
+    pub fn bytes(pr: *const Prompt) usize {
+        return pr.ar.total;
+    }
+
+    /// prefill.matmul: out [n, N] (row stride N) = x [n, K] fp16 @ W + bias, the prompt path's arithmetic.
+    fn gemm(pr: *Prompt, s: Stream, l: exl3.Linear, stored: bool, x: u64, out: u64, out_f32: bool, n: usize) !void {
+        const m = pr.m;
+        try m.k3.linearRotIn(s, x, .f16, l.suh, pr.xh, n, l.k);
+        const st = if (stored) exl3.Kernels.storedStrides(l) else l.strides();
+        try m.k3.unpackStrided(s, l, pr.wq, st);
+        try m.set.run(s, "_gemm", .{ u(((n + BM_GEMM - 1) / BM_GEMM) * (l.n / 128)), 1, 1 }, &.{
+            p("X", "*fp16", pr.xh),   p("W", "*fp16", pr.wq),                                 p("H", "*bf16", pr.had),
+            p("SVH", "*fp16", l.svh), p("BIAS", "*fp16", if (l.bias != 0) l.bias else l.svh), p("OUT", if (out_f32) "*fp32" else "*fp16", out),
+            ii("M", n),               ii("o_stride", l.n),
+        }, &.{ ci("K", l.k), ci("N", l.n), ci("BM", BM_GEMM), ci("BK", 32), ci("GROUP", 8), ci("HAS_BIAS", @intFromBool(l.bias != 0)), aot.cf("SCALE", HAD_SCALE) });
+    }
+
+    fn rms(pr: *Prompt, s: Stream, x: u64, w: u64, out: u64, n: usize) !void {
+        const D = pr.m.w.cfg.hidden;
+        try pr.m.set.run(s, "_rms", .{ u(n), 1, 1 }, &.{ p("X", "*fp32", x), p("W", "*fp32", w), p("OUT", "*fp16", out) }, &.{ ci("N", D), aot.cf("EPS", @floatCast(pr.m.w.cfg.eps)), ci("BLOCK", pow2(D)) });
+    }
+
+    fn addRms(pr: *Prompt, s: Stream, x: u64, w: u64, n: usize) !void {
+        const D = pr.m.w.cfg.hidden;
+        try pr.m.set.run(s, "_add_rms", .{ u(n), 1, 1 }, &.{ p("X", "*fp32", x), p("RES", "*fp32", pr.res), p("W", "*fp32", w), p("OUT", "*fp16", pr.x) }, &.{ ci("N", D), aot.cf("EPS", @floatCast(pr.m.w.cfg.eps)), ci("BLOCK", pow2(D)) });
+    }
+
+    /// forward._sum over the chunk's rows.
+    fn sum(pr: *Prompt, s: Stream, part: u64, n: usize) !u64 {
+        const m = pr.m;
+        const c = m.comm orelse return part;
+        const D = m.w.cfg.hidden;
+        try c.allGather(part, pr.recv, n * D, .f32, s.handle);
+        try m.add2(s, pr.recv, pr.recv + n * D * 4, pr.summed, n * D);
+        return pr.summed;
+    }
+
+    fn launch(f: cuda.Function, s: Stream, gx: usize, threads: usize, a: *cuda.Args) !void {
+        try cuda.launch.launch(f, .{ .grid = .{ .x = u(gx), .y = 1, .z = 1 }, .block = .{ .x = u(threads), .y = 1, .z = 1 } }, s, a);
+    }
+
+    /// moe.MoE._prompt: per expert on the prompt GEMM; the weighted sum of a row's 8 into pr.part (fp32).
+    fn experts(pr: *Prompt, s: Stream, e: exl3.Experts, scale: f32, n: usize) !void {
+        const m = pr.m;
+        const d = m.d;
+        const E = e.count;
+        const D = e.dims;
+        const I = e.width;
+        const K8 = m.w.cfg.top_k;
+        const nk = n * K8;
+        try d.check(d.api.cuMemsetD32Async(pr.counts, 0, E, s.handle), "counts 0");
+        {
+            var a: cuda.Args = .{};
+            a.add(pr.pick);
+            a.add(@as(c_int, @intCast(nk)));
+            a.add(pr.counts);
+            try launch(pr.f_count, s, @min((nk + 255) / 256, 1024), 256, &a);
+        }
+        try s.synchronize(); // torch.bincount(...).tolist(): one host sync a layer
+        try d.check(d.api.cuMemcpyDtoH_v2(@ptrCast(pr.h_counts.ptr), pr.counts, E * 4), "counts");
+        var at: i32 = 0;
+        for (pr.h_counts, pr.h_starts) |c, *st| {
+            st.* = at;
+            at += c;
+        }
+        try d.check(d.api.cuMemcpyHtoD_v2(pr.starts, @ptrCast(pr.h_starts.ptr), E * 4), "starts");
+        {
+            var a: cuda.Args = .{};
+            a.add(pr.pick);
+            a.add(@as(c_int, @intCast(nk)));
+            a.add(pr.starts);
+            a.add(pr.order);
+            try launch(pr.f_order, s, E, 1024, &a);
+        }
+        {
+            var a: cuda.Args = .{};
+            a.add(pr.x);
+            a.add(pr.order);
+            a.add(pr.wts);
+            a.add(@as(f32, 1.0) / scale); // torch: x / scalar as x * (1 / scalar) in fp32
+            a.add(@as(c_int, @intCast(K8)));
+            a.add(@as(c_int, @intCast(D)));
+            a.add(pr.xs);
+            a.add(pr.ws);
+            a.add(pr.inv);
+            try launch(pr.f_gather, s, nk, 256, &a);
+        }
+        for (0..E) |ei| {
+            const c: usize = @intCast(pr.h_counts[ei]);
+            if (c == 0) continue;
+            const o: usize = @intCast(pr.h_starts[ei]);
+            try pr.gemm(s, e.linear(ei, 0), true, pr.xs + o * D * 2, pr.eg + o * I * 2, false, c);
+            try pr.gemm(s, e.linear(ei, 1), true, pr.xs + o * D * 2, pr.eu + o * I * 2, false, c);
+            try m.set.run(s, "_silu_mul_scale", .{ u(c), 1, 1 }, &.{
+                p("G", "*fp16", pr.eg + o * I * 2), p("U", "*fp16", pr.eu + o * I * 2), p("W", "*fp32", pr.ws + o * 4), p("OUT", "*fp16", pr.eh + o * I * 2),
+            }, &.{ ci("N", I), ci("BLOCK", pow2(I)) });
+            try pr.gemm(s, e.linear(ei, 2), true, pr.eh + o * I * 2, pr.ed + o * D * 4, true, c);
+        }
+        {
+            var a: cuda.Args = .{};
+            a.add(pr.ed);
+            a.add(pr.inv);
+            a.add(@as(c_int, @intCast(D)));
+            a.add(scale);
+            a.add(@as(c_int, @intFromBool(scale != 1.0)));
+            a.add(pr.part);
+            try launch(pr.f_combine, s, n, 256, &a);
+        }
+    }
+
+    /// One prompt chunk at [p0, p0 + n) of `slot`: caches written, its last row's logits in the decode buffers.
+    pub fn chunk(pr: *Prompt, s: Stream, slot: u32, p0: usize, tokens: []const i64, cap: ?Model.Capture) !void {
+        const m = pr.m;
+        const cfg = m.w.cfg;
+        const D = cfg.hidden;
+        const H = cfg.heads;
+        const n = tokens.len;
+        if (n == 0 or n > pr.cap) return error.ChunkTooWide;
+        if (n > m.ring - cfg.window) return error.RingOverrun;
+        if (p0 + n > m.context) return error.PastContext;
+        if (slot >= m.slots) return error.BadSlot;
+        for (tokens, 0..) |t, j| {
+            pr.h_ids[j] = t;
+            pr.h_pos[j] = @intCast(p0 + j);
+            pr.h_slot[j] = @intCast(slot);
+        }
+        try m.d.check(m.d.api.cuMemcpyHtoD_v2(pr.ids, @ptrCast(pr.h_ids.ptr), n * 8), "ids");
+        try m.d.check(m.d.api.cuMemcpyHtoD_v2(pr.pos, @ptrCast(pr.h_pos.ptr), n * 4), "pos");
+        try m.d.check(m.d.api.cuMemcpyHtoD_v2(pr.slot, @ptrCast(pr.h_slot.ptr), n * 4), "slot");
+        const dr = if (cap == null) m.dr else null;
+        const keep = @min(n, TOKENS_PER_UPDATE);
+        {
+            var a: cuda.Args = .{};
+            a.add(m.w.embed);
+            a.add(pr.ids);
+            a.add(pr.res);
+            a.add(@as(c_int, @intCast(D)));
+            try launch(m.f_embed, s, n, 256, &a);
+        }
+        try pr.rms(s, pr.res, m.w.layers[0].input_norm, pr.x, n);
+        for (m.w.layers, 0..) |L, i| {
+            const hk = cfg.kvHeads(i);
+            try pr.gemm(s, L.q, false, pr.x, pr.q, false, n);
+            try pr.gemm(s, L.k, false, pr.x, pr.k, false, n);
+            try pr.gemm(s, L.v, false, pr.x, pr.v, false, n);
+            const full = cfg.full[i];
+            const len = if (full) m.context else m.ring;
+            try m.set.run(s, "_qkv", .{ u(n), u(H + 2 * hk), 1 }, &.{
+                p("Q", "*fp16", pr.q),                                  p("K", "*fp16", pr.k),                                  p("V", "*fp16", pr.v),
+                p("COS", "*fp32", if (full) m.cos_full else m.cos_swa), p("SIN", "*fp32", if (full) m.sin_full else m.sin_swa), p("POS", "*i32", pr.pos),
+                p("SLOT", "*i32", pr.slot),                             p("QO", "*fp16", pr.qo),                                p("KC", "*fp16", m.kc[i]),
+                p("VC", "*fp16", m.vc[i]),                              ii("LEN", len),
+            }, &.{ ci("H", H), ci("HK", hk), ci("RD", cfg.rope_dim) });
+            const g = H / hk;
+            if (full) {
+                // attention.prompt over the slot's whole cache
+                const kc = m.kc[i] + @as(u64, slot) * m.context * hk * 192 * 2;
+                const vc = m.vc[i] + @as(u64, slot) * m.context * hk * 128 * 2;
+                try m.set.run(s, "_prompt", .{ u((n + PROMPT_BM - 1) / PROMPT_BM), u(hk), 1 }, &.{
+                    p("Q", "*fp16", pr.qo), p("KC", "*fp16", kc), p("VC", "*fp16", vc), p("OUT", "*fp16", pr.att),
+                    ii("P0", p0),           ii("W", n),
+                }, &.{ ci("H", H), ci("HK", hk), ci("G", g), aot.cf("SCALE", m.scale), ci("BM", PROMPT_BM), ci("BN", fwd.BN) });
+            } else {
+                const nch: usize = (cfg.window + fwd.CK - 1) / fwd.CK + 1;
+                try m.set.run(s, "_rows", .{ u(n), u(hk), u(nch) }, &.{
+                    p("Q", "*fp16", pr.qo),   p("KC", "*fp16", m.kc[i]),  p("VC", "*fp16", m.vc[i]),
+                    p("POS", "*i32", pr.pos), p("SLOT", "*i32", pr.slot), p("PO", "*fp32", pr.po),
+                    p("PM", "*fp32", pr.pm),  p("PL", "*fp32", pr.pl),    ii("LEN", len),
+                    ii("NCH", nch),
+                }, &.{ ci("H", H), ci("HK", hk), ci("G", g), ci("WIN", cfg.window), aot.cf("SCALE", m.scale), ci("CK", fwd.CK), ci("BN", fwd.BN), ci("GP", fwd.GP) });
+                const sinks = L.sinks;
+                try m.set.run(s, "_merge", .{ u(n), u(H), 1 }, &.{
+                    p("PO", "*fp32", pr.po),                               p("PM", "*fp32", pr.pm),   p("PL", "*fp32", pr.pl),
+                    p("SINKS", "*fp32", if (sinks != 0) sinks else pr.pm), p("OUT", "*fp16", pr.att), ii("NCH", nch),
+                }, &.{ ci("H", H), ci("HAS_SINK", @intFromBool(sinks != 0)) });
+            }
+            if (cap) |c| if (c.hook) |hf| try hf(c.ctx, .att, i, pr.att, n * H * 128 * 2);
+            try pr.gemm(s, L.o, false, pr.att, pr.part, true, n);
+            try pr.addRms(s, try pr.sum(s, pr.part, n), L.post_norm, n);
+            if (cap) |c| if (c.hook) |hf| try hf(c.ctx, .attn, i, pr.res, n * D * 4);
+            if (L.experts) |e| {
+                const bm = fwd.routerTile(n);
+                const be: usize, const bk: usize = if (bm == 16) .{ 32, 256 } else .{ 64, 64 };
+                try m.set.run(s, "_router", .{ u((n + bm - 1) / bm), u((cfg.experts + be - 1) / be), 1 }, &.{
+                    p("X", "*fp16", pr.x), p("W", "*fp16", L.router), p("OUT", "*fp32", pr.logits), ii("M", n), ii("x_stride", D),
+                }, &.{ ci("D", D), ci("NE", cfg.experts), ci("BM", bm), ci("BLOCK_E", be), ci("BK", bk) });
+                try m.set.run(s, "_topk", .{ u(n), 1, 1 }, &.{
+                    p("L", "*fp32", pr.logits), p("BIAS", "*fp32", L.bias), p("PICK", "*i32", pr.pick), p("WTS", "*fp32", pr.wts), aot.float("SCALE", L.route_scale),
+                }, &.{ ci("NE", cfg.experts), ci("TOPK", cfg.top_k), ci("BLOCK", pow2(cfg.experts)), ci("KP", pow2(cfg.top_k)) });
+                if (n >= EXPERTS_FROM) {
+                    try pr.experts(s, e, L.route_scale, n);
+                } else {
+                    // the grouped kernel reads the trellis directly; rows are independent, so windows change no bits
+                    var w0: usize = 0;
+                    while (w0 < n) : (w0 += pr.sc.rows) {
+                        const k = @min(pr.sc.rows, n - w0);
+                        try m.k3.routed(s, pr.x + w0 * D * 2, false, D, pr.pick + w0 * cfg.top_k * 4, pr.wts + w0 * cfg.top_k * 4, e, pr.sc, pr.part + w0 * D * 4, k, std.math.inf(f32), 1, true);
+                    }
+                }
+            } else {
+                try pr.gemm(s, L.gate.?, false, pr.x, pr.g, false, n);
+                try pr.gemm(s, L.up.?, false, pr.x, pr.up, false, n);
+                const nd = L.gate.?.n;
+                try m.set.run(s, "_silu_mul", .{ u(n), u(nd / 1024), 1 }, &.{ p("G", "*fp16", pr.g), p("U", "*fp16", pr.up), p("OUT", "*fp16", pr.h) }, &.{ ci("N", nd), ci("BLOCK", 1024) });
+                try pr.gemm(s, L.down.?, false, pr.h, pr.part, true, n);
+            }
+            const after = if (i + 1 < m.w.layers.len) m.w.layers[i + 1].input_norm else m.w.norm;
+            try pr.addRms(s, try pr.sum(s, pr.part, n), after, n);
+            if (cap) |c| if (c.hook) |hf| try hf(c.ctx, .mlp, i, pr.res, n * D * 4);
+            if (dr) |dd| try dd.tapInto(s, i, pr.res + (n - keep) * D * 4, keep, pr.taps);
+        }
+        if (dr) |dd| {
+            const row = dd.taps.len * D * 2;
+            var w0: usize = 0;
+            while (w0 < keep) : (w0 += fwd.DECODE_ROWS) {
+                const k = @min(fwd.DECODE_ROWS, keep - w0);
+                const at = n - keep + w0;
+                try dd.updateFrom(s, pr.taps + w0 * row, pr.pos + at * 4, pr.slot + at * 4, k);
+            }
+        }
+        // _head on the last row: the decode GEMV, gathered into the model's decode buffers
+        try m.k3.linear(s, m.w.head, pr.x + (n - 1) * D * 2, .f16, m.b.xh, m.b.head, .f32, if (m.w.head.split[0] > 1) m.b.z else 0, 1);
+        if (m.comm) |c| try c.allGather(m.b.head, m.b.recv, m.w.head.n, .f32, s.handle);
+    }
+};
+
+/// Python's lone-stream chunks cut to at most `cap` rows, parts a multiple of 16 rows and none under EXPERTS_MIN.
+pub fn plan(gpa: std.mem.Allocator, start: usize, len: usize, cap: usize) ![]usize {
+    var out: std.ArrayList(usize) = .empty;
+    errdefer out.deinit(gpa);
+    var a = start;
+    while (a < len) {
+        const b = @min(len, a + fwd.PROMPT_CHUNK);
+        const c = b - a;
+        if (c <= cap) {
+            try out.append(gpa, c);
+        } else {
+            const parts = (c + cap - 1) / cap;
+            const part = (c + parts - 1) / parts;
+            const p16 = (part + 15) / 16 * 16;
+            var left = c;
+            for (0..parts - 1) |_| {
+                try out.append(gpa, p16);
+                left -= p16;
+            }
+            if (left < EXPERTS_MIN) return error.ChunkPlan;
+            try out.append(gpa, left);
+        }
+        a = b;
+    }
+    return out.toOwnedSlice(gpa);
+}
+
+test "prompt chunk plan" {
+    const g = std.testing.allocator;
+    const a = try plan(g, 0, 40, 4096);
+    defer g.free(a);
+    try std.testing.expectEqualSlices(usize, &.{40}, a);
+    const b = try plan(g, 0, 9000, 4096);
+    defer g.free(b);
+    try std.testing.expectEqualSlices(usize, &.{ 3008, 3008, 2984 }, b);
+    const c = try plan(g, 0, 16384 + 100, 4096);
+    defer g.free(c);
+    try std.testing.expectEqualSlices(usize, &.{ 4096, 4096, 4096, 4096, 100 }, c);
+}
