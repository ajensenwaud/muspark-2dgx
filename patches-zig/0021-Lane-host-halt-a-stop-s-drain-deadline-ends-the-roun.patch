 pub const LaneHost = struct {
     gpa: Allocator,
@@ -38,6 +39,8 @@ pub const LaneHost = struct {
     filling: std.ArrayList(*Job) = .empty, // admitted jobs whose prompt is still going in, a chunk a round, oldest first
