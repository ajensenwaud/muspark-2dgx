-        const arrived = nowNs(g.srv.io);
-        if (g.first_ns == null) g.first_ns = arrived;
-        g.last_ns = arrived;
-        const sink = g.sink orelse return;
-        if (g.streaming_done) return;
-        var fresh: std.ArrayList(u32) = .empty;
-        for (chunk[0..landed]) |t| {
-            if (g.eos(t)) {
