-                break;
-            }
-            try fresh.append(g.a, t);
-        }
-        const all = try g.visible.extend(g.a, g.srv.text, decodeText, fresh.items);
-        const text = g.stops.visible(all, true);
-        if (g.visible.pending()) return; // a character still split across tokens
