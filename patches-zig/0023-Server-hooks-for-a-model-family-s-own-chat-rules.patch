+    /// A reply that ended before anything was sent: a refusal's 400, a failure's 500, nothing when the client left.
+    fn unsent(r: *Run, cx: *Cx, e: chat.Failure, field: []const u8) void {
+        switch (e) {
+            error.Cancelled => {},
