-        }
-        if (g.calls) |*c| {
-            var out: std.ArrayList(Value) = .empty;
-            try c.feed(answer, &out); // never the reasoning: a call it mentions is not made
-            for (out.items) |d| try g.emit(sink, d);
-        }
-    }
