From 82ba328b91dbaef9864c1dd134e6d1753eee45e6 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Sun, 11 Oct 2026 22:36:32 +0700
Subject: [PATCH 33/60] Session store: historyOf returns an entry's ids from
 RAM or from the prompt that names it

(cherry picked from commit 05977fabc879e18a85eed4c04a88abf649ab7310)
---
 zig/src/sessions/store.zig      | 16 ++++++++++++++
 zig/src/sessions/store_test.zig | 39 +++++++++++++++++++++++++++++++++
 2 files changed, 55 insertions(+)

diff --git a/zig/src/sessions/store.zig b/zig/src/sessions/store.zig
index 851ce509..8d96a7af 100644
--- a/zig/src/sessions/store.zig
+++ b/zig/src/sessions/store.zig
@@ -230,6 +230,22 @@ pub const Store = struct {
         return e.extra.bounded.?;
     }
 
+    /// A restored entry's ids (pos long): RAM from the index, else `given`, the prompt's prefix, checked.
+    pub fn historyOf(s: *Store, id: u32, given: ?[]const i32, out: []i32) !void {
+        const e = s.index.get(id);
+        if (out.len != e.pos) return error.BadLength;
+        if (e.ram) return s.index.idsOf(id, out);
+        // an NVMe entry's tokens left the index with its RAM (prefix.dropTokens): only the prompt still holds them
+        const ids = given orelse return error.NotInRam;
+        if (ids.len < e.pos) return error.BadLength;
+        const pos: usize = @intCast(e.pos);
+        const full = pos / s.pool.page;
+        const d = try s.digests(e.tag, ids[0..pos]);
+        const node = if (full == 0) prefix.root(e.tag) else d[full - 1];
+        if (!std.mem.eql(u8, &prefix.entryKey(node, e.pos, ids[full * s.pool.page .. pos]), &e.key)) return error.NotTheEntry;
+        @memcpy(out, ids[0..pos]);
+    }
+
     /// Starts an NVMe resume into an empty slot (pages mapped now, filled by the job); settle it before the slot runs.
     pub fn beginRestore(s: *Store, id: u32, slot: *Slot) !*Job {
         const d = s.disk orelse return error.NoDisk;
diff --git a/zig/src/sessions/store_test.zig b/zig/src/sessions/store_test.zig
index 86b58a4f..5adbb442 100644
--- a/zig/src/sessions/store_test.zig
+++ b/zig/src/sessions/store_test.zig
@@ -214,3 +214,42 @@ test "two split ranks make the same decisions on the same calls and each restore
     try restart(gpa, root, 2, 1);
     try testing.expectEqualSlices(u64, t0.items, t1.items);
 }
+
+test "historyOf: a RAM entry's ids come from the index, an NVMe entry's only from the prompt that names it" {
+    const gpa = testing.allocator;
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const root = try tmpRoot(gpa, &tmp, "history");
+    defer gpa.free(root);
+    var r: Rank = undefined;
+    try r.init(gpa, root, 1, 0, .{ .chats = 1 });
+    defer r.deinit();
+    const s = try r.pool.newSlot(64 * page);
+    const a = try chatIds(gpa, 1, 8 * page);
+    defer gpa.free(a);
+    const b = try chatIds(gpa, 2, 8 * page);
+    defer gpa.free(b);
+    const n = 5 * page + 10;
+    try testing.expectEqualStrings("fresh", try turn(gpa, &r, s, 1, a[0..n]));
+    const hit = (try r.store.find(1, a[0 .. n + 1])).?;
+    try testing.expect(hit.ram and hit.pos == n);
+    var out: [n]i32 = undefined;
+    try r.store.historyOf(hit.id, null, &out);
+    try testing.expectEqualSlices(i32, a[0..n], &out);
+    try testing.expectError(error.BadLength, r.store.historyOf(hit.id, null, out[0 .. n - 1]));
+    // a second idle chat parks chat 1 on NVMe: its ids leave the index with its RAM
+    try testing.expectEqualStrings("fresh", try turn(gpa, &r, s, 2, b[0 .. 6 * page]));
+    const parked = (try r.store.find(1, a[0 .. n + 1])).?;
+    try testing.expect(!parked.ram and parked.pos == n);
+    try testing.expectError(error.NotInRam, r.store.historyOf(parked.id, null, &out));
+    @memset(&out, 0);
+    try r.store.historyOf(parked.id, a, &out); // a longer prompt: its first pos ids, checked against the entry's key
+    try testing.expectEqualSlices(i32, a[0..n], &out);
+    // another chat's ids, or these with the partial page's last id changed, are not this entry
+    try testing.expectError(error.NotTheEntry, r.store.historyOf(parked.id, b[0..n], &out));
+    const edited = try gpa.dupe(i32, a[0..n]);
+    defer gpa.free(edited);
+    edited[n - 1] += 1;
+    try testing.expectError(error.NotTheEntry, r.store.historyOf(parked.id, edited, &out));
+    try testing.expectError(error.BadLength, r.store.historyOf(parked.id, a[0 .. n - 1], &out));
+}
