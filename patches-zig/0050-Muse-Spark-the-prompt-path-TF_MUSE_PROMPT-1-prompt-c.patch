index 00000000..4ab412b7
--- /dev/null
+++ b/zig/src/families/muse_spark/prompt.zig
@@ -0,0 +1,312 @@
+//! Muse Spark's prompt path: one slot's prompt chunk as wide windows. Dense projections and attention run in
+//! 128-row windows on the decode kernels, the routed experts in windows of up to `ewin` rows on the same grouped
+//! kernel (each expert's trellis read once a window instead of once per 128 rows), the head on the last row only.
+//! Every kernel's row bits are independent of its window, so a chunk gives the decode rows' bits (`exact`, the
+//! decode tile settings); `exact = false` runs gate / up unsplit (less scratch, other bits).
+
+const std = @import("std");
+const cuda = @import("cuda");
+const load_ = @import("load.zig");
+const fwd = @import("forward.zig");
+const exl3 = cuda.exl3;
+const Stream = cuda.Stream;
+const Model = fwd.Model;
+
+pub const CAP = 1024; // rows a chunk (TF_MUSE_PROMPT_ROWS)
+pub const EWIN = 512; // rows an experts window (TF_MUSE_PROMPT_EWIN)
+const W = fwd.DECODE_ROWS; // the dense and attention windows
+
+fn u(x: usize) u32 {
+    return @intCast(x);
+}
+fn ci(x: usize) c_int {
+    return @intCast(x);
+}
+
+/// Bytes of the experts window's scratch: (xg + xu + xd, with y over them; z, also the gathers' landing).
+pub fn expertBytes(e: exl3.Experts, ewin: usize, slots: usize, cfg_gu: [4]u32, cfg_d: [4]u32, world: usize, chunk_d: usize) [2]usize {
+    const sz = exl3.Scratch.bytes(e, ewin, slots, cfg_gu, cfg_d);
+    const front = @max(2 * sz.xg + sz.xd, sz.y);
+    const land = world * @max(ewin * slots * e.dims, chunk_d) * 4;
+    return .{ front, @max(sz.z, if (world > 1) land else 0) };
+}
+
+pub const Prompt = struct {
+    m: *Model,
+    gpa: std.mem.Allocator,
+    cap: usize,
+    ewin: usize,
+    exact: bool,
+    ar: load_.Arena,
+    ids: u64, // i64 [cap]
+    pos: u64, // i32 [cap]
+    slot: u64,
+    res: u64, // f32 [cap, D]
+    x: u64, // f16 [cap, D]
+    xf: u64, // f32 [cap, D]
+    part: u64, // f32 [cap, D]
+    big: u64, // f32: the experts' split partials (z), else an all-gather's landing (never live together)
+    logits: u64, // f32 [cap, E]
+    pick: u64, // i32 [cap, K]
+    wts: u64, // f32 [cap, K]
+    lat: u64, // f16 [cap, latent / world]
+    latg: u64, // f16 [world, cap, latent / world]
+    latn: u64, // f16 [cap, latent]
+    acc: u64, // f16 [cap, post inputs]
+    sc: exl3.Scratch, // the grouped kernel's for ewin rows; y over xg / xu / xd, z = big
+    taps: u64, // drafter: the chunk's taps, f16 [cap, taps, D]
+    h_ids: []i64,
+    h_pos: []i32,
+    h_slot: []i32,
+
+    pub fn init(m: *Model, gpa: std.mem.Allocator, cap: usize, ewin_: usize, exact: bool, s: Stream) !*Prompt {
+        const w = m.w;
+        const cfg = w.cfg;
+        if (cap < 1 or ewin_ < 1) return error.PromptRows;
+        const ewin = @min(ewin_, cap);
+        if (ewin * cfg.top_k * 4 > 96 * 1024) return error.ExpertWindow; // the group kernel's picks in shared memory
+        const pr = try gpa.create(Prompt);
+        errdefer gpa.destroy(pr);
+        pr.* = undefined;
+        pr.m = m;
+        pr.gpa = gpa;
+        pr.cap = cap;
+        pr.ewin = ewin;
+        pr.exact = exact;
+        pr.ar = .{ .d = m.d, .gpa = gpa };
+        errdefer pr.ar.deinit();
+        const ar = &pr.ar;
+        const R = cap;
+        const D = cfg.hidden;
+        const L0 = w.layers[0];
+        const e0 = L0.experts;
+        pr.ids = try ar.zeros(R * 8);
+        pr.pos = try ar.zeros(R * 4);
+        pr.slot = try ar.zeros(R * 4);
+        pr.res = try ar.zeros(R * D * 4);
+        pr.x = try ar.zeros(R * D * 2);
+        pr.xf = try ar.zeros(R * D * 4);
+        pr.part = try ar.zeros(R * D * 4);
+        pr.logits = try ar.zeros(R * cfg.experts * 4);
+        pr.pick = try ar.zeros(R * cfg.top_k * 4);
+        pr.wts = try ar.zeros(R * cfg.top_k * 4);
+        pr.lat = try ar.zeros(R * L0.pre.n * 2);
+        pr.latg = try ar.zeros(R * cfg.latent * 2);
+        pr.latn = try ar.zeros(R * cfg.latent * 2);
+        pr.acc = try ar.zeros(R * L0.post.k * 2);
+        const cfg_gu = if (exact) m.b.sc.cfg_gu else try exl3.defaultConfig(e0.dims, e0.width, false); // unsplit: sk 1
+        const cfg_d = m.b.sc.cfg_d;
+        const eb = expertBytes(e0, ewin, cfg.top_k, cfg_gu, cfg_d, w.world, R * D);
+        const sz = exl3.Scratch.bytes(e0, ewin, cfg.top_k, cfg_gu, cfg_d);
+        const front = try ar.zeros(eb[0]);
+        pr.big = try ar.zeros(eb[1]);
+        pr.sc = .{ .xg = front, .xu = front + sz.xg, .xd = front + 2 * sz.xg, .z = pr.big, .y = front, .ids = try ar.zeros(sz.ids), .count = try ar.zeros(4), .members = try ar.alloc(sz.members), .rows = ewin, .slots = cfg.top_k, .cfg_gu = cfg_gu, .cfg_d = cfg_d };
+        try m.d.check(m.d.api.cuMemsetD32_v2(pr.sc.members, 0xFFFF_FFFF, sz.members / 4), "members -1");
+        pr.taps = if (m.dr) |dr| try ar.zeros(R * dr.taps.len * D * 2) else 0;
+        pr.h_ids = try gpa.alloc(i64, R);
+        errdefer gpa.free(pr.h_ids);
+        pr.h_pos = try gpa.alloc(i32, R);
+        errdefer gpa.free(pr.h_pos);
+        pr.h_slot = try gpa.alloc(i32, R);
+        try s.synchronize();
+        return pr;
+    }
+
+    pub fn deinit(pr: *Prompt) void {
+        pr.gpa.free(pr.h_ids);
+        pr.gpa.free(pr.h_pos);
+        pr.gpa.free(pr.h_slot);
+        pr.ar.deinit();
+        pr.gpa.destroy(pr);
+    }
+
+    pub fn bytes(pr: *const Prompt) usize {
+        return pr.ar.total;
+    }
+
+    /// The ranks' fp32 partials [count] gathered into big (rank-major); (rank 0's, rank 1's or 0).
+    fn gather(pr: *Prompt, s: Stream, part: u64, count: usize) ![2]u64 {
+        const c = pr.m.comm orelse return .{ part, 0 };
+        try c.allGather(part, pr.big, count, .f32, s.handle);
+        return .{ pr.big, pr.big + count * 4 };
+    }
+
+    /// An EXL3 projection of the chunk's n rows in 128-row windows: x [n, K] fp16 -> out [n, N].
+    fn proj(pr: *Prompt, s: Stream, l: exl3.Linear, x: u64, out: u64, out_f32: bool, n: usize) !void {
+        var w0: usize = 0;
+        while (w0 < n) : (w0 += W) {
+            const k = @min(W, n - w0);
+            try pr.m.proj(s, l, x + w0 * l.k * 2, out + w0 * l.n * @as(usize, if (out_f32) 4 else 2), out_f32, k);
+        }
+    }
+
+    /// The attention half of layer i for the chunk's rows at [p0, p0 + n): 128-row windows of q / k / v / g,
+    /// attention (each window's keys written before it reads them) and o_proj into part.
+    fn attention(pr: *Prompt, s: Stream, L: load_.Layer, i: usize, p0: usize, n: usize) !void {
+        const m = pr.m;
+        const D = m.w.cfg.hidden;
+        var w0: usize = 0;
+        while (w0 < n) : (w0 += W) {
+            const k = @min(W, n - w0);
+            const x = pr.x + w0 * D * 2;
+            try m.proj(s, L.q, x, m.b.q, false, k);
+            try m.proj(s, L.k, x, m.b.k, false, k);
+            try m.proj(s, L.v, x, m.b.v, false, k);
+            try m.proj(s, L.g, x, m.b.g, false, k);
+            var chunks: usize = 1;
+            for (0..k) |j| chunks = @max(chunks, fwd.rowChunks(m.context, p0 + w0 + j));
+            try m.attentionIo(s, i, k, chunks, .{ .q = m.b.q, .k = m.b.k, .v = m.b.v, .g = m.b.g, .qo = m.b.qo, .att = m.b.att, .pos = pr.pos + w0 * 4, .slot = pr.slot + w0 * 4 });
+            try m.proj(s, L.o, m.b.att, pr.part + w0 * D * 4, true, k);
+        }
+    }
+
+    /// MuseSparkMoE over the chunk: router and latent for every row, routed experts in windows of ewin rows (per-slot
+    /// outputs gathered, normed and summed per window), post_expert_proj into part.
+    fn moe(pr: *Prompt, s: Stream, L: load_.Layer, n: usize) !void {
+        const m = pr.m;
+        const cfg = m.w.cfg;
+        const E = cfg.experts;
+        const K = cfg.top_k;
+        {
+            var a: cuda.Args = .{};
+            a.add(pr.xf);
+            a.add(L.router);
+            a.add(@as(c_int, @intFromBool(L.router_bf16)));
+            a.add(pr.logits);
+            a.add(ci(cfg.hidden));
+            a.add(ci(E));
+            try cuda.launch.launch(m.f_router, .{ .grid = .{ .x = u((E + 7) / 8), .y = u(n), .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, s, &a);
+        }
+        {
+            var a: cuda.Args = .{};
+            a.add(pr.logits);
+            a.add(L.bias);
+            a.add(ci(E));
+            a.add(ci(K));
+            a.add(@as(f32, @floatCast(cfg.out_mult)));
+            a.add(@as(f32, @floatCast(cfg.route_scale)));
+            a.add(pr.pick);
+            a.add(pr.wts);
+            const t = std.math.ceilPowerOfTwo(usize, @max(E, 32)) catch unreachable;
+            try cuda.launch.launch(m.f_topk, .{ .grid = .{ .x = u(n), .y = 1, .z = 1 }, .block = .{ .x = u(t), .y = 1, .z = 1 } }, s, &a);
+        }
+        try pr.proj(s, L.pre, pr.x, pr.lat, false, n);
+        if (m.comm) |c| {
+            const half = L.pre.n;
+            try c.allGather(pr.lat, pr.latg, n * half, .f16, s.handle);
+            try m.normParts(s, pr.latg, true, L.pre_norm, pr.latn, n, cfg.latent, cfg.eps, half);
+        } else try m.norm(s, pr.lat, true, L.pre_norm, pr.latn, n, cfg.latent, cfg.eps);
+        const k3 = m.k3;
+        const e = L.experts;
+        const sc = pr.sc;
+        const gu = sc.cfg_gu;
+        const dn = sc.cfg_d;
+        var w0: usize = 0;
+        while (w0 < n) : (w0 += pr.ewin) {
+            const r = @min(pr.ewin, n - w0);
+            const p = r * K;
+            const nexp = @min(p, E);
+            const pick = pr.pick + w0 * K * 4;
+            try k3.group(s, pick, sc.ids, sc.count, sc.members, r, K, E, r);
+            try k3.expertsRotIn(s, pr.latn + w0 * cfg.latent * 2, false, cfg.latent, pick, e.suh_g, e.suh_u, sc.xg, sc.xu, r, e.dims, K, E);
+            try k3.grouped(s, .{ .x0 = sc.xg, .x1 = sc.xu, .tp0 = e.gate_ptr, .tp1 = e.up_ptr, .k2_0 = e.gate_k2, .k2_1 = e.up_k2, .uids = sc.ids, .ucount = sc.count, .members = sc.members, .z = sc.z, .mats = 2, .k = e.dims, .n = e.width, .p = p, .sk = gu[2], .slots = K, .maxm = r, .nexp_max = nexp, .nt = gu[0], .warps = gu[1], .pf = gu[3], .lo = e.k2_gu[0], .hi = e.k2_gu[1] });
+            try k3.gateupEpilogue(s, sc.z, pick, e.svh_g, e.svh_u, e.suh_d, sc.xd, r, p, e.width, gu[2], K, E, std.math.inf(f32), 1);
+            try k3.grouped(s, .{ .x0 = sc.xd, .x1 = sc.xd, .tp0 = e.down_ptr, .tp1 = e.down_ptr, .k2_0 = e.down_k2, .k2_1 = e.down_k2, .uids = sc.ids, .ucount = sc.count, .members = sc.members, .z = sc.z, .mats = 1, .k = e.width, .n = e.dims, .p = p, .sk = dn[2], .slots = K, .maxm = r, .nexp_max = nexp, .nt = dn[0], .warps = dn[1], .pf = dn[3], .lo = e.k2_d[0], .hi = e.k2_d[1] });
+            try k3.downEpilogue(s, sc.z, pick, e.svh_d, sc.y, r, p, e.dims, dn[2], K, E); // y over xg / xu / xd (dead now)
