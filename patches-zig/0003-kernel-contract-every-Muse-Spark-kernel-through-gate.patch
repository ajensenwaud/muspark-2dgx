new file mode 100644
index 00000000..38e23818
--- /dev/null
+++ b/zig/tests/cuda/contract_muse_norms.zig
@@ -0,0 +1,363 @@
+//! Muse Spark's norm glue under the contract against float64; the 8-block cluster forms bit-equal to the block forms.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const mu = @import("contract_muse_util.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+const rows = core.contract.rows;
+
+/// A thread's ceil(D / 1024) squares, then 32 lanes and 32 warps (or 8 blocks' 4 warps) by halves.
+fn rmsDepth(s: c.Shape) usize {
+    return (s.k + 1023) / 1024 + 12;
+}
+
+const tiles: [3]c.Tile = .{ .{}, .{}, .{ .size = 1024 } };
+const half_why = "an fp16 output follows the sum of squares as ss^-1/2: a bf16 sum's error is a few output ulps";
+const point = "bf16(fp32(y + y2) * scale) is exllamav3's rounding point, replayed on the host from the kernel's two IEEE fp32 " ++
+    "steps (an add, then a multiply: nothing to contract); float64 from there";
+
+pub const Kind = enum { embed, gate_res, gate_x, gate_xf, esum };
+
+pub fn spec(kind: Kind, cluster: bool) c.Spec {
+    const hidden = &[_]c.Shape{ .{ .rows = 8, .n = 8192, .k = 8192 }, .{ .rows = 1, .n = 8192, .k = 8192 } };
+    const latent = &[_]c.Shape{ .{ .rows = 8, .n = 2048, .k = 4096 }, .{ .rows = 1, .n = 2048, .k = 4096 } };
+    const gate_sums: c.Sums = .{ .exact = false, .why = point };
+    var s: c.Spec = switch (kind) {
+        .embed => .{ .name = "cuda muse muse_embed_norm (bf16 rows, fp32 out)", .accum = .f32, .depth = rmsDepth, .ops = 8, .out = .f32, .tiles = tiles, .served = hidden },
+        .gate_res => .{ .name = "cuda muse muse_gate_norm (the residual, in place)", .accum = .f32, .depth = rmsDepth, .out = .f32, .in_place = true, .tiles = tiles, .served = hidden, .sums = gate_sums },
+        .gate_x => .{ .name = "cuda muse muse_gate_norm (the next norm's fp16 x)", .accum = .f32, .depth = rmsDepth, .out = .f16, .tiles = tiles, .served = hidden, .sums = .{ .bf16 = 0, .exact = false, .why = half_why } },
+        .gate_xf => .{ .name = "cuda muse muse_gate_norm (the next norm's fp32 xf)", .accum = .f32, .depth = rmsDepth, .out = .f32, .tiles = tiles, .served = hidden, .sums = gate_sums },
+        .esum => .{ .name = "cuda muse muse_expert_sum (8 slots, a rank's fp16 columns)", .accum = .f32, .depth = rmsDepth, .out = .f16, .tiles = tiles, .served = latent, .sums = .{ .bf16 = 0, .exact = false, .why = half_why } },
+    };
+    if (cluster) {
+        s.name = switch (kind) {
+            .embed => unreachable,
+            .gate_res => "cuda muse muse_gate_norm_c (8 blocks a row: the residual)",
+            .gate_x => "cuda muse muse_gate_norm_c (8 blocks a row: fp16 x)",
+            .gate_xf => "cuda muse muse_gate_norm_c (8 blocks a row: fp32 xf)",
+            .esum => "cuda muse muse_expert_sum_c (8 blocks a row)",
+        };
+        s.replaces = if (kind == .esum) "muse_expert_sum" else "muse_gate_norm";
+        s.nan = .{ .stated = "the bytes of the 1,024-thread form, non-finite inputs included" };
+    }
+    return s;
+}
+
+const slots = 8; // Muse Spark's top 8
+const post_eps: f32 = 1e-8;
+const next_eps: f32 = 1e-5;
+
+pub const Norm = struct {
+    rig: rig_.Rig,
+    kind: Kind,
+    cluster: bool = false,
+    f: cuda.Function,
+    base: ?cuda.Function = null,
+    arena: std.heap.ArenaAllocator,
+    r: ?rows.Rows = null,
+    shape: c.Shape = undefined,
+    // host values as the kernel reads them: gate (res, y, y2, scale, ab, w); esum (y, y2, wts, scale)
+    v: [6][]f64 = undefined,
+    t: []f64 = &.{}, // the rounding point bf16(fp32(y + y2) * scale)
+    dev: [8]u64 = @splat(0),
+    lo: usize = 0,
+    host: std.ArrayList(u8) = .empty,
+    msg: [160]u8 = undefined,
+
+    pub fn deinit(self: *Norm) void {
+        if (self.r) |r| r.deinit();
+        self.host.deinit(self.rig.gpu.gpa);
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    const vt_ref = blk: {
+        var v = g.hooks(Norm);
+        v.check = null;
+        v.replaced = null;
+        break :blk v;
+    };
+    const vt_rep = g.hooks(Norm);
+
+    pub fn kernel(self: *Norm) g.Kernel {
+        return .{ .spec = spec(self.kind, self.cluster), .ctx = self, .vt = if (self.cluster) &vt_rep else &vt_ref };
+    }
+
+    fn D(self: *const Norm) usize {
+        return self.shape.k;
+    }
+
+    fn outW(self: *const Norm) usize {
+        return if (self.kind == .esum) @min(self.shape.n, self.shape.k) else self.shape.k;
+    }
+
+    pub fn prepare(self: *Norm, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.k == 0 or shape.k > 16 * 1024 or shape.rows == 0) return false;
+        if (self.kind == .esum and shape.n == 0) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        if (self.r) |r| r.deinit();
+        self.r = null;
+        self.shape = shape;
+        const ga = self.rig.gpu.gpa;
+        if (self.kind == .embed) return self.prepareEmbed(fill, seed);
+        const a = self.arena.allocator();
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        const d = self.D();
+        const n = if (self.kind == .esum) shape.rows * slots else shape.rows; // rows of y
+        const lens = if (self.kind == .esum) [6]usize{ n * d, n * d, n, d, 0, 0 } else [6]usize{ n * d, n * d, n * d, d, 2 * d, d };
+        for (&self.v, lens) |*x, l| x.* = try a.alloc(f64, l);
+        const v = &self.v;
+        const ys = if (self.kind == .esum) [2]usize{ 0, 1 } else [2]usize{ 1, 2 };
+        for (ys) |i| for (v[i]) |*x| {
+            x.* = if (fill == .stress) mu.int(rng, -16, 16) else mu.uni(rng, f32, -2, 2);
+        };
+        if (self.kind == .esum) {
+            for (v[2]) |*x| x.* = if (fill == .stress) 1 else mu.uni(rng, f32, 0, 0.5);
+            for (v[3]) |*x| x.* = if (fill == .stress) 1 else mu.uni(rng, u16, 0.5, 1.5);
+            self.lo = if (self.outW() < d and seed % 2 == 1) d - self.outW() else 0; // either rank's columns
+        } else {
+            for (v[0]) |*x| x.* = if (fill == .stress) mu.int(rng, -64, 64) else mu.uni(rng, f32, -4, 4);
+            for (v[3]) |*x| x.* = if (fill == .stress) 1 else mu.uni(rng, f32, 0.25, 2);
+            for (v[4]) |*x| x.* = if (fill == .stress) 1 else mu.uni(rng, f32, 0.5, 1.5);
+            for (v[5]) |*x| x.* = mu.uni(rng, f32, 0.5, 1.5);
+        }
+        if (fill == .nonfinite) {
+            const y = v[ys[0]];
+            y[0] = std.math.nan(f64); // row (or slot) 0: every output NaN
+            const second: usize = if (self.kind == .esum) slots + 2 else 2; // row 1's third slot, or row 2
+            if (n > second) v[ys[1]][second * d + 5] = std.math.inf(f64); // inf * 0 at one column, the rest 0 * finite
+            if (self.kind == .esum) {
+                if (n > slots + 1) v[2][slots + 1] = -std.math.inf(f64); // row 1's second slot weight
+            } else if (shape.rows > 3) v[0][3 * d + d - 1] = -std.math.inf(f64); // res: the next norm's row 3
+        }
+        self.t = try a.alloc(f64, n * d);
+        for (self.t, 0..) |*o, i| {
+            const sum: f32 = @as(f32, @floatCast(v[ys[0]][i])) + @as(f32, @floatCast(v[ys[1]][i]));
+            o.* = mu.bf16r(sum * @as(f32, @floatCast(v[3][i % d])));
+        }
+        for (0..6) |i| {
+            if (lens[i] == 0) continue;
+            self.dev[i] = try mu.put(&self.rig, ga, f32, v[i]);
+        }
+        const ob = shape.rows * self.outW();
+        switch (self.kind) {
+            .gate_res => {
+                self.dev[6] = try self.rig.output(ob * 4);
+                self.dev[7] = try self.rig.scratch(ob * 2 + ob * 4);
+            },
+            .gate_x => {
+                self.dev[6] = try self.rig.output(ob * 2);
+                self.dev[7] = try self.rig.scratch(ob * 8);
+            },
+            .gate_xf => {
+                self.dev[6] = try self.rig.output(ob * 4);
+                self.dev[7] = try self.rig.scratch(ob * 4 + ob * 2);
+            },
+            .esum => self.dev[6] = try self.rig.output(ob * 2),
+            .embed => unreachable,
+        }
+        return true;
+    }
+
+    fn prepareEmbed(self: *Norm, fill: g.Fill, seed: u64) !bool {
+        const ga = self.rig.gpu.gpa;
+        var r = try rows.Rows.init(ga, .rms, self.shape);
+        r.eps = next_eps;
+        self.r = r;
+        r.fill(fill, seed);
+        @memset(r.w, c.toBf16(1)); // the weightless embed_norm
+        const n = self.shape.rows;
+        const k = self.shape.k;
+        const table = try self.arena.allocator().alloc(u16, r.x.len); // row i of x at table row n - 1 - i
+        for (0..n) |i| @memcpy(table[(n - 1 - i) * k ..][0..k], r.x[i * k ..][0..k]);
+        self.dev[0] = try self.rig.input(std.mem.sliceAsBytes(table));
+        const ids = try self.arena.allocator().alloc(i64, n);
+        for (ids, 0..) |*o, i| o.* = @intCast(n - 1 - i);
+        self.dev[1] = try mu.ints(&self.rig, i64, ids);
+        self.dev[2] = try self.rig.output(r.outputs() * 4);
+        return true;
+    }
+
+    /// Where the view's buffers sit in a call: res, x, xf (gate) from the output and scratch slots.
+    fn gateOuts(self: *const Norm, out: u64, extra: u64) [3]u64 {
+        const ob = self.shape.rows * self.D();
+        return switch (self.kind) {
+            .gate_res => .{ out, extra, extra + ob * 2 },
+            .gate_x => .{ extra, out, extra + ob * 4 },
+            else => .{ extra, extra + ob * 4, out },
+        };
+    }
+
+    fn launch(self: *Norm, f: cuda.Function, cluster: bool, out: u64, extra: u64) !void {
+        const s = self.rig.s;
+        const n = self.shape.rows;
+        var a: cuda.Args = .{};
+        switch (self.kind) {
+            .embed => {
+                inline for (.{ self.dev[0], self.dev[1], self.dev[2] }) |p| a.add(p);
+                a.add(@as(c_int, @intCast(self.D())));
+                a.add(next_eps);
+            },
+            .esum => {
+                inline for (.{ self.dev[0], self.dev[1], self.dev[2], self.dev[3] }) |p| a.add(p);
+                a.add(post_eps);
+                a.add(out);
+                inline for (.{ self.D(), slots, self.lo, self.outW() }) |v| a.add(@as(c_int, @intCast(v)));
+            },
+            else => {
+                const o = self.gateOuts(out, extra);
+                try mu.copy(&self.rig, o[0], self.dev[0], n * self.D() * 4);
+                inline for (.{ o[0], self.dev[1], self.dev[2], self.dev[3] }) |p| a.add(p);
+                a.add(@as(c_int, 1));
+                a.add(post_eps);
+                inline for (.{ self.dev[4], self.dev[5] }) |p| a.add(p);
+                a.add(next_eps);
+                inline for (.{ o[1], o[2] }) |p| a.add(p);
+                a.add(@as(c_int, @intCast(self.D())));
+            },
+        }
+        const grid: u32 = @intCast(if (cluster) n * 8 else n);
+        try cuda.launch.launch(f, .{ .grid = .{ .x = grid, .y = 1, .z = 1 }, .block = .{ .x = if (cluster) 128 else 1024 } }, s, &a);
+        try s.synchronize();
+    }
+
+    /// The family's launch: ops.gateNormAt / moe's expert sum (rowLaunch), forward's embed.
+    pub fn run(self: *Norm) !void {
+        return self.launch(self.f, self.cluster, self.dev[6], self.dev[7]);
+    }
+
+    pub fn count(self: *Norm) usize {
+        return self.shape.rows * self.outW();
+    }
+
+    /// Float64 outputs from the rounding point on; mag unused (bounds derives each allowance).
+    pub fn reference(self: *Norm, want: []f64, mag: []f64) !void {
+        if (self.kind == .embed) return self.r.?.reference(want, mag);
+        @memset(mag, 0);
+        return self.eval(.none, .sequential, want, null);
+    }
+
+    pub fn simulate(self: *Norm, acc: c.Accum, order: g.Order, out: []f64) !void {
+        if (self.kind == .embed) return self.r.?.simulate(acc, order, out);
+        return self.eval(acc, order, out, null);
+    }
+
+    /// Each output's allowance from first-order propagation of its fp32 roundings (doubled for the second order).
+    pub fn bounds(self: *Norm, want: []const f64, mag: []const f64, allow: []f64) !void {
+        _ = mag;
+        if (self.kind == .embed) return; // the rows family's bound, as registered
+        const tmp = try self.arena.allocator().alloc(f64, want.len);
+        try self.eval(.none, .sequential, tmp, allow);
+    }
+
+    fn sq(acc: c.Accum, order: g.Order, a: std.mem.Allocator, x: []const f64) !f64 {
+        const t = try a.alloc(f64, x.len);
+        defer a.free(t);
+        for (t, x) |*o, v| o.* = v * v;
+        return if (acc == .none) blk: {
+            var s: f64 = 0;
+            for (t) |v| s += v;
+            break :blk s;
+        } else rows.sumIn(acc, order, t);
+    }
+
+    /// Outputs with the sums in `acc` (none: float64), or (err non-null) each output's allowance.
+    fn eval(self: *Norm, acc: c.Accum, order: g.Order, out: []f64, err: ?[]f64) !void {
+        const a = self.rig.gpu.gpa;
+        const d = self.D();
+        const df: f64 = @floatFromInt(d);
+        const g1 = mu.gamma(@floatFromInt(rmsDepth(self.shape)));
+        const e_rs = 0.5 * g1 + 3 * mu.u + mu.fast; // ss / D, + eps, rsqrtf
+        const v = self.v;
+        if (self.kind == .esum) {
+            const accs = try a.alloc(f64, 2 * d);
+            defer a.free(accs);
+            const acc_v = accs[0..d];
+            const acc_e = accs[d..];
+            for (0..self.shape.rows) |r| {
+                @memset(accs, 0);
+                for (0..slots) |k| {
+                    const p = r * slots + k;
+                    const t = self.t[p * d ..][0..d];
+                    const rs = 1 / @sqrt(try sq(acc, order, a, t) / df + post_eps);
+                    for (acc_v, acc_e, t) |*o, *e, x| {
+                        o.* += x * rs * v[2][p];
+                        e.* += @abs(x * rs * v[2][p]) * (e_rs + 2 * mu.u + mu.gamma(slots));
+                    }
+                }
+                const w = self.outW();
+                for (0..w) |j| {
+                    out[r * w + j] = acc_v[self.lo + j];
+                    if (err) |e| e[r * w + j] = mu.allow(.f16, acc_v[self.lo + j], 2 * acc_e[self.lo + j]);
+                }
+            }
+            return;
+        }
+        const buf = try a.alloc(f64, 2 * d);
+        defer a.free(buf);
+        const hv = buf[0..d];
+        const he = buf[d..];
+        for (0..self.shape.rows) |r| {
+            const t = self.t[r * d ..][0..d];
+            const rs1 = 1 / @sqrt(try sq(acc, order, a, t) / df + post_eps);
+            var sh: f64 = 0;
+            for (hv, he, t, 0..) |*o, *e, x, i| {
+                const ra = v[0][r * d + i] * v[4][i];
+                const yb = x * rs1 * v[4][d + i];
+                o.* = ra + yb;
+                e.* = @abs(yb) * (e_rs + mu.u) + 3 * mu.u * (@abs(ra) + @abs(yb));
+                sh += 2 * @abs(o.*) * e.*;
+            }
+            const ss2 = try sq(acc, order, a, hv);
+            const rs2 = 1 / @sqrt(ss2 / df + next_eps);
+            const e_rs2 = 0.5 * (g1 + if (ss2 > 0) sh / ss2 else 0) + 3 * mu.u + mu.fast;
+            for (hv, he, 0..) |x, e, i| {
+                const o = x * rs2 * v[5][i];
+                const eo = @abs(rs2 * v[5][i]) * e + @abs(o) * (e_rs2 + 2 * mu.u);
+                const at = r * d + i;
+                switch (self.kind) {
+                    .gate_res => {
+                        out[at] = x;
+                        if (err) |el| el[at] = mu.allow(.f32, x, 2 * e);
+                    },
+                    .gate_x, .gate_xf => {
+                        out[at] = o;
+                        if (err) |el| el[at] = mu.allow(if (self.kind == .gate_x) .f16 else .f32, o, 2 * eo);
+                    },
+                    else => unreachable,
+                }
+            }
+        }
+    }
+
+    /// The 1,024-thread form on the same inputs, into fresh buffers poisoned as the rig's outputs are.
+    pub fn replaced(self: *Norm) ![]const u8 {
+        const d = self.rig.gpu.d;
+        const ob = self.count() * (if (spec(self.kind, false).out == .f16) @as(usize, 2) else 4);
+        var out = try cuda.DeviceBuffer.alloc(d, ob);
+        defer out.free();
+        try out.fill8(0xff, self.rig.s.handle);
+        var extra = try cuda.DeviceBuffer.alloc(d, self.shape.rows * self.D() * 8 + 4);
+        defer extra.free();
+        try self.launch(self.base.?, false, out.ptr, extra.ptr);
+        try self.host.resize(self.rig.gpu.gpa, ob);
+        try out.download(0, self.host.items);
+        return self.host.items;
+    }
+
+    pub fn check(self: *Norm, at: g.Gate) !?[]const u8 {
+        const a = self.rig.gpu.gpa;
+        const got = try a.dupe(u8, try self.rig.outputBytes());
+        defer a.free(got);
+        return mu.sameBytes(&self.msg, got, try self.replaced(), self.baseName(), spec(self.kind, false).out, at);
+    }
+
+    fn baseName(self: *const Norm) []const u8 {
+        return if (self.kind == .esum) "muse_expert_sum" else "muse_gate_norm";
+    }
+};
diff --git a/zig/tests/cuda/contract_muse_route.zig b/zig/tests/cuda/contract_muse_route.zig
new file mode 100644
index 00000000..0f07c99b
--- /dev/null
+++ b/zig/tests/cuda/contract_muse_route.zig
@@ -0,0 +1,344 @@
+//! Muse Spark's router and head glue under the contract: router, top 8, argmax, soft cap and the RoPE tables.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const mu = @import("contract_muse_util.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+const dense = core.contract.dense;
+
+fn noSums(_: c.Shape) usize {
+    return 0;
+}
+
+/// A lane's k / 32 products in order, then the warp's 32 lanes by halves.
+fn laneChain(s: c.Shape) usize {
+    return (s.k + 31) / 32 + 5;
+}
+
+pub const Kind = enum { router, topk, argmax, softcap, rope };
+
+const topk_rule = "the top 8 of sigmoid(logit * mult) + bias, ties to the lower expert, in expert order; weights " ++
+    "s / (sum s + 1e-15) * scale within 2^-20 of float64; a NaN score at expert e never leaves its tree node: e = 0 is " ++
+    "picked first (every weight NaN), any other e is never picked and hides the experts j = e mod 2^ceil(log2(e + 1))";
+const argmax_rule = "the first NaN, else the first maximum, over both ranks' slices up to the vocabulary";
+
+const top = 8;
+const mult: f32 = 0.17677669529663687; // output_multiplier
+const cap: f32 = 20; // final_logit_softcapping
+const theta: f64 = 500000;
+
+pub fn spec(kind: Kind) c.Spec {
+    return switch (kind) {
+        .router => .{ .name = "cuda muse muse_router (fp32 rows times bf16 weights)", .accum = .f32, .depth = laneChain, .out = .f32, .tiles = .{ .{}, .{ .size = 2 }, .{ .size = 256 } }, .served = &.{ .{ .rows = 8, .n = 256, .k = 8192 }, .{ .rows = 1, .n = 256, .k = 8192 } } },
+        .topk => .{ .name = "cuda muse muse_topk (sigmoid top 8 of 256)", .accum = .none, .depth = noSums, .out = .raw, .nan = .{ .stated = topk_rule }, .tiles = .{ .{}, .{ .size = 256, .step = 32, .min = 32 }, .{} }, .served = &.{ .{ .rows = 8, .n = 256, .k = top }, .{ .rows = 128, .n = 256, .k = top } } },
+        .argmax => .{ .name = "cuda muse muse_argmax (two ranks' head slices)", .accum = .none, .depth = noSums, .out = .raw, .nan = .{ .stated = argmax_rule }, .tiles = .{ .{}, .{ .size = 256 }, .{} }, .served = &.{ .{ .rows = 8, .n = 202048, .k = 101120 }, .{ .rows = 1, .n = 202048, .k = 101120 } } },
+        .softcap => .{ .name = "cuda muse muse_softcap (in place)", .accum = .none, .depth = noSums, .ops = 8, .out = .f32, .in_place = true, .tiles = .{ .{}, .{ .size = 256 }, .{} }, .served = &.{ .{ .rows = 8, .n = 101120, .k = 1 }, .{ .rows = 1, .n = 101120, .k = 1 } } },
+        .rope => .{ .name = "cuda muse muse_rope_tables (fp64 then fp32)", .accum = .none, .depth = noSums, .out = .f32, .tiles = .{ .{ .size = 65536 }, .{}, .{} }, .served = &.{ .{ .rows = 471040, .n = 64, .k = 1 }, .{ .rows = 8192, .n = 128, .k = 1 } } },
+    };
+}
+
+pub const Route = struct {
+    rig: rig_.Rig,
+    kind: Kind,
+    f: cuda.Function,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = undefined,
+    d: ?dense.Dense = null,
+    x: []f64 = &.{}, // logits, head slices or soft-cap inputs
+    bias: []f64 = &.{},
+    th: f64 = theta,
+    dev: [4]u64 = @splat(0),
+    msg: [200]u8 = undefined,
+
+    pub fn deinit(self: *Route) void {
+        if (self.d) |d| d.deinit();
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    const vt_ref = blk: {
+        var v = g.hooks(Route);
+        v.check = null;
+        break :blk v;
+    };
+    const vt_rule = g.hooks(Route);
+
+    pub fn kernel(self: *Route) g.Kernel {
+        const ruled = self.kind == .topk or self.kind == .argmax;
+        return .{ .spec = spec(self.kind), .ctx = self, .vt = if (ruled) &vt_rule else &vt_ref };
+    }
+
+    pub fn prepare(self: *Route, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.n == 0 or shape.k == 0) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        if (self.d) |d| d.deinit();
+        self.d = null;
+        self.shape = shape;
+        const a = self.arena.allocator();
+        const ga = self.rig.gpu.gpa;
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        const nf = fill == .nonfinite;
+        switch (self.kind) {
+            .router => {
+                const d = try dense.Dense.init(ga, shape, 1);
+                self.d = d;
+                d.fillX(fill, seed, 1);
+                const k = shape.k;
+                for (0..shape.n) |j| for (0..k) |i| {
+                    d.w[j * k + i] = if (fill != .stress) mu.uni(rng, u16, -1, 1) else if (i < k / 2) mu.int(rng, 1, 6) else -d.w[j * k + i - k / 2];
+                };
+                if (fill == .stress and k % 2 == 1) for (0..shape.n) |j| {
+                    d.w[j * k + k - 1] = 0;
+                };
+                const xs = try a.alloc(f64, d.x.len);
+                for (xs, d.x) |*o, b| o.* = c.fromBf16(b);
+                self.dev[0] = try mu.put(&self.rig, ga, f32, xs);
+                self.dev[1] = try mu.put(&self.rig, ga, u16, d.w);
+                self.dev[2] = try self.rig.output(shape.rows * shape.n * 4);
+            },
+            .topk => {
+                if (shape.n > 1024 or shape.k != top) return false;
+                self.x = try a.alloc(f64, shape.rows * shape.n);
+                self.bias = try a.alloc(f64, shape.n);
+                for (self.x) |*v| v.* = mu.int(rng, -64, 64) / 8; // eighths: some ties
+                for (self.bias) |*v| v.* = mu.int(rng, 0, 7) / 64;
+                if (nf) {
+                    self.x[3] = std.math.nan(f64); // never picked
+                    if (shape.rows > 1) self.x[shape.n] = std.math.nan(f64); // expert 0: the root keeps it
+                    if (shape.rows > 2) self.x[2 * shape.n + 5] = std.math.inf(f64);
+                    if (shape.rows > 3) self.x[3 * shape.n + 1] = -std.math.inf(f64);
+                }
+                self.dev[0] = try mu.put(&self.rig, ga, f32, self.x);
+                self.dev[1] = try mu.put(&self.rig, ga, f32, self.bias);
+                self.dev[2] = try self.rig.output(shape.rows * top * 4);
+                self.dev[3] = try self.rig.output(shape.rows * top * 4);
+            },
+            .argmax => {
+                const w0 = shape.k;
+                if (shape.n > 2 * w0) return false;
+                const w1: usize = if (shape.n > w0) w0 else 0; // rank 1's slice, padded as rank 0's
+                self.x = try a.alloc(f64, shape.rows * shape.n);
+                for (self.x) |*v| v.* = mu.int(rng, -1024, 1024) / 16; // sixteenths: ties
+                if (nf) {
+                    const n = shape.n;
+                    self.x[n / 2] = std.math.nan(f64);
+                    self.x[n - 1] = std.math.nan(f64); // the first NaN wins
+                    if (shape.rows > 1) self.x[n + n / 3] = std.math.inf(f64);
+                    if (shape.rows > 2) self.x[2 * n + 7] = -std.math.inf(f64);
+                }
+                // device layout: rank 0's [rows, w0], then rank 1's [rows, w1]; NaN past the vocabulary (never read)
+                const lay = try a.alloc(f64, shape.rows * (w0 + w1));
+                @memset(lay, std.math.nan(f64));
+                for (0..shape.rows) |r| for (0..shape.n) |col| {
+                    const at = if (col < w0) r * w0 + col else shape.rows * w0 + r * w1 + col - w0;
+                    lay[at] = self.x[r * shape.n + col];
+                };
+                self.dev[0] = try mu.put(&self.rig, ga, f32, lay);
+                self.dev[1] = try self.rig.output(shape.rows * 4);
+            },
+            .softcap => {
+                self.x = try a.alloc(f64, shape.rows * shape.n);
+                for (self.x) |*v| v.* = mu.uni(rng, f32, -400, 400);
+                if (nf) {
+                    self.x[1] = std.math.nan(f64);
+                    self.x[2] = std.math.inf(f64);
+                    self.x[3] = -std.math.inf(f64);
+                }
+                self.dev[0] = try mu.put(&self.rig, ga, f32, self.x);
+                self.dev[1] = try self.rig.output(self.x.len * 4);
+            },
+            .rope => {
+                if (shape.n % 2 != 0) return false;
+                self.th = if (nf) std.math.nan(f64) else theta; // column 0 stays finite: theta^0 = 1
+                const half = shape.rows * shape.n / 2;
+                self.dev[0] = try self.rig.output(2 * half * 4);
+            },
+        }
+        return true;
+    }
+
+    /// The family's launches (ops.moe, forward's head and tables).
+    pub fn run(self: *Route) !void {
+        const s = self.rig.s;
+        const sh = self.shape;
+        var a: cuda.Args = .{};
+        var grid: [2]u32 = .{ @intCast(sh.rows), 1 };
+        var block: u32 = 256;
+        switch (self.kind) {
+            .router => {
+                inline for (.{ self.dev[0], self.dev[1] }) |p| a.add(p);
+                a.add(@as(c_int, 1));
+                a.add(self.dev[2]);
+                inline for (.{ sh.k, sh.n }) |v| a.add(@as(c_int, @intCast(v)));
+                grid = .{ @intCast((sh.n + 1) / 2), @intCast(sh.rows) };
+                block = 64;
+            },
+            .topk => {
+                inline for (.{ self.dev[0], self.dev[1] }) |p| a.add(p);
+                inline for (.{ sh.n, top }) |v| a.add(@as(c_int, @intCast(v)));
+                a.add(mult);
+                a.add(@as(f32, 1));
+                inline for (.{ self.dev[2], self.dev[3] }) |p| a.add(p);
+                block = @intCast(std.math.ceilPowerOfTwo(usize, @max(sh.n, 32)) catch unreachable);
+            },
+            .argmax => {
+                inline for (.{ self.dev[0], self.dev[1] }) |p| a.add(p);
+                const w1: usize = if (sh.n > sh.k) sh.k else 0;
+                inline for (.{ sh.k, w1 }) |v| a.add(@as(c_int, @intCast(v)));
+                a.add(@as(i64, @intCast(sh.rows * sh.k)));
+                a.add(@as(c_int, @intCast(sh.n)));
+            },
+            .softcap => {
+                const n = sh.rows * sh.n;
+                try mu.copy(&self.rig, self.dev[1], self.dev[0], n * 4);
+                a.add(self.dev[1]);
+                a.add(@as(i64, @intCast(n)));
+                a.add(mult);
+                a.add(cap);
+                grid = .{ @intCast(@min((n + 255) / 256, 4096)), 1 };
+            },
+            .rope => {
+                const half = sh.rows * sh.n / 2;
+                a.add(self.dev[0]);
+                a.add(self.dev[0] + half * 4);
+                a.add(@as(c_int, @intCast(sh.rows)));
+                a.add(self.th);
+                a.add(@as(c_int, @intCast(sh.n)));
+                grid = .{ 256, 1 };
+            },
+        }
+        try cuda.launch.launch(self.f, .{ .grid = .{ .x = grid[0], .y = grid[1], .z = 1 }, .block = .{ .x = block } }, s, &a);
+        try s.synchronize();
+    }
+
+    pub fn count(self: *Route) usize {
+        const sh = self.shape;
+        return switch (self.kind) {
+            .router, .softcap, .rope => sh.rows * sh.n,
+            .topk => sh.rows * top * 8,
+            .argmax => sh.rows * 4,
+        };
+    }
+
+    pub fn reference(self: *Route, want: []f64, mag: []f64) !void {
+        switch (self.kind) {
+            .router => return self.d.?.reference(want, mag),
+            .softcap => for (want, mag, self.x) |*w, *m, x| {
+                const v = x * mult;
+                w.* = std.math.tanh(v / cap) * cap;
+                m.* = 0;
+            },
+            .rope => {
+                const half = self.shape.n / 2;
+                const nh = self.shape.rows * half;
+                for (0..nh) |i| {
+                    const ang = self.angle(i);
+                    want[i] = @cos(ang);
+                    want[nh + i] = @sin(ang);
+                    mag[i] = 0;
+                    mag[nh + i] = 0;
+                }
+            },
+            .topk, .argmax => return error.StatedRule, // gates 1 and 3 run check; no sums for gate 4
+        }
+    }
+
+    fn angle(self: *const Route, i: usize) f64 {
+        const half = self.shape.n / 2;
+        const j: f64 = @floatFromInt(i % half);
+        const p: f64 = @floatFromInt(i / half);
+        return p * (1 / std.math.pow(f64, self.th, 2 * j / @as(f64, @floatFromInt(self.shape.n))));
+    }
+
+    /// The tables: fp64 pow / cos / sin within a few double ulps of the angle; the soft cap's x / cap and tanhf.
+    pub fn bounds(self: *Route, want: []const f64, mag: []const f64, allow: []f64) !void {
+        _ = mag;
+        if (self.kind != .rope) return;
+        const nh = want.len / 2;
+        for (allow, want, 0..) |*l, w, i| l.* = mu.allow(.f32, w, 0x1p-50 * (@abs(self.angle(i % nh)) + 1));
+    }
+
+    pub fn simulate(self: *Route, acc: c.Accum, order: g.Order, out: []f64) !void {
+        if (self.kind != .router) return error.NoSums;
+        return self.d.?.simulate(acc, order, out);
+    }
+
+    /// Expert e's sigmoid and rank score under the stated NaN rule (expert 0 first; a NaN node hides its leaves).
+    fn score(self: *const Route, r: usize, e: usize) [2]f64 {
+        const row = self.x[r * self.shape.n ..][0..self.shape.n];
+        const s = 1 / (1 + @exp(-(row[e] * mult)));
+        const v = s + self.bias[e];
+        if (std.math.isNan(v)) return .{ s, if (e == 0) std.math.inf(f64) else -std.math.inf(f64) };
+        for (row[1..], 1..) |x, j| if (std.math.isNan(x) and j != e) {
+            const span = std.math.ceilPowerOfTwo(usize, j + 1) catch unreachable;
+            if (e % span == j % span) return .{ s, -std.math.inf(f64) };
+        };
+        return .{ s, v };
+    }
+
+    pub fn check(self: *Route, _: g.Gate) !?[]const u8 {
+        return if (self.kind == .topk) self.checkTopk() else self.checkArgmax();
+    }
+
+    fn checkTopk(self: *Route) !?[]const u8 {
+        const a = self.rig.gpu.gpa;
+        const n = self.shape.n;
+        const ids = try a.dupe(u8, try self.rig.bytes(self.dev[2], self.shape.rows * top * 4));
+        defer a.free(ids);
+        const wts = try self.rig.bytes(self.dev[3], self.shape.rows * top * 4);
+        for (0..self.shape.rows) |r| {
+            var taken = std.StaticBitSet(1024).empty;
+            var pick: [top]usize = undefined;
+            var prev: i64 = -1;
+            for (&pick, 0..) |*p, k| {
+                const id = std.mem.readInt(i32, ids[(r * top + k) * 4 ..][0..4], .little);
+                if (id < 0 or id >= n or id <= prev) return try std.fmt.bufPrint(&self.msg, "row {d} pick {d}: expert {d} out of range or out of order", .{ r, k, id });
+                prev = id;
+                p.* = @intCast(id);
+                taken.set(p.*);
+            }
+            var lowest: f64 = std.math.inf(f64);
+            var sum: f64 = 0;
+            for (pick) |p| {
+                lowest = @min(lowest, self.score(r, p)[1]);
+                sum += self.score(r, p)[0];
+            }
+            for (0..n) |e| if (!taken.isSet(e)) {
+                const v = self.score(r, e)[1];
+                const tol = 0x1p-20 * (@abs(lowest) + 1);
+                if (v > lowest + tol) return try std.fmt.bufPrint(&self.msg, "row {d}: expert {d} scores {d:.6} over a pick's {d:.6}", .{ r, e, v, lowest });
+                if (v == lowest) for (pick) |p| if (p > e and self.score(r, p)[1] == v)
+                    return try std.fmt.bufPrint(&self.msg, "row {d}: expert {d} picked over tied expert {d}", .{ r, p, e });
+            };
+            for (pick, 0..) |p, k| {
+                const w: f64 = @as(f32, @bitCast(std.mem.readInt(u32, wts[(r * top + k) * 4 ..][0..4], .little)));
+                const want = self.score(r, p)[0] / (sum + 1e-15);
+                const ok = if (std.math.isFinite(want)) @abs(w - want) <= 0x1p-20 * @abs(want) + 1e-30 else c.classOf(w) == c.classOf(want);
+                if (!ok) return try std.fmt.bufPrint(&self.msg, "row {d} slot {d}: weight {d:.7} where float64 gives {d:.7}", .{ r, k, w, want });
+            }
+        }
+        return null;
+    }
+
+    fn checkArgmax(self: *Route) !?[]const u8 {
+        const got = try self.rig.bytes(self.dev[1], self.shape.rows * 4);
+        const n = self.shape.n;
+        for (0..self.shape.rows) |r| {
+            const row = self.x[r * n ..][0..n];
+            var best: usize = 0;
+            for (row, 0..) |v, i| {
+                const b = row[best];
+                if (std.math.isNan(b)) break;
+                if (std.math.isNan(v) or v > b) best = i;
+            }
+            const id = std.mem.readInt(i32, got[r * 4 ..][0..4], .little);
+            if (id != @as(i32, @intCast(best))) return try std.fmt.bufPrint(&self.msg, "row {d}: column {d} where the rule gives {d}", .{ r, id, best });
+        }
+        return null;
+    }
+};
diff --git a/zig/tests/cuda/contract_muse_select.zig b/zig/tests/cuda/contract_muse_select.zig
new file mode 100644
index 00000000..b1b92db2
--- /dev/null
+++ b/zig/tests/cuda/contract_muse_select.zig
@@ -0,0 +1,472 @@
+//! Muse Spark's DFlash2 ops under the contract (dflash2.cu): dense rows, causal convs, SiLU-mul, top 16, the walk.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const mu = @import("contract_muse_util.zig");
+
+const c = core.contract.spec;
+const g = core.contract.gates;
+const rows = core.contract.rows;
+const dense = core.contract.dense;
+
+const B = 8; // block_size
+const KT = 2; // conv_kernel_size
+const GS = 16; // conv_group_size
+const TOPK = 16;
+const P = B - 1; // drafted rows a stream
+const V = 512; // the fixture's vocabulary (codebook rows)
+const none_id: i32 = 0x7fffffff;
+
+fn noSums(_: c.Shape) usize {
+    return 0;
+}
+
+/// A lane's K / 32 products in order, then the warp by halves.
+fn laneChain(s: c.Shape) usize {
+    return (s.k + 31) / 32 + 5;
+}
+
+/// KT products chained, after w = base + dyn (and y = y0 + y1, then the residual's add).
+fn prepDepth(_: c.Shape) usize {
+    return KT + 1;
+}
+
+fn finishDepth(_: c.Shape) usize {
+    return KT + 3;
+}
+
+pub const Kind = enum { dense_f32, dense_f16, conv_prep, conv_finish, silu, topk, walk };
+
+const topk_rule = "a row's top 16 valid columns by value, ties to the lower global id, a NaN never a candidate; missing " ++
+    "places -inf with id 0x7fffffff; values and ids exact";
+const walk_rule = "per stream, each row's 16 best of the ranks' merged lists (valid ids only, ties to the lower id), " ++
+    "scored v + sum_k pcb[prev, k] g[k] scb[c, k]; the first maximum is within fp32's sum bound of float64's first maximum " ++
+    "(a NaN score never displaces candidate 0); no valid candidate repeats the previous token";
+
+pub fn spec(kind: Kind) c.Spec {
+    const dn = &[_]c.Shape{ .{ .rows = 56, .n = 2048, .k = 8192 }, .{ .rows = 7, .n = 256, .k = 8192 } };
+    const conv = &[_]c.Shape{ .{ .rows = 4, .n = 8192, .k = KT }, .{ .rows = 1, .n = 8192, .k = KT } };
+    return switch (kind) {
+        .dense_f32 => .{ .name = "cuda muse dfl_dense (bf16 weights, fp32 out)", .accum = .f32, .depth = laneChain, .out = .f32, .tiles = .{ .{ .size = 8 }, .{ .size = 8 }, .{ .size = 32 } }, .served = dn },
+        .dense_f16 => .{ .name = "cuda muse dfl_dense (bf16 weights, fp16 out)", .accum = .f32, .depth = laneChain, .out = .f16, .tiles = .{ .{ .size = 8 }, .{ .size = 8 }, .{ .size = 32 } }, .served = dn },
+        .conv_prep => .{ .name = "cuda muse dfl_conv_prep (grouped dynamic causal conv in, fp16)", .accum = .f32, .depth = prepDepth, .out = .f16, .tiles = .{ .{}, .{ .size = 256, .step = GS, .min = GS }, .{} }, .served = conv },
+        .conv_finish => .{ .name = "cuda muse dfl_conv_finish (into the residual, in place)", .accum = .f32, .depth = finishDepth, .out = .f32, .in_place = true, .tiles = .{ .{}, .{ .size = 256, .step = GS, .min = GS }, .{} }, .served = conv },
+        .silu => .{ .name = "cuda muse dfl_silu_mul (fp16 interm)", .accum = .none, .depth = noSums, .ops = 8, .out = .f16, .tiles = .{ .{}, .{ .size = 256 }, .{} }, .served = &.{ .{ .rows = 56, .n = 14336, .k = 1 }, .{ .rows = 7, .n = 14336, .k = 1 } } },
+        .topk => .{ .name = "cuda muse dfl_topk (a rank's top 16 of its head slice)", .accum = .none, .depth = noSums, .out = .raw, .nan = .{ .stated = topk_rule }, .tiles = .{ .{}, .{ .size = 256 }, .{} }, .served = &.{ .{ .rows = 28, .n = 101120, .k = 101120 }, .{ .rows = 7, .n = 101120, .k = 100928 } } },
+        .walk => .{ .name = "cuda muse dfl_walk (the candidate selector, greedy)", .accum = .none, .depth = noSums, .out = .raw, .nan = .{ .stated = walk_rule }, .tiles = .{ .{}, .{}, .{ .size = 32, .step = 32, .min = 32 } }, .served = &.{ .{ .rows = 4, .n = 2, .k = 256 }, .{ .rows = 1, .n = 2, .k = 256 } } },
+    };
+}
+
+pub const Sel = struct {
+    rig: rig_.Rig,
+    kind: Kind,
+    f: cuda.Function,
+    arena: std.heap.ArenaAllocator,
+    shape: c.Shape = undefined,
+    d: ?dense.Dense = null,
+    in: [6][]f64 = @splat(&.{}),
+    ids: []i32 = &.{},
+    anchors: []i64 = &.{},
+    dev: [9]u64 = @splat(0),
+    msg: [200]u8 = undefined,
+
+    pub fn deinit(self: *Sel) void {
+        if (self.d) |d| d.deinit();
+        self.arena.deinit();
+        self.rig.deinit();
+    }
+
+    const vt_ref = blk: {
+        var v = g.hooks(Sel);
+        v.check = null;
+        break :blk v;
+    };
+    const vt_rule = g.hooks(Sel);
+
+    pub fn kernel(self: *Sel) g.Kernel {
+        const ruled = self.kind == .topk or self.kind == .walk;
+        return .{ .spec = spec(self.kind), .ctx = self, .vt = if (ruled) &vt_rule else &vt_ref };
+    }
+
+    fn rnd(self: *Sel, rng: std.Random, comptime T: type, n: usize, lo: f64, hi: f64) ![]f64 {
+        const x = try self.arena.allocator().alloc(f64, n);
+        for (x) |*v| v.* = mu.uni(rng, T, lo, hi);
+        return x;
+    }
+
+    fn convRows(self: *const Sel) usize {
+        return self.shape.rows * B;
+    }
+
+    pub fn prepare(self: *Sel, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.n == 0 or shape.k == 0) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        if (self.d) |d| d.deinit();
+        self.d = null;
+        self.shape = shape;
+        const a = self.arena.allocator();
+        const ga = self.rig.gpu.gpa;
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        const nf = fill == .nonfinite;
+        const st = fill == .stress;
+        const nan = std.math.nan(f64);
+        const inf = std.math.inf(f64);
+        switch (self.kind) {
+            .dense_f32, .dense_f16 => {
+                const d = try dense.Dense.init(ga, shape, 1);
+                self.d = d;
+                d.fillX(fill, seed, 1);
+                for (d.x) |*b| if (@abs(c.fromBf16(b.*)) < 0x1p-14) { // fp16 holds the rest exactly
+                    b.* = 0;
+                };
+                const k = shape.k;
+                for (0..shape.n) |j| for (0..k) |i| {
+                    d.w[j * k + i] = if (!st) mu.uni(rng, u16, -1, 1) else if (i < k / 2) mu.int(rng, 1, 6) else -d.w[j * k + i - k / 2];
+                };
+                if (st and k % 2 == 1) for (0..shape.n) |j| {
+                    d.w[j * k + k - 1] = 0;
+                };
+                const xs = try a.alloc(f64, d.x.len);
+                for (xs, d.x) |*o, b| o.* = c.fromBf16(b);
+                self.dev[0] = try mu.put(&self.rig, ga, f16, xs);
+                self.dev[1] = try mu.put(&self.rig, ga, u16, d.w);
+                self.dev[2] = try self.rig.output(shape.rows * shape.n * (if (self.kind == .dense_f32) @as(usize, 4) else 2));
+            },
+            .conv_prep, .conv_finish => {
+                if (shape.k != KT or shape.n % GS != 0) return false;
+                const R = self.convRows();
+                const D = shape.n;
+                const G = D / GS;
+                self.in[0] = try a.alloc(f64, 2 * KT * D); // base (prep), then base1 (finish)
+                self.in[1] = try a.alloc(f64, R * 2 * KT * G); // dyn
+                for (self.in[0], 0..) |*v, i| v.* = if (st) 512 + @as(f64, @floatFromInt(i / D % KT)) else mu.uni(rng, f32, -1, 1);
+                for (self.in[1], 0..) |*v, i| v.* = if (!st) mu.uni(rng, f16, -0.5, 0.5) else if (i / G % KT == 0) mu.int(rng, 0, 3) else self.in[1][i - G];
+                const h0 = try a.alloc(f64, D);
+                for (h0) |*v| v.* = mu.int(rng, 33, 63);
+                // h (prep, fp16) or y0, y1 (finish, fp32) and res: gate 4's rows alternate sign within a block
+                self.in[2] = if (self.kind == .conv_prep) try self.rnd(rng, f16, R * D, -4, 4) else try self.rnd(rng, f32, R * D, -4, 4);
+                self.in[3] = try self.rnd(rng, f32, R * D, -4, 4);
+                self.in[4] = try self.rnd(rng, f32, R * D, -64, 64);
+                if (st) for (0..R) |r| for (0..D) |i| {
+                    const y = if (r % B % 2 == 0) h0[i] else -h0[i];
+                    self.in[3][r * D + i] = mu.int(rng, -8, 8);
+                    self.in[2][r * D + i] = if (self.kind == .conv_prep) y else y - self.in[3][r * D + i];
+                    self.in[4][r * D + i] = mu.int(rng, -64, 64);
+                };
+                if (nf) {
+                    self.in[2][3] = nan; // rows 0 and 1, column 3
+                    self.in[1][2 * 2 * KT * G + 1] = inf; // row 2's first tap, group 1
+                    self.in[0][(if (self.kind == .conv_prep) 0 else KT * D) + D + 7] = -inf; // the second tap, column 7
+                }
+                self.dev[0] = try mu.put(&self.rig, ga, f32, self.in[0]);
+                self.dev[1] = try mu.put(&self.rig, ga, f16, self.in[1]);
+                if (self.kind == .conv_prep) {
+                    self.dev[2] = try mu.put(&self.rig, ga, f16, self.in[2]);
+                    self.dev[3] = try self.rig.output(R * D * 2);
+                } else {
+                    for (2..5) |i| self.dev[i] = try mu.put(&self.rig, ga, f32, self.in[i]);
+                    self.dev[5] = try self.rig.output(R * D * 4);
+                }
+            },
+            .silu => {
+                const n = shape.rows * shape.n;
+                self.in[0] = try self.rnd(rng, f16, n, -8, 8);
+                self.in[1] = try self.rnd(rng, f16, n, -4, 4);
+                if (nf) {
+                    self.in[0][1] = nan;
+                    self.in[0][2] = inf;
+                    self.in[0][3] = -inf; // -inf / (1 + inf): NaN, as float64 gives it
+                    self.in[1][4] = inf;
+                }
+                self.dev[0] = try mu.put(&self.rig, ga, f16, self.in[0]);
+                self.dev[1] = try mu.put(&self.rig, ga, f16, self.in[1]);
+                self.dev[2] = try self.rig.output(n * 2);
+            },
+            .topk => {
+                self.in[0] = try a.alloc(f64, shape.rows * shape.n);
+                for (self.in[0]) |*v| v.* = mu.int(rng, -2048, 2048) / 32; // ties
+                if (nf) {
+                    self.in[0][0] = nan;
+                    if (shape.rows > 1) self.in[0][shape.n + 3] = inf;
+                    if (shape.rows > 2) for (self.in[0][2 * shape.n ..][0..shape.n]) |*v| {
+                        v.* = if (rng.boolean()) nan else -inf; // fewer than 16 numbers: -inf ids, then the empty places
+                    };
+                }
+                self.dev[0] = try mu.put(&self.rig, ga, f32, self.in[0]);
+                self.dev[1] = try self.rig.output(shape.rows * 2 * TOPK * 4);
+            },
+            .walk => return self.prepareWalk(fill, rng),
+        }
+        return true;
+    }
+
+    /// recv [ranks][rows][32] (each rank's top 16 values, then ids as bits), gate [rows, R], codebooks [V, R].
+    fn prepareWalk(self: *Sel, fill: g.Fill, rng: std.Random) !bool {
+        const sh = self.shape;
+        if (sh.k % 32 != 0 or sh.k > 1024 or sh.n == 0 or sh.n > 4) return false;
+        const a = self.arena.allocator();
+        const ga = self.rig.gpu.gpa;
+        const n1 = sh.rows * P;
+        const R = sh.k;
+        self.in[0] = try a.alloc(f64, sh.n * n1 * TOPK);
+        self.ids = try a.alloc(i32, sh.n * n1 * TOPK);
+        const span = V / sh.n;
+        for (0..sh.n) |q| for (0..n1) |r| {
+            var top: f64 = mu.int(rng, 0, 64) / 4;
+            for (0..TOPK) |j| {
+                const at = (q * n1 + r) * TOPK + j;
+                self.in[0][at] = top;
+                top -= mu.int(rng, 0, 4) / 8; // descending, some ties
+                self.ids[at] = @intCast(q * span + (r * 37 + j * 11) % span); // each rank's own slice of ids
+            }
+        };
+        self.in[1] = try self.rnd(rng, f16, n1 * R, -1, 1);
+        self.in[2] = try self.rnd(rng, u16, V * R, -1, 1);
+        self.in[3] = try self.rnd(rng, u16, V * R, -1, 1);
+        if (fill == .nonfinite) {
+            self.in[1][5] = std.math.nan(f64); // row 0: every score NaN, candidate 0 kept
+            if (n1 > 1) self.in[0][(sh.n - 1) * n1 * TOPK + TOPK + 3] = std.math.inf(f64); // row 1: one candidate +inf
+            if (n1 > 2) for (0..sh.n) |q| for (0..TOPK) |j| {
+                self.ids[(q * n1 + 2) * TOPK + j] = none_id; // row 2: no candidate
+            };
+        }
+        self.anchors = try a.alloc(i64, sh.rows);
+        for (self.anchors) |*x| x.* = rng.uintLessThan(u32, V);
+        const recv = try a.alloc(f32, sh.n * n1 * 2 * TOPK);
+        for (0..sh.n * n1) |r| for (0..TOPK) |j| {
+            recv[r * 2 * TOPK + j] = @floatCast(self.in[0][r * TOPK + j]);
+            recv[r * 2 * TOPK + TOPK + j] = @bitCast(self.ids[r * TOPK + j]);
+        };
+        self.dev[0] = try mu.ints(&self.rig, f32, recv);
+        self.dev[1] = try mu.put(&self.rig, ga, f16, self.in[1]);
+        self.dev[2] = try mu.put(&self.rig, ga, u16, self.in[2]);
+        self.dev[3] = try mu.put(&self.rig, ga, u16, self.in[3]);
+        self.dev[4] = try mu.ints(&self.rig, i64, self.anchors);
+        self.dev[5] = try self.rig.output(n1 * 4);
+        return true;
+    }
+
+    /// dflash2.zig's launches.
+    pub fn run(self: *Sel) !void {
+        const s = self.rig.s;
+        const sh = self.shape;
+        const d = self.dev;
+        var a: cuda.Args = .{};
+        var grid: [2]u32 = .{ @intCast(sh.rows), 1 };
+        var block: u32 = 256;
+        switch (self.kind) {
+            .dense_f32, .dense_f16 => {
+                inline for (.{ d[0], d[1] }) |p| a.add(p);
+                a.add(@as(c_int, 1));
+                a.add(d[2]);
+                a.add(@as(c_int, @intFromBool(self.kind == .dense_f32)));
+                inline for (.{ sh.rows, sh.k, sh.n }) |v| a.add(@as(c_int, @intCast(v)));
+                grid = .{ @intCast((sh.n + 7) / 8), @intCast((sh.rows + 7) / 8) };
+            },
+            .conv_prep => {
+                inline for (.{ d[2], d[1], d[0], d[3] }) |p| a.add(p);
+                inline for (.{ B, sh.n, KT, GS }) |v| a.add(@as(c_int, @intCast(v)));
+                grid[0] = @intCast(self.convRows());
+            },
+            .conv_finish => {
+                try mu.copy(&self.rig, d[5], d[4], self.convRows() * sh.n * 4);
+                inline for (.{ d[5], d[2], d[3], d[1], d[0] + KT * sh.n * 4 }) |p| a.add(p);
+                inline for (.{ B, sh.n, KT, GS }) |v| a.add(@as(c_int, @intCast(v)));
+                grid[0] = @intCast(self.convRows());
+            },
+            .silu => {
+                const n = sh.rows * sh.n;
+                inline for (.{ d[0], d[1], d[2] }) |p| a.add(p);
+                a.add(@as(i64, @intCast(n)));
+                grid[0] = @intCast(@min((n + 255) / 256, 4096));
+            },
+            .topk => {
+                a.add(d[0]);
+                const lo: usize = if (sh.k < sh.n) sh.n else 0; // rank 1's slice: its global ids from lo
+                inline for (.{ sh.n, @min(sh.k, sh.n), lo }) |v| a.add(@as(c_int, @intCast(v)));
+                a.add(d[1]);
+            },
+            .walk => {
+                a.add(d[0]);
+                inline for (.{ sh.n, sh.rows * P }) |v| a.add(@as(c_int, @intCast(v)));
+                a.add(d[1]);
+                a.add(@as(c_int, @intCast(sh.k)));
+                inline for (.{ d[2], d[3] }) |p| a.add(p);
+                a.add(@as(c_int, 1));
+                a.add(d[4]);
+                a.add(@as(c_int, P));
+                a.add(d[5]);
+                block = 512;
+            },
+        }
+        try cuda.launch.launch(self.f, .{ .grid = .{ .x = grid[0], .y = grid[1], .z = 1 }, .block = .{ .x = block } }, s, &a);
+        try s.synchronize();
+    }
+
+    pub fn count(self: *Sel) usize {
+        const sh = self.shape;
+        return switch (self.kind) {
+            .dense_f32, .dense_f16, .silu => sh.rows * sh.n,
+            .conv_prep, .conv_finish => self.convRows() * sh.n,
+            .topk => sh.rows * 2 * TOPK * 4,
+            .walk => sh.rows * P * 4,
+        };
+    }
+
+    pub fn reference(self: *Sel, want: []f64, mag: []f64) !void {
+        switch (self.kind) {
+            .dense_f32, .dense_f16 => return self.d.?.reference(want, mag),
+            .conv_prep, .conv_finish => return self.conv(.none, .sequential, want, mag),
+            .silu => for (want, mag, self.in[0], self.in[1]) |*w, *m, x, uu| {
+                w.* = x / (1 + @exp(-x)) * uu;
+                m.* = 0;
+            },
+            .topk, .walk => return error.StatedRule, // gates 1 and 3 run check; no sums for gate 4
+        }
+    }
+
+    pub fn simulate(self: *Sel, acc: c.Accum, order: g.Order, out: []f64) !void {
+        return switch (self.kind) {
+            .dense_f32, .dense_f16 => self.d.?.simulate(acc, order, out),
+            .conv_prep, .conv_finish => self.conv(acc, order, out, null),
+            else => error.NoSums,
+        };
+    }
+
+    /// Each output's KT terms (and the residual, finish) summed in `acc`; their magnitude into mag.
+    fn conv(self: *Sel, acc: c.Accum, order: g.Order, out: []f64, mag: ?[]f64) !void {
+        const D = self.shape.n;
+        const G = D / GS;
+        const fin = self.kind == .conv_finish;
+        const base = self.in[0][if (fin) KT * D else 0..];
+        var t: [KT + 1]f64 = undefined;
+        for (0..self.convRows()) |r| for (0..D) |col| {
+            const b = r % B;
+            var n: usize = 0;
+            for (0..@min(KT, b + 1)) |tt| {
+                const w = base[tt * D + col] + self.in[1][r * 2 * KT * G + (if (fin) KT * G else 0) + tt * G + col / GS];
+                const at = (r - tt) * D + col;
+                const y = if (fin) self.in[2][at] + self.in[3][at] else self.in[2][at];
+                t[n] = w * y;
+                n += 1;
+            }
+            const at = r * D + col;
+            var s = if (acc == .none) blk: {
+                var x: f64 = 0;
+                for (t[0..n]) |v| x += v;
+                break :blk x;
+            } else rows.sumIn(acc, order, t[0..n]);
+            var m: f64 = 0;
+            for (t[0..n]) |v| m += @abs(v);
+            if (fin) {
+                s += self.in[4][at];
+                m += @abs(self.in[4][at]);
+            }
+            out[at] = s;
+            if (mag) |x| x[at] = m;
+        };
+    }
+
+    pub fn check(self: *Sel, _: g.Gate) !?[]const u8 {
+        return if (self.kind == .topk) self.checkTopk() else self.checkWalk();
+    }
+
+    fn beats(va: f64, ia: i64, vb: f64, ib: i64) bool {
+        return va > vb or (va == vb and ia < ib);
+    }
+
+    fn checkTopk(self: *Sel) !?[]const u8 {
+        const sh = self.shape;
+        const got = try self.rig.bytes(self.dev[1], sh.rows * 2 * TOPK * 4);
+        const lo: i64 = if (sh.k < sh.n) @intCast(sh.n) else 0;
+        for (0..sh.rows) |r| {
+            var v: [TOPK]f64 = @splat(-std.math.inf(f64));
+            var id: [TOPK]i64 = @splat(none_id);
+            for (self.in[0][r * sh.n ..][0..@min(sh.k, sh.n)], 0..) |x, col| {
+                const gid = lo + @as(i64, @intCast(col));
+                if (std.math.isNan(x) or !beats(x, gid, v[TOPK - 1], id[TOPK - 1])) continue;
+                var k: usize = TOPK - 1;
+                while (k > 0 and beats(x, gid, v[k - 1], id[k - 1])) : (k -= 1) {
+                    v[k] = v[k - 1];
+                    id[k] = id[k - 1];
+                }
+                v[k] = x;
+                id[k] = gid;
+            }
+            for (0..TOPK) |k| {
+                const gv: f64 = @as(f32, @bitCast(std.mem.readInt(u32, got[(r * 2 * TOPK + k) * 4 ..][0..4], .little)));
+                const gi = std.mem.readInt(i32, got[(r * 2 * TOPK + TOPK + k) * 4 ..][0..4], .little);
+                if (gv != v[k] or gi != id[k]) return try std.fmt.bufPrint(&self.msg, "row {d} place {d}: ({d}, {d}) where the rule gives ({d}, {d})", .{ r, k, gv, gi, v[k], id[k] });
+            }
+        }
+        return null;
+    }
+
+    fn checkWalk(self: *Sel) !?[]const u8 {
+        const sh = self.shape;
+        const n1 = sh.rows * P;
+        const R = sh.k;
+        const got = try self.rig.bytes(self.dev[5], n1 * 4);
+        for (0..sh.rows) |s| {
+            var pred: i64 = self.anchors[s];
+            for (0..P) |i| {
+                const row = s * P + i;
+                var cv: [TOPK]f64 = undefined;
+                var cid: [TOPK]i64 = @splat(-1);
+                var used = std.StaticBitSet(64).empty;
+                for (0..TOPK) |k| {
+                    var best: ?usize = null;
+                    for (0..sh.n * TOPK) |j| {
+                        const at = ((j / TOPK) * n1 + row) * TOPK + j % TOPK;
+                        const id = self.ids[at];
+                        if (used.isSet(j) or id < 0 or id == none_id) continue;
+                        if (best == null) best = j else {
+                            const bt = ((best.? / TOPK) * n1 + row) * TOPK + best.? % TOPK;
+                            if (beats(self.in[0][at], id, self.in[0][bt], self.ids[bt])) best = j;
+                        }
+                    }
+                    cv[k] = -std.math.inf(f64);
+                    if (best) |j| {
+                        const at = ((j / TOPK) * n1 + row) * TOPK + j % TOPK;
+                        used.set(j);
+                        cv[k] = self.in[0][at];
+                        cid[k] = self.ids[at];
+                    }
+                }
+                var sc: [TOPK]f64 = undefined;
+                var tol: [TOPK]f64 = undefined;
+                for (0..TOPK) |k| {
+                    sc[k] = -std.math.inf(f64);
+                    tol[k] = 0;
+                    if (cid[k] < 0) continue;
+                    var acc: f64 = 0;
+                    var mag: f64 = 0;
+                    for (0..R) |j| {
+                        const t = self.in[2][@as(usize, @intCast(pred)) * R + j] * self.in[1][row * R + j] * self.in[3][@as(usize, @intCast(cid[k])) * R + j];
+                        acc += t;
+                        mag += @abs(t);
+                    }
+                    sc[k] = cv[k] + acc;
+                    tol[k] = mu.gamma(@floatFromInt(R / 32 + 8)) * mag + mu.u * @abs(cv[k]);
+                }
+                var best: usize = 0;
+                for (1..TOPK) |k| if (sc[k] > sc[best]) {
+                    best = k;
+                };
+                const out: i64 = std.mem.readInt(i32, got[row * 4 ..][0..4], .little);
+                const want = if (cid[best] >= 0) cid[best] else pred;
+                if (out != want) {
+                    const k = for (0..TOPK) |x| {
+                        if (cid[x] == out) break x;
+                    } else return try std.fmt.bufPrint(&self.msg, "stream {d} row {d}: {d} is no candidate (rule: {d})", .{ s, i, out, want });
+                    if (!(sc[k] >= sc[best] - tol[k] - tol[best])) return try std.fmt.bufPrint(&self.msg, "stream {d} row {d}: {d} scores {d:.6} under the best {d:.6}", .{ s, i, out, sc[k], sc[best] });
+                }
+                pred = out;
+            }
+        }
+        return null;
+    }
+};
