From a78c6fbfa1fa6d8ee6ae4a63f45a97e4d8798246 Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Sun, 18 Oct 2026 11:00:24 +1100
Subject: [PATCH] conversion: requant_dense, dense-only requantization of an
 EXL3 pack

Requantizes the dense linears of every decoder block (every Linear in a block
that is not a routed expert: attention q/k/v/o/gate and the latent MoE's
pre/post expert projections on Muse Spark) at new bitrates, with per-tensor
fnmatch overrides, and keeps every other tensor of a base EXL3 pack: experts,
embedding, norms, router, gates, expert bias, head.

Per block, the converter's own steps restricted to the dense linears: load
(dense linears unquantized from --dense_src, the rest from the base pack;
expert qmaps cleared so experts never capture), capture with top-k routing,
quantize through convert_model.quantize_linears_parallel (same grouping and
seeds), optionally the base pack's dense tensors on the reference rows
(rfn_base), then reload with the new tensors and advance the calibration
state. Calibration rows are batched (--batch). Checkpoints use the converter's
job format, so a converter checkpoint seeds a job (--seed) and --layers a-b
splits one run over machines (--advance_base reaches layer a with the base
pack's tensors). Writes <work>/qtensors/<block>.safetensors with the dense
tensors only, report.jsonl and requant-done.json; the pack is assembled from
the base pack by a separate byte-copy step.
---
 exllamav3/conversion/requant_dense.py | 602 ++++++++++++++++++++++++++
 1 file changed, 602 insertions(+)
 create mode 100644 exllamav3/conversion/requant_dense.py

diff --git a/exllamav3/conversion/requant_dense.py b/exllamav3/conversion/requant_dense.py
new file mode 100644
index 0000000..36067c3
--- /dev/null
+++ b/exllamav3/conversion/requant_dense.py
@@ -0,0 +1,602 @@
+"""
+Dense-only requantization of an existing EXL3 pack.
+
+Requantizes the dense linears of every decoder block (attention q/k/v/o/gate and the latent MoE's pre/post expert
+projections on Muse Spark: every Linear in a block that is not a routed expert) at new bitrates, and keeps every other
+tensor of the base pack: routed experts, embedding, norms, router, residual gates, expert score bias, head. Built for
+packs whose expert matrices dominate the conversion time (Muse Spark Open: 768 expert matrices a layer, ~62 min a
+layer in the full converter), where only the dense bits change.
+
+Per block, in order, the same steps as the converter's main loop (convert_model.py), restricted to the dense linears:
+
+  1. Load the block: dense linears unquantized from --dense_src (their source `.weight`), everything else from the
+     base pack (EXL3 experts, norms, router). Routed experts never capture Hessians (their qmaps are cleared), the
+     router picks the usual top-k (no all-experts pass).
+  2. Capture pass over the calibration state: Hessians of the dense inputs only (attention input, o_proj input,
+     latent pre-projection input, latent post-projection input), and the reference output of the first rows.
+  3. Quantize the dense linears (convert_model.quantize_linears_parallel, the converter's own path and seeds) at
+     --bits, with per-tensor --override patterns, and save them to <work>/qtensors/<block key>.safetensors (dense
+     linears only).
+  4. Optionally (default) the base pack's own dense tensors on the same input rows, for a per-layer comparison
+     (rfn_base) at no extra calibration cost.
+  5. Reload the block with the new dense tensors and advance the calibration state through it: the next block is
+     calibrated on the output of the requantized blocks before it, as in the converter.
+
+Calibration rows are batched (--batch rows per forward; the converter runs one row at a time; batching changes only
+GEMM shapes, see --verify_batch). The job (args.json, ckpt/job.json + state.safetensors + original_input_ids
+.safetensors) has the converter's checkpoint format, so a converter checkpoint can seed it (--seed) and it resumes with
+-r. A layer range (--layers a-b) splits one requantization across machines: the second machine starts at layer a
+from a seed taken at that layer (e.g. the base conversion's own checkpoint, i.e. the base pack's quantized states), or
+with --advance_base it first runs layers before a with the base pack's tensors unchanged.
+
+The output pack is assembled from the base pack and one or more work dirs' qtensors by a separate step (stdlib
+only, byte copies of every kept tensor): the recipe's tools/exl3/dense_pack.py.
+
+  python3 -m exllamav3.conversion.requant_dense -b /base -s /src -w /work --bits 3.0 [--override "*.k_proj=4,*.v_proj=4"]
+          [--layers 32-61 --seed /seed] [--batch 10] [-r]
+"""
+
+import argparse
+import fnmatch
+import glob
+import json
+import os
+import re
+import shutil
+import sys
+import time
+
+col_default = "\u001b[0m"
+col_red = "\u001b[31;1m"
+
+EXPERT_RE = re.compile(r"\.experts\.\d+\.")
+EXL3_SUBKEYS = ("su", "sv", "suh", "svh", "trellis", "bias", "mcg", "mul1")
+NUM_REF_ROWS = 5
+
+parser = argparse.ArgumentParser(allow_abbrev = False, description = "Dense-only requantization of an EXL3 pack")
+parser.add_argument("-b", "--base", type = str, default = None, help = "Base EXL3 pack (config, tokenizer, and every tensor that is not requantized)")
+parser.add_argument("-s", "--dense_src", type = str, default = None, help = "Unquantized source of the dense linears: directories or .safetensors files (comma separated) holding <key>.weight; other tensors in them are ignored")
+parser.add_argument("-w", "--work_dir", type = str, required = True, help = "Working directory (job state, qtensors, report)")
+parser.add_argument("--bits", type = float, default = None, help = "Bitrate of the dense linears (1-8, or 1.5/2.5/3.5 with the mul1 codebook)")
+parser.add_argument("--override", type = str, default = "", help = "Per-tensor bitrates, comma separated pattern=bits, fnmatch on the full key, last match wins, e.g. \"*.k_proj=4,*.v_proj=4\"")
+parser.add_argument("--layers", type = str, default = None, help = "Decoder layers to requantize, a-b (inclusive), default all")
+parser.add_argument("--seed", type = str, default = None, help = "Start from this checkpoint dir (job.json, state.safetensors, original_input_ids.safetensors; converter or requant format)")
+parser.add_argument("--advance_base", action = "store_true", help = "Run the decoder layers before --layers with the base pack's tensors (unchanged) to reach the first layer")
+parser.add_argument("--ids_ref", type = str, default = None, help = "original_input_ids.safetensors of the base conversion: require identical calibration rows")
+parser.add_argument("-cr", "--cal_rows", type = int, default = None, help = "Calibration rows (default: the base pack's)")
+parser.add_argument("-cc", "--cal_cols", type = int, default = None, help = "Calibration columns (default: the base pack's)")
+parser.add_argument("-cb", "--codebook", type = str, default = None, help = "Codebook (default: the base pack's)")
+parser.add_argument("--batch", type = int, default = 10, help = "Calibration rows per forward pass")
+parser.add_argument("--verify_batch", action = "store_true", help = "First requantized layer: also run the first batch's rows one at a time and report the difference")
+parser.add_argument("--no_ref_base", action = "store_true", help = "Skip the base pack's dense tensors on the reference rows (rfn_base)")
+parser.add_argument("-cpi", "--checkpoint_interval", type = int, default = 600, help = "Minimum seconds between checkpoints; a checkpoint is always written at the end of a range that stops before the last block; < 0: no other checkpoints (an interrupted job restarts from its seed)")
+parser.add_argument("-d", "--device", type = int, default = 0, help = "CUDA device")
+parser.add_argument("-r", "--resume", action = "store_true", help = "Resume the job in --work_dir")
+parser.add_argument("--plan", action = "store_true", help = "Print the plan (tensors, bitrates, sizes, sources found) and exit; no GPU work")
+
+
+def parse_overrides(s):
+    out = []
+    for part in [p.strip() for p in s.split(",") if p.strip()]:
+        assert "=" in part, f"--override entry without '=': {part}"
+        pat, bits = part.rsplit("=", 1)
+        out.append((pat.strip(), float(bits)))
+    return out
+
+
+def parse_layers(s, num_layers):
+    if not s:
+        return 0, num_layers - 1
+    a, b = (s.split("-") + [None])[:2]
+    a = int(a)
+    b = int(b) if b not in (None, "") else num_layers - 1
+    assert 0 <= a <= b < num_layers, f"--layers {s} outside 0-{num_layers - 1}"
+    return a, b
+
+
+def valid_bits(v, codebook):
+    from .allocation import HALF_RATES
+    if float(v).is_integer() and 1 <= v <= 8:
+        return True
+    return codebook == "mul1" and float(v) in HALF_RATES
+
+
+def norm_bits(v):
+    return int(v) if float(v).is_integer() else float(v)
+
+
+def dense_strategy(linears, bits, overrides):
+    strategy = {}
+    for lin in linears:
+        k = bits
+        for pat, b in overrides:
+            if fnmatch.fnmatchcase(lin.key, pat):
+                k = b
+        strategy[lin.key] = norm_bits(k)
+    return strategy
+
+
+def block_linears(block):
+    from ..modules import Linear
+    dense, experts = [], []
+    for m in block:
+        if isinstance(m, Linear):
+            (experts if EXPERT_RE.search(m.key + ".") else dense).append(m)
+    return dense, experts
+
+
+def save_list(tensors, path):
+    from ..loader.safetensors_alt import save_file
+    save_file({f"tensor.{i}": t for i, t in enumerate(tensors)}, path)
+
+
+def load_list(path):
+    from ..loader.safetensors_alt import safe_open
+    with safe_open(path, framework = "pt", device = "cpu") as f:
+        keys = set(f.keys())
+        if "tensor" in keys:
+            return [f.get_tensor("tensor")]
+        out, i = [], 0
+        while f"tensor.{i}" in keys:
+            out.append(f.get_tensor(f"tensor.{i}"))
+            i += 1
+        return out
+
+
+def write_checkpoint(work, job, state, ids):
+    """ckpt_new -> ckpt (previous ckpt -> ckpt_old). The older ckpt_old goes first, so the disk holds at most two
+    state copies (16.8 GB each for 250 x 2048 x 8192 fp32) and always one complete checkpoint"""
+    ck, ck_new, ck_old = (os.path.join(work, d) for d in ("ckpt", "ckpt_new", "ckpt_old"))
+    if os.path.exists(ck_old) and os.path.exists(os.path.join(ck, "job.json")):
+        shutil.rmtree(ck_old)          # this job's own superseded checkpoint
+    if os.path.exists(ck_new):
+        shutil.rmtree(ck_new)          # a partial write of this job's
+    os.makedirs(ck_new)
+    with open(os.path.join(ck_new, "job.json"), "w") as f:
+        json.dump(job, f, indent = 4)
+    save_list(state, os.path.join(ck_new, "state.safetensors"))
+    save_list(ids, os.path.join(ck_new, "original_input_ids.safetensors"))
+    if os.path.exists(ck):
+        if os.path.exists(ck_old):
+            shutil.rmtree(ck_old)
+        os.rename(ck, ck_old)
+    os.rename(ck_new, ck)
+
+
+def add_filtered_tensor_files(stc, sources, wanted):
+    """Add only the keys in `wanted` from the .safetensors files under `sources` to the collection (headers only).
+    Returns the set of keys found."""
+    from ..loader.safetensors import read_header
+    files = []
+    for s in sources:
+        if s.endswith(".safetensors") and os.path.isfile(s):
+            files.append(s)
+        else:
+            files += sorted(glob.glob(os.path.join(s, "*.safetensors")))
+    found = set()
+    for fn in files:
+        header = read_header(fn, stc.tensor_name_fixes)
+        keys = [k for k in header if k not in ("__metadata__", "_header_offset") and k in wanted]
+        if not keys:
+            continue
+        if fn not in stc.file_headers:
+            stc.tensor_files.append(fn)
+            stc.handles[fn] = None
+        stc.file_headers[fn] = header
+        for k in keys:
+            stc.tensor_file_map[k] = fn
+            found.add(k)
+    return found
+
+
+class Batches:
+    """Row batches over the calibration state (rows in bad_rows skipped)"""
+    def __init__(self, n, bad_rows, batch):
+        rows = [i for i in range(n) if i not in bad_rows]
+        self.chunks = [rows[c : c + batch] for c in range(0, len(rows), batch)]
+
+
+def run_forward(module, state, ids, chunk, extra = None):
+    import torch
+    params = {"attn_mode": "flash_attn_nc", "input_ids": torch.cat([ids[i] for i in chunk], dim = 0),
+              "quant_preserve": {}}
+    if extra:
+        params.update(extra)
+    x = module.prepare_for_device(torch.cat([state[i] for i in chunk], dim = 0), params)
+    return module.forward(x, params)
+
+
+def state_error(x, ref):
+    import torch
+    from ..util.measures import cosine_error, sqnr
+    x = x.view(-1, x.shape[-1]).float()
+    ref = ref.view(-1, ref.shape[-1]).float().to(x.device)
+    err = torch.linalg.norm(x - ref, "fro") / torch.linalg.norm(ref, "fro")
+    return err.item(), cosine_error(x, ref), sqnr(x, ref)
+
+
+def load_module(module, device, stc, new_tensors = None):
+    import torch
+    stc.set_new_tensors(new_tensors)
+    try:
+        defer = module.can_defer_load()
+        if defer:
+            stc.begin_deferred_load()
+        try:
+            dev = torch.device("cpu") if module.caps.get("prefer_cpu") else device
+            module.load(dev, keep_source_weights = True)
+        finally:
+            if defer:
+                stc.end_deferred_load()
+    finally:
+        stc.set_new_tensors(None)
+    stc.close()
+
+
+def prepare(args):
+    """Resolve and persist the job's arguments. Returns (in_args, job)"""
+    work = args.work_dir
+    os.makedirs(os.path.join(work, "qtensors"), exist_ok = True)
+    args_path = os.path.join(work, "args.json")
+    if args.resume:
+        in_args = json.load(open(args_path))
+        # Settings that would change the result must match the job
+        for k in ("base", "dense_src", "bits", "override", "layers", "cal_rows", "cal_cols", "codebook"):
+            v = getattr(args, k)
+            if v is not None and v != "" and v != in_args.get(k) and not (k == "dense_src"):
+                raise SystemExit(f" ## Resuming with {k} = {in_args.get(k)}, cannot change it to {v}")
+        if args.dense_src:
+            in_args["dense_src"] = args.dense_src          # paths may move between machines
+        for k in ("batch", "checkpoint_interval", "device", "no_ref_base"):
+            in_args[k] = getattr(args, k)
+        ck_job = os.path.join(work, "ckpt", "job.json")
+        if os.path.exists(ck_job):
+            return in_args, json.load(open(ck_job)), True
+        # Stopped before its first checkpoint: start over from the seed (or the calibration data)
+        return in_args, {"next_module_idx": 0, "q_strategy": None, "bad_rows": [], "mode": "requant_dense"}, False
+
+    assert args.base and args.dense_src and args.bits is not None, "--base, --dense_src and --bits are required"
+    assert not os.path.exists(os.path.join(work, "ckpt", "job.json")), f"{work} holds a job already (use -r)"
+    base_cfg = json.load(open(os.path.join(args.base, "config.json")))
+    qcfg = base_cfg.get("quantization_config", {})
+    assert qcfg.get("quant_method") == "exl3", f"{args.base} is not an EXL3 pack"
+    cal = qcfg.get("calibration", {})
+    in_args = {
+        "base": args.base,
+        "dense_src": args.dense_src,
+        "bits": args.bits,
+        "override": args.override,
+        "layers": args.layers,
+        "seed": args.seed,
+        "advance_base": args.advance_base,
+        "cal_rows": args.cal_rows or cal.get("rows", 250),
+        "cal_cols": args.cal_cols or cal.get("cols", 2048),
+        "codebook": args.codebook or qcfg.get("codebook", "mul1"),
+        "out_scales": qcfg.get("out_scales", "auto"),
+        "batch": args.batch,
+        "checkpoint_interval": args.checkpoint_interval,
+        "device": args.device,
+        "no_ref_base": args.no_ref_base,
+        "ids_ref": args.ids_ref,
+    }
+    job = {"next_module_idx": 0, "q_strategy": None, "bad_rows": [], "mode": "requant_dense"}
+    return in_args, job, False
+
+
+def main(args):
+    import torch
+    from .. import Config, Model, Tokenizer
+    from ..loader.safetensors import SafetensorsCollection
+    from ..modules.quant import LinearFP16, LinearEXL3
+    from ..modules.quant.exl3_lib.quantize import get_temp_buffers
+    from ..util.memory import free_mem, malloc_trim
+    from . import convert_model as cm
+    from .calibration_data import get_default_calibration
+
+    torch.set_grad_enabled(False)
+    work = args.work_dir
+    if os.path.exists(os.path.join(work, "requant-done.json")):
+        print(f" -- {work}: requantization already done (requant-done.json)")
+        return
+    in_args, job, from_ckpt = prepare(args)
+    codebook = in_args["codebook"]
+    bits = in_args["bits"]
+    overrides = parse_overrides(in_args["override"])
+    assert valid_bits(bits, codebook), f"--bits {bits} is not a supported rate"
+    for pat, b in overrides:
+        assert valid_bits(b, codebook), f"--override {pat}={b}: not a supported rate"
+
+    # Model from the base pack. The base pack's own dense EXL3 tensors are hidden for the layers being requantized
+    # (kept in a second collection for rfn_base), and the source `.weight` of exactly those linears is added
+    config = Config.from_directory(in_args["base"])
+    model = Model.from_config(config)
+    stc = config.stc
+    num_layers = config.num_hidden_layers
+    first = model.first_block_idx
+    la, lb = parse_layers(in_args["layers"], num_layers)
+    blocks = model.modules[first : first + num_layers]
+
+    plan = {}
+    for li, block in enumerate(blocks):
+        dense, experts = block_linears(block)
+        for e in experts:
+            e.qmap = None                # never capture expert Hessians
+        if la <= li <= lb:
+            plan[li] = (dense, dense_strategy(dense, bits, overrides))
+    want = {f"{lin.key}.weight": lin for li, (dense, _) in plan.items() for lin in dense}
+    hidden = {}
+    for li, (dense, _) in plan.items():
+        for lin in dense:
+            assert stc.has_tensor(f"{lin.key}.trellis"), f"{lin.key}: not an EXL3 tensor in the base pack"
+            for sub in EXL3_SUBKEYS:
+                k = f"{lin.key}.{sub}"
+                if k in stc.tensor_file_map:
+                    hidden[k] = stc.tensor_file_map.pop(k)
+    found = add_filtered_tensor_files(stc, in_args["dense_src"].split(","), set(want))
+    missing = sorted(set(want) - found)
+
+    # Plan summary
+    numel_new = {}
+    for li, (dense, strat) in plan.items():
+        for lin in dense:
+            kind = lin.key.rsplit(".", 1)[-1]
+            numel_new.setdefault((kind, strat[lin.key]), 0)
+            numel_new[(kind, strat[lin.key])] += lin.weights_numel()
+    print(f" -- Dense requantization of {in_args['base']}")
+    print(f"    Layers {la}-{lb} of {num_layers}, {sum(len(d) for d, _ in plan.values())} dense linears "
+          f"({len(next(iter(plan.values()))[0])} a layer), experts and all other tensors from the base pack")
+    for (kind, k), n in sorted(numel_new.items()):
+        print(f"    {kind:20s} {k:>4} bpw  {n / 1e9:7.3f} G weights")
+    print(f"    Dense source: {in_args['dense_src']} ({len(found)} of {len(want)} tensors found)")
+    print(f"    Calibration: {in_args['cal_rows']} rows x {in_args['cal_cols']}, batch {in_args['batch']}, "
+          f"codebook {codebook}, out scales {in_args['out_scales']}")
+    if missing:
+        print(f" !! {col_red}Missing source tensors{col_default}: {missing[:5]}{' ...' if len(missing) > 5 else ''}")
+        raise SystemExit(1)
+    if args.plan:
+        return
+
+    json.dump(in_args, open(os.path.join(work, "args.json"), "w"), indent = 4)
+    device = torch.device(in_args["device"])
+    qargs = {
+        "work_dir": work, "apply_out_scales": {"always": True, "never": False}.get(in_args["out_scales"]),
+        "out_scales_hessian": False, "hessians": "", "hessians_reg": 0.025, "scaled_hessian": False,
+        "codebook": codebook, "image_dump": False, "verbose": False,
+    }
+    base_stc = SafetensorsCollection(in_args["base"]) if not in_args["no_ref_base"] else None
+
+    # Record proxy errors per tensor from the converter's own report line
+    qlog = {}
+    orig_print = cm.print_quantized_linear
+    def print_quantized_linear(config_, linear, quant_args, proxy_err, time_str = ""):
+        qlog[linear.key] = {"bits": quant_args["K"], "proxy_err": float(proxy_err)}
+        orig_print(config_, linear, quant_args, proxy_err, time_str)
+    cm.print_quantized_linear = print_quantized_linear
+
+    # Initial state
+    if from_ckpt:
+        ck = os.path.join(work, "ckpt")
+        state = load_list(os.path.join(ck, "state.safetensors"))
+        ids = load_list(os.path.join(ck, "original_input_ids.safetensors"))
+        print(f" -- Resuming at module {job['next_module_idx']}")
+    elif in_args["seed"]:
+        sd = in_args["seed"]
+        job = json.load(open(os.path.join(sd, "job.json")))
+        job = {"next_module_idx": job["next_module_idx"], "q_strategy": None, "bad_rows": job.get("bad_rows") or [],
+               "mode": "requant_dense"}
+        state = load_list(os.path.join(sd, "state.safetensors"))
+        ids = load_list(os.path.join(sd, "original_input_ids.safetensors"))
+        print(f" -- Seeded from {sd} at module {job['next_module_idx']}")
+    else:
+        tokenizer = Tokenizer.from_config(config)
+        rows = get_default_calibration({"cal_rows": in_args["cal_rows"], "cal_cols": in_args["cal_cols"]}, tokenizer)
+        ids = [r.clone() for r in rows]
+        state = rows
+        print(f" -- Calibration data: {len(rows)} rows")
+    if in_args.get("ids_ref"):
+        ref_ids = load_list(in_args["ids_ref"])
+        same = len(ref_ids) == len(ids) and all(torch.equal(a, b) for a, b in zip(ref_ids, ids))
+        assert same, f"calibration rows differ from {in_args['ids_ref']}"
+        print(f" -- Calibration rows identical to {in_args['ids_ref']}")
+    assert len(state) == len(ids) == in_args["cal_rows"] or from_ckpt or in_args["seed"], "calibration size"
+    bad_rows = set(job.get("bad_rows") or [])
+    nxt = job["next_module_idx"]
+    end_idx = first + lb + 1
+    if not from_ckpt and nxt > first + la:
+        raise SystemExit(f" ## The seed is at module {nxt}, past layer {la} (module {first + la})")
+    if la > 0 and nxt < first + la and not in_args["advance_base"]:
+        raise SystemExit(f" ## The state is at module {nxt}, layer {la} is module {first + la}: seed the job at "
+                         f"that layer or pass --advance_base")
+
+    report_path = os.path.join(work, "report.jsonl")
+    last_ckpt = time.time()
+    batch = in_args["batch"]
+    t_job = time.time()
+
+    def advance(module, label, measure = None):
+        """state <- module(state) over all good rows; measure: {row: ref} for rfn"""
+        errs = []
+        b = Batches(len(state), bad_rows, batch)
+        for chunk in b.chunks:
+            rs = run_forward(module, state, ids, chunk)
+            rs = rs.cpu()
+            for j, i in enumerate(chunk):
+                r = rs[j : j + 1].clone()
+                if not torch.isfinite(r).all().item():
+                    bad_rows.add(i)
+                    print(f" !! Non-finite hidden state in calibration row {i}, excluding row")
+                elif measure is not None and i in measure:
+                    errs.append(state_error(r, measure[i]))
+                state[i] = r
+        cm.check_bad_rows(bad_rows, len(state))
+        return errs
+
+    for idx in range(nxt, end_idx):
+        module = model.modules[idx]
+        get_temp_buffers.cache_clear()
+        free_mem()
+        t0 = time.time()
+        li = idx - first
+
+        if li < la:
+            # Before the range: embedding / norm, or a block run with the base pack's tensors unchanged
+            load_module(module, device, stc)
+            advance(module, module.key)
+            module.unload()
+            print(f" -- Advanced (base pack): {module.key}  [{time.time() - t0:.2f} s]", flush = True)
+        else:
+            dense, strategy = plan[li]
+            secs = {}
+
+            # 1. Dense linears from the source, everything else from the base pack
+            load_module(module, device, stc)
+            for lin in dense:
+                assert isinstance(lin.inner, LinearFP16), f"{lin.key}: expected the unquantized source weight"
+            for e in block_linears(module)[1]:
+                assert isinstance(e.inner, LinearEXL3), f"{e.key}: expected the base pack's EXL3 tensor"
+            secs["load"] = time.time() - t0
+
+            # 2. Capture
+            t1 = time.time()
+            capture_H, refs = {}, {}
+            b = Batches(len(state), bad_rows, batch)
+            single = None
+            for c, chunk in enumerate(b.chunks):
+                if c == 0 and args.verify_batch and li == la and len(chunk) > 1:
+                    single = [run_forward(module, state, ids, [i]).float().cpu() for i in chunk]
+                rs = run_forward(module, state, ids, chunk, {"capture": capture_H})
+                for j, i in enumerate(chunk):
+                    if i < NUM_REF_ROWS:
+                        r = rs[j : j + 1]
+                        if torch.isfinite(r).all().item():
+                            refs[i] = r.cpu().clone()
+                        else:
+                            bad_rows.add(i)
+                            print(f" !! Non-finite reference state in calibration row {i}, excluding row")
+                if single is not None and c == 0:
+                    d = max(float((s - rs[j : j + 1].float().cpu()).norm() / s.norm()) for j, s in enumerate(single))
+                    print(f" -- Batch of {len(chunk)} vs one row at a time: max rel l2 {d:.3e}", flush = True)
+                    secs["batch_vs_single_rel_l2"] = d
+                rs = None
+            print(f" -- Captured: {module.key}  Hessians: " +
+                  ", ".join(sorted(set(re.sub(r"\d+", "*", k) for k in capture_H))), flush = True)
+            for k, v in capture_H.items():
+                infs, nans = v["inf_nan"][0].item(), v["inf_nan"][1].item()
+                if infs or nans:
+                    print(f" !! Warning: {k} state has {infs:,} inf values and {nans:,} NaN values")
+                v["H_swap_device"] = v["H"].device
+                v["H"] = v["H"].cpu()
+            secs["capture"] = time.time() - t1
+
+            # 3. Quantize the dense linears (the converter's path: one worker per device, grouped by shared Hessian)
+            t1 = time.time()
+            for lin in dense:
+                lin.inner.swap_cpu()
+            qlog.clear()
+            cm.quantize_linears_parallel(qargs, dense, config, strategy, idx, [in_args["device"]], None, capture_H,
+                                         state, None)
+            capture_H = None
+            q_tensors = {}
+            for lin in dense:
+                q_tensors.update(lin.get_tensors())
+            q_path = os.path.join(work, "qtensors", f"{module.key}.safetensors")
+            cm.save_tensor(q_tensors, os.path.relpath(q_path, work), {"work_dir": work})
+            module.unload()
+            free_mem()
+            secs["quantize"] = time.time() - t1
+
+            # 4. The base pack's dense tensors on the reference rows
+            rfn_base = None
+            if base_stc is not None and refs:
+                t1 = time.time()
+                base_dense = {}
+                for lin in dense:
+                    for sub in EXL3_SUBKEYS:
+                        k = f"{lin.key}.{sub}"
+                        if k in hidden:
+                            base_dense[k] = base_stc.get_tensor(k, "cpu", allow_bf16 = True, no_defer = True)
+                base_stc.close()
+                load_module(module, device, stc, base_dense)
+                ref_rows = sorted(refs)
+                rs = run_forward(module, state, ids, ref_rows).cpu()
+                e = [state_error(rs[j : j + 1], refs[i]) for j, i in enumerate(ref_rows)]
+                rfn_base = [sum(x[n] for x in e) / len(e) for n in range(3)]
+                module.unload()
+                del base_dense, rs
+                free_mem()
+                secs["ref_base"] = time.time() - t1
+
+            # 5. Advance with the new dense tensors (the last block of the model only needs the reference rows)
+            t1 = time.time()
+            load_module(module, device, stc, q_tensors)
+            for lin in dense:
+                assert isinstance(lin.inner, LinearEXL3) and lin.inner.K == strategy[lin.key], f"{lin.key}: reload"
+            if idx == first + num_layers - 1:
+                ref_rows = sorted(refs)
+                rs = run_forward(module, state, ids, ref_rows).cpu()
+                errs = [state_error(rs[j : j + 1], refs[i]) for j, i in enumerate(ref_rows)]
+            else:
+                errs = advance(module, module.key, refs)
+            module.unload()
+            del q_tensors
+            secs["advance"] = time.time() - t1
+            rfn = [sum(x[n] for x in errs) / max(len(errs), 1) for n in range(3)]
+
+            malloc_trim()
+            secs["total"] = time.time() - t0
+            rec = {
+                "layer": li, "module_idx": idx, "key": module.key,
+                "rfn": rfn[0], "cos": rfn[1], "sqnr": rfn[2],
+                "rfn_base": rfn_base[0] if rfn_base else None, "sqnr_base": rfn_base[2] if rfn_base else None,
+                "tensors": dict(qlog),
+                "seconds": {k: (v if k == "batch_vs_single_rel_l2" else round(v, 2)) for k, v in secs.items()},
+                "bad_rows": sorted(bad_rows),
+            }
+            with open(report_path, "a") as f:
+                f.write(json.dumps(rec) + "\n")
+            bpw = sorted(set(strategy.values()))
+            print(
+                f" -- Requantized: {module.key}  dense bpw: {','.join(str(x) for x in bpw)}  rfn: {rfn[0]:.6f}"
+                f"  sqnr: {rfn[2]:.3f}" +
+                (f"  (base dense: rfn {rfn_base[0]:.6f} sqnr {rfn_base[2]:.3f})" if rfn_base else "") +
+                f"  [{secs['total']:.1f} s: load {secs['load']:.1f}, capture {secs['capture']:.1f}, "
+                f"quantize {secs['quantize']:.1f}, " + (f"ref_base {secs['ref_base']:.1f}, " if "ref_base" in secs else "") +
+                f"advance {secs['advance']:.1f}]" + cm.host_rss_str(),
+                flush = True
+            )
+            done_layers = idx - max(nxt, first + la) + 1
+            left = end_idx - idx - 1
+            el = time.time() - t_job
+            if left:
+                print(f" -- Estimated remaining time: {cm.human_time(el / done_layers * left)} ({left} layers)")
+
+        job["next_module_idx"] = idx + 1
+        job["bad_rows"] = sorted(bad_rows)
+        # The state after the model's last block is never read (only its reference rows are run): no checkpoint.
+        # -cpi < 0: only at the end of a range that stops before the last block
+        cpi = in_args["checkpoint_interval"]
+        if idx + 1 < first + num_layers and (
+            idx + 1 == end_idx or (cpi >= 0 and time.time() > last_ckpt + cpi)
+        ):
+            t1 = time.time()
+            write_checkpoint(work, job, state, ids)
+            last_ckpt = time.time()
+            print(f" -- Saved checkpoint: next module {idx + 1}  [{last_ckpt - t1:.1f} s]", flush = True)
+
+    qfiles = [f"{model.modules[first + li].key}.safetensors" for li in range(la, lb + 1)]
+    absent = [f for f in qfiles if not os.path.exists(os.path.join(work, "qtensors", f))]
+    assert not absent, f"qtensors missing after the run: {absent[:3]}"
+    done = {"layers": [la, lb], "next_module_idx": end_idx, "bad_rows": sorted(bad_rows), "qtensors": len(qfiles),
+            "seconds": round(time.time() - t_job)}
+    json.dump(done, open(os.path.join(work, "requant-done.json"), "w"), indent = 4)
+    print(f" -- Dense requantization done: layers {la}-{lb} ({len(qfiles)} qtensors files) in "
+          f"{cm.human_time(time.time() - t_job)}")
+
+
+if __name__ == "__main__":
+    _args = parser.parse_args()
+    # NVIDIA's CuTe DSL re-parses sys.argv at its first kernel compile (see the recipe's tools/exl3/convert.py)
+    sys.argv = sys.argv[:1]
+    if os.environ.get("TORCH_ALLOW_TF32_CUBLAS_OVERRIDE") is not None:
+        sys.exit("unset TORCH_ALLOW_TF32_CUBLAS_OVERRIDE before requantizing (env -u ...)")
+    main(_args)
